{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "outDir": "out/test",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"]
  },
  "include": [
    "test/**/*",
    "src/webview/positions.ts",
    "src/webview/parser.ts",
    "src/webview/sync.ts"
  ],
  "exclude": ["node_modules"]
}
