---
import Base from "../layouts/Base.astro";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";

/**
 * GENERATED by codegraph (emdash_plugin) — do not edit by hand.
 * Public list page for the {{ s.p.plugin_id }} plugin, backed by the
 * {{ s.list.page_label }} entity's public list route.
 */

interface Row {
  id?: unknown;
  [key: string]: unknown;
}

const format = Astro.url.searchParams.get("format");
const handler = getPublicPluginApiRouteHandler(Astro.locals);
// The dispatcher matches the route by bare name and parses the query string
// off the Request URL into routeCtx.input.
const route = {% if s.list.public_list %}"{{ s.list.public_list.route }}"{% else %}"{{ s.list.camel }}List"{% endif %};
const result = handler
  ? await handler("{{ s.p.plugin_id }}", "GET", route, new Request(Astro.url))
  : { success: false, data: null, error: { code: "NO_LOCALS", message: "emdash locals unavailable" } };

// Contract: the SDK bridge unwraps the legacy { data, meta } envelope, so a
// successful public route result carries the bare list payload. The route
// returns { success, data } and the runtime wraps that again in its own
// HandlerResponse — unwrap both before rendering.
const routePayload = (result.data ?? {}) as { data?: unknown };
const rows: unknown = Array.isArray(result.data) ? result.data : routePayload.data;
const payload: Row[] = Array.isArray(rows) ? (rows as Row[]) : [];
const error = result.success ? null : result.error;

const titleField = "{{ s.list.title_field }}";
const columns: Array<{ label: string; key: string; format?: string }> = [
{%- for c in s.list.columns %}
  { label: "{{ c.label }}", key: "{{ c.key }}"{% if c.format %}, format: "{{ c.format }}"{% endif %} },
{%- endfor %}
];

function cell(row: Row, key: string, format?: string): string {
  const value = row[key];
  if (value === undefined || value === null || value === "") return "";
  if (format === "bool") return value === true ? "Yes" : "No";
  return String(value);
}
---

<Base title="{{ s.list.page_label }}">
  <h1>{{ s.list.page_label }}</h1>
  {format === "json" ? (
    <pre>{JSON.stringify(result, null, 2)}</pre>
  ) : error ? (
    <p>Plugin route error: {error.code}: {error.message}</p>
  ) : payload.length === 0 ? (
    <p>{{ s.list.empty_text }}</p>
  ) : (
    payload.map((row) => (
      <article>
        <h2>
          {typeof row.id === "string" ? (
            <a href={"/{{ s.p.domain_kebab }}/" + row.id}>{String(row[titleField] ?? "")}</a>
          ) : (
            String(row[titleField] ?? "")
          )}
        </h2>
        {columns.map((col) => (
          <p>
            <strong>{col.label}:</strong> {cell(row, col.key, col.format)}
          </p>
        ))}
      </article>
    ))
  )}
</Base>
