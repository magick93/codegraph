/**
 * GENERATED by codegraph (emdash_plugin) — do not edit by hand.
 * Generic CRUD journey for the {{ p.plugin_id }} plugin, driven through
 * apps/community-site (admin Block Kit dispatch + public plugin routes).
 *
 * Mechanics mirror the hand-written events-journey.spec.ts: dev-bypass
 * beforeAll, adminInteraction (X-EmDash-Request), payloadOf unwrap.
 */

import { expect, test, type APIRequestContext, type BrowserContext, type Page } from "@playwright/test";

const PLUGIN_ID = "{{ p.plugin_id }}";
const ADMIN_DISPATCH = `/_emdash/api/admin/plugins/${PLUGIN_ID}/admin`;

const UNIQUE = Date.now().toString(36);

/** POST a Block Kit interaction to the plugin's admin route. */
async function adminInteraction(
  request: APIRequestContext,
  payload: Record<string, unknown>,
): Promise<{ success: boolean; data?: { blocks?: unknown[]; toast?: { message?: string } }; error?: { code: string; message: string } }> {
  const response = await request.post(ADMIN_DISPATCH, {
    data: payload,
    headers: { "X-EmDash-Request": "1" },
  });
  expect(response.status()).toBe(200);
  const body = await response.json();
  // The dispatch route returns the plugin's BlockResponse ({ blocks, toast? })
  // — a rendered payload with no success flag. Treat blocks as success and
  // keep toast alongside for the assertions below.
  const inner = (body.data ?? body) as {
    blocks?: unknown[];
    toast?: { message?: string };
    error?: { code: string; message: string };
  };
  if (inner && typeof inner === "object" && "blocks" in inner) {
    return { success: true, data: inner };
  }
  return { success: Boolean((inner as { success?: boolean }).success), ...inner };
}

function formSubmit(actionId: string, values: Record<string, unknown>, blockId?: string) {
  return { type: "form_submit", action_id: actionId, values, ...(blockId ? { block_id: blockId } : {}) };
}

function blockAction(actionId: string, value: Record<string, unknown> = {}) {
  return { type: "block_action", action_id: actionId, value };
}

/** Public plugin routes return {success,data:{success,data}} — unwrap once. */
function payloadOf(body: { success: boolean; data?: unknown }): unknown {
  const inner = body.data as { success?: boolean; data?: unknown } | undefined;
  if (inner && typeof inner === "object" && "data" in inner) return inner.data;
  return body.data;
}

test.describe.serial("{{ p.domain_pascal }} generated CRUD journey", () => {
  let context: BrowserContext;
  let page: Page;

  test.beforeAll(async ({ browser }) => {
    context = await browser.newContext();
    await context.request.post("/_emdash/api/setup/dev-reset");
    const bypass = await context.request.post("/_emdash/api/setup/dev-bypass?content=0");
    expect(bypass.status()).toBe(200);
    page = await context.newPage();
  });

  test.afterAll(async () => {
    await context.request.post("/_emdash/api/setup/dev-reset");
    await context.close();
  });
{% for e in p.entities %}
  test("{{ e.page_label }} admin page renders Block Kit blocks", async () => {
    // The admin shell is a client-rendered SPA; the first load initializes
    // the EmDash runtime and can exceed the default 5s expect timeout.
    test.setTimeout(120_000);
{%- if loop.first %}
    await page.goto("/_emdash/admin", { waitUntil: "domcontentloaded" });
    await expect(page.getByText("Loading EmDash...")).toBeHidden({ timeout: 60_000 });
    // First-run onboarding dialog (dev-bypass admin) blocks the shell until
    // dismissed — same handling as the emdash-site admin-lifecycle spec.
    const welcome = page.getByRole("dialog", { name: "Welcome to EmDash, Dev!" });
    if (await welcome.isVisible().catch(() => false)) {
      await welcome.getByRole("button", { name: "Get Started" }).click();
    }
{%- endif %}
    await page.goto(`/_emdash/admin/plugins/${PLUGIN_ID}{{ e.page_path }}`);
    await expect(page.getByRole("heading", { name: "{{ e.page_label }}", exact: true })).toBeVisible({
      timeout: 30_000,
    });
  });
{%- if e.has_create %}

  test("creates, lists and deletes a {{ e.page_label }}", async () => {
    const title = {{ e.e2e_title_expr }};
    const created = await adminInteraction(
      context.request,
      formSubmit("{{ e.key }}:create", {
{%- for f in e.e2e_payload %}
        {{ f.name }}: {{ f.value }},
{%- endfor %}
      }),
    );
    expect(created.success).toBe(true);

    const loaded = await adminInteraction(context.request, { type: "page_load", page: "{{ e.page_path }}" });
    expect(loaded.success).toBe(true);
    expect(JSON.stringify(loaded.data ?? {})).toContain(String(title));
{%- if e.public_list %}

    // Public list route.
    const list = await context.request.get(`/_emdash/api/plugins/${PLUGIN_ID}/{{ e.public_list.route }}`);
    expect(list.status()).toBe(200);
    const listBody = await list.json();
    expect(listBody.success).toBe(true);
{%- if not e.public_list.filter_field %}
    const titles = (payloadOf(listBody) as Array<Record<string, unknown>>).map(
      (row) => String(row["{{ e.title_field }}"] ?? ""),
    );
    expect(titles).toContain(String(title));
{%- endif %}
{%- endif %}
{%- if e.has_delete %}

    // Delete via the admin block action to prove the full CRUD loop.
    const all = await (await context.request.get(`/_emdash/api/plugins/${PLUGIN_ID}/{{ e.camel }}List`)).json();
    const found = (payloadOf(all) as Array<Record<string, unknown>>).find(
      (row) => String(row["{{ e.title_field }}"] ?? "") === String(title),
    );
    expect(found).toBeDefined();
    const deleted = await adminInteraction(
      context.request,
      blockAction("{{ e.key }}:delete", { id: (found as Record<string, unknown>).id }),
    );
    expect(deleted.success).toBe(true);
{%- endif %}
  });
{%- endif %}
{% endfor -%}
});
