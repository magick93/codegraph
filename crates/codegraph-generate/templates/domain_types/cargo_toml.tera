# Generated by {{ project.generator_name }}. DO NOT EDIT.

[package]
name = "{{ project.domain_types_crate | replace(from="_", to="-") }}"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
uuid = { version = "1", features = ["v4", "serde", "js"] }
chrono = { version = "0.4", features = ["serde"] }
rust_decimal = { version = "1", features = ["serde-with-str"] }
utoipa = { version = "6", features = ["chrono", "uuid", "decimal"] }
async-trait = "0.1"
garde = { version = "0.22", features = ["derive", "regex"] }
thiserror = "2"
{% if project.type_contracts_base %}codegraph-type-contracts = { path = "{{ project.type_contracts_base }}" }
{% elif project.codegraph_rev %}codegraph-type-contracts = { git = "https://github.com/magick93/codegraph.git", rev = "{{ project.codegraph_rev }}" }{% endif %}
{%- if has_machines %}
# Machine kernel (issue #815): the `machines` registry deserializes the
# compiled artifact's xstate-ir Machine JSON and re-runs the structural
# validation. Tokio-free (`default-features = false`) — wasm32-safe, the
# domain-types crate links on both targets.
xstate-core = { git = "https://github.com/yestechgroup/restingstate.git", rev = "da0c804d3c30a0bcc938562e39a4b7d7505c663b", default-features = false }
{%- endif %}
{%- if has_machine_guards %}
# The guard seam (issue #816): the generated `MachineGuardImpls` dispatch
# implements the workflow crate's `MachineGuards` trait, so the app can
# register its guard implementations with the workflow service
# (`with_guards`). Wasm32-safe (the workflow crate's kernel decision path
# is sea_orm-free).
{% if project.codegraph_workflow_base %}codegraph-workflow = { path = "{{ project.codegraph_workflow_base }}" }
{% elif project.codegraph_rev %}codegraph-workflow = { git = "https://github.com/magick93/codegraph.git", rev = "{{ project.codegraph_rev }}" }{% endif %}
{%- endif %}
