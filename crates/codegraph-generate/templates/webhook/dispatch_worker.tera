//! Webhook dispatch + delivery (cornucopia provider — worker slice).
//! Generated by {{ project.generator_name }}. DO NOT EDIT.
//!
//! Two halves of the webhook pipeline, split across deployment modes:
//!
//! - **wasm32** (Cloudflare Worker): a `#[event(scheduled)]` cron drain pulls
//!   `events_{{ name }}` from pgmq, INSERTs `platform.webhook_delivery` rows,
//!   and *enqueues* a [`DeliveryJob`] onto the domain's Cloudflare Queue; a
//!   `#[event(queue)]` consumer then performs the HTTP POST and records the
//!   outcome. Transient failures return an error so the queue retries.
//! - **native** (dev/test): a tokio interval loop performs the same drain and
//!   delivers inline over `reqwest` (no Cloudflare Queue available), so the
//!   pipeline is fully testable without a Cloudflare account.

use cornucopia_queries::client::GenericClient;
use hmac::{Hmac, Mac};
use serde::{Deserialize, Serialize};
use sha2::Sha256;
use uuid::Uuid;

use crate::app_state::AppState;

type HmacSha256 = Hmac<Sha256>;

/// Max delivery attempts before an endpoint is auto-deactivated.
pub const MAX_RETRIES: i32 = {{ queue_max_retries }};

/// A delivery job enqueued to (and consumed from) the domain's Cloudflare
/// Queue. Carries enough to locate the delivery row; the consumer re-reads
/// the payload/endpoint from the database at delivery time.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct DeliveryJob {
    pub delivery_id: Uuid,
    pub tenant_id: Uuid,
    pub endpoint_id: Uuid,
    pub subscription_id: Uuid,
}

/// Compute the HMAC-SHA256 hex signature for a webhook body.
fn hmac_signature(secret: Option<&str>, body: &[u8]) -> Option<String> {
    let secret = secret?;
    let mut mac = HmacSha256::new_from_slice(secret.as_bytes()).ok()?;
    mac.update(body);
    Some(hex::encode(mac.finalize().into_bytes()))
}

/// Build the outbound request headers: Content-Type, `X-Webhook-Signature`
/// (HMAC-SHA256), `X-Webhook-Timestamp`, plus endpoint custom headers.
fn outbound_headers(
    secret: Option<&str>,
    custom: &serde_json::Value,
    body: &[u8],
) -> Vec<(String, String)> {
    let mut headers = vec![(
        "Content-Type".to_string(),
        {% if project.event_envelope == "cloudevents" %}"application/cloudevents+json".to_string(){% else %}"application/json".to_string(){% endif %}
    )];
    if let Some(sig) = hmac_signature(secret, body) {
        headers.push(("X-Webhook-Signature".to_string(), format!("sha256={sig}")));
    }
    headers.push((
        "X-Webhook-Timestamp".to_string(),
        chrono::Utc::now().timestamp().to_string(),
    ));
    if let Some(obj) = custom.as_object() {
        for (k, v) in obj {
            if let Some(val) = v.as_str() {
                headers.push((k.clone(), val.to_string()));
            }
        }
    }
    headers
}

/// Exponential backoff for the next retry (no jitter on wasm — fastrand's
/// thread-local RNG does not seed reliably under `wasm32-unknown-unknown`).
pub fn delay_for_attempt(attempt: u32) -> chrono::DateTime<chrono::Utc> {
    let base_secs = 10u64 * 2u64.pow(attempt.saturating_sub(1));
    chrono::Utc::now() + chrono::Duration::seconds(base_secs as i64)
}

#[cfg(not(target_arch = "wasm32"))]
async fn http_post(
    url: &str,
    body: Vec<u8>,
    headers: Vec<(String, String)>,
) -> (Option<i32>, Option<String>, bool) {
    let mut req = reqwest::Client::new().post(url);
    for (k, v) in &headers {
        req = req.header(k.as_str(), v.as_str());
    }
    match req.body(body).send().await {
        Ok(r) => {
            let status = r.status().as_u16();
            let b = r.text().await.unwrap_or_default();
            (Some(status as i32), Some(b), (200..300).contains(&status))
        }
        Err(e) => (None, Some(e.to_string()), false),
    }
}

#[cfg(target_arch = "wasm32")]
async fn http_post(
    url: &str,
    body: Vec<u8>,
    headers: Vec<(String, String)>,
) -> (Option<i32>, Option<String>, bool) {
    let mut init = worker::RequestInit::new();
    init.with_method(worker::Method::Post);
    let hdrs = worker::Headers::new();
    for (k, v) in &headers {
        let _ = hdrs.set(k, v);
    }
    init.with_headers(hdrs);
    init.with_body(Some(worker::js_sys::Uint8Array::from(body.as_slice()).into()));
    let req = match worker::Request::new_with_init(url, &init) {
        Ok(r) => r,
        Err(e) => return (None, Some(e.to_string()), false),
    };
    match worker::Fetch::Request(req).send().await {
        Ok(mut resp) => {
            let status = resp.status_code();
            let b = resp.text().await.unwrap_or_default();
            (Some(status as i32), Some(b), (200..300).contains(&status))
        }
        Err(e) => (None, Some(e.to_string()), false),
    }
}

/// Deliver one job: fetch the delivery + endpoint rows, POST the payload with
/// an HMAC signature, and record the outcome (delivered / scheduled retry /
/// endpoint deactivation). Returns `Err` on a failed delivery so the queue
/// consumer (wasm) retries; the native inline path ignores that `Err`.
pub async fn deliver_job(state: &AppState, job: &DeliveryJob) -> Result<(), String> {
    let client = state.client_source.client().await.map_err(|e| e.to_string())?;

    let row = client
        .query_opt(
            "SELECT d.event_payload, d.attempt, e.url, e.hmac_secret, e.headers \
             FROM platform.webhook_delivery d \
             JOIN platform.webhook_endpoint e ON e.id = d.endpoint_id \
             WHERE d.id = $1",
            &[&job.delivery_id],
        )
        .await
        .map_err(|e| e.to_string())?;

    let Some(row) = row else {
        // Delivery row gone — treat as acknowledged.
        return Ok(());
    };

    let event_payload: serde_json::Value = row.try_get(0).map_err(|e| e.to_string())?;
    let attempt: i32 = row.try_get(1).map_err(|e| e.to_string())?;
    let url: String = row.try_get(2).map_err(|e| e.to_string())?;
    let hmac_secret: Option<String> = row.try_get(3).map_err(|e| e.to_string())?;
    let headers: serde_json::Value = row.try_get(4).map_err(|e| e.to_string())?;

    let body = serde_json::to_vec(&event_payload).unwrap_or_default();
    let outbound = outbound_headers(hmac_secret.as_deref(), &headers, &body);
    let (status, response_body, delivered) = http_post(&url, body, outbound).await;

    if delivered {
        client
            .execute(
                "UPDATE platform.webhook_delivery \
                 SET response_status = $1, response_body = $2, delivered_at = now(), attempt = $3 \
                 WHERE id = $4",
                &[&status, &response_body, &attempt, &job.delivery_id],
            )
            .await
            .map_err(|e| e.to_string())?;
        tracing::info!(delivery_id = %job.delivery_id, status = ?status, "webhook delivered");
        Ok(())
    } else {
        let next_retry = delay_for_attempt(attempt as u32);
        let new_attempt = attempt + 1;
        client
            .execute(
                "UPDATE platform.webhook_delivery \
                 SET response_status = $1, response_body = $2, attempt = $3, next_retry_at = $4 \
                 WHERE id = $5",
                &[
                    &status,
                    &response_body,
                    &new_attempt,
                    &next_retry,
                    &job.delivery_id,
                ],
            )
            .await
            .map_err(|e| e.to_string())?;

        if new_attempt > MAX_RETRIES {
            client
                .execute(
                    "UPDATE platform.webhook_endpoint SET is_active = false WHERE id = $1",
                    &[&job.endpoint_id],
                )
                .await
                .map_err(|e| e.to_string())?;
            tracing::warn!(endpoint_id = %job.endpoint_id, "webhook endpoint deactivated after exhausting retries");
        }

        Err(format!(
            "webhook delivery {} failed (status {status:?})",
            job.delivery_id
        ))
    }
}

/// Deliveries that are due for (re)delivery.
async fn ready_deliveries(state: &AppState) -> Result<Vec<DeliveryJob>, String> {
    let client = state.client_source.client().await.map_err(|e| e.to_string())?;
    let rows = client
        .query(
            "SELECT d.id, d.tenant_id, d.endpoint_id, d.subscription_id \
             FROM platform.webhook_delivery d \
             JOIN platform.webhook_endpoint e ON e.id = d.endpoint_id \
             WHERE d.delivered_at IS NULL \
               AND d.attempt < $1 \
               AND (d.next_retry_at IS NULL OR d.next_retry_at <= now()) \
               AND e.is_active = true \
             ORDER BY d.created_at ASC LIMIT 50",
            &[&MAX_RETRIES],
        )
        .await
        .map_err(|e| e.to_string())?;

    rows.into_iter()
        .map(|r| {
            Ok(DeliveryJob {
                delivery_id: r.try_get(0).map_err(|e| e.to_string())?,
                tenant_id: r.try_get(1).map_err(|e| e.to_string())?,
                endpoint_id: r.try_get(2).map_err(|e| e.to_string())?,
                subscription_id: r.try_get(3).map_err(|e| e.to_string())?,
            })
        })
        .collect()
}

/// Drain `events_{domain}` from pgmq: for each event, find matching
/// subscriptions, INSERT delivery rows, and return the resulting jobs grouped
/// by the pgmq message that produced them (so the caller can delete each
/// message only after its jobs are dispatched).
async fn drain_events_into_jobs(
    state: &AppState,
    domain: &str,
) -> Result<Vec<(String, i64{% if has_events %}, i32{% endif %}, Vec<DeliveryJob>{% if has_events %}, bool{% endif %})>, String> {
    let client = state.client_source.client().await.map_err(|e| e.to_string())?;
    let queue_name = format!("events_{domain}");
    let rows = client
        .query(
            {% if has_events %}"SELECT msg_id, read_ct, message FROM pgmq.read($1, {% if evt_delivery %}{{ evt_delivery.vt_secs }}{% else %}30{% endif %}, 100)",{% else %}"SELECT msg_id, message FROM pgmq.read($1, {% if evt_delivery %}{{ evt_delivery.vt_secs }}{% else %}30{% endif %}, 100)",{% endif %}
            &[&queue_name],
        )
        .await
        .map_err(|e| e.to_string())?;

    let mut groups = Vec::new();
    for row in rows {
        let msg_id: i64 = row.try_get(0).map_err(|e| e.to_string())?;
{% if has_events %}        let read_ct: i32 = row.try_get(1).map_err(|e| e.to_string())?;
        let message: serde_json::Value = row.try_get(2).map_err(|e| e.to_string())?;
{% else %}        let message: serde_json::Value = row.try_get(1).map_err(|e| e.to_string())?;
{% endif %}
        // Issue #609: normalize the event name across both wire shapes —
        // native envelopes key it as `event` + `event_type`, CloudEvents
        // envelopes as `type`; trigger envelopes only ever carry
        // `event_type` (native) or `type` (cloudevents).
        let event_type = message
            .get("event")
            .and_then(|v| v.as_str())
            .or_else(|| message.get("type").and_then(|v| v.as_str()))
            .or_else(|| message.get("event_type").and_then(|v| v.as_str()))
            .unwrap_or("")
            .to_string();
        let event_domain = message["domain"].as_str().unwrap_or("").to_string();
        let event_entity = message["entity_table"].as_str().unwrap_or("").to_string();
        let tenant_id: Uuid = message["tenant_id"]
            .as_str()
            .and_then(|s| Uuid::parse_str(s).ok())
            .unwrap_or_default();

        let subs = client
            .query(
                "SELECT subscription_id, endpoint_id \
                 FROM platform.find_webhook_subscriptions($1, $2, $3, $4)",
                &[&tenant_id, &event_domain, &event_entity, &event_type],
            )
            .await
            .map_err(|e| e.to_string())?;

        let mut jobs = Vec::new();
        for sub in subs {
            let subscription_id: Uuid = sub.try_get(0).map_err(|e| e.to_string())?;
            let endpoint_id: Uuid = sub.try_get(1).map_err(|e| e.to_string())?;
            let delivery_id = Uuid::new_v4();
            client
                .execute(
                    "INSERT INTO platform.webhook_delivery \
                     (id, tenant_id, endpoint_id, subscription_id, event_payload, attempt, next_retry_at, created_at) \
                     VALUES ($1, $2, $3, $4, $5, 1, now() + interval '10 seconds', now())",
                    &[
                        &delivery_id,
                        &tenant_id,
                        &endpoint_id,
                        &subscription_id,
                        &message,
                    ],
                )
                .await
                .map_err(|e| e.to_string())?;
            jobs.push(DeliveryJob {
                delivery_id,
                tenant_id,
                endpoint_id,
                subscription_id,
            });
        }
        tracing::info!(
            queue = %queue_name,
            event = %event_type,
            "events.received"
        );
{% if has_events %}        // Typed consumer dispatch (issue #505): the events plane's
        // registry. Trigger envelopes carry no `event` key and dispatch
        // zero consumers.
        let outcomes = crate::events::consumers::dispatch_registered(
            &*state.client_source,
            message.clone(),{% if project.event_idempotency %}
            msg_id,{% endif %}
        )
        .await;
        let all_ok ={% if evt_delivery and evt_delivery.drop_on_failure %} {
            // At-most-once: consumers run, but a failed dispatch drops the
            // message — the delete is unconditional.
            true
        }{% else %} outcomes.iter().all(|outcome| outcome.ok);{% endif %}
        // Issue #611: a message whose consumers keep failing past the
        // attempt budget dead-letters to `{queue}_dlq` — moved is
        // terminal, the source queue drains, siblings unblock.
        let typed_ok = if !all_ok && read_ct >= MAX_RETRIES {
            match dead_letter(&*state.client_source, &queue_name, msg_id, read_ct, &message, &outcomes)
                .await
            {
                Ok(true) => true,
                _ => false,
            }
        } else {
            all_ok
        };
{% endif %}
{% if has_events %}        if all_ok {
            tracing::info!(queue = %queue_name, event = %event_type, "events.processed");
{% if project.event_archive %}            // Issue #615: archive the delivered envelope (the worker leg
            // archives at drain time — the drain IS the delivery for typed
            // consumers; webhook job failures do not unarchive).
            let _ = archive_envelope(&state.client_source, &queue_name, msg_id, &event_type, &message).await;
{% endif %}
        } else if typed_ok {
            tracing::warn!(queue = %queue_name, event = %event_type, "events.dead_lettered");
        } else {
            tracing::info!(queue = %queue_name, event = %event_type, "events.retried");
        }
{% endif %}        groups.push((queue_name.clone(), msg_id{% if has_events %}, read_ct{% endif %}, jobs{% if has_events %}, typed_ok{% endif %}));
    }

    Ok(groups)
}

{% if has_events %}/// Issue #611: move one poisoned message to `{queue}_dlq` with the
/// failure metadata attached under `_dlq`. The DLQ queue is created
/// lazily on the first dead-letter; the DLQ rides the source queue's
/// owner (the one-draining-worker placement invariant covers it).
/// Returns true when the message was moved AND deleted.
async fn dead_letter(
    source: &dyn ClientSource,
    queue: &str,
    msg_id: i64,
    read_ct: i32,
    message: &serde_json::Value,
    outcomes: &[crate::events::consumers::ConsumerOutcome],
) -> Result<bool, String> {
    let client = source.client().await.map_err(|e| e.to_string())?;
    let dlq = format!("{queue}_dlq");
    client
        .execute(
            "SELECT pgmq.create($1) WHERE NOT EXISTS (SELECT 1 \
             FROM pgmq.list_queues() WHERE queue_name = $1)",
            &[&dlq],
        )
        .await
        .map_err(|e| e.to_string())?;
    let mut envelope = message.clone();
    envelope["_dlq"] = serde_json::json!({
        "consumers": outcomes
            .iter()
            .filter(|o| !o.ok)
            .map(|o| o.consumer)
            .collect::<Vec<_>>(),
        "errors": outcomes
            .iter()
            .filter(|o| !o.ok)
            .filter_map(|o| o.error.clone())
            .collect::<Vec<_>>(),
        "attempts": read_ct,
        "failed_at": chrono::Utc::now().to_rfc3339(),
    });
    client
        .execute("SELECT pgmq.send($1, $2)", &[&dlq, &envelope])
        .await
        .map_err(|e| e.to_string())?;
    client
        .execute("SELECT pgmq.delete($1, $2)", &[&queue, &msg_id])
        .await
        .map_err(|e| e.to_string())?;
    tracing::warn!(
        queue = %queue,
        dlq = %dlq,
        msg_id = msg_id,
        attempts = read_ct,
        "message dead-lettered after exhausting the attempt budget"
    );
    Ok(true)
}
{% endif %}

{% if project.event_archive %}/// Issue #615: archive one delivered envelope (worker-leg semantics in
/// the doc comment at the call site).
async fn archive_envelope(
    source: &dyn crate::db_client::ClientSource,
    queue: &str,
    msg_id: i64,
    event_type: &str,
    message: &serde_json::Value,
) -> Result<(), String> {
    let client = source.client().await.map_err(|e| e.to_string())?;
    let occurred_at = message["occurred_at"].as_str().unwrap_or("");
    client
        .execute(
            "INSERT INTO platform.event_archive (msg_id, channel, event, envelope, occurred_at) \
             VALUES ($1, $2, $3, $4, $5) ON CONFLICT (msg_id) DO NOTHING",
            &[&msg_id, &queue, &event_type, message, &occurred_at],
        )
        .await
        .map(|_| ())
        .map_err(|e| e.to_string())
}

/// Issue #615: retention sweep (default 30 days) — once per dispatch cycle.
async fn sweep_archive(source: &dyn crate::db_client::ClientSource) -> Result<(), String> {
    let client = source.client().await.map_err(|e| e.to_string())?;
    client
        .execute(
            "DELETE FROM platform.event_archive WHERE dispatched_at < now() - interval '30 days'",
            &[],
        )
        .await
        .map(|_| ())
        .map_err(|e| e.to_string())
}
{% endif %}
/// Delete a processed pgmq message.
async fn delete_pgmq_msg(state: &AppState, queue_name: &str, msg_id: i64) -> Result<(), String> {
    let client = state.client_source.client().await.map_err(|e| e.to_string())?;
    client
        .execute("SELECT pgmq.delete($1, $2)", &[&queue_name, &msg_id])
        .await
        .map_err(|e| e.to_string())?;
    Ok(())
}

#[cfg(target_arch = "wasm32")]
async fn dispatch_one(
    env: &worker::Env,
    queue_binding: &str,
    job: &DeliveryJob,
) -> Result<(), String> {
    let queue = env.queue(queue_binding).map_err(|e| e.to_string())?;
    queue.send(job.clone()).await.map_err(|e| e.to_string())
}

#[cfg(not(target_arch = "wasm32"))]
async fn dispatch_one(_state: &AppState, job: &DeliveryJob) -> Result<(), String> {
    // Inline delivery; the failure is already recorded in the delivery row
    // (with a backoff `next_retry_at`), so it is not propagated here.
    let _ = deliver_job(_state, job).await;
    Ok(())
}

/// `Send`-safe wrapper over [`dispatch_cycle`] for axum handlers on wasm.
///
/// `env.queue(binding).send(...)` awaits a JS promise (`JsFuture`), which is
/// `!Send`; axum's `Handler` requires `Send` futures. As in the gateway's
/// service-binding forwarder, we run the non-`Send` cycle in the worker event
/// loop and ship the result back over a oneshot channel.
#[cfg(target_arch = "wasm32")]
pub async fn dispatch_cycle_send(
    state: AppState,
    domain: String,
    env: worker::Env,
    queue_binding: String,
) -> Result<usize, String> {
    let (tx, rx) = futures_channel::oneshot::channel();
    worker::wasm_bindgen_futures::spawn_local(async move {
        let _ = tx.send(dispatch_cycle(&state, &domain, &env, &queue_binding).await);
    });
    rx.await
        .map_err(|_| "worker loop task dropped".to_string())?
}

/// One full dispatch cycle: (1) re-dispatch due deliveries, (2) drain pgmq and
/// dispatch new events. Returns the number of deliveries dispatched.
#[cfg(target_arch = "wasm32")]
pub async fn dispatch_cycle(
    state: &AppState,
    domain: &str,
    env: &worker::Env,
    queue_binding: &str,
) -> Result<usize, String> {
    let mut count = 0usize;

    for job in &ready_deliveries(state).await? {
        dispatch_one(env, queue_binding, job).await?;
        count += 1;
    }

{% if project.event_archive %}        let _ = sweep_archive(&state.client_source).await;
{% endif %}    for (queue_name, msg_id{% if has_events %}, _read_ct{% endif %}, jobs{% if has_events %}, typed_ok{% endif %}) in drain_events_into_jobs(state, domain).await? {
        let mut ok = true;
        for job in &jobs {
            if dispatch_one(env, queue_binding, job).await.is_err() {
                ok = false;
            }
        }
        if ok{% if has_events %} && typed_ok{% endif %} {
            delete_pgmq_msg(state, &queue_name, msg_id).await?;
        }
        count += jobs.len();
    }

    Ok(count)
}

#[cfg(not(target_arch = "wasm32"))]
pub async fn dispatch_cycle(state: &AppState, domain: &str) -> Result<usize, String> {
    let mut count = 0usize;

    for job in &ready_deliveries(state).await? {
        dispatch_one(state, job).await?;
        count += 1;
    }

{% if project.event_archive %}        let _ = sweep_archive(&state.client_source).await;
{% endif %}    for (queue_name, msg_id{% if has_events %}, _read_ct{% endif %}, jobs{% if has_events %}, typed_ok{% endif %}) in drain_events_into_jobs(state, domain).await? {
        let mut ok = true;
        for job in &jobs {
            if dispatch_one(state, job).await.is_err() {
                ok = false;
            }
        }
        if ok{% if has_events %} && typed_ok{% endif %} {
            delete_pgmq_msg(state, &queue_name, msg_id).await?;
        }
        count += jobs.len();
    }

    Ok(count)
}

/// Native tokio dispatch loop (no Cloudflare Queue available in dev/test).
#[cfg(not(target_arch = "wasm32"))]
pub struct WebhookDispatcher {
    state: AppState,
    poll_interval: std::time::Duration,
}

#[cfg(not(target_arch = "wasm32"))]
impl WebhookDispatcher {
    pub fn new(state: AppState) -> Self {
        Self {
            state,
            poll_interval: std::time::Duration::from_secs(5),
        }
    }

    pub async fn run(&self) {
        tracing::info!("webhook dispatch worker started (native loop)");
        let mut ticker = tokio::time::interval(self.poll_interval);
        loop {
            ticker.tick().await;
            if let Err(e) = dispatch_cycle(&self.state, "{{ name }}").await {
                tracing::warn!(error = %e, "webhook dispatch cycle failed");
            }
{% for queue in extra_event_queues %}            if let Err(e) = dispatch_cycle(&self.state, "{{ queue }}").await {
                tracing::warn!(error = %e, "webhook dispatch cycle failed");
            }
{% endfor %}        }
    }
}
