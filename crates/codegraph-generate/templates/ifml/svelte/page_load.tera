import type { PageLoad } from './$types';
{% if guard_only %}
{%- if view_roles or view_requires %}
import { redirect } from '@sveltejs/kit';
import { browser } from '$app/environment';
{%- if view_roles %}
import { currentRoles } from '$lib/roles';
{%- endif %}
{%- if view_requires %}
import { can } from '$lib/roles';
{%- endif %}
{%- if guard_consts %}

{{ guard_consts }}
{%- endif %}
{%- endif %}
{% elif has_fetch %}
{%- if remote_api -%}
{%- for comp in components %}
{%- if comp.remote_query %}
import { {{ comp.remote_query }} } from './data.remote';
{%- endif %}
{%- endfor %}
{%- else %}
import { error } from '@sveltejs/kit';
import { PUBLIC_API_URL, PUBLIC_API_KEY } from '$app/env/public';
{%- endif %}
{%- endif %}
{%- if not guard_only and (view_roles or view_requires or (auth_surface and has_fetch)) %}
import { redirect } from '@sveltejs/kit';
{%- if not integrated or view_roles or view_requires %}
import { browser } from '$app/environment';
{%- endif %}
{%- if view_roles %}
import { currentRoles } from '$lib/roles';
{%- endif %}
{%- if view_requires %}
import { can } from '$lib/roles';
{%- endif %}
{%- if guard_consts %}

{{ guard_consts }}
{%- endif %}
{%- endif %}
{%- if has_fetch and not remote_api %}

// Issue #557: fetches resolve the API ORIGIN (PUBLIC_API_URL) and carry
// the Bearer key — a relative same-origin fetch dies under a split
// gateway topology and an unauthenticated request 401s at the gateway.
// Empty PUBLIC_API_URL keeps the relative form (the dev/preview proxy
// contract).
const API_BASE = PUBLIC_API_URL ?? '';
const API_KEY = PUBLIC_API_KEY ?? '';
const apiHeaders: Record<string, string> = {
	Accept: 'application/json',
	...(API_KEY ? { Authorization: `Bearer ${API_KEY}` } : {})
};
{%- endif %}
export const load: PageLoad = async ({ params, url{% if not remote_api and not guard_only %}, fetch{% endif %}{% if integrated and (view_roles or view_requires) %}, parent{% endif %} }) => {
{%- if view_roles or view_requires %}
{%- if integrated %}
	// Server-decided gating (issue #468 W-a), deferred when the roles are
	// unknowable server-side (issue #598): the (views)/+layout.server.ts
	// load resolves the session's role tokens — null when sessionless. A
	// KNOWN role set decides the guard DURING SSR (real sessions; a denied
	// persona never sees the guarded page or a doomed fetch). An
	// UNKNOWABLE one — a sessionless SSR pass: persona test contexts carry
	// no session on purpose and seed __USER_ROLES__/__USER_CAPABILITIES__
	// via CLIENT-only init scripts — must not redirect here, or every
	// persona would be denied before the client's seeded roles could ever
	// matter: rolesKnown stays false and the client re-evaluates
	// post-hydration (SvelteKit re-runs universal loads during hydration),
	// where the seeded surface is authoritative. The #572 fetch-denial
	// catch below still denies on real 401/403s during SSR.
	const parentData = (await parent()) as { roles?: string[] | null } | undefined;
	const serverRoles = parentData?.roles ?? null;
	const rolesKnown = serverRoles !== null || browser;
{%- if view_roles %}
	const roles: string[] = serverRoles ?? currentRoles();
{%- endif %}
{%- if view_requires %}
	if (rolesKnown && viewRequires.length && !viewRequires.some((c) => can(c))) {
		throw redirect(303, '{{ denial_target }}');
	}
{%- endif %}
{%- if view_roles %}
	if (rolesKnown && viewRoles.length && !roles.some((r) => viewRoles.includes(r))) {
		throw redirect(303, '{{ denial_target }}');
	}
{%- endif %}
{%- else %}
{%- if view_roles %}
	const roles = currentRoles();
{%- endif %}
{%- if view_requires %}
	if (browser && viewRequires.length && !viewRequires.some((c) => can(c))) {
		throw redirect(303, '{{ denial_target }}');
	}
{%- endif %}
{%- if view_roles %}
	if (browser && viewRoles.length && !roles.some((r) => viewRoles.includes(r))) {
		throw redirect(303, '{{ denial_target }}');
	}
{%- endif %}
{%- endif %}
{%- endif %}
	const result: Record<string, {% if has_workflow %}any{% else %}unknown{% endif %}> = {};
{%- if view_params %}
	const viewParams: Record<string, string> = {};
{%- for p in view_params %}
	viewParams['{{ p.name }}'] = url.searchParams.get('{{ p.name }}'){% if p.default %} ?? {{ p.default }}{% else %} ?? ''{% endif %};
{%- endfor %}
	result.params = viewParams;
{%- endif %}
{%- if not guard_only %}
{%- if auth_surface and has_fetch %}
	// Issue #572: a denied fetch (garbage/expired key → 401/403) denies the
	// VISIT — redirect to the denial target like the guard does, instead of
	// rendering the kit error page. Genuine server failures rethrow.
	try {
{%- endif %}
{% for comp in components %}
{%- if remote_api %}
{%- if comp.remote_query and comp.fetch_list %}
	result.{{ comp.items_key }} = await {{ comp.remote_query }}({% if comp.paginate %}{ page: url.searchParams.get('page') ?? '0', pageSize: url.searchParams.get('page_size') ?? '20' }{% endif %});
{%- elif comp.remote_query and comp.fetch_item %}
	const {{ comp.id_param }} = viewParams['{{ comp.id_param }}'];
	if ({{ comp.id_param }}) {
		result.{{ comp.item_key }} = await {{ comp.remote_query }}({{ comp.id_param }});
	}
{%- elif comp.remote_query and comp.fetch_form %}
	const {{ comp.id_param }} = viewParams['{{ comp.id_param }}'];
	if ({{ comp.id_param }}) {
		result.{{ comp.form_data_key }} = await {{ comp.remote_query }}({{ comp.id_param }});
	}
{%- endif %}
{%- else %}
{%- if comp.fetch_list %}
	const {{ comp.name }}Response = await fetch(`${API_BASE}{{ comp.api.base_path }}{% if comp.paginate %}?page=${url.searchParams.get('page') ?? '0'}&page_size=${url.searchParams.get('page_size') ?? '20'}{% endif %}`, { headers: apiHeaders });
	if (!{{ comp.name }}Response.ok) {
		error({{ comp.name }}Response.status, 'Failed to load {{ comp.entity | lower }}');
	}
	const {{ comp.name }}Data = await {{ comp.name }}Response.json();
	result.{{ comp.items_key }} = Array.isArray({{ comp.name }}Data) ? {{ comp.name }}Data : {{ comp.name }}Data.data ?? [];
{%- elif comp.fetch_item %}
	const {{ comp.id_param }} = viewParams['{{ comp.id_param }}'];
	if ({{ comp.id_param }}) {
		const {{ comp.name }}Response = await fetch(`${API_BASE}{{ comp.api.base_path }}/${ {{ comp.id_param }} }`, { headers: apiHeaders });
		if (!{{ comp.name }}Response.ok) {
			error({{ comp.name }}Response.status, 'Failed to load {{ comp.entity | lower }}');
		}
		const {{ comp.name }}Json = await {{ comp.name }}Response.json();
		const {{ comp.name }}Item = {{ comp.name }}Json.data ?? {{ comp.name }}Json;
{%- if comp.workflow %}
		const {{ comp.name }}WfResponse = await fetch(`${API_BASE}{{ comp.api.base_path }}/${ {{ comp.id_param }} }/workflow`, { headers: apiHeaders });
		if ({{ comp.name }}WfResponse.ok) {
			const {{ comp.name }}WfJson = await {{ comp.name }}WfResponse.json();
			{{ comp.name }}Item.workflow_state = {{ comp.name }}WfJson.data ?? {{ comp.name }}WfJson;
		}
{%- endif %}
		result.{{ comp.item_key }} = {{ comp.name }}Item;
	}
{%- elif comp.fetch_form %}
	const {{ comp.id_param }} = viewParams['{{ comp.id_param }}'];
	if ({{ comp.id_param }}) {
		const {{ comp.name }}Response = await fetch(`${API_BASE}{{ comp.api.base_path }}/${ {{ comp.id_param }} }`, { headers: apiHeaders });
		if (!{{ comp.name }}Response.ok) {
			error({{ comp.name }}Response.status, 'Failed to load {{ comp.entity | lower }}');
		}
		const {{ comp.name }}Json = await {{ comp.name }}Response.json();
		const {{ comp.name }}Data = {{ comp.name }}Json.data ?? {{ comp.name }}Json;
{%- if comp.workflow %}
		const {{ comp.name }}WfResponse = await fetch(`${API_BASE}{{ comp.api.base_path }}/${ {{ comp.id_param }} }/workflow`, { headers: apiHeaders });
		if ({{ comp.name }}WfResponse.ok) {
			const {{ comp.name }}WfJson = await {{ comp.name }}WfResponse.json();
			{{ comp.name }}Data.workflow_state = {{ comp.name }}WfJson.data ?? {{ comp.name }}WfJson;
		}
{%- endif %}
		result.{{ comp.form_data_key }} = {{ comp.name }}Data;
	}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if auth_surface and has_fetch %}
	} catch (e) {
		const status = (e as { status?: number })?.status;
		if (status === 401 || status === 403) {
			throw redirect(303, '{{ denial_target }}');
		}
		throw e;
	}
{%- endif %}
{%- endif %}

	return result;
};
