/// A registered consumer: the events its subscription covers plus a
/// dispatch closure carrying the app-installed handler.
type DispatchFn =
    std::sync::Arc<dyn Fn(&DatabaseConnection, &serde_json::Value) -> bool + Send + Sync>;

struct RegisteredConsumer {
    #[allow(dead_code)]
    name: &'static str,
    events: &'static [&'static str],
    dispatch: DispatchFn,
}

static REGISTRY: std::sync::OnceLock<std::sync::RwLock<Vec<RegisteredConsumer>>> =
    std::sync::OnceLock::new();

fn registry() -> &'static std::sync::RwLock<Vec<RegisteredConsumer>> {
    REGISTRY.get_or_init(|| std::sync::RwLock::new(Vec::new()))
}

/// Drain entry point: dispatch one typed envelope to every registered
/// consumer whose subscription covers the event. Returns the number of
/// consumer dispatches that FAILED (0 = every covering consumer handled
/// the event, or no consumer subscribes to it) — the drain keeps the
/// message queued whenever this is non-zero.
pub(crate) fn dispatch_registered(db: &DatabaseConnection, envelope: &serde_json::Value) -> usize {
    let Some(event) = envelope.get("event").and_then(|v| v.as_str()) else {
        return 0;
    };
    let guard = match registry().read() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    guard
        .iter()
        .filter(|consumer| consumer.events.contains(&event))
        .filter(|consumer| !(consumer.dispatch)(db, envelope))
        .count()
}
