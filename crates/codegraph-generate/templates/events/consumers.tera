/// Install the handler for the `{{ consumer.name }}` consumer. Call once
/// at startup, before the drain starts. Idempotent: a later registration
/// under the same consumer name is ignored (worker isolates may re-run
/// bootstrap per request lifetime).
pub fn register_{{ consumer.name_snake }}(
    handler: std::sync::Arc<dyn {{ consumer.handler_trait }}>,
) {
    let events: &'static [&'static str] = &[{% for event in consumer.events %}"{{ event.event_name }}"{% if not loop.last %}, {% endif %}{% endfor %}];
    let dispatch: DispatchFn = std::sync::Arc::new(move |db, envelope| {
        let handler = std::sync::Arc::clone(&handler);
        Box::pin(async move {
            let ctx = {{ consumer.context_struct }} { db: &db };
            dispatch_{{ consumer.name_snake }}(handler.as_ref(), &ctx, &envelope).await
        })
    });
    let mut guard = match registry().write() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    if guard.iter().any(|c| c.name == "{{ consumer.name }}") {
        return;
    }
    guard.push(RegisteredConsumer {
        name: "{{ consumer.name }}",
        events,
        dispatch,
    });
}
{% endfor %}
/// A registered consumer: the events its subscription covers plus a
/// dispatch closure carrying the app-installed handler. Arguments are
/// owned (both are cheap to move) so the boxed future captures no
/// borrowed lifetimes — the higher-ranked closure form does not infer.
type DispatchFn = std::sync::Arc<
    dyn Fn(
            DbClient,
            serde_json::Value,
        ) -> std::pin::Pin<Box<dyn std::future::Future<Output = bool> + Send>>
        + Send
        + Sync,
>;

struct RegisteredConsumer {
    #[allow(dead_code)]
    name: &'static str,
    events: &'static [&'static str],
    dispatch: DispatchFn,
}

static REGISTRY: std::sync::OnceLock<std::sync::RwLock<Vec<RegisteredConsumer>>> =
    std::sync::OnceLock::new();

fn registry() -> &'static std::sync::RwLock<Vec<RegisteredConsumer>> {
    REGISTRY.get_or_init(|| std::sync::RwLock::new(Vec::new()))
}

/// Drain entry point: dispatch one typed envelope to every registered
/// consumer whose subscription covers the event. Returns the number of
/// consumer dispatches that FAILED (0 = every covering consumer handled
/// the event, or no consumer subscribes to it) — the drain keeps the
/// message queued whenever this is non-zero. One client is acquired per
/// consumer dispatch from the drain's [`ClientSource`]; with no
/// registered consumers no client is acquired at all.
pub(crate) async fn dispatch_registered(
    source: &dyn ClientSource,
    envelope: serde_json::Value{% if project.event_idempotency %},
    msg_id: i64{% endif %},
) -> usize {
    let Some(event) = event_name_of(&envelope) else {
        return 0;
    };
    // Clone the matching dispatch closures and drop the guard BEFORE the
    // first await — the std RwLock guard is not Send.
{% if project.event_idempotency %}    let dispatches: Vec<(&'static str, DispatchFn)> = {
        let guard = match registry().read() {
            Ok(guard) => guard,
            Err(poisoned) => poisoned.into_inner(),
        };
        guard
            .iter()
            .filter(|consumer| consumer.events.contains(&event))
            .map(|consumer| (consumer.name, consumer.dispatch.clone()))
            .collect()
    };
    let mut failures = 0;
    for (consumer, dispatch) in &dispatches {
        let Ok(db) = source.client().await else {
            failures += 1;
            continue;
        };
        // Issue #612: insert-first dedupe (fail-open — see the sea_orm
        // twin); skip when this (message, consumer) delivery already
        // ran the handler.
        if !mark_consumed(&db, msg_id, consumer).await {
            continue;
        }
        if !dispatch(db, envelope.clone()).await {
            failures += 1;
        }
    }
    failures
}

/// Record this (message, consumer) delivery; `false` = already processed
/// (the redelivered copy must not re-run the handler).
async fn mark_consumed(db: &DbClient, msg_id: i64, consumer: &str) -> bool {
    match db
        .execute(
            "INSERT INTO platform.event_consumption (msg_id, consumer, processed_at) \
             VALUES ($1, $2, now()) ON CONFLICT DO NOTHING",
            &[&msg_id, &consumer],
        )
        .await
    {
        Ok(n) => n > 0,
        Err(e) => {
            tracing::warn!(msg_id = msg_id, consumer = consumer, error = %e, "idempotency ledger write failed; delivering anyway");
            true
        }
    }
}
{% else %}    let dispatches: Vec<DispatchFn> = {
        let guard = match registry().read() {
            Ok(guard) => guard,
            Err(poisoned) => poisoned.into_inner(),
        };
        guard
            .iter()
            .filter(|consumer| consumer.events.contains(&event))
            .map(|consumer| consumer.dispatch.clone())
            .collect()
    };
    let mut failures = 0;
    for dispatch in &dispatches {
        let Ok(db) = source.client().await else {
            failures += 1;
            continue;
        };
        if !dispatch(db, envelope.clone()).await {
            failures += 1;
        }
    }
    failures
}{% endif %}{% else %}use async_trait::async_trait;
