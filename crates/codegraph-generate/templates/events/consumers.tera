/// Dispatch one typed envelope to a `{{ consumer.handler_trait }}`.
/// `Ok(())` when the event is not subscribed or the handler succeeded;
/// `Err(reason)` when the payload is missing/unparseable or the handler
/// errors — the reason rides the DLQ metadata (#611).
pub async fn dispatch_{{ consumer.name_snake }}(
    handler: &dyn {{ consumer.handler_trait }},
    ctx: &{{ consumer.context_struct }}<'_>,
    envelope: &serde_json::Value,
) -> Result<(), String> {
    let Some(event) = event_name_of(envelope) else {
        return Ok(());
    };
    match event {
{% for event in consumer.events %}        "{{ event.event_name }}" => {
            let Some(payload) = payload_of(envelope) else {
                tracing::warn!(event = %event, consumer = "{{ consumer.name }}", "typed envelope without a payload; skipped");
                return Err("typed envelope without a payload".to_string());
            };
            let Ok(payload) = serde_json::from_value::<{{ event.payload }}>(payload.clone()) else {
                tracing::warn!(event = %event, consumer = "{{ consumer.name }}", "payload failed to deserialize; skipped");
                return Err("payload failed to deserialize".to_string());
            };
            handler.{{ event.method }}(ctx, &payload).await.map_err(|e| {
                tracing::warn!(event = %event, consumer = "{{ consumer.name }}", error = %e, "consumer handler failed");
                e.to_string()
            })
        }
{% endfor %}        other => {
            tracing::debug!(event = %other, consumer = "{{ consumer.name }}", "event not subscribed; skipped");
            Ok(())
        }
    }
}

/// Install the handler for the `{{ consumer.name }}` consumer. Call once
/// at startup, before the drain starts. Idempotent: a later registration
/// under the same consumer name is ignored (worker isolates may re-run
/// bootstrap per request lifetime).
pub fn register_{{ consumer.name_snake }}(
    handler: std::sync::Arc<dyn {{ consumer.handler_trait }}>,
) {
    let events: &'static [&'static str] = &[{% for event in consumer.events %}"{{ event.event_name }}"{% if not loop.last %}, {% endif %}{% endfor %}];
    let dispatch: DispatchFn = std::sync::Arc::new(move |db, envelope| {
        let handler = std::sync::Arc::clone(&handler);
        Box::pin(async move {
            let ctx = {{ consumer.context_struct }} { db: &db };
            dispatch_{{ consumer.name_snake }}(handler.as_ref(), &ctx, &envelope).await
        })
    });
    let mut guard = match registry().write() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    };
    if guard.iter().any(|c| c.name == "{{ consumer.name }}") {
        return;
    }
    guard.push(RegisteredConsumer {
        name: "{{ consumer.name }}",
        events,
        dispatch,
    });
}
{% endfor %}
/// A registered consumer: the events its subscription covers plus a
/// dispatch closure carrying the app-installed handler. Arguments are
/// owned (both are cheap to move) so the boxed future captures no
/// borrowed lifetimes — the higher-ranked closure form does not infer.
type DispatchFn = std::sync::Arc<
    dyn Fn(
            DbClient,
            serde_json::Value,
        ) -> std::pin::Pin<Box<dyn std::future::Future<Output = Result<(), String>> + Send>>
        + Send
        + Sync,
>;

struct RegisteredConsumer {
    name: &'static str,
    events: &'static [&'static str],
    dispatch: DispatchFn,
}

static REGISTRY: std::sync::OnceLock<std::sync::RwLock<Vec<RegisteredConsumer>>> =
    std::sync::OnceLock::new();

fn registry() -> &'static std::sync::RwLock<Vec<RegisteredConsumer>> {
    REGISTRY.get_or_init(|| std::sync::RwLock::new(Vec::new()))
}

/// Drain entry point: dispatch one typed envelope to every registered
/// consumer whose subscription covers the event, returning one
/// [`ConsumerOutcome`] per dispatch (empty when nothing subscribes — the
/// drain deletes; a failed outcome keeps the message queued unless the
/// dead-letter fate moves it, issue #611). One client is acquired per
/// consumer dispatch from the drain's [`ClientSource`]; with no
/// registered consumers no client is acquired at all.
pub(crate) async fn dispatch_registered(
    source: &dyn ClientSource,
    envelope: serde_json::Value{% if project.event_idempotency %},
    msg_id: i64{% endif %},
) -> Vec<ConsumerOutcome> {
    let Some(event) = event_name_of(&envelope) else {
        return Vec::new();
    };
    // Clone the matching dispatch closures and drop the guard BEFORE the
    // first await — the std RwLock guard is not Send.
    let dispatches: Vec<(&'static str, DispatchFn)> = {
        let guard = match registry().read() {
            Ok(guard) => guard,
            Err(poisoned) => poisoned.into_inner(),
        };
        guard
            .iter()
            .filter(|consumer| consumer.events.contains(&event))
            .map(|consumer| (consumer.name, consumer.dispatch.clone()))
            .collect()
    };
    let mut outcomes: Vec<ConsumerOutcome> = Vec::new();
    for (consumer, dispatch) in &dispatches {
        let Ok(db) = source.client().await else {
            outcomes.push(ConsumerOutcome {
                consumer,
                ok: false,
                error: Some("failed to acquire a database client".to_string()),
            });
            continue;
        };
{% if project.event_idempotency %}        // Issue #612: insert-first dedupe (fail-open — the sea_orm twin
        // carries the rationale); skip when this (message, consumer)
        // delivery already ran the handler.
        if !mark_consumed(&db, msg_id, consumer).await {
            continue;
        }
{% endif %}        match dispatch(db, envelope.clone()).await {
            Ok(()) => outcomes.push(ConsumerOutcome {
                consumer,
                ok: true,
                error: None,
            }),
            Err(error) => {
{% if project.event_idempotency %}                // Failure releases the dedupe row (the sea_orm twin
                // carries the rationale): the ledger records successes,
                // never attempts.
                let _ = release_consumption(&db, msg_id, consumer).await;
{% endif %}                outcomes.push(ConsumerOutcome {
                    consumer,
                    ok: false,
                    error: Some(error),
                })
            }
        }
    }
    outcomes
}

/// Record this (message, consumer) delivery; `false` = already processed
/// (the redelivered copy must not re-run the handler).{% if project.event_idempotency %}
async fn mark_consumed(db: &DbClient, msg_id: i64, consumer: &str) -> bool {
    match db
        .execute(
            "INSERT INTO platform.event_consumption (msg_id, consumer, processed_at) \
             VALUES ($1, $2, now()) ON CONFLICT DO NOTHING",
            &[&msg_id, &consumer],
        )
        .await
    {
        Ok(n) => n > 0,
        Err(e) => {
            tracing::warn!(msg_id = msg_id, consumer = consumer, error = %e, "idempotency ledger write failed; delivering anyway");
            true
        }
    }
}

/// Release a failed delivery's ledger row (the redelivery must re-run).
async fn release_consumption(db: &DbClient, msg_id: i64, consumer: &str) {
    let _ = db
        .execute(
            "DELETE FROM platform.event_consumption WHERE msg_id = $1 AND consumer = $2",
            &[&msg_id, &consumer],
        )
        .await;
