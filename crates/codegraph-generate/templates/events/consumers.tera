/// A registered consumer: the events its subscription covers plus a
/// dispatch closure carrying the app-installed handler. Arguments are
/// owned (both are cheap clones) so the boxed future captures no
/// borrowed lifetimes — the higher-ranked closure form does not infer.
type DispatchFn = std::sync::Arc<
    dyn Fn(
            DatabaseConnection,
            serde_json::Value,
        ) -> std::pin::Pin<Box<dyn std::future::Future<Output = Result<(), String>> + Send>>
        + Send
        + Sync,
>;

struct RegisteredConsumer {
    name: &'static str,
    events: &'static [&'static str],
    dispatch: DispatchFn,
}

static REGISTRY: std::sync::OnceLock<std::sync::RwLock<Vec<RegisteredConsumer>>> =
    std::sync::OnceLock::new();

fn registry() -> &'static std::sync::RwLock<Vec<RegisteredConsumer>> {
    REGISTRY.get_or_init(|| std::sync::RwLock::new(Vec::new()))
}

/// Drain entry point: dispatch one typed envelope to every registered
/// consumer whose subscription covers the event, returning one
/// [`ConsumerOutcome`] per dispatch (empty when nothing subscribes — the
/// drain deletes; a failed outcome keeps the message queued unless the
/// dead-letter fate moves it, issue #611).
pub(crate) async fn dispatch_registered(
    db: DatabaseConnection,
    envelope: serde_json::Value{% if project.event_idempotency %},
    msg_id: i64{% endif %},
) -> Vec<ConsumerOutcome> {
    let Some(event) = event_name_of(&envelope) else {
        return Vec::new();
    };
    // Clone the matching dispatch closures and drop the guard BEFORE the
    // first await — the std RwLock guard is not Send.
    let dispatches: Vec<(&'static str, DispatchFn)> = {
        let guard = match registry().read() {
            Ok(guard) => guard,
            Err(poisoned) => poisoned.into_inner(),
        };
        guard
            .iter()
            .filter(|consumer| consumer.events.contains(&event))
            .map(|consumer| (consumer.name, consumer.dispatch.clone()))
            .collect()
    };
    let mut outcomes: Vec<ConsumerOutcome> = Vec::new();
    for (consumer, dispatch) in &dispatches {
{% if project.event_idempotency %}        // Issue #612: insert-first dedupe — skip when this (message,
        // consumer) delivery was already processed by an earlier drain
        // pass (the redelivery path). Fail-open: a dedupe write error
        // still delivers — at-least-once is the floor, keying is
        // best-effort on top of it.
        if !mark_consumed(&db, msg_id, consumer).await {
            continue;
        }
{% endif %}        match dispatch(db.clone(), envelope.clone()).await {
            Ok(()) => outcomes.push(ConsumerOutcome {
                consumer,
                ok: true,
                error: None,
            }),
            Err(error) => {
{% if project.event_idempotency %}                // The delivery FAILED — release the dedupe row so the
                // redelivery re-runs the handler. The ledger records
                // successes, never attempts: keeping the row would let
                // the drain delete a message whose only consumer never
                // handled it.
                let _ = release_consumption(&db, msg_id, consumer).await;
{% endif %}                outcomes.push(ConsumerOutcome {
                    consumer,
                    ok: false,
                    error: Some(error),
                })
            }
        }
    }
    outcomes
}
{% if project.event_idempotency %}
/// Record this (message, consumer) delivery; `false` = already processed
/// (the redelivered copy must not re-run the handler).
async fn mark_consumed(db: &DatabaseConnection, msg_id: i64, consumer: &str) -> bool {
    let res = db
        .execute_raw(Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            "INSERT INTO platform.event_consumption (msg_id, consumer, processed_at) \
             VALUES ($1, $2, now()) ON CONFLICT DO NOTHING",
            [msg_id.into(), consumer.into()],
        ))
        .await;
    match res {
        Ok(r) => r.rows_affected() > 0,
        Err(e) => {
            tracing::warn!(msg_id = msg_id, consumer = consumer, error = %e, "idempotency ledger write failed; delivering anyway");
            true
        }
    }
}

/// Release a failed delivery's ledger row (the redelivery must re-run).
async fn release_consumption(db: &DatabaseConnection, msg_id: i64, consumer: &str) {
    let _ = db
        .execute_raw(Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            "DELETE FROM platform.event_consumption WHERE msg_id = $1 AND consumer = $2",
            [msg_id.into(), consumer.into()],
        ))
        .await;
}{% endif %}{% endif %}

/// The event name of an envelope in either wire shape (issue #609): the
/// native envelope keys it as `event`; a CloudEvents 1.0 envelope keys it
/// as `type`. Mixed producers (native and CloudEvents publishers on one
/// queue) route through the same read.
pub(crate) fn event_name_of(envelope: &serde_json::Value) -> Option<&str> {
    envelope
        .get("event")
        .and_then(|v| v.as_str())
        .or_else(|| envelope.get("type").and_then(|v| v.as_str()))
}

/// The payload of an envelope in either wire shape: native `payload`,
/// CloudEvents `data`.
pub(crate) fn payload_of(envelope: &serde_json::Value) -> Option<&serde_json::Value> {
    envelope.get("payload").or_else(|| envelope.get("data"))
}

/// One consumer's handling of one envelope (issue #611): the drain's
/// delete condition is `outcomes.iter().all(|o| o.ok)`; the dead-letter
/// metadata carries the failed consumers and their error texts, and the
/// #613 delivery counters label by consumer.
pub struct ConsumerOutcome {
    pub consumer: &'static str,
    pub ok: bool,
    pub error: Option<String>,
}
