{
  "lexicon": 1,
  "id": "{{ lexicon.nsid }}",
  "revision": {{ lexicon.revision | default(value=1) }},
  "description": "{{ lexicon.description }}",
  "defs": {
    "main": {
      "type": "record",
      "key": "{% if lexicon.key_strategy == "Tid" %}tid{% elif lexicon.key_strategy == "LiteralSelf" %}#self{% elif lexicon.key_strategy == "Any" %}*{% elif lexicon.key_strategy == "Nsid" %}nsid{% elif lexicon.key_strategy == "Composite" %}composite{% else %}{{ lexicon.key_strategy }}{% endif %}",
      "record": {
        "type": "object",
{%- if record.description %}
        "description": "{{ record.description }}",
{%- endif %}
        "required": [{% for f in record.required_fields %}"{{ f }}"{% if not loop.last %}, {% endif %}{% endfor %}],
        "properties": {
{%- for prop in record.properties %}
          "{{ prop.name }}": { {% if prop.type.type == "string" %}"type": "string"{% elif prop.type.type == "integer" %}"type": "integer"{% elif prop.type.type == "number" %}"type": "number"{% elif prop.type.type == "boolean" %}"type": "boolean"{% elif prop.type.type == "bytes" %}"type": "bytes"{% elif prop.type.type == "datetime" %}"type": "string", "format": "datetime"{% elif prop.type.type == "uri" %}"type": "string", "format": "uri"{% elif prop.type.type == "ref" %}"type": "ref", "ref": "{{ prop.type.ref_name }}"{% elif prop.type.type == "union" %}"type": "union", "refs": [{% for r in prop.type.refs %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% elif prop.type.type == "array" %}"type": "array", "items": { {% if prop.type.items.type == "string" %}"type": "string"{% elif prop.type.items.type == "integer" %}"type": "integer"{% elif prop.type.items.type == "number" %}"type": "number"{% elif prop.type.items.type == "boolean" %}"type": "boolean"{% elif prop.type.items.type == "bytes" %}"type": "bytes"{% elif prop.type.items.type == "datetime" %}"type": "string", "format": "datetime"{% elif prop.type.items.type == "uri" %}"type": "string", "format": "uri"{% elif prop.type.items.type == "ref" %}"type": "ref", "ref": "{{ prop.type.items.ref_name }}"{% elif prop.type.items.type == "union" %}"type": "union", "refs": [{% for r in prop.type.items.refs %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% elif prop.type.items.type == "array" %}"type": "array", "items": { {% if prop.type.items.items.type == "string" %}"type": "string"{% elif prop.type.items.items.type == "integer" %}"type": "integer"{% elif prop.type.items.items.type == "number" %}"type": "number"{% elif prop.type.items.items.type == "boolean" %}"type": "boolean"{% elif prop.type.items.items.type == "bytes" %}"type": "bytes"{% elif prop.type.items.items.type == "datetime" %}"type": "string", "format": "datetime"{% elif prop.type.items.items.type == "uri" %}"type": "string", "format": "uri"{% elif prop.type.items.items.type == "ref" %}"type": "ref", "ref": "{{ prop.type.items.items.ref_name }}"{% elif prop.type.items.items.type == "union" %}"type": "union", "refs": [{% for r in prop.type.items.items.refs %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% elif prop.type.items.items.type == "array" %}"type": "array", "items": { "type": "string" }{% elif prop.type.items.items.type == "object" %}"type": "object"{% elif prop.type.items.items.type == "unknown" %}"type": "unknown"{% else %}"type": "string"{% endif %} }{% elif prop.type.items.type == "object" %}"type": "object"{% elif prop.type.items.type == "unknown" %}"type": "unknown"{% else %}"type": "string"{% endif %} }{% elif prop.type.type == "object" %}"type": "object"{% elif prop.type.type == "unknown" %}"type": "unknown"{% else %}"type": "string"{% endif %} }{% if not loop.last %},{% endif %}
{%- endfor %}
{%- if has_self_labels %}
{%- if record.properties | length > 0 %},{% endif %}
          "selfLabels": {
            "type": "array",
            "items": { "type": "ref", "ref": "com.atproto.label.defs#selfLabel" },
            "maxLength": 10
          }
{%- endif %}
        }
      }
    }{% for def in defs %},
    "{{ def.name }}": {
      "type": "object",
{%- if def.description %}
      "description": "{{ def.description }}",
{%- endif %}
      "required": [{% for f in def.required_fields %}"{{ f }}"{% if not loop.last %}, {% endif %}{% endfor %}],
      "properties": {
{%- for prop in def.properties %}
        "{{ prop.name }}": { {% if prop.type.type == "string" %}"type": "string"{% elif prop.type.type == "integer" %}"type": "integer"{% elif prop.type.type == "number" %}"type": "number"{% elif prop.type.type == "boolean" %}"type": "boolean"{% elif prop.type.type == "bytes" %}"type": "bytes"{% elif prop.type.type == "datetime" %}"type": "string", "format": "datetime"{% elif prop.type.type == "uri" %}"type": "string", "format": "uri"{% elif prop.type.type == "ref" %}"type": "ref", "ref": "{{ prop.type.ref_name }}"{% elif prop.type.type == "union" %}"type": "union", "refs": [{% for r in prop.type.refs %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% elif prop.type.type == "array" %}"type": "array", "items": { {% if prop.type.items.type == "string" %}"type": "string"{% elif prop.type.items.type == "integer" %}"type": "integer"{% elif prop.type.items.type == "number" %}"type": "number"{% elif prop.type.items.type == "boolean" %}"type": "boolean"{% elif prop.type.items.type == "bytes" %}"type": "bytes"{% elif prop.type.items.type == "datetime" %}"type": "string", "format": "datetime"{% elif prop.type.items.type == "uri" %}"type": "string", "format": "uri"{% elif prop.type.items.type == "ref" %}"type": "ref", "ref": "{{ prop.type.items.ref_name }}"{% elif prop.type.items.type == "union" %}"type": "union", "refs": [{% for r in prop.type.items.refs %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% elif prop.type.items.type == "array" %}"type": "array", "items": { {% if prop.type.items.items.type == "string" %}"type": "string"{% elif prop.type.items.items.type == "integer" %}"type": "integer"{% elif prop.type.items.items.type == "number" %}"type": "number"{% elif prop.type.items.items.type == "boolean" %}"type": "boolean"{% elif prop.type.items.items.type == "bytes" %}"type": "bytes"{% elif prop.type.items.items.type == "datetime" %}"type": "string", "format": "datetime"{% elif prop.type.items.items.type == "uri" %}"type": "string", "format": "uri"{% elif prop.type.items.items.type == "ref" %}"type": "ref", "ref": "{{ prop.type.items.items.ref_name }}"{% elif prop.type.items.items.type == "union" %}"type": "union", "refs": [{% for r in prop.type.items.items.refs %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% elif prop.type.items.items.type == "array" %}"type": "array", "items": { "type": "string" }{% elif prop.type.items.items.type == "object" %}"type": "object"{% elif prop.type.items.items.type == "unknown" %}"type": "unknown"{% else %}"type": "string"{% endif %} }{% elif prop.type.items.type == "object" %}"type": "object"{% elif prop.type.items.type == "unknown" %}"type": "unknown"{% else %}"type": "string"{% endif %} }{% elif prop.type.type == "object" %}"type": "object"{% elif prop.type.type == "unknown" %}"type": "unknown"{% else %}"type": "string"{% endif %} }{% if not loop.last %},{% endif %}
{%- endfor %}
      }
    }{% endfor %}
  }
}
