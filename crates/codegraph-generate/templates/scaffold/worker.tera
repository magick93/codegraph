        // delivery jobs onto the domain's Cloudflare Queue.
        crate::webhook_dispatch::dispatch_cycle(&state, "{{ name }}", &env, "{{ queue_binding }}")
            .await
            .map_err(|e| worker::Error::RustError(e))?;
{% endif %}
        Ok(())
    }
{% endif %}
{% if has_webhooks %}

    /// Cloudflare Queues consumer for webhook delivery jobs.
    ///
    /// Each message is a [`crate::webhook_dispatch::DeliveryJob`]; the delivery
    /// is performed inline (HMAC-signed HTTP POST) and the message is acked on
    /// success or retried on a transient failure, so the queue's retry policy
    /// (plus the delivery row's `next_retry_at` scan) provides the backoff.
    #[event(queue)]
    async fn queue(
        message_batch: MessageBatch<crate::webhook_dispatch::DeliveryJob>,
        env: Env,
        _ctx: Context,
    ) -> Result<()> {
{% if observability %}
        observability::init();
{% endif %}
        let state = app_state_from_env(&env).await?;
        for message in message_batch.iter() {
            let Ok(msg) = message else {
                continue;
            };
            let job = msg.body().clone();
            match crate::webhook_dispatch::deliver_job(&state, &job).await {
                Ok(()) => msg.ack(),
                Err(e) => {
                    tracing::warn!(error = %e, delivery_id = %job.delivery_id, "webhook delivery failed; queued for retry");
                    msg.retry();
                }
            }
        }
        Ok(())
    }
{% endif %}
