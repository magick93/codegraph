{% if observability %}
// ── Workers native observability ─────────────────────────────────────────────
//
// The native dev entry (`main.rs`) uses `tracing_subscriber::fmt`; the wasm32
// slice installs a minimal hand-rolled `tracing::Subscriber` that forwards
// `tracing` events to the Worker console (surfacing in `wrangler tail` and
// Workers Logs). worker-rs 0.8 ships `console_log!`/`console_warn!`/
// `console_error!` unconditionally (no feature gate), so this is a small
// self-contained sink rather than a stale third-party `tracing-wasm` dep that
// pins an incompatible `wasm-bindgen`.

/// Minimal wasm tracing subscriber that formats each event (message + fields)
/// into a single console line.
#[cfg(target_arch = "wasm32")]
mod observability {
    use std::fmt;

    use tracing::{field::Visit, Event, Subscriber};

    /// Collects the message + key/value fields of a single event.
    #[derive(Default)]
    struct MessageVisitor {
        message: String,
        fields: Vec<String>,
    }

    impl MessageVisitor {
        fn line(self) -> String {
            if self.fields.is_empty() {
                self.message
            } else {
                format!("{} {}", self.message, self.fields.join(" "))
            }
        }
    }

    impl Visit for MessageVisitor {
        fn record_debug(&mut self, field: &tracing::field::Field, value: &dyn fmt::Debug) {
            if field.name() == "message" {
                self.message = format!("{value:?}");
            } else {
                self.fields.push(format!("{}={value:?}", field.name()));
            }
        }

        fn record_str(&mut self, field: &tracing::field::Field, value: &str) {
            if field.name() == "message" {
                self.message = value.to_string();
            } else {
                self.fields.push(format!("{}={}", field.name(), value));
            }
        }
    }

    /// The global wasm subscriber. Spans are ignored (no span tree on wasm).
    struct WasmConsoleSubscriber;

    impl Subscriber for WasmConsoleSubscriber {
        fn enabled(&self, _metadata: &tracing::Metadata<'_>) -> bool {
            true
        }

        fn new_span(&self, _span: &tracing::span::Attributes<'_>) -> tracing::Id {
            tracing::Id::from_u64(0)
        }

        fn record(&self, _span: &tracing::Id, _values: &tracing::span::Record<'_>) {}

        fn record_follows_from(&self, _span: &tracing::Id, _follows: &tracing::Id) {}

        fn event(&self, event: &Event<'_>) {
            let mut visitor = MessageVisitor::default();
            event.record(&mut visitor);
            let line = visitor.line();
            match *event.metadata().level() {
                tracing::Level::ERROR => worker::console_error!("{}", line),
                tracing::Level::WARN => worker::console_warn!("{}", line),
                _ => worker::console_log!("{}", line),
            }
        }

        fn enter(&self, _span: &tracing::Id) {}

        fn exit(&self, _span: &tracing::Id) {}
    }

    /// Install the console panic hook + tracing subscriber. Idempotent: the
    /// first call installs, later calls are ignored (safe to call per request).
    pub fn init() {
        console_error_panic_hook::set_once();
        let _ = tracing::subscriber::set_global_default(WasmConsoleSubscriber);
    }
}
{% endif %}

/// Build the {{ name }} worker's axum router: the per-domain API router
/// (entity routes) wrapped in the worker-mode auth middleware, plus minimal
/// `/version` and `/health` endpoints.
pub fn router(state: AppState) -> Router<()> {
{% if project.persistence_provider == "cornucopia" %}
    let domain_routes = crate::api::{{ name }}::router::router()
        // Inject the cornucopia client source so the generated per-route
        // API-key scope guard (crate::api::scope::require_scope_for_request)
        // can acquire a DB client without a State extractor (route-level
        // layers cannot access router state).
        .layer(axum::Extension(state.client_source.clone()))
        .layer(
            axum::middleware::from_fn_with_state(state.clone(), crate::middleware::auth_middleware),
        );
{% else %}
    let domain_routes = crate::api::{{ name }}::router::router().layer(
        axum::middleware::from_fn_with_state(state.clone(), crate::middleware::auth_middleware),
    );
{% endif %}
    // `merge` instead of `nest("/", ...)`: axum 0.8 removed root nesting
    // ("Nesting at the root is no longer supported").
    let mut app = Router::new()
        .merge(domain_routes)
        .route("/version", axum::routing::get(version))
        .route("/health", axum::routing::get(health))
        .route("/health/ready", axum::routing::get(health_ready));
    {% if has_webhooks %}
    // Webhook endpoint/subscription CRUD + the `/_dispatch` test pump. Mounted
    // behind the same auth middleware so the gateway path
    // `/api/v1/{{ name }}/webhook-endpoints` (etc.) resolves here.
    let webhook_routes = crate::webhook_router::webhook_routes().layer(
        axum::middleware::from_fn_with_state(state.clone(), crate::middleware::auth_middleware),
    );
    app = app.merge(webhook_routes);
    {% endif %}
    app.with_state(state)
}

async fn version() -> Json<serde_json::Value> {
    Json(serde_json::json!({
        "name": "{{ worker_name }}",
        "domain": "{{ name }}",
        "version": "0.1.0",
    }))
}

{% if project.persistence_provider == "cornucopia" %}
/// Probe the database through the cornucopia client source.
async fn db_ok(state: &AppState) -> bool {
    #[cfg(not(target_arch = "wasm32"))]
    {
        use sea_orm::ConnectionTrait;
        sea_orm::ConnectionTrait::execute(
            &state.db,
            sea_orm::Statement::from_string(sea_orm::DatabaseBackend::Postgres, "SELECT 1"),
        )
        .await
        .is_ok()
    }
    #[cfg(target_arch = "wasm32")]
    {
        // The worker slice opens a fresh Hyperdrive-backed client per probe —
        // this also doubles as a runtime connectivity check for the
        // cornucopia transport.
        use cornucopia_queries::client::GenericClient;
        match state.client_source.client().await {
            Ok(client) => GenericClient::query_one(&client, "SELECT 1", &[]).await.is_ok(),
            Err(e) => {
                tracing::warn!(error = %e, "{{ worker_name }} health probe failed");
                false
            }
        }
    }
}
{% else %}
async fn db_ok(state: &AppState) -> bool {
    sea_orm::ConnectionTrait::execute(
        &state.db,
        sea_orm::Statement::from_string(sea_orm::DatabaseBackend::Postgres, "SELECT 1"),
    )
    .await
    .is_ok()
}
{% endif %}

async fn health(State(state): State<AppState>) -> Json<serde_json::Value> {
    let db_ok = db_ok(&state).await;
    Json(serde_json::json!({
        "status": if db_ok { "ok" } else { "degraded" },
        "db": if db_ok { "connected" } else { "unreachable" },
        "service": "{{ worker_name }}",
    }))
}

async fn health_ready(State(state): State<AppState>) -> Json<serde_json::Value> {
    let db_ok = db_ok(&state).await;
    Json(serde_json::json!({
        "status": if db_ok { "ok" } else { "degraded" },
        "ready": db_ok,
        "service": "{{ worker_name }}",
    }))
}

