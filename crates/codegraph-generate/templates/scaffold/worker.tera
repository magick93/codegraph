    /// Cron-triggered periodic sweep for the {{ name }} domain.
    ///
    /// Runs the workflow timer sweep (when the domain declares SLA timers) and
    /// the webhook pgmq drain (when webhooks are enabled). A single scheduled
    /// handler keeps the exported `scheduled` entrypoint unambiguous.
    #[event(scheduled)]
    async fn scheduled(
        _event: ScheduledEvent,
        env: Env,
        _ctx: ScheduleContext,
    ) -> Result<(), worker::Error> {
{% if observability %}
        observability::init();
{% endif %}
