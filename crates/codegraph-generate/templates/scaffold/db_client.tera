//! Cornucopia client plumbing for the {{ worker_name }} worker ({{ name }} domain).
//! Generated by {{ project.generator_name }}. DO NOT EDIT.
//!
//! Both build modes go through one client abstraction:
//!
//! - native dev builds acquire clients from a deadpool_postgres pool;
//! - the Cloudflare Worker slice builds a `tokio_postgres::Client` per call
//!   from the Hyperdrive binding (Workers TCP socket + StartTls, per the
//!   workers-rs `tokio-postgres` example).
//!
//! The per-entity cornucopia repositories are generic over
//! `cornucopia_queries::client::GenericClient`, so `DbTx` (the transaction
//! wrapper below) plugs straight in.

use std::fmt;
use std::future::Future;

use async_trait::async_trait;
use cornucopia_queries::client::GenericClient;
use tokio_postgres::config::SslMode;
use tokio_postgres::types::{BorrowToSql, ToSql};
use tokio_postgres::{Error, Row, RowStream, Statement, ToStatement};

/// Errors raised while acquiring a cornucopia client or transaction.
#[derive(Debug, thiserror::Error)]
pub enum DbClientError {
    #[error("database configuration error: {0}")]
    Config(#[from] tokio_postgres::Error),
    #[error("invalid database connection parameters: {0}")]
    Invalid(String),
    #[error("failed to acquire pooled database client: {0}")]
    #[cfg(not(target_arch = "wasm32"))]
    Pool(#[from] deadpool_postgres::PoolError),
    #[error("hyperdrive connection failed: {0}")]
    #[cfg(target_arch = "wasm32")]
    Hyperdrive(String),
}

/// Connection parameters for the worker's database.
///
/// Resolved once per isolate from the Hyperdrive binding (Cloudflare) or the
/// `DATABASE_URL` environment variable (native dev), then used to build
/// per-request clients.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct DbConnectionParams {
    pub host: String,
    pub port: u16,
    pub user: String,
    pub password: String,
    pub dbname: String,
    pub ssl_mode: String,
}

impl Default for DbConnectionParams {
    fn default() -> Self {
        Self {
            host: "localhost".to_string(),
            port: 5432,
            user: "postgres".to_string(),
            password: String::new(),
            dbname: "postgres".to_string(),
            ssl_mode: "require".to_string(),
        }
    }
}

impl DbConnectionParams {
    /// Parse a libpq-style connection string (Hyperdrive `connection_string()`
    /// or `DATABASE_URL`) into connection parameters.
    pub fn from_connection_string(url: &str) -> Result<Self, DbClientError> {
        let cfg: tokio_postgres::Config = url.parse()?;
        let ssl_mode = match cfg.get_ssl_mode() {
            SslMode::Disable => "disable",
            SslMode::Prefer => "prefer",
            SslMode::Require => "require",
            _ => "prefer",
        };
        Ok(Self {
            host: cfg
                .get_hosts()
                .first()
                .map(|h| match h {
                    tokio_postgres::config::Host::Tcp(host) => host.clone(),
                    #[cfg(unix)]
                    tokio_postgres::config::Host::Unix(path) => path
                        .to_str()
                        .unwrap_or("localhost")
                        .to_string(),
                })
                .unwrap_or_else(|| "localhost".to_string()),
            port: cfg.get_ports().first().copied().unwrap_or(5432),
            user: cfg
                .get_user()
                .map(str::to_string)
                .ok_or_else(|| DbClientError::Invalid("connection string missing user".to_string()))?,
            password: cfg
                .get_password()
                .map(|p| String::from_utf8_lossy(p).into_owned())
                .unwrap_or_default(),
            dbname: cfg
                .get_dbname()
                .map(str::to_string)
                .ok_or_else(|| DbClientError::Invalid("connection string missing dbname".to_string()))?,
            ssl_mode: ssl_mode.to_string(),
        })
    }

    /// Build a tokio-postgres config for this parameter set.
    pub fn to_config(&self) -> Result<tokio_postgres::Config, DbClientError> {
        let ssl_mode = match self.ssl_mode.as_str() {
            "disable" => SslMode::Disable,
            "prefer" => SslMode::Prefer,
            _ => SslMode::Require,
        };
        let mut cfg = tokio_postgres::Config::new();
        cfg.host(&self.host)
            .port(self.port)
            .user(&self.user)
            .password(&self.password)
            .dbname(&self.dbname)
            .ssl_mode(ssl_mode);
        Ok(cfg)
    }
}

/// A database client for one request handler invocation.
pub enum DbClient {
    #[cfg(not(target_arch = "wasm32"))]
    Deadpool(deadpool_postgres::Object),
    #[cfg(target_arch = "wasm32")]
    Direct(tokio_postgres::Client),
}

impl fmt::Debug for DbClient {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str("DbClient(..)")
    }
}

impl DbClient {
    /// Begin a transaction on this client.
    pub async fn transaction(&mut self) -> Result<DbTx<'_>, Error> {
        match self {
            #[cfg(not(target_arch = "wasm32"))]
            Self::Deadpool(client) => Ok(DbTx::Deadpool(client.transaction().await?)),
            #[cfg(target_arch = "wasm32")]
            Self::Direct(client) => Ok(DbTx::Direct(client.transaction().await?)),
        }
    }
}

/// A transaction wrapper over either client variant.
pub enum DbTx<'a> {
    #[cfg(not(target_arch = "wasm32"))]
    Deadpool(deadpool_postgres::Transaction<'a>),
    #[cfg(target_arch = "wasm32")]
    Direct(tokio_postgres::Transaction<'a>),
}

impl fmt::Debug for DbTx<'_> {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str("DbTx(..)")
    }
}

impl DbTx<'_> {
    /// Commit the transaction.
    pub async fn commit(self) -> Result<(), Error> {
        match self {
            #[cfg(not(target_arch = "wasm32"))]
            Self::Deadpool(tx) => tx.commit().await,
            #[cfg(target_arch = "wasm32")]
            Self::Direct(tx) => tx.commit().await,
        }
    }

    /// Roll the transaction back.
    pub async fn rollback(self) -> Result<(), Error> {
        match self {
            #[cfg(not(target_arch = "wasm32"))]
            Self::Deadpool(tx) => tx.rollback().await,
            #[cfg(target_arch = "wasm32")]
            Self::Direct(tx) => tx.rollback().await,
        }
    }
}

/// Source of per-call database clients.
///
/// The monolith threads a deadpool pool through its handlers; workers
/// topology threads this trait object instead, so the wasm32 slice can
/// build a fresh client from Hyperdrive for every request.
#[async_trait]
pub trait ClientSource: Send + Sync {
    /// Acquire a client for the current request.
    async fn client(&self) -> Result<DbClient, DbClientError>;
}

/// Native (host) client source backed by a deadpool_postgres pool.
#[cfg(not(target_arch = "wasm32"))]
pub struct DeadpoolClientSource {
    pub pool: deadpool_postgres::Pool,
}

#[cfg(not(target_arch = "wasm32"))]
impl DeadpoolClientSource {
    pub fn new(pool: deadpool_postgres::Pool) -> Self {
        Self { pool }
    }
}

#[cfg(not(target_arch = "wasm32"))]
#[async_trait]
impl ClientSource for DeadpoolClientSource {
    async fn client(&self) -> Result<DbClient, DbClientError> {
        Ok(DbClient::Deadpool(self.pool.get().await?))
    }
}

/// Cloudflare Worker client source: one client per request over the
/// Hyperdrive binding's TCP socket.
#[cfg(target_arch = "wasm32")]
pub struct HyperdriveClientSource {
    params: DbConnectionParams,
}

#[cfg(target_arch = "wasm32")]
impl HyperdriveClientSource {
    pub fn new(params: DbConnectionParams) -> Self {
        Self { params }
    }
}

#[cfg(target_arch = "wasm32")]
#[async_trait]
impl ClientSource for HyperdriveClientSource {
    async fn client(&self) -> Result<DbClient, DbClientError> {
        // Per-request connection over the Workers TCP socket API
        // (https://developers.cloudflare.com/workers/runtime-apis/tcp-sockets/),
        // exactly as in the workers-rs `tokio-postgres` example: Hyperdrive
        // terminates TLS to the origin, so the worker-side socket upgrades to
        // TLS with StartTls.
        let socket = worker::Socket::builder()
            .secure_transport(worker::SecureTransport::StartTls)
            .connect(&self.params.host, self.params.port)
            .map_err(|e| DbClientError::Hyperdrive(e.to_string()))?;

        let config = self.params.to_config()?;
        let (client, connection) = config
            .connect_raw(socket, worker::postgres_tls::PassthroughTls)
            .await
            .map_err(|e| DbClientError::Hyperdrive(e.to_string()))?;

        // Drive the connection future to completion in the worker event loop.
        worker::wasm_bindgen_futures::spawn_local(async move {
            if let Err(e) = connection.await {
                tracing::warn!(error = %e, "{{ worker_name }} database connection closed");
            }
        });

        Ok(DbClient::Direct(client))
    }
}

