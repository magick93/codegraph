//! Pre-flight diagnostic checks.
//! Generated by codegraph. DO NOT EDIT.

use std::io::{self, Write};

use crate::config::ServerConfig;

#[derive(Debug)]
pub struct CheckResult {
    pub name: String,
    pub status: CheckStatus,
    pub detail: Option<String>,
}

#[derive(Debug, PartialEq)]
pub enum CheckStatus {
    Pass,
    Warn,
    Fail,
}

impl std::fmt::Display for CheckStatus {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            CheckStatus::Pass => write!(f, "PASS"),
            CheckStatus::Warn => write!(f, "WARN"),
            CheckStatus::Fail => write!(f, "FAIL"),
        }
    }
}

pub async fn run_checks() {
    let mut checks: Vec<CheckResult> = Vec::new();

    // 1. Config file parseable
    checks.push(check_config());

    // 2. Database reachable
    checks.push(check_database().await);

    // 3. Database version
    checks.push(check_db_version().await);

{% if project.database_target == "postgres" %}
    // 4. App pool mode (#169)
    checks.push(check_app_pool_mode().await);
{% endif %}

    // Print results table
    let max_name = checks.iter().map(|c| c.name.len()).max().unwrap_or(20);
    let mut failed = 0u32;
    for check in &checks {
        let status_str = match check.status {
            CheckStatus::Fail => {
                failed += 1;
                "FAIL"
            }
            CheckStatus::Warn => "WARN",
            CheckStatus::Pass => "PASS",
        };
        let detail = check.detail.as_deref().unwrap_or("-");
        println!("  {:<width$}  {:>4}  {}", check.name, status_str, detail, width = max_name);
    }
    let _ = io::stdout().flush();

    if failed > 0 {
        std::process::exit(1);
    }
}

fn check_config() -> CheckResult {
    match ServerConfig::load(None) {
        Ok(cfg) => CheckResult {
            name: "config_parseable".into(),
            status: CheckStatus::Pass,
            detail: Some(format!("bind_addr={} log_level={}", cfg.bind_addr, cfg.log_level)),
        },
        Err(e) => CheckResult {
            name: "config_parseable".into(),
            status: CheckStatus::Fail,
            detail: Some(e.to_string()),
        },
    }
}

async fn check_database() -> CheckResult {
    let db_url = match std::env::var("DATABASE_URL") {
        Ok(u) => u,
        Err(_) => {
            return CheckResult {
                name: "database_reachable".into(),
                status: CheckStatus::Fail,
                detail: Some("DATABASE_URL not set".into()),
            }
        }
    };
    match sea_orm::Database::connect(&db_url).await {
        Ok(db) => {
            let ok = sea_orm::ConnectionTrait::execute(
                &db,
                sea_orm::Statement::from_string(
                    sea_orm::DatabaseBackend::Postgres,
                    "SELECT 1",
                ),
            )
            .await
            .is_ok();
            if ok {
                CheckResult {
                    name: "database_reachable".into(),
                    status: CheckStatus::Pass,
                    detail: Some("connected".into()),
                }
            } else {
                CheckResult {
                    name: "database_reachable".into(),
                    status: CheckStatus::Fail,
                    detail: Some("connected but query failed".into()),
                }
            }
        }
        Err(e) => CheckResult {
            name: "database_reachable".into(),
            status: CheckStatus::Fail,
            detail: Some(e.to_string()),
        },
    }
}

/// App pool mode (#169): APP_DATABASE_URL pins the serving pool to the
/// NOBYPASSRLS app_user role so request context rides the statement payload.
/// Unset means legacy mode — an extra bundled `SET LOCAL ROLE` round trip per
/// transaction.
async fn check_app_pool_mode() -> CheckResult {
    match std::env::var("APP_DATABASE_URL") {
        Err(_) => CheckResult {
            name: "app_pool_mode".into(),
            status: CheckStatus::Warn,
            detail: Some(
                "APP_DATABASE_URL not set — legacy mode (per-transaction SET LOCAL ROLE)".into(),
            ),
        },
        Ok(url) => match sea_orm::Database::connect(&url).await {
            Ok(_) => CheckResult {
                name: "app_pool_mode".into(),
                status: CheckStatus::Pass,
                detail: Some("connected as app_user".into()),
            },
            Err(e) => CheckResult {
                name: "app_pool_mode".into(),
                status: CheckStatus::Fail,
                detail: Some(format!("APP_DATABASE_URL connect failed: {e}")),
            },
        },
    }
}

async fn check_db_version() -> CheckResult {
    let db_url = match std::env::var("DATABASE_URL") {
        Ok(u) => u,
        Err(_) => {
            return CheckResult {
                name: "database_version".into(),
                status: CheckStatus::Fail,
                detail: Some("DATABASE_URL not set".into()),
            }
        }
    };
    match sea_orm::Database::connect(&db_url).await {
        Ok(db) => {
            let result = sea_orm::ConnectionTrait::query_one(
                &db,
                sea_orm::Statement::from_string(
                    sea_orm::DatabaseBackend::Postgres,
                    "SELECT version()",
                ),
            )
            .await;
            match result {
                Ok(Some(row)) => {
                    let version: String = row.try_get("", "version").unwrap_or_default();
                    CheckResult {
                        name: "database_version".into(),
                        status: CheckStatus::Pass,
                        detail: Some(version.chars().take(80).collect()),
                    }
                }
                _ => CheckResult {
                    name: "database_version".into(),
                    status: CheckStatus::Fail,
                    detail: Some("query failed".into()),
                },
            }
        }
        Err(e) => CheckResult {
            name: "database_version".into(),
            status: CheckStatus::Fail,
            detail: Some(e.to_string()),
        },
    }
}
