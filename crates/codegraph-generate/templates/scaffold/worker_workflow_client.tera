//! Cornucopia workflow client for the {{ worker_name }} worker ({{ name }} domain).
//! Generated by {{ project.generator_name }}. DO NOT EDIT.
//!
//! Bridges codegraph-workflow's client-generic engine to the cornucopia
//! `DbClient` (deadpool pool in native dev, per-request Hyperdrive client in
//! the Cloudflare Worker slice). Each engine operation opens an explicit
//! transaction (`BEGIN`/`COMMIT`/`ROLLBACK`) so `set_config(..., true)` RLS
//! session variables are scoped per operation, mirroring the SeaORM engine's
//! `DatabaseTransaction`.

use std::sync::Arc;

use async_trait::async_trait;
use cornucopia_queries::client::GenericClient;
use tokio_postgres::types::ToSql;
use uuid::Uuid;

use codegraph_workflow::{WfParam, WfRow, WorkflowClient, WorkflowError, WorkflowTx};

use crate::db_client::{ClientSource, DbClient};

fn internal<E: std::error::Error + Send + Sync + 'static>(e: E) -> WorkflowError {
    WorkflowError::Internal(Box::new(e))
}

/// Bind [`WfParam`]s to owned tokio-postgres `ToSql` values.
fn bind_params(params: &[WfParam]) -> Vec<Box<dyn ToSql + Sync + Send>> {
    let mut owned: Vec<Box<dyn ToSql + Sync + Send>> = Vec::with_capacity(params.len());
    for p in params {
        match p {
            WfParam::Uuid(v) => owned.push(Box::new(*v)),
            WfParam::Str(s) => owned.push(Box::new(s.clone())),
            WfParam::Bool(b) => owned.push(Box::new(*b)),
            WfParam::I32(i) => owned.push(Box::new(*i)),
            WfParam::I64(i) => owned.push(Box::new(*i)),
            WfParam::DateTime(d) => owned.push(Box::new(*d)),
            WfParam::Null("uuid") => owned.push(Box::new(Option::<Uuid>::None)),
            WfParam::Null("text") => owned.push(Box::new(Option::<String>::None)),
            WfParam::Null("int4") => owned.push(Box::new(Option::<i32>::None)),
            WfParam::Null(_) => owned.push(Box::new(Option::<String>::None)),
        }
    }
    owned
}

/// Deref a `&[&(dyn ToSql + Sync)]` view of the owned bind values.
fn as_refs(owned: &[Box<dyn ToSql + Sync + Send>]) -> Vec<&(dyn ToSql + Sync)> {
    owned
        .iter()
        .map(|b| b.as_ref() as &(dyn ToSql + Sync))
        .collect()
}

/// [`WorkflowClient`] that builds a per-call client from the worker's
/// `ClientSource` and runs each engine operation inside an explicit
/// transaction.
#[derive(Clone)]
pub struct CornucopiaWorkflowClient {
    source: Arc<dyn ClientSource>,
}

impl CornucopiaWorkflowClient {
    pub fn new(source: Arc<dyn ClientSource>) -> Self {
        Self { source }
    }
}

#[async_trait]
impl WorkflowClient for CornucopiaWorkflowClient {
    async fn begin(&self) -> Result<Box<dyn WorkflowTx>, WorkflowError> {
        let client = self.source.client().await.map_err(internal)?;
        GenericClient::execute(&client, "BEGIN", &[]).await.map_err(internal)?;
        Ok(Box::new(DbWorkflowTx {
            client: Some(client),
            finished: false,
        }))
    }
}

/// A [`WorkflowTx`] over an owned `DbClient` (transaction control is manual).
pub struct DbWorkflowTx {
    client: Option<DbClient>,
    finished: bool,
}

impl DbWorkflowTx {
    fn inner(&self) -> Result<&DbClient, WorkflowError> {
        self.client
            .as_ref()
            .ok_or_else(|| WorkflowError::Internal("transaction already finished".into()))
    }
}

#[async_trait]
impl WorkflowTx for DbWorkflowTx {
    async fn execute(&self, sql: &str, params: &[WfParam]) -> Result<u64, WorkflowError> {
        let owned = bind_params(params);
        let refs = as_refs(&owned);
        GenericClient::execute(self.inner()?, sql, &refs).await.map_err(internal)
    }

    async fn query_one(
        &self,
        sql: &str,
        params: &[WfParam],
    ) -> Result<Option<WfRow>, WorkflowError> {
        let owned = bind_params(params);
        let refs = as_refs(&owned);
        let row = GenericClient::query_opt(self.inner()?, sql, &refs)
            .await
            .map_err(internal)?;
        Ok(row.map(WfRow::Postgres))
    }

    async fn query_all(
        &self,
        sql: &str,
        params: &[WfParam],
    ) -> Result<Vec<WfRow>, WorkflowError> {
        let owned = bind_params(params);
        let refs = as_refs(&owned);
        let rows = GenericClient::query(self.inner()?, sql, &refs)
            .await
            .map_err(internal)?;
        Ok(rows.into_iter().map(WfRow::Postgres).collect())
    }

    async fn commit(&mut self) -> Result<(), WorkflowError> {
        if self.finished {
            return Ok(());
        }
        GenericClient::execute(self.inner()?, "COMMIT", &[])
            .await
            .map_err(internal)?;
        self.finished = true;
        Ok(())
    }

    async fn rollback(&mut self) -> Result<(), WorkflowError> {
        if self.finished {
            return Ok(());
        }
        let _ = GenericClient::execute(self.inner()?, "ROLLBACK", &[]).await;
        self.finished = true;
        Ok(())
    }
}
