//! Database migration engine.
//! Generated by codegraph. DO NOT EDIT.
//!
//! Strategy: "{{ migration_strategy }}"

use std::path::Path;

/// Run all pending migrations.
pub async fn run_migrations() -> Result<(), Box<dyn std::error::Error>> {
{% if migration_strategy == "sea-orm" %}
    run_sea_orm_migrations().await
{% elif migration_strategy == "supabase" %}
    println!("This application uses Supabase for database migrations.");
    println!("To apply migrations, run:");
    println!("  npx supabase db reset");
    println!();
    println!("Or use the Supabase local development workflow:");
    println!("  npx supabase start");
    Ok(())
{% else %}
    println!("No migration strategy configured. Manage your database manually.");
    println!();
    println!("Migration files are located in the migrations/ directory.");
    println!("Apply them in numeric order using your preferred tool.");
    Ok(())
{% endif %}
}

{% if migration_strategy == "sea-orm" %}
/// FNV-1a 64-bit hex (16 lowercase hex chars) over the ORIGINAL file bytes —
/// the same checksum the boot runner and the ops harness record (issue #756).
fn fnv1a_64_hex(bytes: &[u8]) -> String {
    let mut hash: u64 = 0xcbf29ce484222325;
    for byte in bytes {
        hash ^= u64::from(*byte);
        hash = hash.wrapping_mul(0x100000001b3);
    }
    format!("{hash:016x}")
}

/// Insert adoption rows into the ONE tracking table (idempotent).
async fn record_tracked(
    db: &sea_orm::DatabaseConnection,
    entries: &[(String, String)],
) -> Result<(), Box<dyn std::error::Error>> {
    if entries.is_empty() {
        return Ok(());
    }
    let values: Vec<String> = entries
        .iter()
        .map(|(name, checksum)| {
            format!(
                "('{}', '{}')",
                name.replace('\'', "''"),
                checksum.replace('\'', "''")
            )
        })
        .collect();
    sea_orm::ConnectionTrait::execute_unprepared(
        db,
        &format!(
            "INSERT INTO platform._migrations (name, checksum) VALUES {} \
             ON CONFLICT (name) DO NOTHING",
            values.join(", ")
        ),
    )
    .await?;
    Ok(())
}

async fn run_sea_orm_migrations() -> Result<(), Box<dyn std::error::Error>> {
    let db_url = std::env::var("DATABASE_URL")
        .map_err(|_| "DATABASE_URL environment variable is required")?;
    let db = sea_orm::Database::connect(&db_url).await?;

    // ONE tracking table shared with the boot runner (`src/boot_migrate.rs`)
    // and the ops harness band (issue #756). `name` is the full migration
    // filename; `checksum` is the FNV-1a 64-bit hex digest of the ORIGINAL
    // file bytes.
    sea_orm::ConnectionTrait::execute_unprepared(
        &db,
        "CREATE SCHEMA IF NOT EXISTS platform;",
    )
    .await?;
    sea_orm::ConnectionTrait::execute_unprepared(
        &db,
        r#"
        CREATE TABLE IF NOT EXISTS platform._migrations (
            name TEXT PRIMARY KEY,
            checksum TEXT NOT NULL,
            applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
        )
        "#,
    )
    .await?;

    // Locate the migrations directory: MIGRATIONS_DIR env → repo-root
    // `../../migrations` (derived from this crate's manifest dir) →
    // CWD-relative `migrations`.
    let migrations_dir = migration_dir();
    if !migrations_dir.is_dir() {
        println!(
            "No migrations/ directory found (tried {}).",
            migrations_dir.display()
        );
        return Ok(());
    }

    let mut files: Vec<_> = std::fs::read_dir(&migrations_dir)?
        .filter_map(|e| e.ok())
        .filter(|e| e.path().extension().is_some_and(|ext| ext == "sql"))
        .collect();
    files.sort_by_key(|e| e.file_name());

    let mut tracked: std::collections::HashMap<String, String> = std::collections::HashMap::new();
    for row in sea_orm::ConnectionTrait::query_all_raw(
        &db,
        sea_orm::Statement::from_string(
            sea_orm::DatabaseBackend::Postgres,
            "SELECT name, checksum FROM platform._migrations",
        ),
    )
    .await?
    {
        tracked.insert(row.try_get("", "name")?, row.try_get("", "checksum")?);
    }

    // Adoption: when the shared tracking table has no rows yet, a legacy
    // `schema_migrations` band (the pre-#756 CLI engine; `version` is the
    // filename WITHOUT `.sql`) vouches for the files it recorded. The rows
    // are adopted with the CURRENT checksum so drift is detectable from then
    // on, and nothing is re-applied over that band.
    if tracked.is_empty() {
        let legacy_present: bool = sea_orm::ConnectionTrait::query_all_raw(
            &db,
            sea_orm::Statement::from_string(
                sea_orm::DatabaseBackend::Postgres,
                "SELECT to_regclass('schema_migrations') IS NOT NULL AS present",
            ),
        )
        .await?
        .first()
        .map(|row| row.try_get("", "present"))
        .transpose()?
        .unwrap_or(false);
        if legacy_present {
            let versions: std::collections::HashSet<String> =
                sea_orm::ConnectionTrait::query_all_raw(
                    &db,
                    sea_orm::Statement::from_string(
                        sea_orm::DatabaseBackend::Postgres,
                        "SELECT version FROM schema_migrations",
                    ),
                )
                .await?
                .into_iter()
                .filter_map(|row| row.try_get("", "version").ok())
                .collect();
            let mut adopted: Vec<(String, String)> = Vec::new();
            for entry in &files {
                let fname = entry.file_name().to_string_lossy().to_string();
                let stem = fname.trim_end_matches(".sql");
                if versions.contains(&fname) || versions.contains(stem) {
                    adopted.push((fname, fnv1a_64_hex(&std::fs::read(entry.path())?)));
                }
            }
            if !adopted.is_empty() {
                record_tracked(&db, &adopted).await?;
                println!(
                    "Adopted {} migration(s) from schema_migrations",
                    adopted.len()
                );
                tracked.extend(adopted);
            }
        }
    }

    // Drift validation BEFORE applying anything: a changed file is a hard,
    // named error, never a silent re-application.
    for entry in &files {
        let fname = entry.file_name().to_string_lossy().to_string();
        if let Some(recorded) = tracked.get(&fname) {
            let current = fnv1a_64_hex(&std::fs::read(entry.path())?);
            if *recorded != current {
                return Err(format!(
                    "Migration checksum mismatch for {fname}: recorded {recorded}, current \
                     {current} — the file changed after it was applied; refusing to re-apply it \
                     over an existing migration band"
                )
                .into());
            }
        }
    }

    let mut applied = 0u32;
    for entry in &files {
        let fname = entry.file_name().to_string_lossy().to_string();
        if tracked.contains_key(&fname) {
            continue;
        }

        let bytes = std::fs::read(entry.path())?;
        let checksum = fnv1a_64_hex(&bytes);
        let sql = String::from_utf8_lossy(&bytes).into_owned();
        let statements = split_sql_statements(&sql);

        // Apply the file's statements one by one inside a transaction; the
        // tracking row is recorded in the SAME transaction, so a crash can
        // never leave the band applied-but-unrecorded.
        let txn = sea_orm::TransactionTrait::begin(&db).await?;
        let mut failure: Option<(usize, sea_orm::DbErr)> = None;
        for (idx, stmt_sql) in statements.iter().enumerate() {
            let res = sea_orm::ConnectionTrait::execute_raw(
                &txn,
                sea_orm::Statement::from_string(
                    sea_orm::DatabaseBackend::Postgres,
                    stmt_sql.clone(),
                ),
            )
            .await;
            if let Err(e) = res {
                failure = Some((idx, e));
                break;
            }
        }
        if let Some((idx, e)) = failure {
            txn.rollback().await?;
            return Err(format!("Migration {fname} failed at statement {idx}: {e}").into());
        }
        sea_orm::ConnectionTrait::execute_raw(
            &txn,
            sea_orm::Statement::from_sql_and_values(
                sea_orm::DatabaseBackend::Postgres,
                "INSERT INTO platform._migrations (name, checksum) VALUES ($1, $2)",
                [fname.clone().into(), checksum.into()],
            ),
        )
        .await?;
        txn.commit().await?;

        println!("Applied: {fname}");
        applied += 1;
    }

    if applied == 0 {
        println!("All migrations already applied.");
    } else {
        println!("Applied {applied} migration(s).");
    }
    Ok(())
}

/// Locate the raw SQL migrations directory.
///
/// Resolution order:
/// 1. `MIGRATIONS_DIR` environment variable
/// 2. `<repo>/migrations` (derived from this crate's manifest dir — the app
///    crate lives at `<repo>/generated/cosmos-app`, so `../../migrations`
///    resolves to the repo root)
/// 3. `./migrations` relative to the current working directory
fn migration_dir() -> std::path::PathBuf {
    if let Ok(dir) = std::env::var("MIGRATIONS_DIR") {
        let p = Path::new(&dir);
        if p.exists() {
            return p.to_path_buf();
        }
    }
    let manifest_relative = Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("..")
        .join("..")
        .join("migrations");
    if manifest_relative.exists() {
        return manifest_relative;
    }
    Path::new("migrations").to_path_buf()
}

/// Split a SQL script into individual statements on `;` terminators,
/// ignoring semicolons inside single-quoted strings, double-quoted
/// identifiers, dollar-quoted strings, and comments. Returns statements
/// with surrounding whitespace trimmed; chunks that contain only
/// whitespace and/or comments are skipped.
fn split_sql_statements(sql: &str) -> Vec<String> {
    let mut statements = Vec::new();
    let mut current = String::new();
    let mut has_code = false;
    let mut chars = sql.chars().peekable();

    while let Some(c) = chars.next() {
        match c {
            '\'' | '"' => {
                // Quoted string/identifier; the quote character escapes itself ('' or "").
                has_code = true;
                current.push(c);
                while let Some(sc) = chars.next() {
                    current.push(sc);
                    if sc == c {
                        if chars.peek() == Some(&c) {
                            current.push(chars.next().unwrap());
                        } else {
                            break;
                        }
                    }
                }
            }
            '-' if chars.peek() == Some(&'-') => {
                // Line comment: consume to end of line (inclusive).
                current.push(c);
                current.push(chars.next().unwrap());
                while let Some(sc) = chars.next() {
                    current.push(sc);
                    if sc == '\n' {
                        break;
                    }
                }
            }
            '/' if chars.peek() == Some(&'*') => {
                // Block comment; PostgreSQL allows nesting.
                current.push(c);
                current.push(chars.next().unwrap());
                let mut depth = 1usize;
                while depth > 0 {
                    match chars.next() {
                        Some('*') if chars.peek() == Some(&'/') => {
                            current.push('*');
                            current.push(chars.next().unwrap());
                            depth -= 1;
                        }
                        Some('/') if chars.peek() == Some(&'*') => {
                            current.push('/');
                            current.push(chars.next().unwrap());
                            depth += 1;
                        }
                        Some(sc) => current.push(sc),
                        None => break,
                    }
                }
            }
            '$' => {
                // Dollar-quoted string: $tag$ ... $tag$, tag is [A-Za-z0-9_]* (may be empty).
                let mut tag = String::new();
                let mut opened = false;
                while let Some(&sc) = chars.peek() {
                    if sc == '$' {
                        chars.next();
                        opened = true;
                        break;
                    } else if sc.is_ascii_alphanumeric() || sc == '_' {
                        chars.next();
                        tag.push(sc);
                    } else {
                        break;
                    }
                }
                if opened {
                    has_code = true;
                    current.push('$');
                    current.push_str(&tag);
                    current.push('$');
                    // Scan for the closing $tag$.
                    while let Some(sc) = chars.next() {
                        current.push(sc);
                        if sc != '$' {
                            continue;
                        }
                        // Check for the closing $tag$.
                        let mut tail = String::new();
                        let mut closed = true;
                        for tc in tag.chars() {
                            match chars.next() {
                                Some(nc) => {
                                    tail.push(nc);
                                    if nc != tc {
                                        closed = false;
                                        break;
                                    }
                                }
                                None => {
                                    closed = false;
                                    break;
                                }
                            }
                        }
                        if closed {
                            match chars.next() {
                                Some('$') => {
                                    current.push_str(&tail);
                                    current.push('$');
                                    break;
                                }
                                other => {
                                    if let Some(nc) = other {
                                        tail.push(nc);
                                    }
                                    closed = false;
                                }
                            }
                        }
                        if !closed {
                            current.push_str(&tail);
                        }
                    }
                } else {
                    // Not a dollar quote: plain '$' plus any peeked tag characters.
                    current.push('$');
                    current.push_str(&tag);
                }
            }
            ';' => {
                let trimmed = current.trim();
                if has_code && !trimmed.is_empty() {
                    statements.push(trimmed.to_string());
                }
                current.clear();
                has_code = false;
            }
            _ => {
                if !c.is_whitespace() {
                    has_code = true;
                }
                current.push(c);
            }
        }
    }

    let trimmed = current.trim();
    if has_code && !trimmed.is_empty() {
        statements.push(trimmed.to_string());
    }
    statements
}
{% endif %}
