//! Boot-time migration runner (issue #756).
//! Generated by {{ project.generator_name }}. DO NOT EDIT.
//!
//! The CLI-less fallback used to run the always-generated SeaORM `migration`
//! crate on every boot. Its tracking table (`seaql_migrations`) is invisible
//! to the ops harness band and to the admin-CLI engine, so a boot over an
//! already-migrated database re-applied every file — and the second pass of
//! the codelist seeds died on the #700 `set_org_id_from_session` trigger
//! (no session organization at boot ⇒ the zero tenant rewrites to NULL).
//!
//! This runner uses the ONE tracking table every plane shares:
//!
//! {% if project.database_target == "sqlite" %}
//! `_migrations` (`name`, `checksum`, `applied_at`) — SQLite has no schemas.
//! {% else %}
//! `platform._migrations` (`name`, `checksum`, `applied_at`).
//! {% endif %}
//!
//! * `name` is the full migration filename (the SeaORM `MigrationName`
//!   convention, so an old `seaql_migrations` band is adoptable verbatim);
//! * `checksum` is the FNV-1a 64-bit hex digest of the ORIGINAL file bytes,
//!   computed inline (no extra dependency);
//! * a tracked file whose checksum changed is a HARD, NAMED error — a
//!   changed file is never silently re-applied over an existing band.
//!
//! Adoption (only when the tracking table is absent or empty, BEFORE
//! anything is applied): (1) `seaql_migrations` rows, (2) legacy
//! `schema_migrations` rows (the old admin-CLI band records the filename
//! without `.sql`), (3) for raw old harness bands, an object-existence
//! probe per file — the table/type/function/schema/extension the file
//! creates (or the table a seed/ALTER/INDEX/TRIGGER/POLICY/GRANT file
//! targets) already exists. Unrecognized files are NOT adopted: they apply,
//! and a genuinely incompatible raw band fails loudly. Adopted rows record
//! the CURRENT checksum, so drift is detectable from then on.

use std::collections::{HashMap, HashSet};
use std::path::{Path, PathBuf};

use sea_orm::{ConnectionTrait, DatabaseBackend, DatabaseConnection, Statement, TransactionTrait};

/// Advisory lock shared with the ops harness band
/// (`codegraph_ops::migrate::MIGRATION_LOCK_KEY`) so concurrent migration
/// runs serialise.
const ADVISORY_LOCK_KEY: i64 = 73287328;

{% if project.database_target == "sqlite" %}
const BACKEND: DatabaseBackend = DatabaseBackend::Sqlite;
const TRACKING_TABLE: &str = "_migrations";
const CREATE_TRACKING_SQL: &str = "CREATE TABLE IF NOT EXISTS _migrations (\
name TEXT PRIMARY KEY, \
checksum TEXT NOT NULL, \
applied_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\
)";
{% else %}
const BACKEND: DatabaseBackend = DatabaseBackend::Postgres;
const TRACKING_TABLE: &str = "platform._migrations";
const CREATE_TRACKING_SQL: &str = "CREATE SCHEMA IF NOT EXISTS platform;\n\
CREATE TABLE IF NOT EXISTS platform._migrations (\
name TEXT PRIMARY KEY, \
checksum TEXT NOT NULL, \
applied_at TIMESTAMPTZ NOT NULL DEFAULT now()\
)";
{% endif %}

/// Apply every untracked migration file, then record it. Idempotent: a second
/// boot over the same band applies nothing.
pub async fn run_boot_migrations(
    db: &DatabaseConnection,
) -> Result<(), Box<dyn std::error::Error>> {
    let dir = migrations_dir();
    if !dir.is_dir() {
        println!(
            "boot-migrations: no migrations/ directory found (tried {}); nothing to apply",
            dir.display()
        );
        return Ok(());
    }
    let files = collect_migrations(&dir)?;

    advisory_lock(db).await?;
    let result = apply(db, &files).await;
    if let Err(e) = advisory_unlock(db).await {
        if result.is_ok() {
            return Err(format!("boot-migrations: advisory unlock failed: {e}").into());
        }
        eprintln!("boot-migrations: advisory unlock failed: {e}");
    }
    result
}

async fn apply(
    db: &DatabaseConnection,
    files: &[(String, PathBuf)],
) -> Result<(), Box<dyn std::error::Error>> {
    let tracking_preexisted = tracking_table_exists(db).await?;
    let tracked: HashMap<String, String> = if tracking_preexisted {
        load_tracking(db).await?
    } else {
        HashMap::new()
    };

    // Adoption happens FIRST, before this runner creates any object: on a
    // database that has never run this runner, the absence of
    // `platform._migrations` is itself evidence that a legacy band applied
    // the files.
    let adopted: Vec<(String, String)> = if tracked.is_empty() {
        let mut adopted = Vec::new();
        for name in adopt_from_legacy_tables(db, files).await? {
            if let Some((_, path)) = files.iter().find(|(fname, _)| *fname == name) {
                adopted.push((name, fnv1a_64_hex(&std::fs::read(path)?)));
            }
        }
        for name in probe_existing_objects(db, files, &adopted, tracking_preexisted).await? {
            if let Some((_, path)) = files.iter().find(|(fname, _)| *fname == name) {
                adopted.push((name, fnv1a_64_hex(&std::fs::read(path)?)));
            }
        }
        adopted
    } else {
        Vec::new()
    };

    db.execute_unprepared(CREATE_TRACKING_SQL).await?;
    if !adopted.is_empty() {
        insert_tracking(db, &adopted).await?;
        println!(
            "boot-migrations: adopted {} already-applied file(s) from a legacy band",
            adopted.len()
        );
    }

    let adopted_names: HashSet<&str> = adopted.iter().map(|(name, _)| name.as_str()).collect();

    // Pass 1 — validate every tracked file BEFORE applying anything. A changed
    // file is a hard, named error; it must never be re-applied.
    for (name, path) in files {
        let Some(recorded) = tracked.get(name) else {
            continue;
        };
        let current = fnv1a_64_hex(&std::fs::read(path)?);
        if *recorded != current {
            return Err(format!(
                "boot-migrations: checksum mismatch for {name}: recorded {recorded}, current \
                 {current} — the file changed after it was applied; refusing to re-apply it over \
                 an existing migration band"
            )
            .into());
        }
    }

    // Pass 2 — apply untracked, unadopted files in filename order.
    let mut applied = 0usize;
    let mut already = 0usize;
    for (name, path) in files {
        if tracked.contains_key(name) || adopted_names.contains(name.as_str()) {
            already += 1;
            continue;
        }
        let bytes = std::fs::read(path)?;
        let checksum = fnv1a_64_hex(&bytes);
        let sql = String::from_utf8_lossy(&bytes).into_owned();

        let txn = db.begin().await?;
        if !sql.trim().is_empty() {
            if let Err(e) = txn.execute_unprepared(&sql).await {
                return Err(format!("boot-migrations: applying {name} failed: {e}").into());
            }
        }
        txn.execute_unprepared(&format!(
            "INSERT INTO {TRACKING_TABLE} (name, checksum) VALUES ('{}', '{}')",
            escape_sql(name),
            escape_sql(&checksum)
        ))
        .await?;
        txn.commit().await?;
        applied += 1;
    }

    println!("boot-migrations: {applied} applied, {already} already applied");
    Ok(())
}

/// Tier 1 + tier 2: names recorded by an older tracker. Returns the filenames
/// (from `files`) the legacy tables vouch for.
async fn adopt_from_legacy_tables(
    db: &DatabaseConnection,
    files: &[(String, PathBuf)],
) -> Result<Vec<String>, Box<dyn std::error::Error>> {
    let mut adopted = Vec::new();

    // Tier 1: the always-generated SeaORM migration crate. `version` is the
    // full filename (RawSqlMigration::name).
    if table_exists(db, "seaql_migrations").await? {
        let versions = select_versions(db, "seaql_migrations").await?;
        for (name, _) in files {
            if versions.contains(name) {
                adopted.push(name.clone());
            }
        }
    }

    // Tier 2: the old admin-CLI engine. Its `version` is the filename without
    // `.sql`; accept both spellings so a hand-repaired band still adopts.
    if table_exists(db, "schema_migrations").await? {
        let versions = select_versions(db, "schema_migrations").await?;
        for (name, _) in files {
            if adopted.contains(name) {
                continue;
            }
            let stem = name.trim_end_matches(".sql");
            if versions.contains(name) || versions.contains(stem) {
                adopted.push(name.clone());
            }
        }
    }

    Ok(adopted)
}

async fn select_versions(
    db: &DatabaseConnection,
    table: &str,
) -> Result<HashSet<String>, Box<dyn std::error::Error>> {
    let rows = db
        .query_all_raw(Statement::from_string(
            BACKEND,
            format!("SELECT version FROM {table}"),
        ))
        .await?;
    let mut out = HashSet::new();
    for row in rows {
        let version: String = row.try_get("", "version")?;
        out.insert(version);
    }
    Ok(out)
}

/// Tier 3: object-existence probe for raw bands (harness runs that recorded
/// nothing). {% if project.database_target != "sqlite" %}One catalog read
/// answers every probe, so a 130-file band costs one round trip.{% endif %}
async fn probe_existing_objects(
    db: &DatabaseConnection,
    files: &[(String, PathBuf)],
    already_adopted: &[(String, String)],
    tracking_preexisted: bool,
) -> Result<Vec<String>, Box<dyn std::error::Error>> {
{% if project.database_target == "sqlite" %}
    // SQLite has no object catalog probe in v1 (the ops harness is
    // Postgres-only): legacy trackers above are the adoption surface.
    let _ = (db, files, already_adopted, tracking_preexisted);
    Ok(Vec::new())
{% else %}
{% include "scaffold/boot_migrate/probe.tera" %}{% endif %}
}


/// FNV-1a 64-bit hex (16 lowercase hex chars) over the ORIGINAL file bytes.
/// Inline by design: generated apps take no dependency for this.
fn fnv1a_64_hex(bytes: &[u8]) -> String {
    let mut hash: u64 = 0xcbf29ce484222325;
    for byte in bytes {
        hash ^= u64::from(*byte);
        hash = hash.wrapping_mul(0x100000001b3);
    }
    format!("{hash:016x}")
}

fn escape_sql(value: &str) -> String {
    value.replace('\'', "''")
}

async fn tracking_table_exists(
    db: &DatabaseConnection,
) -> Result<bool, Box<dyn std::error::Error>> {
{% if project.database_target == "sqlite" %}
    let rows = db
        .query_all_raw(Statement::from_string(
            BACKEND,
            "SELECT COUNT(*) AS present FROM sqlite_master \
             WHERE type = 'table' AND name = '_migrations'",
        ))
        .await?;
    let present: i64 = rows
        .first()
        .map(|row| row.try_get("", "present"))
        .transpose()?
        .unwrap_or(0);
    Ok(present > 0)
{% else %}
    let rows = db
        .query_all_raw(Statement::from_string(
            BACKEND,
            "SELECT to_regclass('platform._migrations') IS NOT NULL AS present",
        ))
        .await?;
    let present: bool = rows
        .first()
        .map(|row| row.try_get("", "present"))
        .transpose()?
        .unwrap_or(false);
    Ok(present)
{% endif %}
}

async fn table_exists(
    db: &DatabaseConnection,
    table: &str,
) -> Result<bool, Box<dyn std::error::Error>> {
{% if project.database_target == "sqlite" %}
    let rows = db
        .query_all_raw(Statement::from_string(
            BACKEND,
            format!(
                "SELECT COUNT(*) AS present FROM sqlite_master \
                 WHERE type = 'table' AND name = '{}'",
                escape_sql(table)
            ),
        ))
        .await?;
    let present: i64 = rows
        .first()
        .map(|row| row.try_get("", "present"))
        .transpose()?
        .unwrap_or(0);
    Ok(present > 0)
{% else %}
    let rows = db
        .query_all_raw(Statement::from_sql_and_values(
            BACKEND,
            "SELECT to_regclass($1) IS NOT NULL AS present",
            [table.into()],
        ))
        .await?;
    let present: bool = rows
        .first()
        .map(|row| row.try_get("", "present"))
        .transpose()?
        .unwrap_or(false);
    Ok(present)
{% endif %}
}

async fn load_tracking(
    db: &DatabaseConnection,
) -> Result<HashMap<String, String>, Box<dyn std::error::Error>> {
    let rows = db
        .query_all_raw(Statement::from_string(
            BACKEND,
            format!("SELECT name, checksum FROM {TRACKING_TABLE}"),
        ))
        .await?;
    let mut out = HashMap::new();
    for row in rows {
        let name: String = row.try_get("", "name")?;
        let checksum: String = row.try_get("", "checksum")?;
        out.insert(name, checksum);
    }
    Ok(out)
}

async fn insert_tracking(
    db: &DatabaseConnection,
    entries: &[(String, String)],
) -> Result<(), Box<dyn std::error::Error>> {
    if entries.is_empty() {
        return Ok(());
    }
    let values: Vec<String> = entries
        .iter()
        .map(|(name, checksum)| {
            format!("('{}', '{}')", escape_sql(name), escape_sql(checksum))
        })
        .collect();
    db.execute_unprepared(&format!(
        "INSERT INTO {TRACKING_TABLE} (name, checksum) VALUES {} \
         ON CONFLICT (name) DO NOTHING",
        values.join(", ")
    ))
    .await?;
    Ok(())
}

async fn advisory_lock(db: &DatabaseConnection) -> Result<(), Box<dyn std::error::Error>> {
{% if project.database_target == "sqlite" %}
    let _ = db;
    Ok(())
{% else %}
    db.execute_unprepared(&format!("SELECT pg_advisory_lock({ADVISORY_LOCK_KEY})"))
        .await?;
    Ok(())
{% endif %}
}

async fn advisory_unlock(db: &DatabaseConnection) -> Result<(), Box<dyn std::error::Error>> {
{% if project.database_target == "sqlite" %}
    let _ = db;
    Ok(())
{% else %}
    db.execute_unprepared(&format!("SELECT pg_advisory_unlock({ADVISORY_LOCK_KEY})"))
        .await?;
    Ok(())
{% endif %}
}

/// Locate the raw SQL migrations directory.
///
/// Resolution order (identical to the retired SeaORM fallback, so an existing
/// deployment keeps finding its files):
/// 1. `MIGRATIONS_DIR` environment variable
/// 2. `<repo>/migrations` (derived from this crate's manifest dir — the app
///    crate lives at `<repo>/generated/<app>`, so `../../migrations` resolves
///    to the repo root)
/// 3. `./migrations` relative to the current working directory
fn migrations_dir() -> PathBuf {
    if let Ok(dir) = std::env::var("MIGRATIONS_DIR") {
        let p = Path::new(&dir);
        if p.exists() {
            return p.to_path_buf();
        }
    }
    let manifest_relative = Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("..")
        .join("..")
        .join("migrations");
    if manifest_relative.exists() {
        return manifest_relative;
    }
    Path::new("migrations").to_path_buf()
}

/// Every `.sql` file in filename order.
fn collect_migrations(
    dir: &Path,
) -> Result<Vec<(String, PathBuf)>, Box<dyn std::error::Error>> {
    let mut entries: Vec<PathBuf> = std::fs::read_dir(dir)?
        .filter_map(|entry| entry.ok())
        .map(|entry| entry.path())
        .filter(|path| path.extension().is_some_and(|ext| ext == "sql"))
        .collect();
    entries.sort_by_key(|path| path.file_name().map(|n| n.to_os_string()));
    let mut files = Vec::new();
    for path in entries {
        let name = path
            .file_name()
            .map(|n| n.to_string_lossy().into_owned())
            .unwrap_or_default();
        if name.is_empty() {
            continue;
        }
        files.push((name, path));
    }
    Ok(files)
}
