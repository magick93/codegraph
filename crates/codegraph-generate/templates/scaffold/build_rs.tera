    // The generated protos import well-known types
    // (google/protobuf/timestamp.proto, struct.proto, empty.proto). A distro
    // protoc ships those only under its own include directory, so it must be
    // on the include path or protoc reports
    // `"google.protobuf.Timestamp" is not defined` (issue #793).
    // PROTOC_INCLUDE wins, then the standard locations.
    let mut includes: Vec<std::path::PathBuf> = vec![std::path::PathBuf::from("proto")];
