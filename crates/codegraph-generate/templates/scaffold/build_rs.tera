        .build_server(true)
        .build_client(true)
        .compile(&protos, &includes)
        .expect("protobuf compilation failed");
}

/// Locate the protobuf include dir that ships the well-known types.
fn well_known_types_include() -> Option<std::path::PathBuf> {
    let mut candidates: Vec<std::path::PathBuf> = Vec::new();
    if let Ok(dir) = std::env::var("PROTOC_INCLUDE") {
        if !dir.is_empty() {
            candidates.push(std::path::PathBuf::from(dir));
        }
    }
    candidates.push(std::path::PathBuf::from("/usr/include"));
    candidates.push(std::path::PathBuf::from("/usr/local/include"));
    candidates
        .into_iter()
        .find(|dir| dir.join("google/protobuf/empty.proto").is_file())
}

fn collect_protos(dir: &std::path::Path, protos: &mut Vec<std::path::PathBuf>) {
    if let Ok(entries) = std::fs::read_dir(dir) {
        for entry in entries.flatten() {
            let path = entry.path();
