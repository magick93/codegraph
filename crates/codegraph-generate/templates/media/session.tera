//! Media session plane (issue #690): the #169 request-scope bundle and the
//! tenant-scoped parent gate the media route handlers ride.
//! GENERATED by codegraph. DO NOT EDIT.
//!
//! `set_config(..., true)` is transaction-local, so every media statement
//! must run on the ONE transaction [`begin_scoped`] returns: the child-row
//! write/delete and the parent existence check share the bundle, and a
//! dropped transaction rolls back (no context leaks between pooled
//! connections).
use sea_orm::{
    ConnectionTrait, DatabaseBackend, DatabaseConnection, DatabaseTransaction, DbErr, Statement,
    TransactionTrait,
};
use uuid::Uuid;

/// Open a transaction and install the #169 session context on it: the API
/// key + organization + user + role the RLS policies read, plus the
/// `app_user` role flip for the legacy (owner-URL) pool. BOTH planes ride a
/// SINGLE simple-query payload — one round trip (mirrors the command/query
/// plane's private helper; `correlation_id` is command-plane only).
///
/// Every `set_config(..., true)` is TRANSACTION-LOCAL: all media work for
/// this request must ride the returned transaction, and dropping it
/// (without `commit`) rolls the context and the statements back.
pub async fn begin_scoped(
    db: &DatabaseConnection,
    api_key_id: Uuid,
    organization_id: Uuid,
    user_id: Uuid,
    role: &str,
) -> Result<DatabaseTransaction, DbErr> {
    let tx = db.begin().await?;
    let sql = format!(
        "SELECT set_config('app.current_api_key', '{}', true), \
                set_config('app.current_api_key_id', '{}', true), \
                set_config('app.organization_id', '{}', true), \
                set_config('app.user_id', '{}', true), \
                set_config('app.role', '{}', true); \
         SET LOCAL ROLE app_user",
        api_key_id,
        api_key_id,
        organization_id,
        user_id,
        role.replace('\'', "''"),
    );
    tx.execute_unprepared(&sql).await?;
    Ok(tx)
}

/// Whether the owning row exists AND belongs to the session organization.
///
/// `table` and `tenant_column` are GENERATOR CONSTANTS (never request
/// data); only `id` and `organization_id` arrive at runtime, and both are
/// BOUND parameters — no SQL string interpolation. A `None` tenant column
/// is legal only for a GLOBAL parent (the DDL's own tenancy rule); the
/// statement is then deliberately unscoped — every organization may see a
/// global row.
///
/// `soft_delete` (issue #699) is also a generation-time constant per media
/// field: it is the DDL's own auditable decision, so it is true exactly when
/// the owning table carries `deleted_at`. When set, a soft-deleted row is
/// treated as absent — the media of a deleted parent must not be served, and
/// must not be destructively removed by `remove`.
pub async fn parent_exists<C: ConnectionTrait>(
    conn: &C,
    table: &str,
    tenant_column: Option<&str>,
    id: Uuid,
    organization_id: Uuid,
    soft_delete: bool,
) -> Result<bool, DbErr> {
    let live_only = if soft_delete {
        " AND deleted_at IS NULL"
    } else {
        ""
    };
    let statement = match tenant_column {
        Some(column) => Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            format!("SELECT 1 FROM {table} WHERE id = $1 AND {column} = $2{live_only} LIMIT 1"),
            [sea_orm::Value::from(id), sea_orm::Value::from(organization_id)],
        ),
        None => Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            format!("SELECT 1 FROM {table} WHERE id = $1{live_only} LIMIT 1"),
            [sea_orm::Value::from(id)],
        ),
    };
    Ok(conn.query_one_raw(statement).await?.is_some())
}{% if has_nested_media %}

/// Whether the owning row exists, belongs to the URL PARENT, AND belongs to
/// the session organization (issue #722).
///
/// A child entity's media routes are mounted nested
/// (`.nest("/{parent_id}/{child_segment}", …)`), so the route is addressed by
/// `(parent_id, id)`. The plain [`parent_exists`] gate only proves the row
/// exists, which would let any caller pass its OWN parent id with another
/// record's child id — an IDOR. This gate adds the ownership predicate:
/// `id` must be the row whose `link_column` equals `parent_id`.
///
/// `table`, `tenant_column` and `link_column` are GENERATOR CONSTANTS (never
/// request data); only `id`, `parent_id` and `organization_id` arrive at
/// runtime, and all three are BOUND parameters — no SQL string interpolation.
/// A `None` tenant column is legal only for a GLOBAL parent (the DDL's own
/// tenancy rule); the statement is then deliberately unscoped.
///
/// Depth rule: the predicate is on the IMMEDIATE parent only. A depth-2 route
/// (`/grandparent/{_grandparent_id}/parent/{parent_id}/child/{id}`) resolves
/// the row by `(id, parent_id)`, mirroring the CRUD plane's
/// `find_by_id_scoped(id, parent_id)` — the grandparent id addresses the route
/// and is not re-verified here.
pub async fn parent_exists_linked<C: ConnectionTrait>(
    conn: &C,
    table: &str,
    tenant_column: Option<&str>,
    link_column: &str,
    id: Uuid,
    parent_id: Uuid,
    organization_id: Uuid,
    soft_delete: bool,
) -> Result<bool, DbErr> {
    // Issue #699: `soft_delete` is the DDL's auditable decision for this
    // table, supplied as a generation-time constant by the route module —
    // a soft-deleted row is absent here too (no serving, no destructive
    // delete of a deleted parent's media).
    let live_only = if soft_delete {
        " AND deleted_at IS NULL"
    } else {
        ""
    };
    let statement = match tenant_column {
        Some(column) => Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            format!(
                "SELECT 1 FROM {table} WHERE id = $1 AND {link_column} = $2 AND {column} = $3{live_only} LIMIT 1"
            ),
            [
                sea_orm::Value::from(id),
                sea_orm::Value::from(parent_id),
                sea_orm::Value::from(organization_id),
            ],
        ),
        None => Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            format!(
                "SELECT 1 FROM {table} WHERE id = $1 AND {link_column} = $2{live_only} LIMIT 1"
            ),
            [
                sea_orm::Value::from(id),
                sea_orm::Value::from(parent_id),
            ],
        ),
    };
    Ok(conn.query_one_raw(statement).await?.is_some())
}{% endif %}
