            return Err(crate::media::MediaError::Provider {
                message: format!(
                    "supabase sign → {} ({})",
                    resp.status,
                    String::from_utf8_lossy(&resp.body)
                ),
            });
        }
        let signed: Vec<serde_json::Value> = serde_json::from_slice(&resp.body).map_err(|e| {
            crate::media::MediaError::Provider {
                message: format!("supabase sign response: {e}"),
            }
        })?;
        let mut out = BTreeMap::new();
        for (idx, key) in keys.iter().enumerate() {
            let entry = signed.get(idx).ok_or_else(|| crate::media::MediaError::Provider {
                message: format!("supabase sign response missing entry {idx}"),
            })?;
            if entry.get("error").map(|e| !e.is_null()).unwrap_or(false) {
                return Err(crate::media::MediaError::NotFound { key: key.clone() });
            }
            let relative = entry
                .get("signedURL")
                .and_then(|v| v.as_str())
                .ok_or_else(|| crate::media::MediaError::Provider {
                    message: format!("supabase sign response missing signedURL for {key}"),
                })?;
            out.insert(key.clone(), format!("{}{}", self.base_url, relative));
        }
        Ok(out)
