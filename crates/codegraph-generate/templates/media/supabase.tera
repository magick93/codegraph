        // Batch sign endpoint: request order is preserved in the response.
        let url = format!("{}/storage/v1/object/sign/{}", self.base_url, self.bucket);
        let body = serde_json::json!({
            "keys": keys,
            "expiresIn": self.display_ttl_secs,
        });
