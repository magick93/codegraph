            let m = reqwest::Method::from_bytes(method.as_bytes()).map_err(|e| {
                crate::media::MediaError::Provider {
                    message: format!("invalid http method {method:?}: {e}"),
                }
            })?;
            let mut req = self.client.request(m, url);
            for (k, v) in &headers {
                req = req.header(k, v);
