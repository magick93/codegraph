//! GENERATED by codegraph. DO NOT EDIT.
//! R2 adapter (issue #625 PR-C): the S3-compatible REST surface with
//! hand-rolled AWS SigV4 — no SDK, so the module compiles natively AND on
//! wasm32 with only `hmac`/`sha2`/`hex` (the compile pin legs). Endpoint is
//! R2's S3 gateway (`https://{account}.r2.cloudflarestorage.com`, override
//! with `R2_S3_ENDPOINT` for any S3-compatible store); credentials ride the
//! environment. The wrangler `[[r2_buckets]]` binding is the workers-native
//! data path; THIS adapter is the env-credentialed path shared by monolith
//! and worker deployments.
use async_trait::async_trait;
use std::collections::BTreeMap;
use std::sync::Arc;

/// SigV4 region for R2 (AWS SigV4 requires the token; R2 answers to
/// region "auto" regardless of location).
const SIGV4_REGION: &str = "auto";
const SIGV4_SERVICE: &str = "s3";

pub struct R2Storage {
    http: Arc<dyn crate::media::MediaHttp>,
    /// S3 endpoint, no trailing slash + scheme included.
    endpoint: String,
    /// Host for SigV4 (endpoint minus scheme).
    host: String,
    bucket: String,
    access_key_id: String,
    secret_access_key: String,
    public_read: bool,
    /// Public base (r2.dev / custom domain) used for display when
    /// `public_read` — private buckets mint presigned GETs instead.
    public_base: Option<String>,
    display_ttl_secs: u64,
}

impl R2Storage {
    /// Construct from the environment with generation-known bucket config.
    /// Missing env ⇒ `Err` naming the variable — the AppState media slot
    /// stays `None` and the plane answers 503 (never a hard dependency).
    pub fn from_env(
        http: Arc<dyn crate::media::MediaHttp>,
        bucket: &str,
        public_read: bool,
        display_ttl_secs: u64,
    ) -> Result<Self, String> {
        let access_key_id = std::env::var("R2_ACCESS_KEY_ID").map_err(|_| {
            "media: R2_ACCESS_KEY_ID is not set (required by provider \"r2\")".to_string()
        })?;
        let secret_access_key = std::env::var("R2_SECRET_ACCESS_KEY").map_err(|_| {
            "media: R2_SECRET_ACCESS_KEY is not set (required by provider \"r2\")".to_string()
        })?;
        if access_key_id.is_empty() || secret_access_key.is_empty() {
            return Err("media: R2 credentials are empty".to_string());
        }
        let endpoint = match std::env::var("R2_S3_ENDPOINT") {
            Ok(e) if !e.is_empty() => e.trim_end_matches('/').to_string(),
            _ => {
                let account = std::env::var("R2_ACCOUNT_ID").map_err(|_| {
                    "media: set R2_S3_ENDPOINT or R2_ACCOUNT_ID (provider \"r2\")".to_string()
                })?;
                format!("https://{account}.r2.cloudflarestorage.com")
            }
        };
        let host = endpoint
            .strip_prefix("https://")
            .or_else(|| endpoint.strip_prefix("http://"))
            .ok_or_else(|| format!("media: R2 endpoint must be absolute: {endpoint}"))?
            .to_string();
        let public_base = std::env::var("R2_PUBLIC_BASE")
            .ok()
            .filter(|v| !v.is_empty())
            .map(|v| v.trim_end_matches('/').to_string());
        Ok(Self {
            http,
            endpoint,
            host,
            bucket: bucket.to_string(),
            access_key_id,
            secret_access_key,
            public_read,
            public_base,
            display_ttl_secs,
        })
    }
}

// ── SigV4 core (pure, known-answer-tested) ─────────────────────────────

fn hmac_sha256(key: &[u8], data: &[u8]) -> Vec<u8> {
    use hmac::Mac;
    let mut mac = hmac::Hmac::<sha2::Sha256>::new_from_slice(key)
        .expect("hmac accepts any key length");
    mac.update(data);
    mac.finalize().into_bytes().to_vec()
}

pub fn sha256_hex(data: &[u8]) -> String {
    use sha2::Digest;
    hex::encode(sha2::Sha256::digest(data))
}

/// One SigV4 request description. Query params and headers must already be
/// sorted by name (the signing algorithm requires canonical order).
pub struct SigV4Request {
    pub method: &'static str,
    /// Canonical URI — absolute path, each segment URI-encoded, `/` kept.
    pub canonical_uri: String,
    /// Sorted, URI-encoded `name=value` canonical query string (no `?`).
    pub canonical_query: String,
    /// Sorted `(lowercase-name, value)` header pairs.
    pub headers: Vec<(String, String)>,
    /// Hex SHA-256 of the payload, or `UNSIGNED-PAYLOAD` for presign.
    pub payload_hash: String,
    /// `YYYYMMDD` date stamp.
    pub date_stamp: String,
    /// `YYYYMMDDTHHMMSSZ` timestamp.
    pub amz_date: String,
    /// SigV4 region (R2 answers `auto`; other S3-compatible stores may
    /// require a real region — a request parameter, not a constant).
    pub region: String,
    /// SigV4 service name (`s3` for object storage).
    pub service: String,
}

impl SigV4Request {
    pub fn canonical_request(&self) -> String {
        let mut header_lines = String::new();
        let mut signed_names = Vec::with_capacity(self.headers.len());
        for (name, value) in &self.headers {
            header_lines.push_str(&format!("{name}:{value}\n"));
            signed_names.push(name.as_str());
        }
        format!(
            "{}\n{}\n{}\n{}\n{}\n{}",
            self.method,
            self.canonical_uri,
            self.canonical_query,
            header_lines,
            signed_names.join(";"),
            self.payload_hash
        )
    }

    pub fn string_to_sign(&self, canonical_request: &str) -> String {
        format!(
            "AWS4-HMAC-SHA256\n{}\n{}/{}/{}/aws4_request\n{}",
            self.amz_date,
            self.date_stamp,
            self.region,
            self.service,
            sha256_hex(canonical_request.as_bytes())
        )
    }

    fn signing_key(&self, secret_access_key: &str) -> Vec<u8> {
        let k_date = hmac_sha256(
            format!("AWS4{secret_access_key}").as_bytes(),
            self.date_stamp.as_bytes(),
        );
        let k_region = hmac_sha256(&k_date, self.region.as_bytes());
        let k_service = hmac_sha256(&k_region, self.service.as_bytes());
        hmac_sha256(&k_service, b"aws4_request")
    }

    pub fn signature(&self, secret_access_key: &str) -> String {
        let k_signing = self.signing_key(secret_access_key);
        let sts = self.string_to_sign(&self.canonical_request());
        hex::encode(hmac_sha256(&k_signing, sts.as_bytes()))
    }

    /// The `Authorization` header for header-signed operations.
    pub fn authorization(&self, access_key_id: &str, secret_access_key: &str) -> String {
        let signed = self
            .headers
            .iter()
            .map(|(n, _)| n.as_str())
            .collect::<Vec<_>>()
            .join(";");
        format!(
            "AWS4-HMAC-SHA256 Credential={}/{}/{}/{}/aws4_request,SignedHeaders={},Signature={}",
            access_key_id,
            self.date_stamp,
            self.region,
            self.service,
            signed,
            self.signature(secret_access_key)
        )
    }
}

/// URI-encode per RFC 3986 (AWS SigV2-style strictness: unreserved set
/// passes, everything else `%XX`; `/` is NOT special here — callers split).
pub fn uri_encode(value: &str, encode_slash: bool) -> String {
    let mut out = String::with_capacity(value.len());
    for b in value.bytes() {
        match b {
            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'.' | b'_' | b'~' => {
                out.push(b as char);
            }
            b'/' if !encode_slash => out.push('/'),
            _ => out.push_str(&format!("%{b:02X}")),
        }
    }
    out
}

/// `YYYYMMDDTHHMMSSZ` + `YYYYMMDD` from the system clock — hand-rolled so
/// the media plane needs no chrono on the wasm pin leg.
pub fn amz_dates(now_unix_secs: u64) -> (String, String) {
    let days = now_unix_secs / 86_400;
    let secs_of_day = now_unix_secs % 86_400;
    // Howard Hinnant's civil-from-days.
    let z = days as i64 + 719_468;
    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
    let doe = (z - era * 146_097) as u64;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146_096) / 365;
    let y = yoe as i64 + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = if m <= 2 { y + 1 } else { y };
    let (hh, mm, ss) = (
        secs_of_day / 3600,
        (secs_of_day % 3600) / 60,
        secs_of_day % 60,
    );
    (
        format!("{y:04}{m:02}{d:02}T{hh:02}{mm:02}{ss:02}Z"),
        format!("{y:04}{m:02}{d:02}"),
    )
}

fn now_unix_secs() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.as_secs())
        .unwrap_or(0)
}

impl R2Storage {
    async fn s3_request(
        &self,
        method: &'static str,
        key: &str,
        payload_hash: &str,
        body: Vec<u8>,
        content_type: Option<&str>,
    ) -> Result<crate::media::MediaHttpResponse, crate::media::MediaError> {
        let (amz_date, date_stamp) = amz_dates(now_unix_secs());
        let mut headers: Vec<(String, String)> = vec![
            ("host".to_string(), self.host.clone()),
            ("x-amz-content-sha256".to_string(), payload_hash.to_string()),
            ("x-amz-date".to_string(), amz_date.clone()),
        ];
        if let Some(ct) = content_type {
            headers.push(("content-type".to_string(), ct.to_string()));
        }
        headers.sort();
        let req = SigV4Request {
            method,
            canonical_uri: format!("/{}/{}", self.bucket, uri_encode(key, true)),
            canonical_query: String::new(),
            headers,
            payload_hash: payload_hash.to_string(),
            date_stamp,
            amz_date,
            region: SIGV4_REGION.to_string(),
            service: SIGV4_SERVICE.to_string(),
        };
        let mut send_headers = BTreeMap::new();
        for (n, v) in &req.headers {
            send_headers.insert(n.clone(), v.clone());
        }
        send_headers.insert(
            "authorization".to_string(),
            req.authorization(&self.access_key_id, &self.secret_access_key),
        );
        let url = format!("{}{}", self.endpoint, req.canonical_uri);
        self.http.request(method, &url, send_headers, body).await
    }

    fn presign(&self, key: &str, expires_in_secs: u64, method: &'static str) -> String {
        let (amz_date, date_stamp) = amz_dates(now_unix_secs());
        let scope = format!(
            "{}/{}/{}/aws4_request",
            date_stamp, SIGV4_REGION, SIGV4_SERVICE
        );
        let mut query: Vec<(String, String)> = vec![
            (
                "X-Amz-Algorithm".to_string(),
                "AWS4-HMAC-SHA256".to_string(),
            ),
            (
                "X-Amz-Credential".to_string(),
                format!("{}/{}", self.access_key_id, scope),
            ),
            ("X-Amz-Date".to_string(), amz_date.clone()),
            (
                "X-Amz-Expires".to_string(),
                expires_in_secs.to_string(),
            ),
            ("X-Amz-SignedHeaders".to_string(), "host".to_string()),
        ];
        query.sort();
        let canonical_query = query
            .iter()
            .map(|(n, v)| format!("{}={}", uri_encode(n, true), uri_encode(v, true)))
            .collect::<Vec<_>>()
            .join("&");
        let req = SigV4Request {
            method,
            canonical_uri: format!("/{}/{}", self.bucket, uri_encode(key, true)),
            canonical_query,
            headers: vec![("host".to_string(), self.host.clone())],
            payload_hash: "UNSIGNED-PAYLOAD".to_string(),
            date_stamp,
            amz_date,
            region: SIGV4_REGION.to_string(),
            service: SIGV4_SERVICE.to_string(),
        };
        let signature = req.signature(&self.secret_access_key);
        format!(
            "{}{}?{}&X-Amz-Signature={}",
            self.endpoint, req.canonical_uri, req.canonical_query, signature
        )
    }

    fn public_url(&self, key: &str) -> Option<String> {
        self.public_base
            .as_ref()
            .map(|base| format!("{}/{}/{}", base, self.bucket, crate::media::encode_key(key)))
    }
}

#[async_trait]
impl crate::media::MediaStorage for R2Storage {
    async fn put(
        &self,
        key: &str,
        data: Vec<u8>,
        mime_type: &str,
    ) -> Result<crate::media::StoredRef, crate::media::MediaError> {
        let payload_hash = sha256_hex(&data);
        let resp = self
            .s3_request("PUT", key, &payload_hash, data, Some(mime_type))
            .await?;
        if !(200..300).contains(&resp.status) {
            return Err(crate::media::MediaError::Provider {
                message: format!(
                    "r2 put {} → {} ({})",
                    key,
                    resp.status,
                    String::from_utf8_lossy(&resp.body)
                ),
            });
        }
        Ok(crate::media::StoredRef {
            key: key.to_string(),
            url: if self.public_read {
                self.public_url(key)
            } else {
                None
            },
            mime_type: mime_type.to_string(),
        })
    }

    async fn delete(&self, key: &str) -> Result<(), crate::media::MediaError> {
        // S3 DELETE answers 204 for missing keys too — cleanup is best-effort
        // without existence probes.
        let empty_hash = sha256_hex(&[]);
        let resp = self.s3_request("DELETE", key, &empty_hash, Vec::new(), None).await?;
        if !(200..300).contains(&resp.status) {
            return Err(crate::media::MediaError::Provider {
                message: format!(
                    "r2 delete {} → {} ({})",
                    key,
                    resp.status,
                    String::from_utf8_lossy(&resp.body)
                ),
            });
        }
        Ok(())
    }

    async fn display_urls(
        &self,
        keys: &[String],
    ) -> Result<BTreeMap<String, String>, crate::media::MediaError> {
        if keys.is_empty() {
            return Ok(BTreeMap::new());
        }
        if self.public_read {
            return Ok(keys
                .iter()
                .filter_map(|k| self.public_url(k).map(|u| (k.clone(), u)))
                .collect());
        }
        // R2 has no batch sign endpoint — presign per key (the S3 shape).
        Ok(keys
            .iter()
            .map(|k| {
                (
                    k.clone(),
                    self.presign(k, self.display_ttl_secs, "GET"),
                )
            })
            .collect())
    }

    async fn presign_put(
        &self,
        key: &str,
        _mime_type: &str,
        expires_in_secs: u64,
    ) -> Result<crate::media::PresignedPut, crate::media::MediaError> {
        Ok(crate::media::PresignedPut {
            url: self.presign(key, expires_in_secs, "PUT"),
            headers: BTreeMap::new(),
            expires_in_secs,
        })
    }
}
