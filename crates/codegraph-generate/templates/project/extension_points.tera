# Extension points for {{ project_name }} — generated by `codegraph init`.
#
# Define integration points here; pass this file to the wrapper with
# `--extension-points`. A file containing only comments is a valid
# ExtensionPointsConfig.
#
# Example:
#
# [payroll-sync]
# name = "Payroll Sync"
# description = "Synchronise employee and pay data"
# cardinality = "exclusive"
# entities = ["common.item"]
# directions = ["push"]
#
# [payroll-sync.config]
# api_base_url = { type = "text", required = true, label = "Payroll API base URL" }
