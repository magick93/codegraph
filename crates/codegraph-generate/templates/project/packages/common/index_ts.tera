/** One selectable value of a code list (the generated `codelist/*.ts` data). */
export interface CodelistOption {
  value: string;
  label: string;
}

/** A code list as the generated UI emits it (`src/lib/codelist/*.ts`). */
export interface CodelistData {
  title: string;
  description?: string;
  options: CodelistOption[];
}
