name: CI

on: [push, pull_request]

jobs:
  generate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Generate code
        run: cargo run -p {{ graph_binary }} -- run{% if features.rosetta %}{% for d in domains %} --rosetta-files model/{{ d.name }}.rosetta{% endfor %}{% else %}{% for d in domains %} --mox-files model/{{ d.name }}.mox{% endfor %}{% endif %} --config domains.toml --output generated
      - name: Check generated workspace compiles
        run: cargo check --manifest-path generated/Cargo.toml

  ops-api:
    runs-on: ubuntu-latest
    services:
      postgres:
{% if features.rosetta %}        # pgmq-bundled postgres: the generated domain-event triggers
        # insert into pgmq queues; plain postgres has no pgmq extension and
        # every event insert 500s. Tag = latest stable pgmq release image
        # (quay.io/tembo/pgmq-pg, manifest list for pg15/pg16 x amd64/arm64).
        image: quay.io/tembo/pgmq-pg:v1.2.1
{% else %}        image: postgres:15
{% endif %}        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_USER: postgres
          POSTGRES_DB: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Install psql
        run: sudo apt-get update && sudo apt-get install -y postgresql-client
{% if features.rosetta %}        # App_user serving pool (migration 0002 seeds the same password):
        # the harness pins app_user to app_user_pass and passes this through
        # to the generated server, exercising the NOBYPASSRLS pool mode.
        env:
          APP_DATABASE_URL: postgres://app_user:app_user_pass@localhost:5432/postgres
{% endif %}      - name: Run ops API suite
        run: cargo run -p testkit -- --config codegraph-ops.toml api
