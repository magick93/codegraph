# pnpm workspace — generated by `codegraph init` (issue #18).
#
# The generated SvelteKit app (`generated/ui`) imports its auth/dashboard/
# settings and entity-shell components from the `@{{ ui_package_scope }}/*`
# packages vendored under `packages/`. They are YOURS: `codegraph init`
# never overwrites them without `--force`, so restyle or replace freely.
# Install once from the repo root: `pnpm install`.
packages:
  - "packages/*"
  - "generated/ui"
