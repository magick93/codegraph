# {{ project_name }} — generated by `codegraph init`.

default: generate

# Regenerate code from schemas.
generate:
    cargo run -p {{ graph_binary }} -- run

# Show entity/VO classification decisions.
classify:
    cargo run -p {{ graph_binary }} -- classify

# Validate project layout and configuration.
doctor:
    cargo run -p {{ graph_binary }} -- doctor --config domains.toml

# API integration tests (preflight, migrate, hurl, curl smoke, RLS).
api *flags="":
    cargo run -p testkit -- --config codegraph-ops.toml api {% raw %}{{flags}}{% endraw %}

# End-to-end: Supabase -> generate -> migrate -> build -> Playwright.
e2e *flags="":
    cargo run -p testkit -- --config codegraph-ops.toml e2e {% raw %}{{flags}}{% endraw %}

# api then e2e.
full *flags="":
    cargo run -p testkit -- --config codegraph-ops.toml full {% raw %}{{flags}}{% endraw %}

# Stop services and remove generated output.
clean:
    cargo run -p testkit -- --config codegraph-ops.toml clean
