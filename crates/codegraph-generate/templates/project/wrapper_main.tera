//! {{ project_name }} codegen wrapper: a thin clap CLI over the `codegraph`
//! driver library. Generated by `codegraph init` as `{{ graph_binary }}`.

use std::path::PathBuf;

use clap::{Parser, Subcommand};

use codegraph::error::Result;

#[derive(Parser)]
#[command(name = "{{ graph_binary }}", about = "Codegen driver for {{ project_name }}")]
struct Cli {
    #[command(subcommand)]
    command: Commands,
}

#[derive(Subcommand)]
enum Commands {
    /// Ingest the .mox model, classify, then run all generators.
    Run {
        /// JSON Schema directory. Optional when --mox-files or
        /// --rosetta-files is provided; JSON schemas are a secondary source
        /// (use `codegraph migrate` to convert them to .mox).
        #[arg(
            long,
            required_unless_present_any = ["mox_files", "rosetta_files"]
        )]
        schemas: Option<PathBuf>,
        /// Classifier config path (only needed when --schemas is provided).
        #[arg(long)]
        classifier: Option<PathBuf>,
        /// Domain config path.
        #[arg(long, default_value = "domains.toml")]
        config: PathBuf,
        /// Output directory for generated code.
        #[arg(long, default_value = "generated")]
        output: PathBuf,
        /// Extension points config path.
        #[arg(long)]
        extension_points: Option<PathBuf>,
        /// Integration catalog manifest TOML files (issue #552); seeds
        /// platform_integrations.catalog. Requires --extension-points.
        #[arg(long)]
        integration_manifests: Vec<PathBuf>,
        /// Profile name.
        #[arg(long, default_value = "default")]
        profile: String,
        /// Profile variant.
        #[arg(long)]
        variant: Option<String>,
        /// profiles.toml path (defaults to ./profiles.toml).
        #[arg(long)]
        profiles_config: Option<PathBuf>,
        /// Skip post-generation scripts.
        #[arg(long)]
        no_post_gen: bool,
        /// Additional template override directories (later dirs take precedence).
        #[arg(long = "template-dir")]
        template_dir: Vec<PathBuf>,
        /// IFML DSL files to ingest.
        #[arg(long = "ifml-files")]
        ifml_files: Vec<PathBuf>,
        /// OpenAPI spec files to ingest.
        #[arg(long = "openapi-files")]
        openapi_files: Vec<PathBuf>,
        /// rexlang .mox domain model files (primary model source).
        #[arg(long = "mox-files")]
        mox_files: Vec<PathBuf>,
        /// Rosetta (Rune DSL) .rosetta model files (primary model source).
        #[arg(long = "rosetta-files")]
        rosetta_files: Vec<PathBuf>,
        /// rexlang .ddd design files; compiled against their imported
        /// .mox domains and ingested as the DDD design plane.
        #[arg(long)]
        ddd_files: Vec<PathBuf>,
        /// rexlang .evt event-contract files; compiled against their
        /// imported .mox domains and ingested as the events plane.
        #[arg(long)]
        evt_files: Vec<PathBuf>,
        /// rexlang .deploy deployment files; compiled against their
        /// imported .ddd designs and .ifml flows and ingested as the
        /// deployment plane.
        #[arg(long)]
        deploy_files: Vec<PathBuf>,
        /// IFML framework targets for code generation (e.g. svelte, react).
        #[arg(long)]
        ifml_framework: Vec<String>,
        /// Path to ifml-components.toml mapping IFML components to
        /// handcrafted components.
        #[arg(long)]
        ifml_components: Option<PathBuf>,
        /// Built-in IFML design-system pack to apply (e.g. "shadcn-svelte").
        /// Overrides the profiles.toml `ifml_design_system` feature.
        #[arg(long)]
        ifml_design_system: Option<String>,
        /// Path to a ux-rules.toml; rules shadow the built-in ux-default pack.
        #[arg(long)]
        ux_rules: Option<PathBuf>,
        /// Compile-check the generated output with `cargo check` after
        /// generation; a failing check fails the run.
        #[arg(long)]
        check: bool,
    },
    /// Show entity/VO classification decisions for the .mox model.
    Classify {
        /// JSON Schema directory. Optional when --mox-files is provided.
        #[arg(long)]
        schemas: Option<PathBuf>,
        /// Classifier config path (only needed when --schemas is provided).
        #[arg(long)]
        classifier: Option<PathBuf>,
        /// Domain config path.
        #[arg(long, default_value = "domains.toml")]
        config: PathBuf,
        /// Only show results for this domain.
        #[arg(long)]
        domain: Option<String>,
        /// rexlang .mox domain model files (primary model source).
        #[arg(long = "mox-files")]
        mox_files: Vec<PathBuf>,
        /// Rosetta (Rune DSL) .rosetta model files (primary model source).
        #[arg(long = "rosetta-files")]
        rosetta_files: Vec<PathBuf>,
    },
    /// Generate code without ingesting schemas.
    Generate {
        /// Domain config path.
        #[arg(long, default_value = "domains.toml")]
        config: PathBuf,
        /// Output directory for generated code.
        #[arg(long, default_value = "generated")]
        output: PathBuf,
        /// Extension points config path.
        #[arg(long)]
        extension_points: Option<PathBuf>,
        /// Integration catalog manifest TOML files (issue #552); seeds
        /// platform_integrations.catalog. Requires --extension-points.
        #[arg(long)]
        integration_manifests: Vec<PathBuf>,
        /// Path to a ux-rules.toml; rules shadow the built-in ux-default pack.
        #[arg(long)]
        ux_rules: Option<PathBuf>,
        /// Compile-check the generated output with `cargo check` after
        /// generation; a failing check fails the run.
        #[arg(long)]
        check: bool,
    },
    /// Validate project layout and configuration.
    Doctor {
        /// Domain config path.
        #[arg(long, default_value = "domains.toml")]
        config: PathBuf,
        /// JSON Schema directory. Optional when --mox-files is provided
        /// (mox-first projects carry no schemas directory).
        #[arg(long)]
        schemas: Option<PathBuf>,
        /// Classifier config path (only needed when JSON schemas are present).
        #[arg(long)]
        classifier: Option<PathBuf>,
        /// profiles.toml path.
        #[arg(long)]
        profiles_config: Option<PathBuf>,
        /// rexlang .mox domain model files.
        #[arg(long = "mox-files")]
        mox_files: Vec<PathBuf>,
        /// Rosetta (Rune DSL) .rosetta model files (sigil-verified).
        #[arg(long = "rosetta-files")]
        rosetta_files: Vec<PathBuf>,
        /// rexlang .ddd design files (compile-verified against their
        /// imported .mox domains).
        #[arg(long)]
        ddd_files: Vec<PathBuf>,
        /// rexlang .evt event-contract files (compile-verified against
        /// their imported .mox domains).
        #[arg(long)]
        evt_files: Vec<PathBuf>,
        /// rexlang .deploy deployment files (compile-verified against
        /// their imported .ddd designs and .ifml flows).
        #[arg(long)]
        deploy_files: Vec<PathBuf>,
        /// rexlang .ifml interaction-model files (parse-verified, policy
        /// imports resolved).
        #[arg(long)]
        ifml_files: Vec<PathBuf>,
        /// Extension points config path (parse-validated, entity refs
        /// cross-checked).
        #[arg(long)]
        extension_points: Option<PathBuf>,
    },
}

/// Built-in template overrides shipped with the wrapper (the consumer's
/// `templates/` directory), merged with any `--template-dir` flag values.
fn template_dirs(extra: &[PathBuf]) -> Vec<PathBuf> {
    let mut dirs = vec![PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("templates")];
    dirs.extend_from_slice(extra);
    dirs
}

/// The codegraph git rev this wrapper pins generated Cargo.toml deps to.
/// Empty when the workspace uses local path deps (--codegraph-path init mode).
const CODEGRAPH_REV: &str = "{{ codegraph_rev }}";

/// Content hash of the codegraph project templates that rendered this
/// wrapper (issue #348). `codegraph doctor` compares it against the
/// binary's live hash to flag scaffolds rendered by different templates.
const CODEGRAPH_TEMPLATE_REV: &str = "{{ template_rev }}";

#[tokio::main]
async fn main() -> Result<()> {
    let cli = Cli::parse();
    match cli.command {
        Commands::Run {
            schemas,
            classifier,
            config,
            output,
            extension_points,
            integration_manifests,
            profile,
            variant,
            profiles_config,
            no_post_gen,
            template_dir,
            ifml_files,
            openapi_files,
            mox_files,
            rosetta_files,
            ddd_files,
            evt_files,
            deploy_files,
            ifml_framework,
            ifml_components,
            ifml_design_system,
            ux_rules,
            check,
        } => {
            let dirs = template_dirs(&template_dir);
            codegraph::driver::run(codegraph::driver::RunArgs {
                schemas: schemas.as_deref(),
                classifier: classifier.as_deref(),
                config_path: &config,
                output: &output,
                extension_points_path: extension_points.as_deref(),
                integration_manifests: &integration_manifests,
                profile_name: &profile,
                variant: variant.as_deref(),
                profiles_config_path: profiles_config,
                no_post_gen,
                template_dir: &dirs,
                ifml_files: &ifml_files,
                openapi_files: &openapi_files,
                mox_files: &mox_files,
                rosetta_files: &rosetta_files,
                ddd_files: &ddd_files,
                evt_files: &evt_files,
                deploy_files: &deploy_files,
                ifml_framework: &ifml_framework,
                ifml_components: ifml_components.as_deref(),
                ifml_design_system: ifml_design_system.as_deref(),
                ux_rules: ux_rules.as_deref(),
                codegraph_rev: if CODEGRAPH_REV.is_empty() {
                    None
                } else {
                    Some(CODEGRAPH_REV.to_string())
                },
                check,
            })
            .await
            .map_err(|e| codegraph::error::Error::Config(format!("run failed: {e}")))?;
            println!(
                "Generated app in {}. Run `just api` for integration tests.",
                output.display()
            );
            Ok(())
        }
        Commands::Classify {
            schemas,
            classifier,
            config,
            domain,
            mox_files,
            rosetta_files,
        } => codegraph::driver::classify(
            schemas.as_deref(),
            classifier.as_deref(),
            &config,
            domain.as_deref(),
            codegraph::driver::ClassifyFormat::Table,
            &mox_files,
            &rosetta_files,
        )
        .await
        .map_err(|e| codegraph::error::Error::Config(format!("classify failed: {e}"))),
        Commands::Generate {
            config,
            output,
            extension_points,
            integration_manifests,
            ux_rules,
            check,
        } => {
            let dirs = template_dirs(&[]);
            codegraph::driver::generate(
                &config,
                &output,
                extension_points.as_deref(),
                &integration_manifests,
                &dirs,
                &[],
                None,
                None,
                ux_rules.as_deref(),
                check,
            )
            .await
            .map_err(|e| codegraph::error::Error::Config(format!("generate failed: {e}")))
        }
        Commands::Doctor {
            config,
            schemas,
            classifier,
            profiles_config,
            mox_files,
            rosetta_files,
            ddd_files,
            evt_files,
            deploy_files,
            ifml_files,
            extension_points,
        } => codegraph::init::commands::cmd_doctor(&codegraph::init::commands::DoctorArgs {
            config,
            schemas,
            classifier,
            profiles_config,
            mox_files,
            rosetta_files,
            ddd_files,
            evt_files,
            deploy_files,
            ifml_files,
            extension_points,
        })
        .map(|_summary| ())
        .map_err(|e| codegraph::error::Error::Config(format!("doctor failed: {e}"))),
    }
}
