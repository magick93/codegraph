//! {{ project_name }} codegen wrapper: a thin clap CLI over the `codegraph`
//! driver library. Generated by `codegraph init` as `{{ graph_binary }}`.

use std::path::PathBuf;

use clap::{Parser, Subcommand};

use codegraph::error::Result;

#[derive(Parser)]
#[command(name = "{{ graph_binary }}", about = "Codegen driver for {{ project_name }}")]
struct Cli {
    #[command(subcommand)]
    command: Commands,
}

#[derive(Subcommand)]
enum Commands {
    /// Ingest the .mox model, classify, then run all generators.
    Run {
        /// JSON Schema directory. Optional when --mox-files or
        /// --rosetta-files is provided; JSON schemas are a secondary source
        /// (use `codegraph migrate` to convert them to .mox).
        #[arg(
            long,
            required_unless_present_any = ["mox_files", "rosetta_files"]
        )]
        schemas: Option<PathBuf>,
        /// Classifier config path (only needed when --schemas is provided).
        #[arg(long)]
        classifier: Option<PathBuf>,
        /// Domain config path.
        #[arg(long, default_value = "domains.toml")]
        config: PathBuf,
        /// Output directory for generated code.
        #[arg(long, default_value = "generated")]
        output: PathBuf,
        /// Extension points config path.
        #[arg(long)]
        extension_points: Option<PathBuf>,
        /// Profile name.
        #[arg(long, default_value = "default")]
        profile: String,
        /// Profile variant.
        #[arg(long)]
        variant: Option<String>,
        /// profiles.toml path (defaults to ./profiles.toml).
        #[arg(long)]
        profiles_config: Option<PathBuf>,
        /// Skip post-generation scripts.
        #[arg(long)]
        no_post_gen: bool,
        /// Additional template override directories (later dirs take precedence).
        #[arg(long = "template-dir")]
        template_dir: Vec<PathBuf>,
        /// IFML DSL files to ingest.
        #[arg(long = "ifml-files")]
        ifml_files: Vec<PathBuf>,
        /// OpenAPI spec files to ingest.
        #[arg(long = "openapi-files")]
        openapi_files: Vec<PathBuf>,
        /// rexlang .mox domain model files (primary model source).
        #[arg(long = "mox-files")]
        mox_files: Vec<PathBuf>,
        /// Rosetta (Rune DSL) .rosetta model files (primary model source).
        #[arg(long = "rosetta-files")]
        rosetta_files: Vec<PathBuf>,
    },
    /// Show entity/VO classification decisions for the .mox model.
    Classify {
        /// JSON Schema directory. Optional when --mox-files is provided.
        #[arg(long)]
        schemas: Option<PathBuf>,
        /// Classifier config path (only needed when --schemas is provided).
        #[arg(long)]
        classifier: Option<PathBuf>,
        /// Domain config path.
        #[arg(long, default_value = "domains.toml")]
        config: PathBuf,
        /// Only show results for this domain.
        #[arg(long)]
        domain: Option<String>,
        /// rexlang .mox domain model files (primary model source).
        #[arg(long = "mox-files")]
        mox_files: Vec<PathBuf>,
        /// Rosetta (Rune DSL) .rosetta model files (primary model source).
        #[arg(long = "rosetta-files")]
        rosetta_files: Vec<PathBuf>,
    },
    /// Generate code without ingesting schemas.
    Generate {
        /// Domain config path.
        #[arg(long, default_value = "domains.toml")]
        config: PathBuf,
        /// Output directory for generated code.
        #[arg(long, default_value = "generated")]
        output: PathBuf,
        /// Extension points config path.
        #[arg(long)]
        extension_points: Option<PathBuf>,
    },
    /// Validate project layout and configuration.
    Doctor {
        /// Domain config path.
        #[arg(long, default_value = "domains.toml")]
        config: PathBuf,
        /// JSON Schema directory. Optional when --mox-files is provided
        /// (mox-first projects carry no schemas directory).
        #[arg(long)]
        schemas: Option<PathBuf>,
        /// Classifier config path (only needed when JSON schemas are present).
        #[arg(long)]
        classifier: Option<PathBuf>,
        /// profiles.toml path.
        #[arg(long)]
        profiles_config: Option<PathBuf>,
        /// rexlang .mox domain model files.
        #[arg(long = "mox-files")]
        mox_files: Vec<PathBuf>,
        /// Rosetta (Rune DSL) .rosetta model files (sigil-verified).
        #[arg(long = "rosetta-files")]
        rosetta_files: Vec<PathBuf>,
    },
}

/// Built-in template overrides shipped with the wrapper (the consumer's
/// `templates/` directory), merged with any `--template-dir` flag values.
fn template_dirs(extra: &[PathBuf]) -> Vec<PathBuf> {
    let mut dirs = vec![PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("templates")];
    dirs.extend_from_slice(extra);
    dirs
}

/// The codegraph git rev this wrapper pins generated Cargo.toml deps to.
/// Empty when the workspace uses local path deps (--codegraph-path init mode).
const CODEGRAPH_REV: &str = "{{ codegraph_rev }}";

#[tokio::main]
async fn main() -> Result<()> {
    let cli = Cli::parse();
    match cli.command {
        Commands::Run {
            schemas,
            classifier,
            config,
            output,
            extension_points,
            profile,
            variant,
            profiles_config,
            no_post_gen,
            template_dir,
            ifml_files,
            openapi_files,
            mox_files,
            rosetta_files,
        } => {
            let dirs = template_dirs(&template_dir);
            codegraph::driver::run(codegraph::driver::RunArgs {
                schemas: schemas.as_deref(),
                classifier: classifier.as_deref(),
                config_path: &config,
                output: &output,
                extension_points_path: extension_points.as_deref(),
                profile_name: &profile,
                variant: variant.as_deref(),
                profiles_config_path: profiles_config,
                no_post_gen,
                template_dir: &dirs,
                ifml_files: &ifml_files,
                openapi_files: &openapi_files,
                mox_files: &mox_files,
                rosetta_files: &rosetta_files,
                ifml_framework: &[],
                ifml_components: None,
                ifml_design_system: None,
                codegraph_rev: if CODEGRAPH_REV.is_empty() {
                    None
                } else {
                    Some(CODEGRAPH_REV.to_string())
                },
            })
            .await
            .map_err(|e| codegraph::error::Error::Config(format!("run failed: {e}")))?;
            println!(
                "Generated app in {}. Run `just api` for integration tests.",
                output.display()
            );
            Ok(())
        }
        Commands::Classify {
            schemas,
            classifier,
            config,
            domain,
            mox_files,
            rosetta_files,
        } => codegraph::driver::classify(
            schemas.as_deref(),
            classifier.as_deref(),
            &config,
            domain.as_deref(),
            codegraph::driver::ClassifyFormat::Table,
            &mox_files,
            &rosetta_files,
        )
        .await
        .map_err(|e| codegraph::error::Error::Config(format!("classify failed: {e}"))),
        Commands::Generate {
            config,
            output,
            extension_points,
        } => {
            let dirs = template_dirs(&[]);
            codegraph::driver::generate(
                &config,
                &output,
                extension_points.as_deref(),
                &dirs,
                &[],
                None,
                None,
            )
            .await
            .map_err(|e| codegraph::error::Error::Config(format!("generate failed: {e}")))
        }
        Commands::Doctor {
            config,
            schemas,
            classifier,
            profiles_config,
            mox_files,
            rosetta_files,
        } => codegraph::init::commands::cmd_doctor(&codegraph::init::commands::DoctorArgs {
            config,
            schemas,
            classifier,
            profiles_config,
            mox_files,
            rosetta_files,
        })
        .map(|_summary| ())
        .map_err(|e| codegraph::error::Error::Config(format!("doctor failed: {e}"))),
    }
}
