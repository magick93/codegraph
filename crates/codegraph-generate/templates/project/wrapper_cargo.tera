# Codegen wrapper binary for {{ project_name }} — generated by `codegraph init`.

[package]
name = "{{ graph_binary }}"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
codegraph = { workspace = true }
codegraph-backend = { workspace = true }
codegraph-config = { workspace = true }
codegraph-classifier = { workspace = true }
codegraph-grafeo = { workspace = true }
codegraph-core = { workspace = true }
clap = { workspace = true }
tokio = { workspace = true }
