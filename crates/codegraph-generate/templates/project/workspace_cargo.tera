# Workspace for {{ project_name }} — generated by `codegraph init`.

[workspace]
resolver = "2"
members = [
    "{{ graph_binary }}",
    "ops/testkit",
]
exclude = ["generated"]

[workspace.dependencies]
{% if codegraph_path %}
codegraph = { path = "{{ codegraph_path }}/crates/codegraph" }
{% else %}
codegraph = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-core = { path = "{{ codegraph_path }}/crates/codegraph-core" }
{% else %}
codegraph-core = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-grafeo = { path = "{{ codegraph_path }}/crates/codegraph-grafeo" }
{% else %}
codegraph-grafeo = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-backend = { path = "{{ codegraph_path }}/crates/codegraph-backend" }
{% else %}
codegraph-backend = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-type-contracts = { path = "{{ codegraph_path }}/crates/codegraph-type-contracts" }
{% else %}
codegraph-type-contracts = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-naming = { path = "{{ codegraph_path }}/crates/codegraph-naming" }
{% else %}
codegraph-naming = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-classifier = { path = "{{ codegraph_path }}/crates/codegraph-classifier" }
{% else %}
codegraph-classifier = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-config = { path = "{{ codegraph_path }}/crates/codegraph-config" }
{% else %}
codegraph-config = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-ext-points = { path = "{{ codegraph_path }}/crates/codegraph-ext-points" }
{% else %}
codegraph-ext-points = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-workflow = { path = "{{ codegraph_path }}/crates/codegraph-workflow" }
{% else %}
codegraph-workflow = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
{% if codegraph_path %}
codegraph-ops = { path = "{{ codegraph_path }}/crates/codegraph-ops" }
{% else %}
codegraph-ops = { git = "https://github.com/magick93/codegraph.git", rev = "{{ codegraph_rev }}" }
{% endif %}
serde = { version = "1", features = ["derive"] }
tokio = { version = "1", features = ["full"] }
clap = { version = "4", features = ["derive"] }
