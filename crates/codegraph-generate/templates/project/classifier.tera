# Classifier configuration for {{ project_name }} — generated by `codegraph init`.
#
# Extend with wrapper classifications as needed. Every key is optional; a
# file containing only comments is a valid ClassifierConfig.
#
# Example primitive wrapper:
#
# [primitive_wrappers.CodeType]
# postgres = "TEXT"
# rust = "String"
# sea_orm = "Text"
#
# Example composite wrapper:
#
# [[composite_wrappers]]
# schema = "AmountType"
# columns = [
#   { suffix = "_value", postgres = "NUMERIC(19,4)", rust = "rust_decimal::Decimal", sea_orm = "Decimal", fk_table = "" },
#   { suffix = "_currency", postgres = "TEXT", rust = "String", sea_orm = "Text", fk_table = "" },
# ]
