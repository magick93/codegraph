# Domain configuration for {{ project_name }} — generated by `codegraph init`.
{% if features.rosetta %}# Model source: model/<domain>.rosetta (edit, then `just generate`).
# Rosetta types are auto-scored by the classifier: entity vs value object
# follows from the graph shape.
{% else %}# Model source: model/<domain>.mox (edit, then `just generate`).
# Mox is author-declarative: entity vs value object follows from the model
# (a class only targeted by `contains` is a value object; `refers` wins).
{% endif %}
[defaults]
app_name = "{{ app_name }}"
operations = ["create", "read", "update", "delete", "list"]

{% for d in domains %}[domains.{{ d.name }}]
label = "{{ d.label }}"
schema_dir = "{{ d.name }}"
postgres_schema = "{{ d.postgres_schema }}"
{% if features.rosetta %}# Model source: model/{{ d.name }}.rosetta
{% else %}# Model source: model/{{ d.name }}.mox
{% endif %}{% endfor %}