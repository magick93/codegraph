{#-
  UX-rules list-rendering E2E spec (issue #302).
  Rendered only when the entity's UxPlan is active; every test block is
  gated on a feature the entity's list page ACTUALLY renders (chips,
  copy-chip, alignment/Intl formatting, overflow actions, timeline,
  sorting, zebra) — no vacuous tests. Selector contract: ui/list_page.tera
  + ui/list_timeline.tera + ui/_ux_cell.tera testids.
-#}
// Generated by {{ project.generator_name }}. DO NOT EDIT.
// UX list-rendering E2E tests for {{ entity_name }} (ux-rules epic, #302).

{% if ux_spec %}
import { test, expect } from '../../e2e/fixtures/personas';
import type { OrgContext } from '../../e2e/fixtures/personas';
import {
  createEntityAsAcme,
  deleteEntityAsAcme,
  waitForHydration,
} from '../../e2e/helpers';

{% if parent %}
{% if parent.grandparent %}
const GRANDPARENT_API_PATH = '/{{ parent.grandparent.domain }}/{{ parent.grandparent.path_segment }}';
let PARENT_API_PATH: string;
{% else %}
const PARENT_API_PATH = '/{{ parent.domain }}/{{ parent.path_segment }}';
{% endif %}
let parentId: string;
let BASE_PATH: string;
let LIST_PATH: string;
{% else %}
const BASE_PATH = '/{{ domain }}/{{ path_segment }}';
const LIST_PATH = BASE_PATH;
{% endif %}

const MODULE = '{{ module_name }}';
const UX_LOCALE = '{{ ux_spec.locale }}';
{% if ux_spec.currency %}
const UX_CURRENCY = '{{ ux_spec.currency }}';
{% endif %}

// Entity reference dependency IDs — populated in beforeAll when FK deps exist
{% raw %}
const depIds: Record<string, string | string[]> = {};
{% endraw %}

let createdIds: string[] = [];

{% raw %}
function testData(): Record<string, unknown> {
{% endraw %}
  return {
{% for field in create_fields %}
{% if field.nested_type_name %}
    {%- if field.is_array %}
    '{{ field.name }}': [],
    {%- else %}
    // '{{ field.name }}': ValueObject — omit, serde default
    {%- endif %}
{% elif field.input_type == "number" %}
    '{{ field.name }}': 42,
{% elif field.input_type == "checkbox" %}
    '{{ field.name }}': true,
{% elif field.input_type == "date" %}
    '{{ field.name }}': '2025-01-15',
{% elif field.input_type == "datetime-local" %}
    '{{ field.name }}': '2025-01-15T10:30:00Z',
{% elif field.is_codelist and field.codelist_values | length > 0 and field.is_array %}
    '{{ field.name }}': [{ code: '{{ field.codelist_values | first }}' }],
{% elif field.is_codelist and field.codelist_values | length > 0 %}
    '{{ field.name }}': '{{ field.codelist_values | first }}',
{% elif field.structured_sub_fields | length > 0 and field.is_array %}
    '{{ field.name }}': [{ value: 'Test {{ field.label }}' }],
{% elif field.structured_sub_fields | length > 0 %}
    '{{ field.name }}': { value: 'Test {{ field.label }}' },
{% elif field.is_range %}
    '{{ field.name }}': '[2025-01-01T00:00:00Z,2025-12-31T23:59:59Z]',
{% elif field.is_entity_ref %}
    // '{{ field.name }}': entity ref — emitted by _dep_setup.tera
{% elif field.pg_type == "UUID" and not field.is_entity_ref %}
    '{{ field.name }}': `00000000-0000-4000-8000-${Math.random().toString(16).slice(2, 14).padStart(12, '0')}`,
{% elif field.pg_type is containing("GEOMETRY") %}
    // geometry field omitted — plain WKT strings are not accepted by the API without ST_GeomFromText
{% elif field.is_array %}
    '{{ field.name }}': ['Test {{ field.label }}'],
{% elif field.input_type == "geometry" %}
{% elif field.input_type == "code" %}
    '{{ field.name }}': `TestCode-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
{% else %}
    '{{ field.name }}': 'Test {{ field.label }}',
{% endif %}
{% endfor %}
{% set dep_section = "test_data" %}
{% include "ui/test/_dep_setup.tera" %}
  };
}

// Create a ux fixture row via the API and register it for teardown.
async function createUxFixture(
  orgContext: OrgContext,
  overrides: Record<string, unknown> = {},
): Promise<string> {
  const entity = await createEntityAsAcme(orgContext, BASE_PATH, { ...testData(), ...overrides });
  const id = entity['id'] as string;
  createdIds.push(id);
  return id;
}

test.describe('{{ entity_name }} UX list rendering', () => {

{% if parent or has_entity_ref_deps %}
  test.beforeAll(async ({ orgContext }) => {
{% if parent %}
{% if parent.grandparent %}
    const gpEntity = await createEntityAsAcme(orgContext, GRANDPARENT_API_PATH, { {{ grandparent_test_data_json }} });
    const gpId = gpEntity['id'] as string;
    PARENT_API_PATH = `${GRANDPARENT_API_PATH}/${gpId}/{{ parent.path_segment }}`;
{% endif %}
    const parentEntity = await createEntityAsAcme(orgContext, PARENT_API_PATH, { {{ parent_test_data_json }} });
    parentId = parentEntity['id'] as string;
    BASE_PATH = `${PARENT_API_PATH}/${parentId}/{{ path_segment }}`;
    LIST_PATH = `${BASE_PATH}`;
{% endif %}
{% set dep_section = "before_all" %}
{% include "ui/test/_dep_setup.tera" %}
  });

  test.afterAll(async ({ orgContext }) => {
{% set dep_section = "after_all" %}
{% include "ui/test/_dep_setup.tera" %}
  });
{% endif %}

  test.afterEach(async ({ orgContext }) => {
    for (const id of createdIds) {
      try {
        await deleteEntityAsAcme(orgContext, BASE_PATH, id);
      } catch { /* best effort */ }
    }
    createdIds = [];
  });

{% if ux_spec.has_table %}
  test('list renders the ux table contract', async ({ ownerPage: page, orgContext }) => {
    await createUxFixture(orgContext);
    await page.goto(LIST_PATH);
    await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
    await expect(page.locator(`[data-testid="${MODULE}-table"]`)).toBeVisible();
    // The header sequence mirrors the plan's column_order — no extra or
    // missing columns. A plan with no resolvable columns renders the
    // id fallback column, so expect exactly that one.
    const headerCount = await page.locator('thead th').count();
    expect(headerCount).toBe({% if ux_spec.columns %}{{ ux_spec.columns | length }}{% else %}1{% endif %});
{% if ux_spec.first_column %}
    // The first rendered column is the human-readable field, not the
    // system id (plan rows 17/25).
    {
      const firstCell = page.locator('tbody tr:first-child td:first-child');
      await expect(firstCell).toHaveText({{ ux_spec.first_column.expected_literal }});
    }
{% endif %}
  });
{% endif %}

{% if ux_spec.chip_checks | length > 0 %}
  test('status chips render with the expected labels', async ({ ownerPage: page, orgContext }) => {
    await createUxFixture(orgContext);
    await page.goto(LIST_PATH);
    await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
{% for chip in ux_spec.chip_checks %}
    {
      const chip = page
        .locator(`[data-testid="${MODULE}-chip"]`)
        .filter({ hasText: '{{ chip.text }}' })
        .first();
      await expect(chip).toBeVisible();
      await expect(chip).toHaveText('{{ chip.text }}');
    }
{% endfor %}
  });
{% endif %}

{% if ux_spec.align_checks | length > 0 or ux_spec.format_checks | length > 0 %}
  test('numeric columns right-align and format through Intl', async ({ ownerPage: page, orgContext }) => {
    await createUxFixture(orgContext);
    await page.goto(LIST_PATH);
    await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
{% for col in ux_spec.align_checks %}
    {
      const td = page.locator('tbody tr:first-child td:nth-child({{ col.td_index }})');
      await expect(td).toHaveClass(/text-right/);
      await expect(td).toHaveClass(/tabular-nums/);
    }
{% if col.sortable %}
    {
      const th = page.locator(`th:has([data-testid="${MODULE}-sort-{{ col.key }}"])`);
      await expect(th).toHaveClass(/text-right/);
      await expect(th).toHaveClass(/tabular-nums/);
    }
{% endif %}
{% endfor %}
{% for col in ux_spec.format_checks %}
    {
      const td = page.locator('tbody tr:first-child td:nth-child({{ col.td_index }})');
{% if col.kind == "money" %}
      const fmt = new Intl.NumberFormat(UX_LOCALE{% if ux_spec.currency %}, { style: 'currency', currency: UX_CURRENCY }{% endif %});
      await expect(td).toHaveText(fmt.format({{ col.fixture_literal }}));
{% elif col.kind == "quantity" %}
      const fmt = new Intl.NumberFormat(UX_LOCALE);
      await expect(td).toHaveText(fmt.format({{ col.fixture_literal }}));
{% else %}
      const fmt = new Intl.DateTimeFormat(UX_LOCALE, { dateStyle: 'medium', timeStyle: 'short' });
      await expect(td).toHaveText(fmt.format(new Date({{ col.fixture_literal }})));
{% endif %}
    }
{% endfor %}
  });
{% endif %}

{% if ux_spec.copy_check %}
  test('copy-chip copies the identifier and surfaces a tooltip', async ({ ownerPage: page, orgContext }) => {
    const createdId = await createUxFixture(orgContext);
    await page.goto(LIST_PATH);
    await page.context().grantPermissions(['clipboard-read', 'clipboard-write']);
    await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
    // The copy cell truncates, so scope to the row carrying the fixture
    // value prefix rather than trusting row order.
    const row = page
      .locator('tbody tr')
      .filter({ hasText: ({{ ux_spec.copy_check.expected_expr }}).slice(0, 8) })
      .first();
    const copyTrigger = row.locator(`[data-testid="${MODULE}-copy"]`).first();
    await copyTrigger.click();
{% if ux_spec.copy_check.expected_expr == "createdId" %}
    await expect
      .poll(() => page.evaluate(() => navigator.clipboard.readText()))
      .toBe(createdId);
{% else %}
    await expect
      .poll(() => page.evaluate(() => navigator.clipboard.readText()))
      .toBe({{ ux_spec.copy_check.expected_expr }});
{% endif %}
{% if ux_spec.copy_check.truncate_tooltip %}
    // Hover (or focus) surfaces the FULL value through the Tooltip. Radix
    // closes the tooltip on trigger click, and a hover() over an element
    // the pointer already occupies fires no new pointerenter — move the
    // pointer away first so the reopen is deterministic.
    await page.mouse.move(0, 0);
    await copyTrigger.hover();
    const tooltip = page
      .locator('[data-slot="tooltip-content"]')
      .filter({ hasText: {{ ux_spec.copy_check.expected_expr }} });
    await expect(tooltip).toBeVisible();
{% endif %}
  });
{% endif %}

{% if ux_spec.actions %}
  test('row actions open the overflow menu', async ({ ownerPage: page, orgContext }) => {
    await createUxFixture(orgContext);
    await page.goto(LIST_PATH);
    await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
    const trigger = page.locator(`[data-testid="${MODULE}-actions"]`).first();
    await trigger.click();
    const menu = page.locator(`[data-testid="${MODULE}-actions-menu"]`);
    await expect(menu).toBeVisible();
{% if ux_spec.actions.confirm_delete %}
    // Delete opens the confirmation dialog; CANCEL keeps the row.
    await page.locator(`[data-testid="${MODULE}-action-delete"]`).click();
    const confirm = page.locator(`[data-testid="${MODULE}-delete-confirm"]`);
    await expect(confirm).toBeVisible();
    const rows = page.locator('tbody tr');
    const rowsBefore = await rows.count();
    await confirm.getByRole('button', { name: /cancel/i }).click();
    await expect(confirm).toBeHidden();
    await expect(rows).toHaveCount(rowsBefore);
{% endif %}
  });
{% endif %}

{% if ux_spec.timeline %}
  test('timeline renders entries newest-first', async ({ ownerPage: page, orgContext }) => {
    await createUxFixture(orgContext);
    await createUxFixture(orgContext);
    await page.goto(LIST_PATH);
    await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
    const timeline = page.locator(`[data-testid="${MODULE}-timeline"]`);
    await expect(timeline).toBeVisible();
    const items = page.locator(`[data-testid="${MODULE}-timeline-item"]`);
    const itemCount = await items.count();
    expect(itemCount).toBeGreaterThan(0);
    const times = await items.locator('time').allTextContents();
    expect(times.length).toBeGreaterThan(0);
    // Every entry shows a real date.
    for (const text of times) {
      expect(text.trim().length).toBeGreaterThan(0);
      expect(text).toMatch(/\d/);
    }
{% if ux_spec.timeline_order_fixture %}
    // Fixture-controlled order_by: the localized rendering matches the
    // same Intl.DateTimeFormat the page runs.
    {
      const fmt = new Intl.DateTimeFormat(UX_LOCALE, { dateStyle: 'medium' });
      const expected = fmt.format(new Date({{ ux_spec.timeline_order_fixture }}));
      expect(times).toContain(expected);
    }
{% endif %}
    // DESC: parsed times never increase down the timeline (entries the
    // locale parser cannot read are skipped rather than failed).
    {
      const parsed = times.map((t) => Date.parse(t)).filter((v) => !Number.isNaN(v));
      for (let i = 1; i < parsed.length; i++) {
        expect(parsed[i]).toBeLessThanOrEqual(parsed[i - 1]);
      }
    }
  });
{% endif %}

{% if ux_spec.sort %}
  test('sortable headers toggle aria-sort and validate ?sort', async ({ ownerPage: page, orgContext }) => {
    await createUxFixture(orgContext);
    await page.goto(LIST_PATH);
    await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
{% for key in ux_spec.sort.fields %}
    {
      const th = page.locator(`th:has([data-testid="${MODULE}-sort-{{ key }}"])`);
      const btn = page.locator(`[data-testid="${MODULE}-sort-{{ key }}"]`);
      await expect(btn).toBeVisible();
      await expect(th).toHaveAttribute('aria-sort', 'none');
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'ascending');
      await expect(page).toHaveURL(/sort={{ key }}(&|$)/);
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'descending');
      await expect(page).toHaveURL(/order=desc(&|$)/);
    }
{% endfor %}
    // The rendered header order follows the plan's column_order sequence
    // (readable field first, audit stamps last).
    {
      const headerOrder: number[] = [];
{% for key in ux_spec.sort.fields %}
      headerOrder.push(
        await page
          .locator('thead th')
          .filter({ has: page.locator(`[data-testid="${MODULE}-sort-{{ key }}"]`) })
          .evaluate((th) => Array.from(th.parentElement?.children ?? []).indexOf(th))
      );
{% endfor %}
      const sortedOrder = [...headerOrder].sort((a, b) => a - b);
      expect(headerOrder).toEqual(sortedOrder);
    }
    // Invalid sort fields are rejected with the allow-list.
    {
      const baseUrl = process.env.PUBLIC_API_URL ?? 'http://localhost:3000';
      const res = await fetch(`${baseUrl}/api/v1${BASE_PATH}?sort=__nope__`, {
        headers: { 'Authorization': `Bearer ${orgContext.acme.apiKey}` },
      });
      expect(res.status).toBe(400);
      const body = await res.text();
      expect(body).toContain('Unknown sort field');
      expect(body).toContain('{{ ux_spec.sort.valid_fields_text }}');
    }
{% if ux_spec.sort.flip %}
    // Valid ?sort=&order= flips the alt fixture row's position. The row
    // is located by its own fixture literal, not by first-row cell text —
    // null placeholder cells (—) sort differently asc/desc and make a
    // first-row text comparison vacuous.
    {
      await createUxFixture(orgContext);
      await createUxFixture(orgContext, { '{{ ux_spec.sort.flip.key }}': {{ ux_spec.sort.flip.alt_literal }} });
      const altRow = page
        .locator('tbody tr')
        .filter({ hasText: {{ ux_spec.sort.flip.alt_literal }} })
        .first();
      await page.goto(`${LIST_PATH}?sort={{ ux_spec.sort.flip.key }}&order=asc`);
      await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
      const ascPos = await altRow.evaluate((el) => Array.from(el.parentElement?.children ?? []).indexOf(el));
      await page.goto(`${LIST_PATH}?sort={{ ux_spec.sort.flip.key }}&order=desc`);
      await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
      const descPos = await altRow.evaluate((el) => Array.from(el.parentElement?.children ?? []).indexOf(el));
      expect(ascPos).not.toBe(descPos);
    }
{% endif %}
  });
{% endif %}

{% if ux_spec.has_table and ux_spec.zebra %}
  test('rows keep zebra shading and hover/focus feedback', async ({ ownerPage: page, orgContext }) => {
    await createUxFixture(orgContext);
    await createUxFixture(orgContext);
    await page.goto(LIST_PATH);
    await waitForHydration(page, `[data-testid="${MODULE}-pagination"]`);
    const firstRow = page.locator('tbody tr').first();
    await expect(firstRow).toHaveClass(/hover:bg-muted\/50/);
    await expect(firstRow).toHaveClass(/focus-visible:ring-2/);
    // Second visual row carries the zebra band (odd row index).
    const secondRow = page.locator('tbody tr').nth(1);
    await expect(secondRow).toHaveClass(/bg-muted\/50/);
  });
{% endif %}
});
{% endif %}
