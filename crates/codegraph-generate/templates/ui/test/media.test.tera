{#
  Media round-trip E2E spec (issue #633).

  Emitted only when the entity has media fields with an app-plane route
  (`media::plan::media_route_fields`) AND the remote-functions detail page
  that renders the control is part of the plan. Every interaction flows
  through the page object (`{{ entity_name }}Page` → `BasePage.uploadMedia` /
  `removeMedia`) — zero raw testids in this file (the #316/#318 contract).
  API-fixture creation stays here (the crud template's convention).

  TODO(#633): the emitted media route answers 400 for an unaccepted mime
  and for an oversize upload (`AppError::bad_request`) while its utoipa
  annotations document 415/413. The status-code split belongs to the api
  plane (`templates/api/media_route.tera`, out of this workstream's scope),
  so these legs assert the REJECTION the user sees — the control's error
  surface — and the client pre-flight (`validateMediaFile`) short-circuits
  both before the request is sent.
#}
// Generated by {{ project.generator_name }}. DO NOT EDIT.
// Media upload E2E tests for {{ entity_name }} (issue #633).

import { mkdtempSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import path from 'node:path';

import { test, expect } from '../../e2e/fixtures/personas';
import type { OrgContext } from '../../e2e/fixtures/personas';
import { createEntityAsAcme, deleteEntityAsAcme } from '../../e2e/helpers';
import { {{ entity_name }}Page } from './{{ path_segment }}.page';

const BASE_PATH = '/{{ domain }}/{{ path_segment }}';

// The smallest valid PNG (1×1, transparent) — the accepted-mime fixture.
const PNG_1X1 = Buffer.from(
  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFAAH/q842iQAAAABJRU5ErkJggg==',
  'base64',
);

test.describe('{{ entity_name }} media', () => {
  let entityId = '';
  let fixtureDir = '';

  test.beforeAll(async ({ orgContext }) => {
    fixtureDir = mkdtempSync(path.join(tmpdir(), 'media-{{ module_name }}-'));
    const row = await createEntityAsAcme(orgContext, BASE_PATH, { {{ media_test_data_json }} });
    entityId = row['id'] as string;
  });

  test.afterAll(async ({ orgContext }) => {
    if (entityId) {
      try {
        await deleteEntityAsAcme(orgContext, BASE_PATH, entityId);
      } catch {
        /* best effort — the row may already be gone */
      }
    }
  });

  /** Write one fixture file into the per-run temp dir. */
  function fixtureFile(name: string, contents: Buffer): string {
    const file = path.join(fixtureDir, name);
    writeFileSync(file, contents);
    return file;
  }

  test('detail page renders before upload', async ({ ownerPage: page }) => {
    const ui = new {{ entity_name }}Page(page);
    await ui.gotoDetail(entityId);
    await expect(ui.detailHeading()).toBeVisible();
    await expect(ui.media{{ media_fields[0].pascal }}Display()).toHaveCount(0);
  });

{% for m in media_fields %}
  test('{{ m.field }}: upload stores the reference and the display renders', async ({ ownerPage: page }) => {
    const ui = new {{ entity_name }}Page(page);
    await ui.gotoDetail(entityId);
    await expect(ui.detailHeading()).toBeVisible();

    await ui.upload{{ m.pascal }}(fixtureFile('{{ m.field }}-ok.png', PNG_1X1));
    await expect(ui.media{{ m.pascal }}Display()).toBeVisible();
    await expect(ui.media{{ m.pascal }}Display()).toHaveAttribute('src', /.+/);

    // Reference round-trip: a fresh server load resolves the stored
    // reference (the display URL is minted from the child row), so the
    // display survives a reload — it is not just upload-time client state.
    await ui.gotoDetail(entityId);
    await expect(ui.detailHeading()).toBeVisible();
    await expect(ui.media{{ m.pascal }}Display()).toBeVisible();
  });

  test('{{ m.field }}: remove clears the reference and the display', async ({ ownerPage: page }) => {
    const ui = new {{ entity_name }}Page(page);
    await ui.gotoDetail(entityId);
    await expect(ui.detailHeading()).toBeVisible();
    // Seed a reference through the control (the remove leg needs one).
    await ui.upload{{ m.pascal }}(fixtureFile('{{ m.field }}-remove.png', PNG_1X1));
    await expect(ui.media{{ m.pascal }}Display()).toBeVisible();

    await ui.remove{{ m.pascal }}();
    await expect(ui.media{{ m.pascal }}Display()).toHaveCount(0);

    // The stored reference is gone, not just the client state.
    await ui.gotoDetail(entityId);
    await expect(ui.detailHeading()).toBeVisible();
    await expect(ui.media{{ m.pascal }}Display()).toHaveCount(0);
  });

  // Wrong mime and oversize: the control rejects the file and surfaces the
  // reason (`415`/`413` semantics — see the header note on the status
  // mapping). `uploadMedia` throws with the control's message, so the leg
  // asserts both the rejection and its cause.
  test('{{ m.field }}: wrong mime is rejected', async ({ ownerPage: page }) => {
    const ui = new {{ entity_name }}Page(page);
    await ui.gotoDetail(entityId);
    await expect(ui.detailHeading()).toBeVisible();
    const rejected = fixtureFile('{{ m.field }}-wrong-mime.txt', Buffer.from('plain text'));

    await expect(ui.upload{{ m.pascal }}(rejected)).rejects.toThrow(/mime/i);
    await expect(ui.media{{ m.pascal }}Display()).toHaveCount(0);
  });

  test('{{ m.field }}: oversize upload is rejected', async ({ ownerPage: page }) => {
    const ui = new {{ entity_name }}Page(page);
    await ui.gotoDetail(entityId);
    await expect(ui.detailHeading()).toBeVisible();
    // One byte over the configured cap: the mime is accepted, the size is
    // not (`{{ m.max_bytes }}` bytes from the domain's `[media]` table).
    const rejected = fixtureFile('{{ m.field }}-oversize.png', Buffer.alloc({{ m.max_bytes }} + 1, 1));

    await expect(ui.upload{{ m.pascal }}(rejected)).rejects.toThrow(/exceeds/i);
    await expect(ui.media{{ m.pascal }}Display()).toHaveCount(0);
  });
{% endfor %}
});
