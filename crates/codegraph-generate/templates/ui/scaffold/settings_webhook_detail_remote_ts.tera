//
// Webhook settings data plane (issue #574 S2): remote functions run
// SERVER-side — the browser only calls the generated same-origin
// endpoints, so the API origin and its credentials never reach the client.

import { command, query } from '$app/server';
import { apiFetch } from '$lib/server/api';

export const getEndpointData = query('unchecked', async (id: string) => {
	const base = `/api/v1/webhooks/webhook-endpoints/${id}`;
	const [endpointRes, subsRes, delsRes] = await Promise.all([
		apiFetch(base),
		apiFetch(`${base}/subscriptions`),
		apiFetch(`${base}/deliveries`)
	]);
	if (!endpointRes.ok) {
		throw new Error(`Failed to load webhook endpoint (${endpointRes.status})`);
	}
	const endpoint = await (endpointRes.json() as Promise<Record<string, unknown>>).then(
		(j) => j.data ?? j
	);
	const subs = subsRes.ok ? await subsRes.json() : [];
	const deliveries = delsRes.ok ? await delsRes.json() : [];
	return {
		endpoint,
		subscriptions: Array.isArray(subs) ? subs : subs.data ?? [],
		deliveries: Array.isArray(deliveries) ? deliveries : deliveries.data ?? []
	};
});

export const toggleActive = command(
	'unchecked',
	async (id: string, isActive: boolean) => {
		const response = await apiFetch(`/api/v1/webhooks/webhook-endpoints/${id}`, {
			method: 'PUT',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ is_active: isActive })
		});
		if (!response.ok) {
			const body = await response.json().catch(() => null);
			return {
				ok: false as const,
				message: body?.error ?? body?.message ?? `Request failed (${response.status})`
			};
		}
		// Single-flight refresh (issue #574 S4a): the fresh endpoint data
		// rides the command response to the client's query instance.
		void getEndpointData(id).refresh();
		return { ok: true as const };
	}
);

export const rotateSecret = command('unchecked', async (id: string) => {
	const response = await apiFetch(
		`/api/v1/webhooks/webhook-endpoints/${id}/rotate-secret`,
		{
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({})
		}
	);
	if (!response.ok) {
		const body = await response.json().catch(() => null);
		return {
			ok: false as const,
			message: body?.error ?? body?.message ?? `Request failed (${response.status})`
		};
	}
	const json = await response.json();
	void getEndpointData(id).refresh();
	return { ok: true as const, secret: (json.data ?? json).secret as string };
});

export const deleteSubscription = command(
	'unchecked',
	async (endpointId: string, subscriptionId: string) => {
		const response = await apiFetch(`/api/v1/webhooks/webhook-subscriptions/${subscriptionId}`, {
			method: 'DELETE'
		});
		if (!response.ok) {
			const body = await response.json().catch(() => null);
			return {
				ok: false as const,
				message: body?.error ?? body?.message ?? `Request failed (${response.status})`
			};
		}
		void getEndpointData(endpointId).refresh();
		return { ok: true as const };
	}
);
{% if ui_live_queries %}
// Live delivery log (issue #574 S4c): a query.live stream polling the
// deliveries read every 5s. The page consumes the instance reactively on
// the client; the load payload stays the SSR fallback.
export const getDeliveriesLive = query.live(async function* (id: string) {
	while (true) {
		const res = await apiFetch(`/api/v1/webhooks/webhook-endpoints/${id}/deliveries`);
		if (res.ok) {
			const json = await res.json();
			yield Array.isArray(json) ? json : json.data ?? [];
		}
		await new Promise((resolve) => setTimeout(resolve, 5000));
	}
});
{% endif %}
