				{/if}
			{/snippet}{% endraw %}
		</form.Subscribe>

		<form.Subscribe selector={(state) => ({ canSubmit: state.canSubmit, isSubmitting: state.isSubmitting })}>
			{% raw %}{#snippet children({ canSubmit, isSubmitting })}
				<div class="flex flex-col-reverse gap-3 pt-4 sm:flex-row sm:justify-end">
					<Button variant="outline" type="button" onclick={() => history.back()} data-testid="{% endraw %}{{ tid.cancel_btn }}{% raw %}">
						{m.common_cancel()}
					</Button>
					<Button type="submit" disabled={!canSubmit || isSubmitting} data-testid="{% endraw %}{{ tid.submit_btn }}{% raw %}">
						{#if isSubmitting}
							<Spinner class="mr-2 h-4 w-4" />
							{m.common_saving()}
						{:else}
