						subFields={[
							{% endraw %}{% for sf in field.structured_sub_fields %}{% raw %}{ name: '{% endraw %}{{ sf.name }}{% raw %}', label: '{% endraw %}{{ sf.label }}{% raw %}', required: {% endraw %}{{ sf.is_required }}{% raw %}, showByDefault: {% endraw %}{{ sf.show_by_default }}{% raw %}, description: `{% endraw %}{{ sf.description | js_template_literal }}{% raw %}` },
							{% endraw %}{% endfor %}{% raw %}
						]}
						value={field.state.value}
