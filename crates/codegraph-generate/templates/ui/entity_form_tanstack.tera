<!-- TanStack Form component for {{ entity_name }} (issue #580): the zod
     schema is lowered IN RUST (forms::ZodObject) and interpolated; field
     errors come from TanStack field state meta; the submit button rides
     form.Subscribe. 422 field details map onto the matching fields. -->
<script lang="ts">
	import { createAppForm } from '$lib/forms/form';
	import { z } from 'zod';
	import { Button } from '#lib/components/ui/button/index.js';
	import { Spinner } from '#lib/components/ui/spinner/index.js';
	import { DateRangeField } from '#lib/components/ui/date-range-field/index.js';
	import { ArrayField } from '#lib/components/ui/array-field/index.js';
	import { StructuredWrapperField } from '#lib/components/ui/structured-wrapper-field/index.js';
	import * as m from '#lib/paraglide/messages.js';
	import type { {{ entity_name }}Response } from '#lib/api/types.ts';

	type SubmitResult = {
		ok: boolean;
		id?: string;
		message?: string;
		fieldErrors?: Record<string, string>;
	};

	interface Props {
		mode: 'create' | 'edit';
		initialData?: {{ entity_name }}Response;
		onsubmit: (data: Record<string, unknown>) => Promise<SubmitResult>;
	}

	let { mode, initialData = undefined, onsubmit }: Props = $props();

	{{ tanstack.schema_source }}
	const defaultValues = {
{% for field in tanstack.fields %}
		{{ field.name }}: {{ field.default_ts }},
{% endfor %}
	};

	const form = createAppForm(() => ({
		defaultValues,
		validators: {
			// The schema validates the SUBMIT payload; the live form state
			// is its looser precursor (placeholder empty strings,
			// pre-edit optionals), so the static shape is loosened here —
			// TanStack still runs the schema through its Standard Schema
			// integration and distributes errors onto the fields.
			onSubmit: {{ tanstack.schema_name }} as never,
		},
		onSubmit: async ({ value }) => {
			form.setErrorMap({ onSubmit: undefined });
			const payload: Record<string, unknown> = { ...value };
{% for field in tanstack.fields %}
{% if field.kind == "datetime" %}
			if (payload['{{ field.name }}']) {
				payload['{{ field.name }}'] = String(payload['{{ field.name }}']).includes('Z')
					? payload['{{ field.name }}']
					: payload['{{ field.name }}'] + ':00Z';
			}
{% endif %}
{% if field.is_array_codelist %}
			if (payload['{{ field.name }}']) {
				payload['{{ field.name }}'] = [{ code: payload['{{ field.name }}'] }];
			}
{% endif %}
{% if field.kind == "number" and not field.required %}
			if (
				payload['{{ field.name }}'] === undefined ||
				Number.isNaN(payload['{{ field.name }}'] as number)
			) {
				delete payload['{{ field.name }}'];
			}
{% endif %}
{% if not field.required and (field.kind == "text" or field.kind == "textarea" or field.kind == "select" or field.kind == "date" or field.kind == "uuid" or field.kind == "email" or field.kind == "url") %}
			if (payload['{{ field.name }}'] === '') {
				delete payload['{{ field.name }}'];
			}
{% endif %}
{% endfor %}
			const result = await onsubmit(payload);
			if (!result.ok) {
				if (result.fieldErrors) {
					for (const fieldName of Object.keys(result.fieldErrors)) {
						const message = result.fieldErrors[fieldName];
						form.setFieldMeta(fieldName as never, (meta) => ({
							...meta,
							errors: [message],
						}));
					}
				}
				form.setErrorMap({ onSubmit: result.message } as never);
			}
		},
	}));

	function handleSubmit(e: Event) {
		e.preventDefault();
		void form.handleSubmit();
	}
</script>

<form onsubmit={handleSubmit} class="space-y-6" aria-label={% raw %}{{% endraw %}mode === 'create' ? m.{{ domain }}_{{ module_name }}_new() : m.common_edit() + ' ' + m.{{ domain }}_{{ module_name }}_title(){% raw %}}{% endraw %} data-testid="{{ tid.form }}">
	<form.AppForm>
{% for field in tanstack.fields %}
{% if field.kind == "junction" %}
		<form.AppField name="{{ field.name }}" mode="array">
			{% raw %}{#snippet children(field)}
				<div class="space-y-2">
					<span class="text-sm font-medium">{% endraw %}{{ field.label }}{% if field.required %} <span class="text-destructive">*</span>{% endif %}{% raw %}</span>
					{% endraw %}{% if field.description %}{% raw %}<p class="text-muted-foreground text-sm">{% endraw %}{{ field.description }}{% raw %}</p>
					{% endraw %}{% endif %}{% raw %}
					{#each field.state.value as row, i}
						<div class="flex items-center gap-2" data-testid="{% endraw %}{{ field.name }}{% raw %}-row-{i}">
							<input
								type="text"
								class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm"
								value={row}
								oninput={(e) =>
									field.handleChange(
										field.state.value.map((v, j) => (j === i ? e.currentTarget.value : v))
									)}
							/>
							<button
								type="button"
								class="inline-flex h-9 items-center rounded-md border border-input bg-transparent px-3 text-sm"
								onclick={() => field.removeValue(i)}
								data-testid="{% endraw %}{{ field.name }}{% raw %}-remove-{i}"
							>
								Remove
							</button>
						</div>
					{/each}
					<button
						type="button"
						class="inline-flex h-9 items-center rounded-md border border-input bg-transparent px-3 text-sm"
						onclick={() => field.pushValue('')}
						data-testid="{% endraw %}{{ field.name }}{% raw %}-add-btn"
					>
						Add item
					</button>
					{#if field.state.meta.errors.length > 0}
						<p class="text-destructive text-sm" data-testid="{% endraw %}{{ field.name }}{% raw %}-error">
							{field.state.meta.errors
								.map((e: unknown) =>
									typeof e === 'string' ? e : ((e as { message?: string })?.message ?? '')
								)
								.filter(Boolean)[0]}
						</p>
					{/if}
				</div>
			{/snippet}{% endraw %}
		</form.AppField>
{% elif field.kind == "range" %}
		<form.AppField name="{{ field.name }}">
			{% raw %}{#snippet children(field)}
				<div class="space-y-2">
					<span class="text-sm font-medium">{% endraw %}{{ field.label }}{% if field.required %} <span class="text-destructive">*</span>{% endif %}{% raw %}</span>
					<DateRangeField
						id="{% endraw %}{{ field.name }}{% raw %}-value"
						value={field.state.value}
						onvaluechange={(v: string) => field.handleChange(v)}
						openEnd={% endraw %}{{ field.open_end }}{% raw %}
						{% endraw %}{% if field.required %}required{% endif %}{% raw %}
						data-testid="{% endraw %}{{ field.name }}{% raw %}-value"
					/>
					{% endraw %}{% if field.description %}{% raw %}<p class="text-muted-foreground text-sm">{% endraw %}{{ field.description }}{% raw %}</p>{% endraw %}{% endif %}{% raw %}
				</div>
			{/snippet}{% endraw %}
		</form.AppField>
{% elif field.kind == "structured" %}
		<form.AppField name="{{ field.name }}">
			{% raw %}{#snippet children(field)}
				<div class="space-y-2">
					<StructuredWrapperField
