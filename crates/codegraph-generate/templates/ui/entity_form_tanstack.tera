				<div class="space-y-2">
					<span class="text-sm font-medium">{% endraw %}{{ field.label }}{% if field.required %} <span class="text-destructive">*</span>{% endif %}{% raw %}</span>
					<ArrayField
						id="{% endraw %}{{ field.name }}{% raw %}"
						value={field.state.value}
						onvaluechange={(v: string[]) => field.handleChange(v)}
						label={% endraw %}{{ field.label_ts }}{% raw %}
						{% endraw %}{% if field.required %}required{% endif %}{% raw %}
						data-testid="{% endraw %}{{ field.name }}{% raw %}"
					/>
				</div>
			{/snippet}{% endraw %}
		</form.AppField>
{% else %}
		<form.AppField name="{{ field.name }}">
			{% raw %}{#snippet children(field)}
				<field.{% endraw %}{{ field.component }}{% raw %}
					label={% endraw %}{{ field.label_ts }}{% raw %}
					testid="{% endraw %}{{ field.testid }}{% raw %}"
					{% endraw %}{% if field.kind == "select" %}values={{ field.values_ts }}
					{% endif %}{% raw %}required={% endraw %}{{ field.required }}{% raw %}
					description={% endraw %}{{ field.description_ts }}{% raw %}
