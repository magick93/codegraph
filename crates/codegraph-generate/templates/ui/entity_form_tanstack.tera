			{/snippet}{% endraw %}
		</form.AppField>
{% endif %}
{% endfor %}

{% raw %}
		{#if form.state.errorMap.onSubmit}
{% endraw %}
		<form.Subscribe selector={(state) => state.errorMap.onSubmit}>
			{% raw %}{#snippet children(serverMessage)}
				{#if serverMessage}
					<div
						class="rounded-md bg-destructive/10 border border-destructive/20 p-4 text-sm text-destructive"
						role="alert"
						data-testid="{% endraw %}{{ tid.form }}{% raw %}-error"
					>
						{typeof serverMessage === 'string' ? serverMessage : 'Request failed'}
