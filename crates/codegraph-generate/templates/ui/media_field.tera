<!-- GENERATED by codegraph. DO NOT EDIT.
     Media fallback upload control (issue #630 PR-B). Transport-agnostic:
     the page supplies `upload` (the generated page wires its data.remote.ts
     command; consumers override — the AvatarPicker contract). -->
<script lang="ts">
  import {
    validateMediaFile,
    type MediaFieldSpec,
    type MediaUploadResult,
  } from './media';

  let {
    spec,
    upload,
    entityId,
    label = '',
  }: {
    spec: MediaFieldSpec;
    upload: (id: string, file: File) => Promise<MediaUploadResult>;
    entityId: string;
    label?: string;
  } = $props();

  let busy = $state(false);
  let error = $state<string | null>(null);

  async function onChange(event: Event) {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    const problem = validateMediaFile(file, spec);
    if (problem) {
      error = problem;
      return;
    }
    busy = true;
    error = null;
    try {
      await upload(entityId, file);
    } catch (e) {
      error = e instanceof Error ? e.message : String(e);
    } finally {
      busy = false;
    }
  }
</script>

{% raw %}
<div class="media-field" data-testid="media-{spec.field}">
  {#if label}
    <label for="media-{spec.field}-input">{label}</label>
  {/if}
  <input
    id="media-{spec.field}-input"
    data-testid="media-{spec.field}-input"
    type="file"
    accept={spec.accept.join(',')}
    disabled={busy}
    onchange={onChange}
  />
  {#if busy}
    <span data-testid="media-{spec.field}-busy">Uploading…</span>
  {/if}
  {#if error}
    <span data-testid="media-{spec.field}-error" role="alert">{error}</span>
  {/if}
</div>
{% endraw %}