<!-- GENERATED by codegraph. DO NOT EDIT.
     Media fallback upload control (issue #630 PR-B, display/remove #633).
     Transport-agnostic: the page supplies `upload` (the generated page wires
     its data.remote.ts command; consumers override — the AvatarPicker
     contract) and, when the reference is removable, `remove`. `initialUrl`
     is the server-resolved display URL (the media route 307s to a signed
     provider URL, followable server-side only); the upload result replaces
     it, and a successful remove clears it. -->
<script lang="ts">
  import {
    validateMediaFile,
    type MediaFieldSpec,
    type MediaUploadResult,
  } from './media';

  let {
    spec,
    upload,
    remove = undefined,
    entityId,
    initialUrl = null,
    label = '',
  }: {
    spec: MediaFieldSpec;
    upload: (id: string, file: File) => Promise<MediaUploadResult>;
    remove?: (id: string) => Promise<void>;
    entityId: string;
    initialUrl?: string | null;
    label?: string;
  } = $props();

  let busy = $state(false);
  let error = $state<string | null>(null);
  let currentUrl = $state<string | null>(initialUrl);

  async function onChange(event: Event) {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    input.value = '';
    if (!file) return;
    const problem = validateMediaFile(file, spec);
    if (problem) {
      error = problem;
      return;
    }
    busy = true;
    error = null;
    try {
      const stored = await upload(entityId, file);
      if (stored?.url) {
        currentUrl = stored.url;
      }
    } catch (e) {
      error = e instanceof Error ? e.message : String(e);
    } finally {
      busy = false;
    }
  }

  async function onRemove() {
    if (!remove) return;
    busy = true;
    error = null;
    try {
      await remove(entityId);
      currentUrl = null;
    } catch (e) {
      error = e instanceof Error ? e.message : String(e);
    } finally {
      busy = false;
    }
  }
</script>

{% raw %}
<div class="media-field" data-testid="media-{spec.field}">
  {#if label}
    <label for="media-{spec.field}-input">{label}</label>
  {/if}
  <input
    id="media-{spec.field}-input"
    data-testid="media-{spec.field}-input"
    type="file"
    accept={spec.accept.join(',')}
    disabled={busy}
    onchange={onChange}
  />
  {#if busy}
    <span data-testid="media-{spec.field}-busy">Uploading…</span>
  {/if}
  {#if error}
    <span data-testid="media-{spec.field}-error" role="alert">{error}</span>
  {/if}
  {#if currentUrl}
    <img
      class="media-preview"
      data-testid="media-{spec.field}-display"
      src={currentUrl}
      alt={label || spec.field}
    />
    {#if remove}
      <button
        type="button"
        data-testid="media-{spec.field}-remove"
        disabled={busy}
        onclick={onRemove}
      >
        Remove
      </button>
    {/if}
  {/if}
</div>
{% endraw %}
