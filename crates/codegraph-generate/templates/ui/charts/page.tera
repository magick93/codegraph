{% if chart.kind == "pie" or chart.kind == "radar" or chart.kind == "line" or chart.kind == "bar" %}
	function firstValue(point: { values: Record<string, number | null> }): number {
		const v = Object.values(point.values)[0];
		return typeof v === 'number' ? v : 0;
	}

	const points = $derived(data.series ?? []);
