				const angle = (2 * Math.PI * i) / series.length - Math.PI / 2;
				const v = Math.max(0, firstValue(p)) / max;
				return `${cx + r * v * Math.cos(angle)},${cy + r * v * Math.sin(angle)}`;
			})
			.join(' ');
	}

	const radar = $derived(radarPoints(points, maxV));
{% endif %}
{% if chart.kind == "line" %}
	function linePoints(series: typeof points, max: number): string {
