{% endif %}
{% if chart.kind == "pie" %}
	const PIE_COLORS = [
		'#4f46e5', '#0ea5e9', '#10b981', '#f59e0b', '#ef4444',
		'#8b5cf6', '#ec4899', '#14b8a6', '#f97316', '#64748b',
	];

	function pieStops(series: typeof points, total: number): string {
		let acc = 0;
		const stops: string[] = [];
		for (let i = 0; i < series.length; i++) {
			const share = total === 0 ? 0 : (Math.max(0, firstValue(series[i])) / total) * 100;
			const from = acc;
			acc += share;
			const color = PIE_COLORS[i % PIE_COLORS.length];
			stops.push(`${color} ${from}% ${acc}%`);
		}
		return stops.join(', ');
	}

	const total = $derived(points.reduce((acc, p) => acc + Math.max(0, firstValue(p)), 0));
	const stops = $derived(pieStops(points, total));
{% endif %}
{% if chart.kind == "radar" %}
	function radarPoints(series: typeof points, max: number): string {
		if (series.length < 3) return '';
		const cx = 100;
		const cy = 100;
		const r = 80;
		return series
