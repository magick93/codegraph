//! GENERATED by codegraph. DO NOT EDIT.
//! Media field validation + shared types (issue #630 PR-B). The fallback
//! upload control is transport-agnostic: the PAGE supplies the `upload`
//! callback (the generated page wires its data.remote.ts command; consumers
//! override with their own uploader — the `@crewbase/ui/AvatarPicker`
//! contract, memo R6 tiering).

export interface MediaFieldSpec {
  /** The contained-value feature (snake) — also the testid namespace. */
  field: string;
  /** Accepted mime types (`type/subtype` or `type/*`). */
  accept: string[];
  /** Hard byte cap — mirrors the API's config `max_bytes`. */
  maxBytes: number;
}

export interface MediaUploadResult {
  key: string;
  url?: string;
}

function mimeMatches(mime: string, patterns: string[]): boolean {
  return patterns.some((pattern) =>
    pattern.endsWith('/*') ? mime.startsWith(pattern.slice(0, -1)) : mime === pattern,
  );
}

/** Pre-flight validation mirroring the API route's checks (415/413). */
export function validateMediaFile(file: File, spec: MediaFieldSpec): string | null {
  if (!mimeMatches(file.type || 'application/octet-stream', spec.accept)) {
    return `mime type ${file.type || 'unknown'} is not accepted (allowed: ${spec.accept.join(', ')})`;
  }
  if (file.size > spec.maxBytes) {
    return `file exceeds ${spec.maxBytes} bytes`;
  }
  return null;
}
