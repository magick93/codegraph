-- Policy-derived row level security — generated by {{ project.generator_name }}. DO NOT EDIT.
--
-- Source: the rexlang actor policy graph (the `.actor` policy ingested with
-- the IFML model). ADDITIVE with the domains.toml-driven RLS in the
-- per-entity `{schema}_{table}_rls.sql` migrations: Postgres OR-combines
-- PERMISSIVE policies, so these grants can only widen access; the
-- RESTRICTIVE org-isolation/scope/role policies AND on top unchanged.
-- `forbid` grants are emitted as REVOKE (auditable privilege removal, not
-- row filtering).
--
-- Role mapping: human actors become NOLOGIN group roles (snake_case);
-- agent actors map to the existing gateway role app_user (they never hold
-- DB credentials). Attach a human role to a login user with
-- `GRANT <role> TO <user>` to activate its policies.
{% if roles %}
-- Policy roles (human actors)
{% for role in roles %}
DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '{{ role }}') THEN
    CREATE ROLE "{{ role }}" NOLOGIN;
  END IF;
END $$;
{% endfor %}
{% endif %}
{% for t in tables %}
{% for cap in t.capabilities %}
-- capability `{{ cap.name }}` (class {{ cap.class }}) on {{ t.schema }}.{{ t.table }}
{% if cap.forbid_roles %}
REVOKE ALL ON TABLE {{ t.schema }}.{{ t.table }} FROM {{ cap.forbid_roles | join(sep=", ") }};
{% endif %}
{% if cap.permit_roles %}
CREATE POLICY "{{ cap.policy_name }}" ON {{ t.schema }}.{{ t.table }}
  FOR ALL TO {{ cap.permit_roles | join(sep=", ") }}
  USING ({{ cap.using_sql }})
  WITH CHECK ({{ cap.using_sql }});
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE {{ t.schema }}.{{ t.table }} TO {{ cap.permit_roles | join(sep=", ") }};
{% endif %}
{% endfor %}
{% endfor %}
