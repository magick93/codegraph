-- Machine kernel seed (issue #816, Lane 2 of epic #812).
-- Upserts platform.workflow_definition with the machine kernel ENVELOPE:
-- the canonical xstate-ir Machine (the ONE transition decision-maker both
-- planes share), its FNV-1a content hash (the drift-detection discipline —
-- a row whose recorded hash stops matching its machine JSON is a NAMED
-- hard error, never a silent re-decision on a changed machine), and the
-- engine-level layers (data guards, timers, dual-status guards) whose
-- evaluators register as NAMED kernel guards.
--
-- The same file carries the WRITE-BOTH reconciliation step (issue #816
-- Decision 3, the #700 backfill pattern): each entity's status column is
-- pulled back into agreement with its workflow instance — idempotent, and
-- a fixed point after the first run.
--
-- 0006 (the legacy shape) stays byte-identical so deployments that already
-- recorded it never see a changed tracked file (#756). This file upgrades
-- the definition rows after it.
-- Generated by {{ project.generator_name }}. DO NOT EDIT.

{% for entry in entries %}
INSERT INTO platform.workflow_definition (
    tenant_id, name, domain, entity_table, status_field,
    approval_status_field, initial_state, terminal_states,
    state_machine, version
) VALUES (
    '00000000-0000-0000-0000-000000000000',
    '{{ entry.name }}',
    '{{ entry.domain }}',
    '{{ entry.entity_table }}',
    '{{ entry.status_field }}',
    {% if entry.approval_status_field %}'{{ entry.approval_status_field }}'{% else %}NULL{% endif %},
    '{{ entry.initial_state }}',
    ARRAY[{% for ts in entry.terminal_states %}'{{ ts }}'{% if not loop.last %}, {% endif %}{% endfor %}]::TEXT[],
    $${{ entry.machine_envelope_json }}$$::JSONB,
    1
) ON CONFLICT (tenant_id, domain, entity_table, version) DO UPDATE SET
    status_field = EXCLUDED.status_field,
    approval_status_field = EXCLUDED.approval_status_field,
    initial_state = EXCLUDED.initial_state,
    terminal_states = EXCLUDED.terminal_states,
    state_machine = EXCLUDED.state_machine,
    updated_at = now();

-- Write-both reconciliation: the entity's workflow-managed column moves to
-- the instance's current state wherever the two disagree. Parked
-- (`pending_approval:from->to`) instances never reconcile — the column
-- stays at the transition's origin state.
UPDATE "{{ entry.domain }}"."{{ entry.entity_table }}" AS e
SET "{{ entry.status_field }}" = wi.current_state
FROM platform.workflow_instance wi
JOIN platform.workflow_definition wd ON wi.definition_id = wd.id
WHERE wd.domain = '{{ entry.domain }}'
  AND wd.entity_table = '{{ entry.entity_table }}'
  AND wd.is_active = true
  AND wi.current_state NOT LIKE 'pending_approval:%'
  AND e.id = wi.entity_id
  AND e."{{ entry.status_field }}" IS DISTINCT FROM wi.current_state;
{% endfor %}
