-- RLS policies for {{ schema_name }}.{{ table_name }}
-- Generated by {{ project.generator_name }}. DO NOT EDIT.
--
-- Uses get_current_org_id() which reads app.organization_id session var.
-- This is set by the Axum middleware for BOTH API key and JWT auth,
-- so one policy set works for all auth modes.

ALTER TABLE {{ schema_name }}.{{ table_name | quote_pg }} ENABLE ROW LEVEL SECURITY;
ALTER TABLE {{ schema_name }}.{{ table_name | quote_pg }} FORCE ROW LEVEL SECURITY;

-- Drop all existing policies (clean slate on regeneration)
DO $$ DECLARE pol RECORD; BEGIN
  FOR pol IN SELECT policyname FROM pg_policies
    WHERE schemaname = '{{ schema_name }}' AND tablename = '{{ table_name }}'
  LOOP
    EXECUTE format('DROP POLICY IF EXISTS %I ON {{ schema_name }}.{{ table_name | quote_pg }}', pol.policyname);
  END LOOP;
END $$;

-- Org isolation: SELECT
CREATE POLICY "org_isolation_select" ON {{ schema_name }}.{{ table_name | quote_pg }}
  FOR SELECT
  USING ((platform_organization_id = public.get_current_org_id()
    OR platform_organization_id = '00000000-0000-0000-0000-000000000000'::uuid));

-- Org isolation: INSERT
CREATE POLICY "org_isolation_insert" ON {{ schema_name }}.{{ table_name | quote_pg }}
  FOR INSERT
  WITH CHECK ((platform_organization_id = public.get_current_org_id()
    OR platform_organization_id = '00000000-0000-0000-0000-000000000000'::uuid));

-- Org isolation: UPDATE
CREATE POLICY "org_isolation_update" ON {{ schema_name }}.{{ table_name | quote_pg }}
  FOR UPDATE
  USING ((platform_organization_id = public.get_current_org_id()
    OR platform_organization_id = '00000000-0000-0000-0000-000000000000'::uuid))
  WITH CHECK ((platform_organization_id = public.get_current_org_id()
    OR platform_organization_id = '00000000-0000-0000-0000-000000000000'::uuid));

-- Org isolation: DELETE
CREATE POLICY "org_isolation_delete" ON {{ schema_name }}.{{ table_name | quote_pg }}
  FOR DELETE
  USING ((platform_organization_id = public.get_current_org_id()
    OR platform_organization_id = '00000000-0000-0000-0000-000000000000'::uuid));
{% if is_auditable %}
-- Scope enforcement (#169): RESTRICTIVE policies AND-combine with the
-- org-isolation policies above for app_user AND api_key sessions, in both
-- pool modes (app_user pool and legacy SET LOCAL ROLE). API-key sessions
-- must hold a scope matching this entity: without one the policy raises
-- P0403 INSUFFICIENT_SCOPE (mapped to HTTP 403) instead of silently
-- filtering every row. JWT sessions pass through — tenancy only.
CREATE POLICY "scope_enforced_select" ON {{ schema_name }}.{{ table_name | quote_pg }}
  AS RESTRICTIVE FOR SELECT TO app_user, api_key
  USING (public.enforce_api_key_scope('{{ resource_name }}', {{ primary_key }}::text, 'read'));

CREATE POLICY "scope_enforced_insert" ON {{ schema_name }}.{{ table_name | quote_pg }}
  AS RESTRICTIVE FOR INSERT TO app_user, api_key
  WITH CHECK (public.enforce_api_key_scope('{{ resource_name }}', '*', 'create'));

CREATE POLICY "scope_enforced_update" ON {{ schema_name }}.{{ table_name | quote_pg }}
  AS RESTRICTIVE FOR UPDATE TO app_user, api_key
  USING (public.enforce_api_key_scope('{{ resource_name }}', {{ primary_key }}::text, 'update'))
  WITH CHECK (public.enforce_api_key_scope('{{ resource_name }}', {{ primary_key }}::text, 'update'));

CREATE POLICY "scope_enforced_delete" ON {{ schema_name }}.{{ table_name | quote_pg }}
  AS RESTRICTIVE FOR DELETE TO app_user, api_key
  USING (public.enforce_api_key_scope('{{ resource_name }}', {{ primary_key }}::text, 'delete'));
{% endif %}
{% if role_enforced %}
-- Role enforcement (#169): minimum-role gates move into the database. The
-- caller's org role rides the request context bundle (`app.role`, resolved
-- once at auth time); `role_at_least` ranks it against the configured
-- `[rbac] roles_hierarchy` (defaults below) and raises P0403 ROLE_FORBIDDEN
-- → HTTP 403 on denial. API-key sessions pass through here (scopes above);
-- entities without permission config keep tenancy-only behaviour.
{% for min in role_minima %}
{% if min.operation == "read" %}
CREATE POLICY "role_enforced_select" ON {{ schema_name }}.{{ table_name | quote_pg }}
  AS RESTRICTIVE FOR SELECT TO app_user, api_key
  USING (public.role_at_least('{{ min.min_role }}'));
{% elif min.operation == "create" %}
CREATE POLICY "role_enforced_insert" ON {{ schema_name }}.{{ table_name | quote_pg }}
  AS RESTRICTIVE FOR INSERT TO app_user, api_key
  WITH CHECK (public.role_at_least('{{ min.min_role }}'));
{% elif min.operation == "update" %}
CREATE POLICY "role_enforced_update" ON {{ schema_name }}.{{ table_name | quote_pg }}
  AS RESTRICTIVE FOR UPDATE TO app_user, api_key
  USING (public.role_at_least('{{ min.min_role }}'))
  WITH CHECK (public.role_at_least('{{ min.min_role }}'));
{% elif min.operation == "delete" %}
CREATE POLICY "role_enforced_delete" ON {{ schema_name }}.{{ table_name | quote_pg }}
  AS RESTRICTIVE FOR DELETE TO app_user, api_key
  USING (public.role_at_least('{{ min.min_role }}'));
{% endif %}
{% endfor %}
{% endif %}
{% if user_scope_column %}
-- Per-row user scoping (#169, config: permissions.user_scope_column).
-- The column is auto-stamped from `app.user_id` on INSERT; reads of
-- non-null rows are limited to the owning user unless the caller's role
-- ranks above "member" (managers, admins, …).
ALTER TABLE {{ schema_name }}.{{ table_name | quote_pg }}
    ADD COLUMN IF NOT EXISTS {{ user_scope_column | quote_pg }} UUID;

CREATE OR REPLACE FUNCTION {{ schema_name }}.{{ table_name }}_set_req_user_id()
RETURNS TRIGGER AS $$
DECLARE
    v_user_id uuid;
BEGIN
    v_user_id := nullif(current_setting('app.user_id', true), '')::uuid;
    IF v_user_id IS NOT NULL AND v_user_id != '00000000-0000-0000-0000-000000000000'::uuid THEN
        NEW.{{ user_scope_column | quote_pg }} := v_user_id;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS trg_{{ table_name }}_set_req_user_id ON {{ schema_name }}.{{ table_name | quote_pg }};
CREATE TRIGGER trg_{{ table_name }}_set_req_user_id
    BEFORE INSERT ON {{ schema_name }}.{{ table_name | quote_pg }}
    FOR EACH ROW
    EXECUTE FUNCTION {{ schema_name }}.{{ table_name }}_set_req_user_id();

CREATE POLICY "user_scope_enforced_select" ON {{ schema_name }}.{{ table_name | quote_pg }}
  AS RESTRICTIVE FOR SELECT TO app_user, api_key
  USING ({{ user_scope_column | quote_pg }} IS NULL
    OR {{ user_scope_column | quote_pg }} = nullif(current_setting('app.user_id', true), '')::uuid
    OR public.role_rank(coalesce(current_setting('app.role', true), '')) < public.role_rank('member'));
{% endif %}

-- Schema + table privileges for app_user and api_key (RLS policies only
-- filter rows; these grants enable access). Idempotent, so it's safe to
-- emit from every entity migration in a domain.
-- ALL TABLES covers child tables (created by the entity migration before
-- this file runs); ALTER DEFAULT PRIVILEGES covers tables created later.
GRANT USAGE ON SCHEMA {{ schema_name }} TO app_user, api_key;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA {{ schema_name }} TO app_user, api_key;
ALTER DEFAULT PRIVILEGES IN SCHEMA {{ schema_name }}
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_user, api_key;

