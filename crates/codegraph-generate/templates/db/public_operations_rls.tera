-- Public-operations row level security — generated by {{ project.generator_name }}. DO NOT EDIT.
--
-- Source: the per-definition access flag (`access = Public`, issue #279)
-- combined with the entity's `public_operations` config — the deferred
-- #169 Q3 gap (public route mounting + PUBLIC RLS policies), derived from
-- the model instead of hand-written config.
--
-- ADDITIVE with the domains.toml-driven RLS in the per-entity
-- `{schema}_{table}_rls.sql` migrations: these policies are PERMISSIVE and
-- Postgres OR-combines permissive policies, so they can only widen access;
-- the RESTRICTIVE org-isolation/scope/role policies AND on top unchanged.
-- A `TO PUBLIC` policy can therefore never bypass a restrictive policy.
--
-- Only entities whose ENTIRE operation set is public also skip the route
-- permission layers (see `route_auth_is_public` in the router generator).
{% for t in tables %}
{% for p in t.policies %}
-- public `{{ p.operation }}` on {{ t.schema }}.{{ t.table }}
CREATE POLICY "{{ p.policy_name }}" ON {{ t.schema }}.{{ t.table }}
  FOR {{ p.action }} TO PUBLIC{% if p.needs_using %}
  USING (true){% endif %}{% if p.needs_check %}
  WITH CHECK (true){% endif %};
{% endfor %}
GRANT {{ t.actions | join(sep=", ") }} ON TABLE {{ t.schema }}.{{ t.table }} TO app_user;
{% endfor %}
