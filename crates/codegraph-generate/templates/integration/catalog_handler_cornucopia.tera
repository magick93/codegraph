//! Integration catalog and installation management handlers (cornucopia
//! provider — gateway slice).
//! Generated by {{ project.generator_name }}. DO NOT EDIT.
//!
//! Cornucopia equivalent of the monolith `integration_catalog.rs`: queries
//! run through the per-request `DbClient` (cornucopia `GenericClient`) from
//! the host worker's client source instead of SeaORM. RLS session vars are
//! set on the same client via `set_config` — mirroring the worker webhook
//! API — so the `platform_integrations` policies (keyed on
//! `public.get_current_org_id()`) bind for the gateway-served requests.

use axum::extract::{Path, State};
use axum::http::StatusCode;
use axum::Json;
use cornucopia_queries::client::GenericClient;
use uuid::Uuid;

use crate::app_state::AppState;
use crate::error::AppError;
use crate::middleware::AuthInfo;

/// Scope the current connection to the caller's organization via RLS.
async fn set_org(client: &impl GenericClient, organization_id: Uuid) -> Result<(), AppError> {
    client
        .execute(
            "SELECT set_config('app.organization_id', $1, true)",
            &[&organization_id.to_string()],
        )
        .await
        .map_err(|e| AppError::internal(format!("Failed to scope connection: {e}")))?;
    Ok(())
}

/// Acquire the per-request database client from the host's client source.
async fn db_client(state: &AppState) -> Result<impl GenericClient, AppError> {
    state
        .client_source
        .client()
        .await
        .map_err(|e| AppError::internal(format!("Failed to acquire database client: {e}")))
}

/// List all available integrations in the catalog.
#[utoipa::path(
    get,
    path = "/api/{{ project.api_version }}/integrations/catalog",
    tag = "Integrations",
    responses(
        (status = 200, description = "OK"),
    )
)]
pub async fn list_catalog(
    State(state): State<AppState>,
) -> Result<Json<serde_json::Value>, AppError> {
    let client = db_client(&state).await?;
    let rows = client
        .query(
            "SELECT id, name, vendor, version, description, extension_point_id, tier, categories, markets, enabled
             FROM platform_integrations.catalog WHERE enabled = TRUE ORDER BY name",
            &[],
        )
        .await
        .map_err(|e| AppError::internal(format!("Failed to list catalog: {e}")))?;

    let items: Vec<serde_json::Value> = rows.iter().map(|r| {
        serde_json::json!({
            "id": r.try_get::<_, String>(0).unwrap_or_default(),
            "name": r.try_get::<_, String>(1).unwrap_or_default(),
            "vendor": r.try_get::<_, String>(2).unwrap_or_default(),
            "version": r.try_get::<_, String>(3).unwrap_or_default(),
            "description": r.try_get::<_, Option<String>>(4).unwrap_or_default(),
            "extension_point_id": r.try_get::<_, String>(5).unwrap_or_default(),
            "tier": r.try_get::<_, String>(6).unwrap_or_default(),
        })
    }).collect();

    Ok(Json(serde_json::json!({ "data": items })))
}

/// List installations for the current tenant.
#[utoipa::path(
    get,
    path = "/api/{{ project.api_version }}/integrations/installations",
    tag = "Integrations",
    responses(
        (status = 200, description = "OK"),
    )
)]
pub async fn list_installations(
    State(state): State<AppState>,
    axum::extract::Extension(auth): axum::extract::Extension<AuthInfo>,
) -> Result<Json<serde_json::Value>, AppError> {
    let client = db_client(&state).await?;
    set_org(&client, auth.organization_id).await?;
    let rows = client
        .query(
            "SELECT i.id, i.catalog_id, i.extension_point_id, i.status, i.installed_at::text,
                    c.name, c.vendor
             FROM platform_integrations.installations i
             JOIN platform_integrations.catalog c ON c.id = i.catalog_id
             WHERE i.platform_organization_id = $1
             ORDER BY i.installed_at DESC",
            &[&auth.organization_id],
        )
        .await
        .map_err(|e| AppError::internal(format!("Failed to list installations: {e}")))?;

    let items: Vec<serde_json::Value> = rows.iter().map(|r| {
        serde_json::json!({
            "id": r.try_get::<_, Uuid>(0).unwrap_or_default().to_string(),
            "catalog_id": r.try_get::<_, String>(1).unwrap_or_default(),
            "extension_point_id": r.try_get::<_, String>(2).unwrap_or_default(),
            "status": r.try_get::<_, String>(3).unwrap_or_default(),
            "installed_at": r.try_get::<_, String>(4).unwrap_or_default(),
            "name": r.try_get::<_, String>(5).unwrap_or_default(),
            "vendor": r.try_get::<_, String>(6).unwrap_or_default(),
        })
    }).collect();

    Ok(Json(serde_json::json!({ "data": items })))
}

/// Install an integration for the current tenant.
#[derive(serde::Deserialize, utoipa::ToSchema)]
pub struct InstallRequest {
    pub catalog_id: String,
    pub settings: Option<serde_json::Value>,
    /// Optional HMAC-SHA256 signing secret for event delivery (issue #511,
    /// provisionable via the API since #552 — no raw SQL). NULL/omitted ⇒
    /// unsigned delivery.
    pub signing_secret: Option<String>,
}

#[utoipa::path(
    post,
    path = "/api/{{ project.api_version }}/integrations/installations",
    tag = "Integrations",
    request_body = InstallRequest,
    responses(
        (status = 201, description = "Created"),
        (status = 404, description = "Not found"),
    )
)]
pub async fn install_integration(
    State(state): State<AppState>,
    axum::extract::Extension(auth): axum::extract::Extension<AuthInfo>,
    Json(body): Json<InstallRequest>,
) -> Result<(StatusCode, Json<serde_json::Value>), AppError> {
    let client = db_client(&state).await?;
    set_org(&client, auth.organization_id).await?;

    let catalog_row = client
        .query_opt(
            "SELECT extension_point_id FROM platform_integrations.catalog WHERE id = $1 AND enabled = TRUE",
            &[&body.catalog_id],
        )
        .await
        .map_err(|e| AppError::internal(format!("Catalog lookup failed: {e}")))?
        .ok_or_else(|| AppError::not_found("Integration not found in catalog"))?;

    let extension_point_id: String = catalog_row
        .try_get(0)
        .map_err(|e| AppError::internal(format!("Parse error: {e}")))?;

    let row = client
        .query_one(
            "INSERT INTO platform_integrations.installations (platform_organization_id, catalog_id, extension_point_id, status, installed_by, signing_secret)
             VALUES ($1, $2, $3, 'active', $4, $5)
             RETURNING id",
            &[&auth.organization_id, &body.catalog_id, &extension_point_id, &auth.user_id, &body.signing_secret],
        )
        .await
        .map_err(|e| AppError::internal(format!("Install failed: {e}")))?;

    let installation_id: Uuid = row
        .try_get(0)
        .map_err(|e| AppError::internal(format!("Parse error: {e}")))?;

    let settings = body.settings.unwrap_or_else(|| serde_json::json!({}));
    let _ = client
        .execute(
            "INSERT INTO platform_integrations.installation_settings (installation_id, platform_organization_id, settings)
             VALUES ($1, $2, $3)",
            &[&installation_id, &auth.organization_id, &settings],
        )
        .await;

    Ok((StatusCode::CREATED, Json(serde_json::json!({
        "data": { "id": installation_id.to_string(), "status": "active" }
    }))))
}

/// Uninstall an integration.
#[utoipa::path(
    delete,
    path = "/api/{{ project.api_version }}/integrations/installations/{id}",
    tag = "Integrations",
    params(("id" = Uuid, Path, description = "Installation ID")),
    responses(
        (status = 204, description = "No content"),
        (status = 404, description = "Not found"),
    )
)]
pub async fn uninstall_integration(
    State(state): State<AppState>,
    axum::extract::Extension(auth): axum::extract::Extension<AuthInfo>,
    Path(installation_id): Path<Uuid>,
) -> Result<StatusCode, AppError> {
    let client = db_client(&state).await?;
    set_org(&client, auth.organization_id).await?;
    let affected = client
        .execute(
            "DELETE FROM platform_integrations.installations WHERE id = $1 AND platform_organization_id = $2",
            &[&installation_id, &auth.organization_id],
        )
        .await
        .map_err(|e| AppError::internal(format!("Uninstall failed: {e}")))?;

    if affected == 0 {
        return Err(AppError::not_found("Installation not found"));
    }

    Ok(StatusCode::NO_CONTENT)
}

/// Get a single catalog entry by ID.
pub async fn get_catalog_entry(
    State(state): State<AppState>,
    Path(catalog_id): Path<String>,
) -> Result<Json<serde_json::Value>, AppError> {
    let client = db_client(&state).await?;
    let row = client
        .query_opt(
            "SELECT id, name, vendor, version, description, extension_point_id, tier,
                    categories, markets, config_schema, permissions, data_flows
             FROM platform_integrations.catalog WHERE id = $1 AND enabled = TRUE",
            &[&catalog_id],
        )
        .await
        .map_err(|e| AppError::internal(format!("Catalog lookup failed: {e}")))?
        .ok_or_else(|| AppError::not_found("Catalog entry not found"))?;

    let item = serde_json::json!({
        "id": row.try_get::<_, String>(0).unwrap_or_default(),
        "name": row.try_get::<_, String>(1).unwrap_or_default(),
        "vendor": row.try_get::<_, String>(2).unwrap_or_default(),
        "version": row.try_get::<_, String>(3).unwrap_or_default(),
        "description": row.try_get::<_, Option<String>>(4).unwrap_or_default(),
        "extension_point_id": row.try_get::<_, String>(5).unwrap_or_default(),
        "tier": row.try_get::<_, String>(6).unwrap_or_default(),
        "categories": row.try_get::<_, serde_json::Value>(7).unwrap_or(serde_json::json!([])),
        "markets": row.try_get::<_, serde_json::Value>(8).unwrap_or(serde_json::json!([])),
        "config_schema": row.try_get::<_, serde_json::Value>(9).unwrap_or(serde_json::json!([])),
        "permissions": row.try_get::<_, serde_json::Value>(10).unwrap_or(serde_json::json!([])),
        "data_flows": row.try_get::<_, serde_json::Value>(11).unwrap_or(serde_json::json!([])),
    });

    Ok(Json(serde_json::json!({ "data": item })))
}

/// Get a single installation by ID with settings and catalog metadata.
pub async fn get_installation(
    State(state): State<AppState>,
    axum::extract::Extension(auth): axum::extract::Extension<AuthInfo>,
    Path(installation_id): Path<Uuid>,
) -> Result<Json<serde_json::Value>, AppError> {
    let client = db_client(&state).await?;
    set_org(&client, auth.organization_id).await?;
    let row = client
        .query_opt(
            "SELECT i.id, i.catalog_id, i.extension_point_id, i.status, i.installed_at::text,
                    c.name, c.vendor, c.version, c.description, c.tier,
                    c.config_schema, c.permissions, c.data_flows,
                    s.settings
             FROM platform_integrations.installations i
             JOIN platform_integrations.catalog c ON c.id = i.catalog_id
             LEFT JOIN platform_integrations.installation_settings s ON s.installation_id = i.id
             WHERE i.id = $1 AND i.platform_organization_id = $2",
            &[&installation_id, &auth.organization_id],
        )
        .await
        .map_err(|e| AppError::internal(format!("Installation lookup failed: {e}")))?
        .ok_or_else(|| AppError::not_found("Installation not found"))?;

    let item = serde_json::json!({
        "id": row.try_get::<_, Uuid>(0).unwrap_or_default().to_string(),
        "catalog_id": row.try_get::<_, String>(1).unwrap_or_default(),
        "extension_point_id": row.try_get::<_, String>(2).unwrap_or_default(),
        "status": row.try_get::<_, String>(3).unwrap_or_default(),
        "installed_at": row.try_get::<_, String>(4).unwrap_or_default(),
        "name": row.try_get::<_, String>(5).unwrap_or_default(),
        "vendor": row.try_get::<_, String>(6).unwrap_or_default(),
        "version": row.try_get::<_, String>(7).unwrap_or_default(),
        "description": row.try_get::<_, Option<String>>(8).unwrap_or_default(),
        "tier": row.try_get::<_, String>(9).unwrap_or_default(),
        "config_schema": row.try_get::<_, serde_json::Value>(10).unwrap_or(serde_json::json!([])),
        "permissions": row.try_get::<_, serde_json::Value>(11).unwrap_or(serde_json::json!([])),
        "data_flows": row.try_get::<_, serde_json::Value>(12).unwrap_or(serde_json::json!([])),
        "settings": row.try_get::<_, serde_json::Value>(13).unwrap_or(serde_json::json!({})),
    });

    Ok(Json(serde_json::json!({ "data": item })))
}

/// Update settings for an installation (partial JSONB merge).
pub async fn update_installation_settings(
    State(state): State<AppState>,
    axum::extract::Extension(auth): axum::extract::Extension<AuthInfo>,
    Path(installation_id): Path<Uuid>,
    Json(body): Json<serde_json::Value>,
) -> Result<Json<serde_json::Value>, AppError> {
    let client = db_client(&state).await?;
    set_org(&client, auth.organization_id).await?;

    // Verify installation belongs to tenant
    let _installation = client
        .query_opt(
            "SELECT id FROM platform_integrations.installations WHERE id = $1 AND platform_organization_id = $2",
            &[&installation_id, &auth.organization_id],
        )
        .await
        .map_err(|e| AppError::internal(format!("Installation lookup failed: {e}")))?
        .ok_or_else(|| AppError::not_found("Installation not found"))?;

    // JSONB merge: existing settings || new settings
    let _ = client
        .execute(
            "UPDATE platform_integrations.installation_settings
             SET settings = settings || $1, updated_at = NOW()
             WHERE installation_id = $2 AND platform_organization_id = $3",
            &[&body, &installation_id, &auth.organization_id],
        )
        .await
        .map_err(|e| AppError::internal(format!("Settings update failed: {e}")))?;

    Ok(Json(serde_json::json!({ "data": { "id": installation_id.to_string(), "settings": body } })))
}

/// Provision (or clear) the HMAC signing secret for an installation
/// (issue #511 rider, API-provisionable since #552 — no raw SQL). The
/// dispatcher SELECTs `i.signing_secret` fresh on every dispatch, so the
/// next dispatch picks the new value up. The secret itself is never
/// echoed back.
#[derive(serde::Deserialize, utoipa::ToSchema)]
pub struct SigningSecretRequest {
    /// The new secret, or null to clear it (unsigned delivery).
    pub signing_secret: Option<String>,
}

#[utoipa::path(
    put,
    path = "/api/{{ project.api_version }}/integrations/installations/{id}/signing-secret",
    tag = "Integrations",
    request_body = SigningSecretRequest,
    params(("id" = Uuid, Path, description = "Installation ID")),
    responses(
        (status = 200, description = "OK"),
        (status = 404, description = "Not found"),
    )
)]
pub async fn set_signing_secret(
    State(state): State<AppState>,
    axum::extract::Extension(auth): axum::extract::Extension<AuthInfo>,
    Path(installation_id): Path<Uuid>,
    Json(body): Json<SigningSecretRequest>,
) -> Result<Json<serde_json::Value>, AppError> {
    let client = db_client(&state).await?;
    set_org(&client, auth.organization_id).await?;

    let provisioned = body.signing_secret.is_some();
    let affected = client
        .execute(
            "UPDATE platform_integrations.installations
             SET signing_secret = $1
             WHERE id = $2 AND platform_organization_id = $3",
            &[&body.signing_secret, &installation_id, &auth.organization_id],
        )
        .await
        .map_err(|e| AppError::internal(format!("Signing secret update failed: {e}")))?;

    if affected == 0 {
        return Err(AppError::not_found("Installation not found"));
    }

    Ok(Json(serde_json::json!({
        "data": { "id": installation_id.to_string(), "signing_secret_set": provisioned }
    })))
}

