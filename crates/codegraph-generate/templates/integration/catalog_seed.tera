-- Integration catalog seed (issue #552).
-- Generated by {{ project.generator_name }} from --integration-manifests. DO NOT EDIT.
--
-- The declarative replacement for hand-written catalog bootstrap SQL:
-- one idempotent upsert per manifest entry (a changed manifest re-seeds
-- cleanly), plus the optional demo installations. `manifest_hash` records
-- which manifest revision produced the row.

{% for row in catalog %}
INSERT INTO platform_integrations.catalog (id, name, vendor, version, description, extension_point_id, tier, categories, markets, manifest_hash, worker_url, enabled)
VALUES (
    {{ row.id | dollar_quote }},
    {{ row.name | dollar_quote }},
    {{ row.vendor | dollar_quote }},
    {{ row.version | dollar_quote }},
    {{ row.description | dollar_quote }},
    {{ row.extension_point | dollar_quote }},
    {{ row.tier | dollar_quote }},
    ARRAY[{% for c in row.categories %}{{ c | dollar_quote }}{% if not loop.last %}, {% endif %}{% endfor %}],
    ARRAY[{% for m in row.markets %}{{ m | dollar_quote }}{% if not loop.last %}, {% endif %}{% endfor %}],
    {{ row.manifest_hash | dollar_quote }},
    {% if row.worker_url %}{{ row.worker_url | dollar_quote }}{% else %}NULL{% endif %},
    {% if row.enabled %}TRUE{% else %}FALSE{% endif %}
) ON CONFLICT (id) DO UPDATE SET
    name = EXCLUDED.name,
    vendor = EXCLUDED.vendor,
    version = EXCLUDED.version,
    description = EXCLUDED.description,
    extension_point_id = EXCLUDED.extension_point_id,
    tier = EXCLUDED.tier,
    categories = EXCLUDED.categories,
    markets = EXCLUDED.markets,
    manifest_hash = EXCLUDED.manifest_hash,
    worker_url = EXCLUDED.worker_url,
    enabled = EXCLUDED.enabled;
{% endfor %}
{% for inst in installations %}
INSERT INTO platform_integrations.installations (platform_organization_id, catalog_id, extension_point_id, status)
VALUES (
    {{ inst.organization_id | dollar_quote }}::uuid,
    {{ inst.catalog_id | dollar_quote }},
    {{ inst.extension_point | dollar_quote }},
    {{ inst.status | dollar_quote }}
) ON CONFLICT (platform_organization_id, catalog_id) DO NOTHING;
{% endfor %}
