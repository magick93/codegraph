fn mime_matches(mime: &str, patterns: &[&str]) -> bool {
    patterns.iter().any(|pattern| {
        if pattern.ends_with("/*") {
            let prefix = &pattern[..pattern.len() - 1];
            mime.starts_with(prefix)
        } else {
            mime == *pattern
        }
    })
}

/// SQL literal escaping (the generated plane's raw-SQL convention — the
/// webhook JSONB workaround precedent). Keys are config+uuid-derived but
/// mime types arrive from request headers, so escape everything.
fn esc(s: &str) -> String {
    s.replace('\'', "''")
}

