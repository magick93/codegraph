//! Media data-plane handlers for {{ entity_name }}.{{ media_field_name }}.
//! Generated by {{ project.generator_name }}. DO NOT EDIT.
//!
//! Issue #625 PR-C: the app-plane data path for upload modes that need one
//! (`{% if mode_presigned %}presigned{% else %}through-app{% endif %}`).
//! Every request is authorized by the shared middleware BEFORE these
//! handlers run; the provider-side surface is defense-in-depth only. The
//! reference lives on the child table (the contained-value model — R4),
//! object keys render from the domain's key template (R7 — overwrite in
//! place, org-scoped from the session bundle).
//!
//! Issue #690: every handler opens a transaction carrying the #169 session
//! bundle (`set_config(..., true)` + `SET LOCAL ROLE app_user`) and resolves
//! the owning {{ entity_name }} row under the session organization BEFORE any
//! storage or child-row work. A foreign or missing parent id is a 404 —
//! never a 403 (the cross-tenant convention) — and that parent gate runs
//! BEFORE the storage-slot capability check, so the answer is the same on a
//! deployment with no provider configured. Parent and child tables are
//! schema-qualified (`app_user`'s search_path is `public, extensions`); ids
//! travel as bound parameters, never as SQL string literals. A GLOBAL owning
//! table (the DDL's own tenancy rule) is deliberately unscoped — every
//! organization may see a global row by definition; the const below says
//! which case applies.
//! `upload` uses TWO short transactions — the gate is re-run on the second
//! (the FK is the backstop if the parent vanished between them) — so the
//! multipart body read and the provider `put` hold no pooled connection.
//! Every child statement filters on the session organization exactly: the
//! child tables carry the parent's `set_org_id_from_session` trigger and
//! their RLS policies stopped tolerating the DDL's zero default (issue #700),
//! so no branch here needs to widen the predicate.
//!
//! Issue #707: a stored key must belong to the SESSION ORGANIZATION.
//! `display` and `remove` hand the key to the provider with the SERVICE
//! credential, and the column was client-writable while the create/update
//! DTOs nested the media reference, so a foreign key is refused with a 404
//! BEFORE any storage call (never a 403 — a cross-tenant object is
//! indistinguishable from a missing one).
//!
//! The guard is DERIVED from the domain's own `key_template` (a user-facing
//! config field; `{org}` is optional and may sit anywhere), never assumed:
//! - org-first template (first segment is `{org}` — the same predicate the
//!   bucket-RLS migration uses, `media/keys.rs::key_template_is_org_first`):
//!   the stored key must start with `KEY_PREFIX_FORMAT` rendered for the
//!   session org. The const is a PLAIN string used with `.replace` — never
//!   `format!` on a runtime string.
//! - otherwise (`media/{org}/…`, `media-{org}/…`, no `{org}` at all): there
//!   is no segment a prefix test can compare, so the guard is the full
//!   invariant this plane already relies on — the key is a pure function of
//!   (org, domain, entity, id, field), and `render_key` computes it, so the
//!   stored key must EQUAL `render_key(&org, id)`. That is the stronger
//!   form; anything else answers the same 404.
//! Defense in depth: in `through-app` domains the request DTOs no longer
//! carry the reference at all, so the upload handler is its only writer.
use axum::{
    extract::{Extension, Multipart, Path, State},
    http::{HeaderMap, StatusCode},
    response::IntoResponse,
    Json,
};
use sea_orm::{ConnectionTrait, DatabaseBackend, DatabaseTransaction, Statement, Value};
use uuid::Uuid;

use crate::app_state::AppState;
use crate::error::AppError;
use crate::middleware::ApiKeyInfo;

const ACCEPTED_MIME_TYPES: &[&str] = &[
{% for accept in media_accept %}
    "{{ accept }}",
{% endfor %}
];

/// The owning table, SCHEMA-QUALIFIED: generated tables live under the
/// domain's Postgres schema, while `app_user`'s search_path is
/// `public, extensions` — an unqualified name is not the table the DDL
/// created (every media statement used to 500 on a non-public schema).
/// Schema source is `postgres_schema` (the grants/RLS plane); the DDL keys
/// tables off the domain name — the divergence is silent today (issue #702).
const PARENT_TABLE: &str = "{{ schema }}.{{ entity_snake }}";
/// The contained-value child table (the media reference), schema-qualified.
const CHILD_TABLE: &str = "{{ schema }}.{{ child_table }}";
/// The owning table's tenancy column, resolved through `is_global_entity` —
/// the tenancy rule is currently THREE separate copies (`db/entity.rs`,
/// `db/ddl/query.rs`, `persistence.rs`) that MUST move together; unifying
/// them is a recorded follow-up with no issue yet (#702 tracks the
/// neighbouring schema-source divergence). A `None` value means a GLOBAL
/// owning table.
{% if parent_tenant_column %}const PARENT_TENANT_COLUMN: Option<&str> = Some("{{ parent_tenant_column }}");
{% else %}/// `None` only for a GLOBAL owning table: such a table is visible to every
/// organization by definition, so the parent gate and the child statements
/// are deliberately unscoped.
const PARENT_TENANT_COLUMN: Option<&str> = None;
{% endif %}
/// The domain's key template lowered to a Rust format string (R7): `org`
/// and `id` are the runtime slots, everything else is baked.
fn render_key(org: &str, id: Uuid) -> String {
    format!("{{ key_format }}")
}
{% if key_org_first %}
/// Issue #707: the org-first PREFIX of the domain's own key template, as a
/// PLAIN string with `{org}` as the runtime slot (it is `.replace`d, never
/// `format!`ed — a literal `{` in the template would otherwise open a
/// format hole). `media/keys.rs::key_prefix_format_for` derives it from the
/// same `key_template_is_org_first` predicate the bucket-RLS migration uses.
const KEY_PREFIX_FORMAT: &str = "{{ key_prefix_format }}";
{% endif %}

fn mime_matches(mime: &str, patterns: &[&str]) -> bool {
    patterns.iter().any(|pattern| {
        if pattern.ends_with("/*") {
            let prefix = &pattern[..pattern.len() - 1];
            mime.starts_with(prefix)
        } else {
            mime == *pattern
        }
    })
}

/// 503 fail-closed: the media slot is `None` until the provider env is
/// configured (the AppState constructor's documented posture).
fn storage_unavailable() -> AppError {
    AppError {
        status: StatusCode::SERVICE_UNAVAILABLE,
        code: "MEDIA_UNCONFIGURED",
        message: "Media storage is not configured".to_string(),
        details: None,
        correlation_id: None,
    }
}

/// Classify a database error exactly the way `errors::{{ domain | pascal_case }}Error::from_repo_err`
/// does (#169): the RESTRICTIVE `scope_enforced_*` policies raise P0403 with
/// an INSUFFICIENT_SCOPE / ROLE_FORBIDDEN payload, and org-isolation writes
/// surface Postgres' canonical "violates row-level security policy" text.
/// Those are authorization denials → 403 (never a 500, and never with the raw
/// DB text echoed as the outcome); everything else stays internal.
fn db_err(context: &str, e: sea_orm::DbErr) -> AppError {
    let msg = e.to_string();
    if msg.contains("INSUFFICIENT_SCOPE")
        || msg.contains("ROLE_FORBIDDEN")
        || msg.contains("violates row-level security policy")
    {
        AppError::forbidden(format!("{context}: {msg}"))
    } else {
        AppError::internal(format!("{context}: {msg}"))
    }
}

/// Resolve the owning row under the #169 session bundle: open a
/// transaction, install the session context, and require the parent to
/// exist AND belong to the session organization. A miss is 404 — never 403:
/// a foreign id must be indistinguishable from a missing one. A nil session
/// organization is 404 unconditionally: the child predicates are exact-org
/// since #700, so a nil org can never match a row.
async fn scoped_tx(
    state: &AppState,
    api_key_info: &ApiKeyInfo,
    id: Uuid,
) -> Result<DatabaseTransaction, AppError> {
    if api_key_info.organization_id.is_nil() {
        return Err(AppError::not_found(format!(
            "{{ entity_name }} {id} not found"
        )));
    }
    let tx = crate::media::session::begin_scoped(
        &state.db,
        api_key_info.api_key_id,
        api_key_info.organization_id,
        api_key_info.user_id,
        &api_key_info.role,
    )
    .await
    .map_err(|e| db_err("failed to open the media session", e))?;
    let exists = crate::media::session::parent_exists(
        &tx,
        PARENT_TABLE,
        PARENT_TENANT_COLUMN,
        id,
        api_key_info.organization_id,
    )
    .await
    .map_err(|e| db_err("failed to resolve the media parent", e))?;
    if !exists {
        return Err(AppError::not_found(format!(
            "{{ entity_name }} {id} not found"
        )));
    }
    Ok(tx)
}

{% if mode_presigned %}
/// The presign request body. `request_body = PresignRequest` needs the
/// utoipa schema derive; the presigned branch had no compile pin, so it
/// shipped without it.
#[derive(Debug, serde::Deserialize, utoipa::ToSchema)]
pub struct PresignRequest {
    pub mime_type: String,
}

/// Presign issuance (issue #625 PR-C): the app mints a short-lived PUT; the
/// browser uploads DIRECTLY to the provider (no byte hop through the app);
/// the reference is persisted afterwards through the normal update path.
#[utoipa::path(
    post,
    path = "{{ route_prefix }}/{id}/{{ media_field_name }}/presign",
    tag = "{{ domain }}",
    operation_id = "{{ domain }}_{{ entity_module }}_{{ media_field_name }}_presign",
    params(
{% for p in route_parents %}
        ("{{ p.param_name }}" = Uuid, Path, description = "The parent {{ p.entity_title }} id"),
{% endfor %}
        ("id" = Uuid, Path, description = "The owning {{ entity_name }} id"),
    ),
    request_body = PresignRequest,
    responses(
        (status = 200, description = "Presigned upload URL"),
        (status = 404, description = "The owning record does not exist in this organization"),
        (status = 415, description = "Mime type not accepted"),
        (status = 503, description = "Media storage not configured"),
    )
)]
#[tracing::instrument(skip(state, _headers, api_key_info, body), fields(domain = "{{ domain }}", entity = "{{ entity_module }}"))]
pub async fn presign(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    _headers: HeaderMap,
    Path(id): Path<Uuid>,
    Json(body): Json<PresignRequest>,
) -> Result<impl IntoResponse, AppError> {
    // The tenant/ownership gate runs BEFORE the storage-slot availability
    // check: a foreign id must 404 even where no provider is configured.
    {
        // The gate is a read-only existence check; release the transaction
        // before the provider round trip.
        let _tx = scoped_tx(&state, &api_key_info, id).await?;
    }
    let storage = state
        .{{ domain }}_media_storage
        .as_ref()
        .ok_or_else(storage_unavailable)?;
    if !mime_matches(&body.mime_type, ACCEPTED_MIME_TYPES) {
        return Err(AppError::unsupported_media_type(format!(
            "mime type {} is not accepted (allowed: {:?})",
            body.mime_type, ACCEPTED_MIME_TYPES
        )));
    }
    let org = api_key_info.organization_id.to_string();
    let key = render_key(&org, id);
    let presigned = storage
        .presign_put(&key, &body.mime_type, {{ presign_ttl_secs }})
        .await
        .map_err(|e| AppError::internal(format!("media presign failed: {e}")))?;
    Ok(Json(serde_json::json!({
        "key": key,
        "url": presigned.url,
        "headers": presigned.headers,
        "expires_in_secs": presigned.expires_in_secs,
    })))
}
{% else %}
/// Through-app upload (issue #625 PR-C): bytes flow through the generated
/// route; the app authorizes (middleware + the session-bundle parent gate)
/// and writes the CHILD row on a second, short scoped transaction.
#[utoipa::path(
    put,
    path = "{{ route_prefix }}/{id}/{{ media_field_name }}",
    tag = "{{ domain }}",
    operation_id = "{{ domain }}_{{ entity_module }}_{{ media_field_name }}_upload",
    params(
{% for p in route_parents %}
        ("{{ p.param_name }}" = Uuid, Path, description = "The parent {{ p.entity_title }} id"),
{% endfor %}
        ("id" = Uuid, Path, description = "The owning {{ entity_name }} id"),
    ),
    responses(
        (status = 200, description = "Uploaded; the reference row is persisted"),
        (status = 404, description = "The owning record does not exist in this organization"),
        (status = 413, description = "File exceeds max_bytes"),
        (status = 415, description = "Mime type not accepted"),
        (status = 503, description = "Media storage not configured"),
    )
)]
#[tracing::instrument(skip(state, headers, api_key_info, multipart), fields(domain = "{{ domain }}", entity = "{{ entity_module }}"))]
pub async fn upload(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
    Path(id): Path<Uuid>,
    mut multipart: Multipart,
) -> Result<impl IntoResponse, AppError> {
    let _ = headers;
    // Transaction 1 (SHORT): the tenant/ownership gate runs BEFORE the
    // storage-slot check and BEFORE any byte is read — a foreign id must 404
    // even where no provider is configured, and it must not cost a body read.
    {
        let _gate = scoped_tx(&state, &api_key_info, id).await?;
    }
    let storage = state
        .{{ domain }}_media_storage
        .as_ref()
        .ok_or_else(storage_unavailable)?;

    let field = multipart
        .next_field()
        .await
        .map_err(|e| AppError::bad_request(format!("invalid multipart body: {e}")))?
        .ok_or_else(|| AppError::bad_request("multipart body carries no file field"))?;
    let mime_type = field
        .content_type()
        .unwrap_or("application/octet-stream")
        .to_string();
    if !mime_matches(&mime_type, ACCEPTED_MIME_TYPES) {
        return Err(AppError::unsupported_media_type(format!(
            "mime type {mime_type} is not accepted (allowed: {ACCEPTED_MIME_TYPES:?})"
        )));
    }
    let data = field.bytes().await.map_err(|e| {
        // axum's `DefaultBodyLimit` (2 MiB unless the route sets one) trips
        // INSIDE the extractor, before the `max_bytes` comparison below — map
        // it to the same 413 the contract publishes instead of leaking a 400
        // for an oversize body (issue #691; raising the limit is #710).
        if e.status() == StatusCode::PAYLOAD_TOO_LARGE {
            AppError::payload_too_large(format!("upload exceeds {{ max_bytes }} bytes"))
        } else {
            AppError::bad_request(format!("failed to read upload: {e}"))
        }
    })?;
    if data.len() as u64 > {{ max_bytes }} {
        return Err(AppError::payload_too_large(format!(
            "upload exceeds {{ max_bytes }} bytes"
        )));
    }

    let org = api_key_info.organization_id.to_string();
    let key = render_key(&org, id);
    let stored = storage
        .put(&key, data.to_vec(), &mime_type)
        .await
        .map_err(|e| AppError::internal(format!("media upload failed: {e}")))?;

    // Transaction 2 (SHORT): RE-RUN the gate — the parent may have vanished
    // while the body was read and the object written; the child FK is the
    // backstop. A miss here 404s and leaves the just-written object for the
    // `testkit storage --gc` sweep. Both transactions are short: no pooled
    // connection is held across the body read or the provider round trip.
    let tx = scoped_tx(&state, &api_key_info, id).await?;

    // Overwrite-in-place semantics: one reference row per (parent, field) —
    // replace any existing row on the SAME transaction that installed the
    // session bundle. Both statements are exact-org (#700): the child's
    // INSERT trigger stamps the session organization, so a legacy
    // zeros-tenant row can only have been repaired by the child migration's
    // backfill, never by a wider predicate here. Every value is a bound
    // parameter.
    let delete = Statement::from_sql_and_values(
        DatabaseBackend::Postgres,
        format!("DELETE FROM {CHILD_TABLE} WHERE {{ parent_fk_column }} = $1{% if parent_tenant_column %} AND {{ parent_tenant_column }} = $2{% endif %}"),
        [
            Value::from(id),
{% if parent_tenant_column %}            Value::from(api_key_info.organization_id),
{% endif %}        ],
    );
    tx.execute_raw(delete)
        .await
        .map_err(|e| db_err("failed to clear the media reference", e))?;
    let insert = Statement::from_sql_and_values(
        DatabaseBackend::Postgres,
        format!("INSERT INTO {CHILD_TABLE} ({{ parent_fk_column }}{% if parent_tenant_column %}, {{ parent_tenant_column }}{% endif %}, {{ url_column }}, {{ mime_column }}) VALUES ($1{% if parent_tenant_column %}, $2, $3, $4{% else %}, $2, $3{% endif %})"),
        [
            Value::from(id),
{% if parent_tenant_column %}            Value::from(api_key_info.organization_id),
{% endif %}            Value::from(stored.key.clone()),
            Value::from(mime_type.clone()),
        ],
    );
    tx.execute_raw(insert)
        .await
        .map_err(|e| db_err("failed to persist media reference", e))?;
    tx.commit()
        .await
        .map_err(|e| db_err("failed to commit the media reference", e))?;

    Ok(Json(serde_json::json!({
        "key": stored.key,
        "url": stored.url,
        "mimeType": mime_type,
    })))
}
{% endif %}

/// Signed display (issue #625 PR-B, R8): resolve the stored reference and
/// 307 to the provider display URL — private buckets mint a short-TTL
/// signed GET, public buckets resolve the static URL. No bytes flow
/// through the app.
#[utoipa::path(
    get,
    path = "{{ route_prefix }}/{id}/{{ media_field_name }}",
    tag = "{{ domain }}",
    operation_id = "{{ domain }}_{{ entity_module }}_{{ media_field_name }}_display",
    params(
{% for p in route_parents %}
        ("{{ p.param_name }}" = Uuid, Path, description = "The parent {{ p.entity_title }} id"),
{% endfor %}
        ("id" = Uuid, Path, description = "The owning {{ entity_name }} id"),
    ),
    responses(
        (status = 307, description = "Redirect to the (signed) display URL"),
        (status = 404, description = "No reference stored"),
        (status = 503, description = "Media storage not configured"),
    )
)]
#[tracing::instrument(skip(state, headers, api_key_info), fields(domain = "{{ domain }}", entity = "{{ entity_module }}"))]
pub async fn display(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
    Path(id): Path<Uuid>,
) -> Result<impl IntoResponse, AppError> {
    let _ = headers;
    // The tenant/ownership gate runs BEFORE the storage-slot availability
    // check: a foreign id must 404 even where no provider is configured.
    let tx = scoped_tx(&state, &api_key_info, id).await?;
    let select = Statement::from_sql_and_values(
        DatabaseBackend::Postgres,
        format!("SELECT {{ url_column }} AS url FROM {CHILD_TABLE} WHERE {{ parent_fk_column }} = $1{% if parent_tenant_column %} AND {{ parent_tenant_column }} = $2{% endif %} ORDER BY id DESC LIMIT 1"),
        [
            Value::from(id),
{% if parent_tenant_column %}            Value::from(api_key_info.organization_id),
{% endif %}        ],
    );
    let row = tx
        .query_one_raw(select)
        .await
        .map_err(|e| db_err("failed to load media reference", e))?;
    // Release the transaction before the provider round trip: the
    // transaction-local session context is no longer needed and the read is
    // complete.
    tx.commit()
        .await
        .map_err(|e| db_err("failed to close the media session", e))?;
    let storage = state
        .{{ domain }}_media_storage
        .as_ref()
        .ok_or_else(storage_unavailable)?;
    let key = row
        .and_then(|r| r.try_get::<String>("", "url").ok())
        .filter(|k| !k.is_empty())
        .ok_or_else(|| {
            AppError::not_found(format!("{{ entity_name }} {id} carries no {{ media_field_name }} reference"))
        })?;
    // Issue #707: the row is client-writable (the legacy create/update DTOs
    // nested this reference), so a key that does not belong to the session
    // organization must never reach the provider with the SERVICE
    // credential: `display_urls` signs ANY key. Both shapes below answer 404,
    // never 403 — a cross-tenant object must be indistinguishable from a
    // missing one. (Defense in depth: `through-app` request DTOs no longer
    // carry the reference at all.)
    let org = api_key_info.organization_id.to_string();
{% if key_org_first %}
    // Org-first key template: the org occupies the whole first path segment,
    // so the stored key must START WITH that segment's rendering.
    if !key.starts_with(&KEY_PREFIX_FORMAT.replace("{org}", &org)) {
        return Err(AppError::not_found(format!(
            "{{ entity_name }} {id} carries no {{ media_field_name }} reference"
        )));
    }
{% else %}
    // Non-org-first key template (`{org}` elsewhere or absent): no segment
    // can be prefix-checked, so enforce the full invariant — the key is a
    // pure function of (org, domain, entity, id, field) and `render_key`
    // computes it exactly.
    if key != render_key(&org, id) {
        return Err(AppError::not_found(format!(
            "{{ entity_name }} {id} carries no {{ media_field_name }} reference"
        )));
    }
{% endif %}
    let urls = storage
        .display_urls(std::slice::from_ref(&key))
        .await
        .map_err(|e| AppError::internal(format!("media display signing failed: {e}")))?;
    let url = urls
        .get(&key)
        .ok_or_else(|| AppError::not_found(format!("media object {key} not found")))?;
    Ok(axum::response::Redirect::temporary(url))
}

/// Remove the reference AND the bytes: the reverse of upload. The child row
/// goes first (row-then-bytes): a crash between the two leaves an orphaned
/// object the `testkit storage --gc` sweep collects, while byte-first would
/// leave a row pointing at a deleted object (a broken UI state).
#[utoipa::path(
    delete,
    path = "{{ route_prefix }}/{id}/{{ media_field_name }}",
    tag = "{{ domain }}",
    operation_id = "{{ domain }}_{{ entity_module }}_{{ media_field_name }}_delete",
    params(
{% for p in route_parents %}
        ("{{ p.param_name }}" = Uuid, Path, description = "The parent {{ p.entity_title }} id"),
{% endfor %}
        ("id" = Uuid, Path, description = "The owning {{ entity_name }} id"),
    ),
    responses(
        (status = 204, description = "Reference and bytes removed"),
        (status = 404, description = "No reference stored"),
        (status = 503, description = "Media storage not configured"),
    )
)]
#[tracing::instrument(skip(state, headers, api_key_info), fields(domain = "{{ domain }}", entity = "{{ entity_module }}"))]
pub async fn remove(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
    Path(id): Path<Uuid>,
) -> Result<StatusCode, AppError> {
    let _ = headers;
    // The tenant/ownership gate runs BEFORE the storage-slot availability
    // check: a foreign id must 404 even where no provider is configured.
    let tx = scoped_tx(&state, &api_key_info, id).await?;
    let storage = state
        .{{ domain }}_media_storage
        .as_ref()
        .ok_or_else(storage_unavailable)?;
    let select = Statement::from_sql_and_values(
        DatabaseBackend::Postgres,
        format!("SELECT {{ url_column }} AS url FROM {CHILD_TABLE} WHERE {{ parent_fk_column }} = $1{% if parent_tenant_column %} AND {{ parent_tenant_column }} = $2{% endif %}"),
        [
            Value::from(id),
{% if parent_tenant_column %}            Value::from(api_key_info.organization_id),
{% endif %}        ],
    );
    let row = tx
        .query_one_raw(select)
        .await
        .map_err(|e| db_err("failed to load media reference", e))?;
    let key = row
        .and_then(|r| r.try_get::<String>("", "url").ok())
        .filter(|k| !k.is_empty())
        .ok_or_else(|| {
            AppError::not_found(format!("{{ entity_name }} {id} carries no {{ media_field_name }} reference"))
        })?;
    // Issue #707: the row is client-writable (the legacy create/update DTOs
    // nested this reference), so a key that does not belong to the session
    // organization must never reach the provider with the SERVICE
    // credential: `delete` deletes ANY key. Both shapes below answer 404,
    // never 403 — a cross-tenant object must be indistinguishable from a
    // missing one. Checking here is also what keeps the CHILD ROW from being
    // deleted for a key this org does not own.
    let org = api_key_info.organization_id.to_string();
{% if key_org_first %}
    // Org-first key template: the org occupies the whole first path segment,
    // so the stored key must START WITH that segment's rendering.
    if !key.starts_with(&KEY_PREFIX_FORMAT.replace("{org}", &org)) {
        return Err(AppError::not_found(format!(
            "{{ entity_name }} {id} carries no {{ media_field_name }} reference"
        )));
    }
{% else %}
    // Non-org-first key template (`{org}` elsewhere or absent): no segment
    // can be prefix-checked, so enforce the full invariant — the key is a
    // pure function of (org, domain, entity, id, field) and `render_key`
    // computes it exactly.
    if key != render_key(&org, id) {
        return Err(AppError::not_found(format!(
            "{{ entity_name }} {id} carries no {{ media_field_name }} reference"
        )));
    }
{% endif %}
    let delete = Statement::from_sql_and_values(
        DatabaseBackend::Postgres,
        format!("DELETE FROM {CHILD_TABLE} WHERE {{ parent_fk_column }} = $1{% if parent_tenant_column %} AND {{ parent_tenant_column }} = $2{% endif %}"),
        [
            Value::from(id),
{% if parent_tenant_column %}            Value::from(api_key_info.organization_id),
{% endif %}        ],
    );
    tx.execute_raw(delete)
        .await
        .map_err(|e| db_err("failed to remove media reference", e))?;
    tx.commit()
        .await
        .map_err(|e| db_err("failed to commit the media removal", e))?;
    // Best-effort byte removal AFTER the row commit: an orphaned object is
    // collected by the `testkit storage --gc` sweep.
    let _ = storage.delete(&key).await;
    Ok(StatusCode::NO_CONTENT)
}
