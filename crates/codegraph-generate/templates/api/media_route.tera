#[tracing::instrument(skip(state, _headers, api_key_info, body), fields(domain = "{{ domain }}", entity = "{{ entity_module }}"))]
pub async fn presign(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    _headers: HeaderMap,
