#[tracing::instrument(skip(state, headers), fields(domain = "{{ domain }}", entity = "{{ entity_module }}"))]
pub async fn display(
    State(state): State<AppState>,
    headers: HeaderMap,
    Path(id): Path<Uuid>,
) -> Result<impl IntoResponse, AppError> {
    let _ = headers;
    let storage = state
        .{{ domain }}_media_storage
        .as_ref()
        .ok_or_else(storage_unavailable)?;
    let sql = format!(
        "SELECT {{ url_column }} AS url FROM {{ child_table }} WHERE {{ parent_fk_column }} = '{}' ORDER BY id DESC LIMIT 1",
        id
    );
    let row = state
        .db
        .query_one(Statement::from_string(DatabaseBackend::Postgres, sql))
        .await
        .map_err(|e| AppError::internal(format!("failed to load media reference: {e}")))?;
    let key = row
        .and_then(|r| r.try_get::<String>("", "url").ok())
        .filter(|k| !k.is_empty())
        .ok_or_else(|| {
            AppError::not_found(format!("{{ entity_name }} {id} carries no {{ media_field_name }} reference"))
        })?;
    let urls = storage
        .display_urls(std::slice::from_ref(&key))
        .await
        .map_err(|e| AppError::internal(format!("media display signing failed: {e}")))?;
    let url = urls
        .get(&key)
        .ok_or_else(|| AppError::not_found(format!("media object {key} not found")))?;
    Ok(axum::response::Redirect::temporary(url))
}

