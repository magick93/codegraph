#[tracing::instrument(skip(state, headers, api_key_info, multipart), fields(domain = "{{ domain }}", entity = "{{ entity_module }}"))]
pub async fn upload(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
    Path(id): Path<Uuid>,
    mut multipart: Multipart,
) -> Result<impl IntoResponse, AppError> {
    let _ = headers;
    let storage = state
        .{{ domain }}_media_storage
        .as_ref()
        .ok_or_else(storage_unavailable)?;

    let field = multipart
        .next_field()
        .await
        .map_err(|e| AppError::bad_request(format!("invalid multipart body: {e}")))?
        .ok_or_else(|| AppError::bad_request("multipart body carries no file field"))?;
    let mime_type = field
        .content_type()
        .unwrap_or("application/octet-stream")
        .to_string();
    if !mime_matches(&mime_type, ACCEPTED_MIME_TYPES) {
        return Err(AppError::bad_request(format!(
            "mime type {mime_type} is not accepted (allowed: {ACCEPTED_MIME_TYPES:?})"
        )));
    }
    let data = field
        .bytes()
        .await
        .map_err(|e| AppError::bad_request(format!("failed to read upload: {e}")))?;
    if data.len() as u64 > {{ max_bytes }} {
        return Err(AppError::bad_request(format!(
            "upload exceeds {{ max_bytes }} bytes"
        )));
    }

    let org = api_key_info.organization_id.to_string();
    let key = render_key(&org, id);
    let stored = storage
        .put(&key, data.to_vec(), &mime_type)
        .await
        .map_err(|e| AppError::internal(format!("media upload failed: {e}")))?;

    // Overwrite-in-place semantics: one reference row per (parent, field) —
    // replace any existing row (the contained-value update contract).
    let sql = format!(
        "DELETE FROM {{ child_table }} WHERE {{ parent_fk_column }} = '{}'; INSERT INTO {{ child_table }} ({{ parent_fk_column }}, {{ url_column }}, {{ mime_column }}) VALUES ('{}', '{}', '{}');",
        id,
        id,
        esc(&stored.key),
        esc(&mime_type),
    );
    state
        .db
        .execute(Statement::from_string(DatabaseBackend::Postgres, sql))
        .await
        .map_err(|e| AppError::internal(format!("failed to persist media reference: {e}")))?;

    Ok(Json(serde_json::json!({
        "key": stored.key,
        "url": stored.url,
        "mimeType": mime_type,
    })))
}
