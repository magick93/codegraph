/// The machine's registry id (`{{ project.domain_types_crate }}::machines`).
const MACHINE_ID: &str = "{{ machine_id }}";

/// The machine read model for {{ entity_name }} `id`: load the row
/// (RLS-scoped), read the status column, derive from the kernel. This is
/// the ONE derivation — the merged `/workflow` payload reuses it when the
/// entity carries a workflow config.
pub(crate) async fn machine_read_model(
    state: &AppState,
    api_key_info: &crate::middleware::ApiKeyInfo,
    id: Uuid,
) -> Result<MachineReadModelResponse, AppError> {
    let correlation_id = Uuid::new_v4();
    let entity = state.{{ domain }}_{{ module_name }}_queries.find_by_id(id{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e| AppError::internal(format!("Failed to find {{ entity_name }}: {e}")).with_correlation_id(correlation_id))?
        .ok_or_else(|| AppError::not_found(format!("{{ entity_name }} {id} not found")).with_correlation_id(correlation_id))?;
    // The entity column is the write-both source of truth (Stage 2 keeps
    // it in sync with the workflow instance).
    let current = {% if status_field_optional %}entity.{{ status_field_rust }}.as_ref().map(|v| v.to_string()).unwrap_or_default(){% else %}entity.{{ status_field_rust }}.to_string(){% endif %};
    let machine_json = {{ project.domain_types_crate }}::machines::machine_json(MACHINE_ID)
        .ok_or_else(|| AppError::internal(format!("machine '{MACHINE_ID}' is not in the registry")).with_correlation_id(correlation_id))?;
    let ir: serde_json::Value = serde_json::from_str(machine_json)
        .map_err(|e| AppError::internal(format!("machine '{MACHINE_ID}' does not parse: {e}")).with_correlation_id(correlation_id))?;
    let runtime = codegraph_workflow::MachineRuntime::from_json(&ir)
        .map_err(|e| AppError::internal(format!("machine '{MACHINE_ID}' is invalid: {e}")).with_correlation_id(correlation_id))?;
    let model = runtime.read_model(&current);
    let states = runtime.state_names().into_iter().map(str::to_string).collect();
    Ok(MachineReadModelResponse {
        machine_id: model.machine_id,
        current_state: model.current_state,
        is_terminal: model.is_terminal,
        state_known: model.state_known,
        machine_hash: model.machine_hash,
        states,
        available_transitions: model
            .available_transitions
            .into_iter()
            .map(|e| MachineTransitionEdge {
                event: e.event,
                from: e.from,
                to: e.to,
                guard: e.guard,
            })
            .collect(),
