{% if has_update %}

/// Update an existing {{ entity_name }}.
#[utoipa::path(
    put,
{% if role == "child" %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }",
    params(
        ("{{ parent_param_name }}" = Uuid, Path, description = "{{ parent_entity }} ID"),
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
    ),
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/{ {{- param_name -}} }",
    params(("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID")),
{% endif %}
    tag = "{{ tag }}",
    operation_id = "{{ domain }}_{{ module_name }}_update",
    request_body = Update{{ entity_name }}Request,
    responses(
        (status = 200, description = "Updated", body = {{ entity_name }}Response),
        (status = 404, description = "Not found"),
        (status = 422, description = "Validation error"),
{% if update_guarded %}        (status = 403, description = "Denied by an eligibility rule"),
{% endif %}{% if update_invariant_block %}        (status = 409, description = "Denied by a design invariant (INVARIANT_VIOLATION)"),
{% endif %}    )
)]
#[tracing::instrument(skip(state, headers, body), fields(domain = "{{ domain }}", entity = "{{ module_name }}"))]
pub async fn update(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
{{ path_extractor_item }}
    JsonPathBody(body): JsonPathBody<Update{{ entity_name }}Request>,
) -> Result<Json<serde_json::Value>, AppError> {
    let correlation_id = extract_correlation_id(&headers);
{% if role == "child" %}
    // Verify ownership before update: entity must belong to the parent
    {{ update_ownership_prefix | default(value="") }}state.{{ domain }}_{{ module_name }}_queries.find_by_id_scoped(id, parent_id{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e: {{ domain | pascal_case }}Error| {
                    AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to find {{ entity_name }}")
                        .with_correlation_id(correlation_id)
                })?
        .ok_or_else(|| AppError::not_found(format!("{{ entity_name }} {id} not found under parent {parent_id}"))
            .with_correlation_id(correlation_id))?;
{% endif %}
{{ update_guard_block | default(value="") }}
    // Validate request
    if let Err(report) = garde::Validate::validate(&body) {
        let details: Vec<crate::error::FieldError> = report.into_inner()
            .into_iter()
            .map(|(path, error)| crate::error::FieldError {
                field: path.to_string(),
                message: error.message().to_string(),
            })
            .collect();
        return Err(AppError::validation("Request validation failed", details)
            .with_correlation_id(correlation_id));
    }
{{ update_invariant_block | default(value="") }}
    state.{{ domain }}_{{ module_name }}_commands.update(id, body, {{ project.domain_types_crate }}::SourceContext::api(), correlation_id, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e: {{ domain | pascal_case }}Error| {
                    AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to update {{ entity_name }}")
                        .with_correlation_id(correlation_id)
                })?;
    let response = state.{{ domain }}_{{ module_name }}_queries.find_by_id(id{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e: {{ domain | pascal_case }}Error| {
                    AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to find {{ entity_name }}")
                        .with_correlation_id(correlation_id)
                })?
        .ok_or_else(|| AppError::not_found(format!("{{ entity_name }} {id} not found"))
            .with_correlation_id(correlation_id))?;
    Ok(Json(serde_json::json!({
        "data": response,
        "meta": { "correlation_id": correlation_id.to_string() }
    })))
}
{% endif %}
