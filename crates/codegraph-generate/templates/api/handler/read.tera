{% if has_read %}

/// Get {{ entity_name }} by ID.
#[utoipa::path(
    get,
    operation_id = "{{ domain }}_{{ module_name }}_get_by_id",
{% if role == "child" %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }",
    params(
        ("{{ parent_param_name }}" = Uuid, Path, description = "{{ parent_entity }} ID"),
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
{% if has_include or is_auditable %}
        ListParams,
{% endif %}
    ),
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/{ {{- param_name -}} }",
{% if has_include or is_auditable %}
    params(
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
        ListParams,
    ),
{% else %}
    params(("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID")),
{% endif %}
{% endif %}
    tag = "{{ tag }}",
    responses(
        (status = 200, description = "OK", body = {% if has_include %}{{ entity_name }}WithIncludeResponse{% else %}{{ entity_name }}LinkedResponse{% endif %}),
        (status = 404, description = "Not found"),
{% if read_guarded %}        (status = 403, description = "Denied by an eligibility rule"),
{% endif %}    )
)]
#[tracing::instrument(skip(state, headers), fields(domain = "{{ domain }}", entity = "{{ module_name }}"))]
pub async fn get_by_id(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
{{ path_extractor_item }}
{% if has_include or is_auditable %}
    crate::qs_query::QsQuery(params): crate::qs_query::QsQuery<ListParams>,
{% endif %}
) -> Result<Json<{% if has_include %}{{ entity_name }}WithIncludeResponse{% else %}serde_json::Value{% endif %}>, AppError> {
    let correlation_id = extract_correlation_id(&headers);{{ include_deleted_guard_block }}
{% if role == "child" %}
    let response = state.{{ domain }}_{{ module_name }}_queries.find_by_id_scoped(id, parent_id{% if is_auditable %}, params.include_deleted.unwrap_or(false){% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e: {{ domain | pascal_case }}Error| {
                    AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to find {{ entity_name }}")
                        .with_correlation_id(correlation_id)
                })?
        .ok_or_else(|| AppError::not_found(format!("{{ entity_name }} {id} not found under parent {parent_id}"))
            .with_correlation_id(correlation_id))?;{{ read_guard_block | default(value="") }}
{% if ancestor_path_params >= 2 %}
    let self_link = format!(
        "/api/{{ project.api_version }}/{}/{}/{}/{}/{}/{}",
        "{{ grandparent_domain | default(value=domain) }}",
        "{{ grandparent_path_segment }}",
        _grandparent_id,
        "{{ parent_path_segment }}",
        parent_id,
        "{{ path_segment }}",
    );
    let parent_link = format!(
        "/api/{{ project.api_version }}/{}/{}/{}/{}/{}",
        "{{ grandparent_domain | default(value=domain) }}",
        "{{ grandparent_path_segment }}",
        _grandparent_id,
        "{{ parent_path_segment }}",
        parent_id,
    );
    let linked = {{ entity_name }}LinkedResponse {
        data: response,
        links: crate::api::links::Links::child(
            format!("{}/{}", self_link, id),
            parent_link,
        ),
    };
{% else %}
    let linked = {{ entity_name }}LinkedResponse::child(
        response,
        "{{ parent_domain | default(value=domain) }}",
        "{{ parent_path_segment }}",
        parent_id,
        "{{ path_segment }}",
    );
{% endif %}
{% else %}
    let response = state.{{ domain }}_{{ module_name }}_queries.find_by_id(id{% if is_auditable %}, params.include_deleted.unwrap_or(false){% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e: {{ domain | pascal_case }}Error| {
                    AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to find {{ entity_name }}")
                        .with_correlation_id(correlation_id)
                })?
        .ok_or_else(|| AppError::not_found(format!("{{ entity_name }} {id} not found"))
            .with_correlation_id(correlation_id))?;{{ read_guard_block | default(value="") }}
    let linked = {{ entity_name }}LinkedResponse::root(response, "{{ domain }}", "{{ path_segment }}");
{% endif %}
{% if children | length > 0 or cross_refs | length > 0 %}
    let self_href = linked.links.self_link.clone();
{% endif %}
{% for child in children %}
    let linked = linked.with_child("{{ child.path_segment }}", format!("{}/{}", self_href, "{{ child.path_segment }}"));
{% endfor %}
{% for xref in cross_refs %}
    let linked = linked.with_related("{{ xref.link_rel }}", format!("{}/{}", self_href, "{{ xref.path_segment }}"));
{% endfor %}
{% if has_include %}
    let include_paths: Vec<String> = params.include
        .as_ref()
        .map(|s| s.split(',').map(|p| p.trim().to_string()).collect())
        .unwrap_or_default();
    
    for path in &include_paths {
        if !ALLOWED_INCLUDE_KEYS.contains(&path.as_str()) {
            return Err(AppError::bad_request(format!("Unknown include path: {path}"))
                .with_correlation_id(correlation_id));
        }
        if path.split('.').count() > 3 {
            return Err(AppError::bad_request("Max include depth is 3")
                .with_correlation_id(correlation_id));
        }
    }
    
    let mut included = {{ entity_name }}IncludedData { 
        {%- for field in included_default_fields %}
        {{ field }}: None,
        {%- endfor %}
    };
    
{{ include_get_block | default(value="") }}
    
    Ok(Json({{ entity_name }}WithIncludeResponse {
        data: linked,
        included: Some(included),
        meta: crate::api::meta::Meta { correlation_id: correlation_id.to_string() },
    }))
{% else %}
    Ok(Json(serde_json::json!({
        "data": linked,
        "meta": { "correlation_id": correlation_id.to_string() }
    })))
{% endif %}
}
{% endif %}
