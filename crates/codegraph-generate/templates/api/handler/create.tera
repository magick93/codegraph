{%- if has_create %}
/// Create one or more {{ entity_name }} records.
///
/// Send a single JSON object to create one record (returns 201),
/// or send a JSON array to bulk-create (returns 207 with per-item results).
#[utoipa::path(
    post,
{% if role == "child" %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}",
    params(("{{ parent_param_name }}" = Uuid, Path, description = "{{ parent_entity }} ID")),
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}",
{% endif %}
    tag = "{{ tag }}",
    operation_id = "{{ domain }}_{{ module_name }}_create",
    request_body(
        content = Create{{ entity_name }}Body,
        description = "A single {{ entity_name }} object or an array of {{ entity_name }} objects",
    ),
    responses(
        (status = 201, description = "Single item created", body = {{ entity_name }}Response),
        (status = 207, description = "Bulk operation completed (partial success)", body = BulkCreateResponse),
        (status = 400, description = "Invalid request (empty array or exceeds batch limit)"),
        (status = 422, description = "Validation error"),
{% if create_guarded %}        (status = 403, description = "Denied by an eligibility rule"),
{% endif %}{% if create_invariant_block %}        (status = 409, description = "Denied by a design invariant (INVARIANT_VIOLATION)"),
{% endif %}    )
)]
#[tracing::instrument(skip(state, headers, body), fields(domain = "{{ domain }}", entity = "{{ module_name }}"))]
pub async fn create(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
{{ path_extractor_collection }}
    CreateBody(body): CreateBody,
) -> Result<axum::response::Response, AppError> {
    use axum::response::IntoResponse;
    let correlation_id = extract_correlation_id(&headers);

    match body {
        Create{{ entity_name }}Body::Single(item) => {
            // Validate request
            if let Err(report) = garde::Validate::validate(&item) {
                let details: Vec<crate::error::FieldError> = report.into_inner()
                    .into_iter()
                    .map(|(path, error)| crate::error::FieldError {
                        field: path.to_string(),
                        message: error.message().to_string(),
                    })
                    .collect();
                return Err(AppError::validation("Request validation failed", details)
                    .with_correlation_id(correlation_id));
            }

{% if role == "child" %}
            let id = state.{{ domain }}_{{ module_name }}_commands.create(item, parent_id, {{ project.domain_types_crate }}::SourceContext::api(), correlation_id, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
{% else %}
            let id = state.{{ domain }}_{{ module_name }}_commands.create(item, {{ project.domain_types_crate }}::SourceContext::api(), correlation_id, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
{% endif %}
                .map_err(|e: {{ domain | pascal_case }}Error| {
                    AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to create {{ entity_name }}")
                        .with_correlation_id(correlation_id)
                })?;
            let response = state.{{ domain }}_{{ module_name }}_queries.find_by_id(id{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
                .map_err(|e: {{ domain | pascal_case }}Error| {
                    AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to find {{ entity_name }}")
                        .with_correlation_id(correlation_id)
                })?
                .ok_or_else(|| AppError::internal("Created entity not found")
                    .with_correlation_id(correlation_id))?;{{ create_guard_block | default(value="") }}{{ create_invariant_block | default(value="") }}
            Ok((StatusCode::CREATED, Json(serde_json::json!({
                "data": response,
                "meta": { "correlation_id": correlation_id.to_string() }
            }))).into_response())
        }
        Create{{ entity_name }}Body::Bulk(items) => {
            if items.is_empty() {
                return Err(AppError::bad_request("Bulk request must contain at least one item")
                    .with_correlation_id(correlation_id));
            }
            if items.len() > {{ max_bulk_size }} {
                return Err(AppError::bad_request("Bulk request exceeds maximum of {{ max_bulk_size }} items")
                    .with_correlation_id(correlation_id));
            }

{% if role == "child" %}
            let result = state.{{ domain }}_{{ module_name }}_commands.bulk_create(items, parent_id, {{ project.domain_types_crate }}::SourceContext::api(), correlation_id, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await;
{% else %}
            let result = state.{{ domain }}_{{ module_name }}_commands.bulk_create(items, {{ project.domain_types_crate }}::SourceContext::api(), correlation_id, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await;
{% endif %}

            let mut success = Vec::new();
            let mut failed = Vec::new();

            for item_result in result {
                match item_result {
                    Ok(id) => {
                        match state.{{ domain }}_{{ module_name }}_queries.find_by_id(id{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await {
                            Ok(Some(resp)) => success.push(resp),
                            Ok(None) => {
                                tracing::warn!(entity_id = %id, "Bulk-created entity not found during response assembly");
                            }
                            Err(e) => {
                                tracing::warn!(entity_id = %id, "Failed to fetch bulk-created entity: {e}");
                            }
                        }
                    }
                    Err(err) => {
                        failed.push(err);
                    }
                }
            }

            let response = BulkCreateResponse { success, failed, correlation_id: correlation_id.to_string() };
            Ok((StatusCode::MULTI_STATUS, Json(response)).into_response())
        }
    }
}
{% endif %}
