/// Delegate pending approval for {{ entity_name }}.
#[utoipa::path(
    post,
{% if role == "child" %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }/actions/delegate",
    params(
        ("{{ parent_param_name }}" = Uuid, Path, description = "Parent ID"),
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
    ),
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/{ {{- param_name -}} }/actions/delegate",
    params(("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID")),
{% endif %}
    tag = "{{ tag }}",
    request_body = DelegateRequest,
    responses(
        (status = 200, description = "Delegated"),
        (status = 400, description = "No pending approval to delegate"),
        (status = 404, description = "Not found"),
    )
)]
pub async fn delegate(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<crate::middleware::ApiKeyInfo>,
    headers: HeaderMap,
{% if role == "child" %}
{% if ancestor_path_params >= 2 %}
    Path((_grandparent_id, _parent_id, id)): Path<(Uuid, Uuid, Uuid)>,
{% else %}
    Path((_parent_id, id)): Path<(Uuid, Uuid)>,
{% endif %}
{% else %}
    Path(id): Path<Uuid>,
{% endif %}
    Json(body): Json<DelegateRequest>,
) -> Result<axum::http::StatusCode, AppError> {
    let correlation_id = extract_correlation_id(&headers, body.correlation_id);
    let from_actor_id = api_key_info.api_key_id;
    let ctx = codegraph_workflow::DelegationContext {
        tenant_id: api_key_info.organization_id,
        entity_id: id,
        domain: "{{ domain }}".to_string(),
        entity_table: "{{ module_name }}".to_string(),
        from_actor_id,
        to_actor_id: body.to_actor_id,
        correlation_id,
        reason: body.reason,
        session_user_id: Some(api_key_info.user_id),
        session_api_key_id: Some(api_key_info.api_key_id),
    };
    state.workflow_service.delegate(ctx).await
        .map_err(|e| AppError::internal(e.to_string()))?;
    Ok(axum::http::StatusCode::OK)
}