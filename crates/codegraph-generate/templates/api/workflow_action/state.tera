/// Get workflow state for {{ entity_name }}.
#[utoipa::path(
    get,
{% if role == "child" %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }/workflow",
    params(
        ("{{ parent_param_name }}" = Uuid, Path, description = "Parent ID"),
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
    ),
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/{ {{- param_name -}} }/workflow",
    params(("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID")),
{% endif %}
    tag = "{{ tag }}",
    responses(
        (status = 200, description = "OK", body = WorkflowStateResponse),
        (status = 404, description = "Not found"),
    )
)]
pub async fn get_workflow_state(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<crate::middleware::ApiKeyInfo>,
    headers: HeaderMap,
{% if role == "child" %}
{% if ancestor_path_params >= 2 %}
    Path((_grandparent_id, {% if not machine_scoped_load %}_{% endif %}parent_id, id)): Path<(Uuid, Uuid, Uuid)>,
{% else %}
    Path(({% if not machine_scoped_load %}_{% endif %}parent_id, id)): Path<(Uuid, Uuid)>,
{% endif %}
{% else %}
    Path(id): Path<Uuid>,
{% endif %}
) -> Result<Json<serde_json::Value>, AppError> {
    let correlation_id = headers
        .get("x-correlation-id")
        .and_then(|v| v.to_str().ok())
        .and_then(|s| s.parse::<Uuid>().ok())
        .unwrap_or_else(Uuid::new_v4);
{%- if machine %}
    // The machine read model merged into the SAME payload (issue #817) —
    // one read-model shape, two planes, no parallel fetches. The sibling
    // module owns the ONE derivation (entity column + kernel). The
    // machine block is ENTITY-COLUMN-backed (the write-both source of
    // truth), so a freshly created row with no workflow INSTANCE yet
    // still serves: the instance-backed fields fall back to the machine's
    // own kernel projection instead of 404ing the read model.
    let ws = state.workflow_service
        .get_state(api_key_info.organization_id, "{{ domain }}", "{{ module_name }}", id)
        .await
        .ok();
    let machine = super::{{ module_name }}_machine::machine_read_model(&state, &api_key_info, {% if machine_scoped_load %}parent_id, {% endif %}id)
        .await
        .map_err(|e| e.with_correlation_id(correlation_id))?;
    let response = match ws {
        Some(ws) => WorkflowStateResponse {
            entity_id: ws.entity_id,
            current_state: ws.current_state,
{% if has_approval_status %}
            approval_state: ws.approval_state,
{% endif %}
            is_terminal: ws.is_terminal,
            available_transitions: ws.available_transitions,
        },
        None => WorkflowStateResponse {
            entity_id: id,
            current_state: machine.current_state.clone(),
{% if has_approval_status %}
            approval_state: None,
{% endif %}
            is_terminal: machine.is_terminal,
            available_transitions: machine
                .available_transitions
                .iter()
                .map(|e| e.to.clone())
                .collect(),
        },
    };
    let mut data = serde_json::to_value(&response)
        .map_err(|e| AppError::internal(format!("Serialize error: {e}")).with_correlation_id(correlation_id))?;
    if let Some(obj) = data.as_object_mut() {
        obj.insert("machine".to_string(), serde_json::to_value(&machine).map_err(|e| AppError::internal(format!("Serialize error: {e}")).with_correlation_id(correlation_id))?);
    }
    Ok(Json(serde_json::json!({
        "data": data,
        "meta": { "correlation_id": correlation_id.to_string() }
    })))
{%- else %}
    let ws = state.workflow_service
        .get_state(api_key_info.organization_id, "{{ domain }}", "{{ module_name }}", id)
        .await
        .map_err(|e| AppError::not_found(e.to_string()).with_correlation_id(correlation_id))?;
    let response = WorkflowStateResponse {
        entity_id: ws.entity_id,
        current_state: ws.current_state,
{% if has_approval_status %}
        approval_state: ws.approval_state,
{% endif %}
        is_terminal: ws.is_terminal,
        available_transitions: ws.available_transitions,
    };
    Ok(Json(serde_json::json!({
        "data": response,
        "meta": { "correlation_id": correlation_id.to_string() }
    })))
{%- endif %}
}