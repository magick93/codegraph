/// Approve {{ entity_name }}.
#[utoipa::path(
    post,
{% if role == "child" %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }/actions/approve",
    params(
        ("{{ parent_param_name }}" = Uuid, Path, description = "Parent ID"),
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
    ),
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/{ {{- param_name -}} }/actions/approve",
    params(("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID")),
{% endif %}
    tag = "{{ tag }}",
    request_body = ApprovalRequest,
    responses(
        (status = 200, description = "Approved", body = WorkflowStateResponse),
        (status = 400, description = "Cannot approve in current state"),
        (status = 404, description = "Not found"),
        (status = 409, description = "Conflict"),
    )
)]
pub async fn approve(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<crate::middleware::ApiKeyInfo>,
    headers: HeaderMap,
{% if role == "child" %}
{% if ancestor_path_params >= 2 %}
    Path((_grandparent_id, _parent_id, id)): Path<(Uuid, Uuid, Uuid)>,
{% else %}
    Path((_parent_id, id)): Path<(Uuid, Uuid)>,
{% endif %}
{% else %}
    Path(id): Path<Uuid>,
{% endif %}
    Json(body): Json<ApprovalRequest>,
) -> Result<Json<serde_json::Value>, AppError> {
    let correlation_id = extract_correlation_id(&headers, body.correlation_id);
    let actor_id = api_key_info.api_key_id;
     let ctx = codegraph_workflow::ApprovalContext {
        tenant_id: api_key_info.organization_id,
        entity_id: id,
        domain: "{{ domain }}".to_string(),
        entity_table: "{{ module_name }}".to_string(),
        actor_id,
        decision: codegraph_workflow::ApprovalDecision::Approved,
        correlation_id,
        idempotency_key: body.idempotency_key,
        comment: body.comment,
        session_user_id: Some(api_key_info.user_id),
        session_api_key_id: Some(api_key_info.api_key_id),
    };
    let ws = state.workflow_service.approval_action(ctx).await
        .map_err(|e| AppError::internal(e.to_string()).with_correlation_id(correlation_id))?;
    let response = WorkflowStateResponse {
        entity_id: ws.entity_id,
        current_state: ws.current_state,
        approval_state: ws.approval_state,
        is_terminal: ws.is_terminal,
        available_transitions: ws.available_transitions,
    };
    Ok(Json(serde_json::json!({
        "data": response,
        "meta": { "correlation_id": correlation_id.to_string() }
    })))
}

