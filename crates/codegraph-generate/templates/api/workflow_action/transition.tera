/// Transition {{ entity_name }} to a new workflow state.
#[utoipa::path(
    post,
{% if role == "child" %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }/actions/transition",
    params(
        ("{{ parent_param_name }}" = Uuid, Path, description = "Parent ID"),
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
    ),
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/{ {{- param_name -}} }/actions/transition",
    params(("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID")),
{% endif %}
    tag = "{{ tag }}",
    request_body = TransitionRequest,
    responses(
        (status = 200, description = "Transitioned", body = WorkflowStateResponse),
        (status = 202, description = "Accepted (approval required)"),
        (status = 400, description = "Invalid transition"),
        (status = 404, description = "Not found"),
        (status = 409, description = "Conflict"),
    )
)]
pub async fn transition(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<crate::middleware::ApiKeyInfo>,
    headers: HeaderMap,
{% if role == "child" %}
{% if ancestor_path_params >= 2 %}
    Path((_grandparent_id, _parent_id, id)): Path<(Uuid, Uuid, Uuid)>,
{% else %}
    Path((_parent_id, id)): Path<(Uuid, Uuid)>,
{% endif %}
{% else %}
    Path(id): Path<Uuid>,
{% endif %}
    Json(body): Json<TransitionRequest>,
) -> Result<Json<serde_json::Value>, AppError> {
    let correlation_id = extract_correlation_id(&headers, body.correlation_id);
    let entity = state.{{ domain }}_{{ module_name }}_queries.find_by_id(id{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e| AppError::internal(format!("Failed to find {{ entity_name }}: {e}")))?
        .ok_or_else(|| AppError::not_found(format!("{{ entity_name }} {id} not found")))?;
    let entity_data = serde_json::to_value(&entity)
        .map_err(|e| AppError::internal(format!("Serialize error: {e}")))?;
    let ctx = codegraph_workflow::TransitionContext {
        tenant_id: api_key_info.organization_id,
        entity_id: id,
        domain: "{{ domain }}".to_string(),
        entity_table: "{{ module_name }}".to_string(),
        target_state: body.target_state,
        actor_id: Some(api_key_info.api_key_id),
        correlation_id,
        idempotency_key: body.idempotency_key,
        comment: body.comment,
        entity_data,
        trigger_source: codegraph_workflow::TriggerSource::User,
        session_user_id: Some(api_key_info.user_id),
        session_api_key_id: Some(api_key_info.api_key_id),
    };
    let ws = state.workflow_service.transition(ctx).await.map_err(|e| {
        use codegraph_workflow::WorkflowError;
        match &e {
            WorkflowError::InvalidTransition { .. } | WorkflowError::AlreadyTerminal => {
                AppError::conflict(e.to_string()).with_correlation_id(correlation_id)
            }
            WorkflowError::NotFound => AppError::not_found(e.to_string()).with_correlation_id(correlation_id),
            // The machine names a guard the app has not implemented yet —
            // the fail-closed 501 names the guard (issue #816).
            WorkflowError::UnimplementedGuard(_) => AppError {
                status: axum::http::StatusCode::NOT_IMPLEMENTED,
                code: "NOT_IMPLEMENTED",
                message: e.to_string(),
                details: None,
                correlation_id: Some(correlation_id),
            },
            _ => AppError::internal(e.to_string()).with_correlation_id(correlation_id),
        }
    })?;{% if has_extension_points %}
    if let Some(dispatcher) = &state.integration_dispatcher {
        dispatcher.notify(api_key_info.organization_id, "{{ entity_ref }}", "state_changed", id, correlation_id).await;
    }
{% endif %}
    let response = WorkflowStateResponse {
        entity_id: ws.entity_id,
        current_state: ws.current_state,