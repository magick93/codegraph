/// Get process history for {{ entity_name }} (HR Open ProcessHistoryType compatible).
#[utoipa::path(
    get,
{% if role == "child" %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }/workflow/history",
    params(
        ("{{ parent_param_name }}" = Uuid, Path, description = "Parent ID"),
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
    ),
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/{ {{- param_name -}} }/workflow/history",
    params(("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID")),
{% endif %}
    tag = "{{ tag }}",
    responses(
        (status = 200, description = "OK", body = Vec<ProcessHistoryEntry>),
        (status = 404, description = "Not found"),
    )
)]
pub async fn get_process_history(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<crate::middleware::ApiKeyInfo>,
    headers: HeaderMap,
{% if role == "child" %}
{% if ancestor_path_params >= 2 %}
    Path((_grandparent_id, _parent_id, id)): Path<(Uuid, Uuid, Uuid)>,
{% else %}
    Path((_parent_id, id)): Path<(Uuid, Uuid)>,
{% endif %}
{% else %}
    Path(id): Path<Uuid>,
{% endif %}
) -> Result<Json<serde_json::Value>, AppError> {
    let correlation_id = headers
        .get("x-correlation-id")
        .and_then(|v| v.to_str().ok())
        .and_then(|s| s.parse::<Uuid>().ok())
        .unwrap_or_else(Uuid::new_v4);
    let entries = state.workflow_service
        .get_history(api_key_info.organization_id, "{{ domain }}", "{{ module_name }}", id)
        .await
        .map_err(|e| AppError::internal(e.to_string()).with_correlation_id(correlation_id))?;
    let history: Vec<ProcessHistoryEntry> = entries
        .into_iter()
        .map(|e| ProcessHistoryEntry {
            id: e.id,
            action_date: e.action_date,
            status: e.status,
            previous_status: e.previous_status,
            correlation_id: e.correlation_id,
            actor_id: e.actor_id,
            comment: e.comment,
        })
        .collect();
    Ok(Json(serde_json::json!({
        "data": history,
        "meta": { "correlation_id": correlation_id.to_string() }
    })))
}