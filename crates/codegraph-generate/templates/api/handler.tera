pub async fn {{ op.fn_name }}(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
{% if op.execution.kind == "create" %}
    body: Option<Json<serde_json::Value>>,
{% elif op.execution.kind == "child_op" and op.execution.action == "add" %}
{% if op.execution.payload %}
{{ path_extractor_child_op_add }}
    body: Option<Json<serde_json::Value>>,
{% else %}
{{ path_extractor_child_op_add }}
    CreateBody(body): CreateBody,
{% endif %}
{% elif op.execution.kind == "projection_read" and op.execution.plan.collection %}
    body: Option<Json<serde_json::Value>>,
{% else %}
{{ path_extractor_item_named }}
    body: Option<Json<serde_json::Value>>,
{% endif %}
) -> Result<axum::response::Response, AppError> {
    use axum::response::IntoResponse;
    let correlation_id = extract_correlation_id(&headers);
    let _ = &body;
{% if op.record_load | default(value=true) %}
    let response = state.{{ domain }}_{{ module_name }}_queries
        .{% if role == "child" %}find_by_id_scoped({{ param_name }}, parent_id{% else %}find_by_id({{ param_name }}{% endif %}{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone())
        .await
        .map_err(|e: {{ domain | pascal_case }}Error| {
            AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to find {{ entity_name }}")
                .with_correlation_id(correlation_id)
        })?
        .ok_or_else(|| AppError::not_found({% if role == "child" %}format!("{{ entity_name }} { {{- param_name -}} } not found under parent {parent_id}"){% else %}"{{ entity_name }} not found"{% endif %}).with_correlation_id(correlation_id))?;
{% endif %}
{% if op.authorize_fn | default(value="") | length > 0 %}
{% if op.authorize_async | default(value=false) %}
    if let Err(reason) = {{ op.fn_name }}_authorize(&state, &api_key_info, &response).await {
{% else %}
    if let Err(reason) = {{ op.fn_name }}_authorize(api_key_info.role.as_str(){% if op.record_load | default(value=true) %}, &response{% endif %}) {
{% endif %}
        return Err(AppError::forbidden(reason).with_correlation_id(correlation_id));
    }
{% endif %}
