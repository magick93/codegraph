{#- Handler template assembler (issue #778 wave 4): one include per
    responsibility fragment under `api/handler/`. Fragments render
    verbatim, so each include tag sits alone on a line carrying `-%}`
    (the tag line contributes no newline) and every fragment owns the
    boundary newline its span used to emit. A fragment whose span was
    followed by a `{%-` tag (support, list, mox, service_op) therefore
    ends WITHOUT a trailing newline — that removed tag trimmed it. -#}
{% include "api/handler/support.tera" -%}
{% include "api/handler/create.tera" -%}
{% include "api/handler/read.tera" -%}
{% include "api/handler/update.tera" -%}
{% include "api/handler/delete.tera" -%}
{% include "api/handler/list.tera" -%}
{% include "api/handler/search.tera" -%}
{% include "api/handler/semantic_search.tera" -%}
{% include "api/handler/tree.tera" -%}
{% include "api/handler/extensibility.tera" -%}
{% include "api/handler/mox.tera" -%}
{% include "api/handler/service_op.tera" -%}
