    {{ update_ownership_prefix | default(value="") }}state.{{ domain }}_{{ module_name }}_queries.find_by_id_scoped(id, parent_id{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
