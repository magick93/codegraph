{% endif %}
{{ update_guard_block | default(value="") }}
    // Validate request
    if let Err(report) = garde::Validate::validate(&body) {
        let details: Vec<crate::error::FieldError> = report.into_inner()
            .into_iter()
            .map(|(path, error)| crate::error::FieldError {
                field: path.to_string(),
                message: error.message().to_string(),
            })
            .collect();
        return Err(AppError::validation("Request validation failed", details)
            .with_correlation_id(correlation_id));
    }
{{ update_invariant_block | default(value="") }}
    state.{{ domain }}_{{ module_name }}_commands.update(id, body, {{ project.domain_types_crate }}::SourceContext::api(), correlation_id, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e: {{ domain | pascal_case }}Error| {
                    AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to update {{ entity_name }}")
                        .with_correlation_id(correlation_id)
                })?;
    let response = state.{{ domain }}_{{ module_name }}_queries.find_by_id(id{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e: {{ domain | pascal_case }}Error| {
                    AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to find {{ entity_name }}")
                        .with_correlation_id(correlation_id)
                })?
        .ok_or_else(|| AppError::not_found(format!("{{ entity_name }} {id} not found"))
            .with_correlation_id(correlation_id))?;
    Ok(Json(serde_json::json!({
        "data": response,
        "meta": { "correlation_id": correlation_id.to_string() }
    })))
}
