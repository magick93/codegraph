//         &self,
//         state: axum::extract::State<AppState>,
//         headers: axum::http::HeaderMap,
//         Json(body): axum::Json<Create{{ entity_name }}Request>,
//     ) -> Result<axum::response::Response, AppError> {
//         // Your custom logic here
//         todo!()
//     }
// }
{% endif %}
{% if mox_ops | default(value=[]) | length > 0 %}{% for op in mox_ops %}

/// Mox operation `{{ op.name }}` (issue #508 R2): `POST …/{id}/op/{{ op.snake }}`
/// on the loaded row — the tested invocation contract. Params arrive as
/// JSON body members; the result rides the standard `{"data": …}` envelope.
pub async fn mox_op_{{ op.snake }}(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
    Path({{ param_name }}): Path<Uuid>,
    body: Option<axum::Json<serde_json::Value>>,
) -> Result<axum::response::Response, AppError> {
    use axum::response::IntoResponse;
    let correlation_id = extract_correlation_id(&headers);
    let resp = state.{{ domain }}_{{ module_name }}_queries
        .find_by_id({{ param_name }}{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone())
        .await
        .map_err(|e: {{ domain | pascal_case }}Error| {
            AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to find {{ entity_name }}")
                .with_correlation_id(correlation_id)
        })?
        .ok_or_else(|| AppError::not_found("{{ entity_name }} not found").with_correlation_id(correlation_id))?;
    let mirror = {{ project.domain_types_crate }}::{{ domain }}::mox_types::{{ entity_name }}::from_response(&resp);
    let mut res = {{ project.domain_types_crate }}::{{ domain }}::mox_types::Resource::new(
        api_key_info.organization_id, correlation_id, Some(api_key_info.api_key_id),
    );
    res.insert_{{ module_name }}(mirror);
    let target = res.get_{{ module_name }}({{ param_name }}).expect("row inserted above");
{%- for p in op.params %}
    let {{ p.name }}: {{ p.rust_type }} = body
        .as_ref()
        .and_then(|b| b.get("{{ p.name }}").cloned())
        .and_then(|v| serde_json::from_value(v).ok())
        .ok_or_else(|| AppError::bad_request("missing or invalid parameter '{{ p.name }}'").with_correlation_id(correlation_id))?;
{%- endfor %}
    let out = target.{{ op.snake }}(&res{% for p in op.params %}, {{ p.name }}{% endfor %});
    Ok(axum::Json(serde_json::json!({ "data": out })).into_response())
}
{% endfor %}{% endif %}{%- if service_ops | default(value=[]) | length > 0 %}

/// The 501 seam for service ops with no executable lowering yet (issue
/// #590): the route exists and the policy gates it, but the op body has
/// no lowering — the response names the gap.
#[allow(clippy::result_large_err)]
fn service_op_not_implemented(reason: impl Into<String>) -> AppError {
    AppError {
        status: axum::http::StatusCode::NOT_IMPLEMENTED,
        code: "NOT_IMPLEMENTED",
        message: reason.into(),
        details: None,
        correlation_id: None,
    }
}
{% for op in service_ops %}
{{ op.authorize_fn | default(value="") }}
/// Service operation `{{ op.op_name }}` (service `{{ op.service }}`, issue
/// #590): `POST …/{id}/actions/{{ op.snake }}` — the IFML action button's
/// wire shape (#559) with the actor policy enforced server-side. Child
/// entities nest the route under the parent and load the record through
/// the parent-scoped read (WS4).{% if op.execution.kind == "child_op" %}
///
/// Aggregate child operation (issue #661): declared by the root's
/// `children {{ op.service }} {{ '{' }} … => {{ op.execution.feature }}.{{ op.execution.action }} }`
/// block, lowered against the CHILD's command plane through the parent's
/// aggregate path — `add` creates and links one element (collection route),
/// `save`/`remove` act on the parent-scoped element.{% endif %}
#[utoipa::path(
    post,
{% if role == "child" %}
{% if op.execution.kind == "child_op" and op.execution.action == "add" %}
{% if ancestor_path_params >= 2 %}
    path = "/api/{{ project.api_version }}/{{ grandparent_domain | default(value=domain) }}/{{ grandparent_path_segment }}/{ {{- grandparent_param_name -}} }/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/actions/{{ op.snake }}",
    params(
        ("{{ grandparent_param_name }}" = Uuid, Path, description = "Grandparent ID"),
        ("{{ parent_param_name }}" = Uuid, Path, description = "{{ parent_entity }} ID"),
    ),
{% else %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/actions/{{ op.snake }}",
    params(("{{ parent_param_name }}" = Uuid, Path, description = "{{ parent_entity }} ID")),
{% endif %}
{% elif ancestor_path_params >= 2 %}
    path = "/api/{{ project.api_version }}/{{ grandparent_domain | default(value=domain) }}/{{ grandparent_path_segment }}/{ {{- grandparent_param_name -}} }/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }/actions/{{ op.snake }}",
    params(
        ("{{ grandparent_param_name }}" = Uuid, Path, description = "Grandparent ID"),
        ("{{ parent_param_name }}" = Uuid, Path, description = "{{ parent_entity }} ID"),
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
    ),
{% else %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }/actions/{{ op.snake }}",
    params(
        ("{{ parent_param_name }}" = Uuid, Path, description = "{{ parent_entity }} ID"),
        ("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID"),
    ),
{% endif %}
{% elif op.execution.kind == "create" or (op.execution.kind == "projection_read" and op.execution.plan.collection) %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/actions/{{ op.snake }}",
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/{ {{- param_name -}} }/actions/{{ op.snake }}",
    params(("{{ param_name }}" = Uuid, Path, description = "{{ entity_name }} ID")),
{% endif %}
{% if op.execution.kind == "child_op" and op.execution.action == "add" %}
{% if op.execution.payload %}
    request_body(content = {{ op.execution.payload.request_body | default(value="serde_json::Value") }}, description = "The modeled DTO boundary payload"),
{% else %}
    request_body(content = Create{{ entity_name }}Body, description = "The child element to add"),
{% endif %}
{% endif %}
{% if op.execution.kind == "create" %}
    request_body(content = {{ op.execution.plan.request_body | default(value="serde_json::Value") }}, description = "The modeled DTO boundary create body"),
{% endif %}
{% if op.execution.kind == "body" and op.execution.plan.params | length == 1 and op.execution.plan.params[0].direct_body %}
    request_body(content = {{ op.execution.plan.params[0].request_body }}, description = "The modeled DTO boundary request body"),
{% endif %}
    responses(
{% if op.execution.kind == "create" %}
        (status = 201, description = "Created", body = {{ entity_name }}Response),
        (status = 403, description = "Denied by the actor policy"),
        (status = 422, description = "Invalid request body, or a failed validation"),
{% if create_invariant_block | default(value="") | length > 0 %}        (status = 409, description = "Denied by a design invariant (INVARIANT_VIOLATION)"),
{% endif %}{% elif op.execution.kind == "projection_read" %}
{% if op.execution.plan.collection %}
        (status = 200, description = "The projection over the session's collection", body = [{{ project.domain_types_crate }}::dto::{{ op.execution.plan.module }}::{{ op.execution.plan.projection }}]),
{% else %}
        (status = 200, description = "The projection over the loaded record", body = {{ project.domain_types_crate }}::dto::{{ op.execution.plan.module }}::{{ op.execution.plan.projection }}),
{% endif %}
        (status = 403, description = "Denied by the actor policy"),
{% if not op.execution.plan.collection %}        (status = 404, description = "Not found"),
{% endif %}{% else %}
        (status = 200, description = "Accepted"),
        (status = 403, description = "Denied by the actor policy"),
        (status = 404, description = "Not found"),
{% endif %}
{% if op.execution.kind == "child_op" %}
        (status = 422, description = "Invalid child payload"),
{% endif %}
{% if op.execution.kind == "update" and (op.execution.state | default(value=false)) and op.invariant_block %}        (status = 409, description = "The transition is not allowed from the current state, or a design invariant denied the write"),
{% elif op.execution.kind == "update" and (op.execution.state | default(value=false)) %}        (status = 409, description = "The transition is not allowed from the current state"),
{% elif op.execution.kind == "update" and op.invariant_block %}        (status = 409, description = "Denied by a design invariant (INVARIANT_VIOLATION)"),
{% endif %}
{% if op.execution.kind == "seam" %}
        (status = 501, description = "Operation body not lowered"),
{% endif %}{% if op.raise_responses %}
{% for raise in op.raise_responses %}        (status = {{ raise.status }}, description = "The operation raised {{ raise.errors }} (declared `throws`)"),
{% endfor %}{% endif %}{% if op.execution.kind == "body" %}
{% for raise in op.execution.plan.responses %}        (status = {{ raise.status }}, description = "The operation body raised {{ raise.errors }}"),
{% endfor %}{% endif %}
    )
)]
#[tracing::instrument(skip(state, headers, body), fields(domain = "{{ domain }}", entity = "{{ module_name }}", op = "{{ op.snake }}"))]
pub async fn {{ op.fn_name }}(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
{% if op.execution.kind == "create" %}
    body: Option<Json<serde_json::Value>>,
{% elif op.execution.kind == "child_op" and op.execution.action == "add" %}
{% if op.execution.payload %}
{{ path_extractor_child_op_add }}
    body: Option<Json<serde_json::Value>>,
{% else %}
{{ path_extractor_child_op_add }}
    CreateBody(body): CreateBody,
{% endif %}
{% elif op.execution.kind == "projection_read" and op.execution.plan.collection %}
    body: Option<Json<serde_json::Value>>,
{% else %}
{{ path_extractor_item_named }}
    body: Option<Json<serde_json::Value>>,
{% endif %}
) -> Result<axum::response::Response, AppError> {
    use axum::response::IntoResponse;
    let correlation_id = extract_correlation_id(&headers);
    let _ = &body;
{% if op.record_load | default(value=true) %}
    let response = state.{{ domain }}_{{ module_name }}_queries
        .{% if role == "child" %}find_by_id_scoped({{ param_name }}, parent_id{% else %}find_by_id({{ param_name }}{% endif %}{% if is_auditable %}, false{% endif %}, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone())
        .await
        .map_err(|e: {{ domain | pascal_case }}Error| {
            AppError::from_domain_error(e.http_status(), e.to_string(), "Failed to find {{ entity_name }}")
                .with_correlation_id(correlation_id)
        })?
        .ok_or_else(|| AppError::not_found({% if role == "child" %}format!("{{ entity_name }} { {{- param_name -}} } not found under parent {parent_id}"){% else %}"{{ entity_name }} not found"{% endif %}).with_correlation_id(correlation_id))?;
{% endif %}
{% if op.authorize_fn | default(value="") | length > 0 %}
{% if op.authorize_async | default(value=false) %}
    if let Err(reason) = {{ op.fn_name }}_authorize(&state, &api_key_info, &response).await {
{% else %}
    if let Err(reason) = {{ op.fn_name }}_authorize(api_key_info.role.as_str(){% if op.record_load | default(value=true) %}, &response{% endif %}) {
{% endif %}
        return Err(AppError::forbidden(reason).with_correlation_id(correlation_id));
    }
{% endif %}
{% if op.execution.kind == "seam" %}{# the seam arm's else-branch tag line #}
{% endif %}
{{ op.execution_block }}
{% if op.execution.kind == "child_op" %}{# the child arm's action-chain tag line #}
{% endif %}
}
{% endfor %}
{% endif %}