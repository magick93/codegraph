    headers: HeaderMap,
{{ path_extractor_item }}
    JsonPathBody(body): JsonPathBody<Update{{ entity_name }}Request>,
) -> Result<Json<serde_json::Value>, AppError> {
    let correlation_id = extract_correlation_id(&headers);
{% if role == "child" %}
