# hurl_contract: {{ domain }}.{{ module }} — service-op action contracts (issue #590).
# Regenerate with the codegraph pipeline. Vars: base_url, api_key.
#
# The actor policy (capability, `never_both`, per-grant and op-level `when`)
# answers 403 to JWT sessions; API-key sessions bypass the policy gates
# (RLS scopes still apply), so these contracts pin route existence — the
# dead-button class — and the execution lowering.
#
# State awareness: a machine-bound op pins 200 only when its transition is
# valid from the record's CURRENT state (the CREATE above starts at the
# machine's initial state); an out-of-order op pins 409, and one transition
# is replayed after the sequence to prove the wrong-state contract. Ops with
# no executable lowering pin 501.
{% for parent in fk_sections %}
{{ parent.body }}
{% endfor %}
# CREATE — capture the row the actions run against
POST {{ create_url }}
{{ auth_header }}
{{ create_body }}

HTTP 201
[Captures]
{{ capture_name }}: jsonpath "$.data.id"
[Asserts]
{{ create_asserts }}
{% for op in ops %}
# service op `{{ op.op_name }}` (service `{{ op.service }}`){% if op.seam %} — 501 seam: {{ op.seam_reason }}{% elif op.wrong_state %} — wrong-state guard (409): {{ op.seam_reason }}{% endif %}
POST {{ item_url_base }}/{{ capture_ref }}/actions/{{ op.snake }}
{{ auth_header }}

HTTP {{ op.expect }}
{% endfor %}
