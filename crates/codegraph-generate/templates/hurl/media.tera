{% if kind == "through_app" %}# hurl_contract: media surface (issue #625 PR-B) — {{ domain }}.{{ field }}.
# PROVIDER-FREE legs only. Since #690 every media handler resolves the owning
# row under the session organization BEFORE the storage-slot check, so the
# authn leg and the missing-parent leg are deterministic with NO bucket
# configured. The happy path (upload → display → remove, and the 413/415
# rejections) needs a configured provider and lives in the runtime lane
# (issue #625 OQ8 → #695 Stage 1).
# The URL is pinned to the router's own path shape by `media_pipeline_tests`
# (issues #691/#713): {{ prefix }}/{id}/{field} — the entity's path segment
# plus the nesting chain `router.tera` mounts a child entity under.

# authn — no credentials, rejected by the shared middleware before the
# handler (and therefore before any extractor) runs.
PUT {{ upload_url }}

HTTP 401
[Asserts]
jsonpath "$.error.code" == "UNAUTHORIZED"

# ownership — a VALID key against an id no row carries must be 404, never
# 403: a foreign or missing parent is indistinguishable by design. Addressed
# through the GET display route (same path, no body extractor), so the
# answer comes from the handler and not from multipart parsing.
GET {{ display_url }}
{{ auth_header }}

HTTP 404
[Asserts]
jsonpath "$.error.code" == "NOT_FOUND"
{% endif %}{% if kind == "presigned" %}# hurl_contract: media surface (issue #625 PR-C) — {{ domain }}.{{ field }}.
# PROVIDER-FREE legs only: the #690 parent gate answers before the storage
# slot, so presign issuance is testable without a bucket. The presign happy
# path needs a configured provider — the runtime lane owns it (issue #625
# OQ8 → #695 Stage 1).
# The URL is pinned to the router's own path shape by `media_pipeline_tests`
# (issues #691/#713): {{ prefix }}/{id}/{field}/presign — the entity's path
# segment plus the nesting chain `router.tera` mounts a child entity under.

# authn — no credentials, rejected before the handler runs.
POST {{ presign_url }}
Content-Type: application/json
{"mime_type": "{{ mime }}"}

HTTP 401
[Asserts]
jsonpath "$.error.code" == "UNAUTHORIZED"

# ownership — a valid key against an id no row carries → 404, never 403.
POST {{ presign_url }}
{{ auth_header }}
Content-Type: application/json
{"mime_type": "{{ mime }}"}

HTTP 404
[Asserts]
jsonpath "$.error.code" == "NOT_FOUND"
{% endif %}
