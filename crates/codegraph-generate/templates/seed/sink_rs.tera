/// Tenant holding the default `platform.workflow_definition` rows that are
/// copied into the target organization.
const DEFAULT_TENANT_ID: Uuid = Uuid::nil();

/// Sentinels used when the caller does not supply `--api-key-id`/`--user-id`.
/// RLS for the `app_user` role authorizes on `app.organization_id` only.
const NIL_API_KEY_ID: Uuid = Uuid::nil();
const NIL_USER_ID: Uuid = Uuid::nil();

/// Per-item context threaded through every command-handler call.
#[derive(Clone)]
struct SeedCtx {
    source: SourceContext,
    correlation_id: Uuid,
    api_key_id: Uuid,
    organization_id: Uuid,
    user_id: Uuid,
}

fn count_ok(results: &[Result<Uuid, crate::error::BulkItemError>]) -> usize {
    results.iter().filter(|r| r.is_ok()).count()
}

fn warn_errors(results: &[Result<Uuid, crate::error::BulkItemError>]) {
    for err in results.iter().filter_map(|r| r.as_ref().err()) {
        tracing::warn!(index = err.index, error = %err.error, "seed item failed");
    }
}

/// Distribute `items` across `parents` round-robin. Deterministic; keeps
/// foreign keys valid when the seed output carries no explicit parent link.
fn group_by_parent<T: Clone>(items: &[T], parents: &[Uuid]) -> Vec<(Uuid, Vec<T>)> {
    if parents.is_empty() {
        return Vec::new();
    }
    let mut groups: Vec<(Uuid, Vec<T>)> = parents.iter().map(|p| (*p, Vec::new())).collect();
    let group_count = groups.len();
    for (idx, item) in items.iter().enumerate() {
        groups[idx % group_count].1.push(item.clone());
    }
    groups
}

pub struct AppStateSeedSink {
    state: Arc<AppState>,
    api_key_id: Uuid,
    user_id: Uuid,
}

impl AppStateSeedSink {
    pub fn new(state: Arc<AppState>) -> Self {
        Self {
            state,
            api_key_id: NIL_API_KEY_ID,
            user_id: NIL_USER_ID,
        }
    }

    pub fn with_api_key_id(mut self, api_key_id: Uuid) -> Self {
        self.api_key_id = api_key_id;
        self
    }

    pub fn with_user_id(mut self, user_id: Uuid) -> Self {
        self.user_id = user_id;
        self
    }

    /// Mint a dedicated seed API key via `public.create_api_key` when the
    /// caller did not supply one. Several RLS policies (person, position,
    /// timecard, ...) reject inserts whose `app.current_api_key` is the nil
    /// UUID unless the session also carries an owner/admin account role.
    async fn resolve_api_key_id(&self, organization_id: Uuid) -> Result<Uuid, SeedError> {
        if !self.api_key_id.is_nil() {
            return Ok(self.api_key_id);
        }
        let statement = Statement::from_string(
            DatabaseBackend::Postgres,
            format!(
                "SELECT public.create_api_key('{organization_id}', 'seed-provision', '[\"*\"]'::jsonb)::text AS id"
            ),
        );
        let row = sea_orm::ConnectionTrait::query_one(&self.state.db, statement)
            .await
            .map_err(|e| SeedError::Internal(format!("create_api_key: {e}")))?
            .ok_or_else(|| {
                SeedError::Internal("create_api_key returned no row".to_string())
            })?;
        let json: String = row
            .try_get::<String>("", "id")
            .map_err(|e| SeedError::Internal(format!("create_api_key column: {e}")))?;
        let parsed: serde_json::Value = serde_json::from_str(&json)
            .map_err(|e| SeedError::Internal(format!("create_api_key json: {e}")))?;
        let id = parsed
            .get("id")
            .and_then(|v| v.as_str())
            .and_then(|s| Uuid::parse_str(s).ok())
            .ok_or_else(|| SeedError::Internal("create_api_key id missing".to_string()))?;
        tracing::info!(api_key_id = %id, "minted seed API key");
        Ok(id)
    }
}

#[async_trait]
impl SeedSink for AppStateSeedSink {
    async fn init_workflows(&self, organization_id: Uuid) -> Result<(), SeedError> {
        let sql = "INSERT INTO platform.workflow_definition \
                   (tenant_id, name, domain, entity_table, status_field, approval_status_field, \
                    initial_state, terminal_states, state_machine, version) \
                   SELECT $1, name, domain, entity_table, status_field, approval_status_field, \
                          initial_state, terminal_states, state_machine, version \
                   FROM platform.workflow_definition \
                   WHERE tenant_id = $2 \
                   ON CONFLICT (tenant_id, domain, entity_table, version) DO NOTHING";
        let statement = Statement::from_sql_and_values(
            DatabaseBackend::Postgres,
            sql,
            [organization_id.into(), DEFAULT_TENANT_ID.into()],
        );
        sea_orm::ConnectionTrait::execute(&self.state.db, statement)
            .await
            .map_err(|e| SeedError::Internal(format!("init_workflows: {e}")))?;
        Ok(())
    }

    async fn persist(
        &self,
        organization_id: Uuid,
        output: &SeedOutput,
    ) -> Result<PersistSummary, SeedError> {
        let api_key_id = self.resolve_api_key_id(organization_id).await?;
        let ctx = SeedCtx {
            source: SourceContext::api(),
            correlation_id: Uuid::new_v4(),
            api_key_id,
            organization_id,
            user_id: self.user_id,
        };
        let mut summary = PersistSummary::default();

        // Root entities first; created ids feed parent-scoped children.
        {% raw %}
        macro_rules! bulk_ids {
            ($field:ident, $handler:expr, $items:expr) => {{
                let results = $handler
                    .bulk_create(
                        $items.to_vec(),
                        ctx.source.clone(),
                        ctx.correlation_id,
                        ctx.api_key_id,
                        ctx.organization_id,
                        ctx.user_id,
                    )
                    .await;
                let ids: Vec<Uuid> = results
                    .iter()
                    .filter_map(|r| r.as_ref().ok().copied())
                    .collect();
                summary.$field = ids.len();
                warn_errors(&results);
                ids
            }};
        }
        macro_rules! bulk {
            ($field:ident, $handler:expr, $items:expr) => {{
                let results = $handler
                    .bulk_create(
                        $items.to_vec(),
                        ctx.source.clone(),
                        ctx.correlation_id,
                        ctx.api_key_id,
                        ctx.organization_id,
                        ctx.user_id,
                    )
                    .await;
                summary.$field = count_ok(&results);
                warn_errors(&results);
            }};
        }
        // Parent-scoped children: one bulk_create per parent chunk.
        macro_rules! bulk_grouped {
            ($field:ident, $handler:expr, $items:expr, $parents:expr) => {{
                let mut ok = 0usize;
                for (parent_id, chunk) in group_by_parent($items, $parents) {
                    let results = $handler
                        .bulk_create(
                            chunk,
                            parent_id,
                            ctx.source.clone(),
                            ctx.correlation_id,
                            ctx.api_key_id,
                            ctx.organization_id,
                            ctx.user_id,
                        )
                        .await;
                    ok += count_ok(&results);
                    warn_errors(&results);
                }
                summary.$field = ok;
            }};
        }
        {% endraw %}

        let person_ids = bulk_ids!(persons, self.state.common_person_commands, &output.common.persons);
        let worker_ids = bulk_ids!(workers, self.state.common_worker_commands, &output.common.workers);
        // Positions reference each other via reports_to_position_id and are
        // ordered managers-first in the seed output; `bulk_create` gives no
        // ordering guarantees, so insert sequentially. Each position's
        // pre-generated id rides in `document_id` (scheme "position-self")
        // and is remapped to the created DB id.
        {
            let mut fake_to_real: HashMap<Uuid, Uuid> = HashMap::new();
            let mut created = 0usize;
            for position in &output.common.positions {
                let mut position = position.clone();
                let fake_id = position
                    .document_id
                    .as_ref()
                    .filter(|d| d.scheme_id.as_deref() == Some("position-self"))
                    .and_then(|d| Uuid::parse_str(&d.value).ok());
                position.document_id = None;
                if let Some(reports_to) = position.reports_to_position_id.take() {
                    position.reports_to_position_id = fake_to_real.get(&reports_to).copied();
                }
                match self
                    .state
                    .common_position_commands
                    .create(
                        position,
                        ctx.source.clone(),
                        ctx.correlation_id,
                        api_key_id,
                        organization_id,
                        self.user_id,
                    )
                    .await
                {
                    Ok(id) => {
                        created += 1;
                        if let Some(fake) = fake_id {
                            fake_to_real.insert(fake, id);
                        }
                    }
                    Err(e) => tracing::warn!(error = %e, "seed position failed"),
                }
            }
            summary.positions = created;
        }
        // Certifications are person-scoped (`certification.person_type_id`).
        bulk_grouped!(certifications, self.state.common_certification_commands, &output.common.certifications, &person_ids);
        bulk_grouped!(work_assignments, self.state.common_work_assignment_commands, &output.common.work_assignments, &worker_ids);
        bulk_grouped!(deployments, self.state.common_deployment_commands, &output.common.deployments, &worker_ids);
        bulk!(compensations, self.state.compensation_compensation_commands, &output.domains.compensation.compensations);

        let setup_ids = bulk_ids!(payroll_setups, self.state.payroll_payroll_setup_commands, &output.domains.payroll.payroll_setups);
        bulk_grouped!(payroll_instructions, self.state.payroll_payroll_instructions_commands, &output.domains.payroll.payroll_instructions, &setup_ids);
        bulk_grouped!(payment_instructions, self.state.payroll_payment_instructions_commands, &output.domains.payroll.payment_instructions, &setup_ids);

        let enrollment_ids = bulk_ids!(enrollments, self.state.benefits_enrollment_commands, &output.domains.benefits.enrollments);
        bulk_grouped!(elections, self.state.benefits_election_commands, &output.domains.benefits.elections, &enrollment_ids);
        bulk_grouped!(dependents, self.state.benefits_dependent_commands, &output.domains.benefits.dependents, &enrollment_ids);

        // Timecard pay rates ride inside each timecard (nested create in the
        // repository), so the flat list needs no separate write.
        bulk!(timecards, self.state.timecard_timecard_commands, &output.domains.timecard.timecards);
        bulk!(leave_requests, self.state.timecard_leave_request_commands, &output.domains.timecard.leave_requests);

        bulk!(candidates, self.state.recruiting_candidate_commands, &output.domains.recruiting.candidates);
        bulk!(position_openings, self.state.recruiting_position_opening_commands, &output.domains.recruiting.position_openings);
        bulk!(job_postings, self.state.recruiting_job_posting_commands, &output.domains.recruiting.job_postings);

        // Organizations: the first org is the company root; the rest are
        // departments whose `parent_organization_id` carries a pre-generated
        // id. Create the root first, then point every child at the real id.
        {
            let orgs = output.common.organizations.as_slice();
            if let Some((root, children)) = orgs.split_first() {
                let root_ids = bulk_ids!(
                    organizations,
                    self.state.common_organization_commands,
                    std::slice::from_ref(root)
                );
                let children: Vec<_> = children
                    .iter()
                    .map(|o| {
                        let mut o = o.clone();
                        o.parent_organization_id = root_ids.first().copied();
                        o
                    })
                    .collect();
                let child_ids = bulk_ids!(
                    organizations,
                    self.state.common_organization_commands,
                    &children
                );
                summary.organizations = root_ids.len() + child_ids.len();
            }
        }

        // Screening orders pre-generate their ids in `document_id`; map them
        // to the real DB ids so screenings/reports can link validly.
        let order_ids = bulk_ids!(screening_orders, self.state.screening_order_commands, &output.domains.screening.orders);
        let mut order_map: HashMap<Uuid, Uuid> = HashMap::new();
        for (req, id) in output.domains.screening.orders.iter().zip(order_ids.iter()) {
            if let Some(fake) = req
                .document_id
                .as_ref()
                .filter(|d| d.scheme_id.as_deref() == Some("screening-order"))
                .and_then(|d| Uuid::parse_str(&d.value).ok())
            {
                order_map.insert(fake, *id);
            }
        }
        // Screenings optionally reference a screening report; reports are
        // created after screenings and mapped per order, so the fake report
        // link must not block the screening insert.
        let screenings: Vec<_> = output
            .domains
            .screening
            .screenings
            .iter()
            .map(|s| {
                let mut s = s.clone();
                s.order_id = s
                    .order_id
                    .and_then(|fake| order_map.get(&fake).copied());
                s.report_id = None;
                s
            })
            .collect();
        bulk!(screenings, self.state.screening_screening_commands, &screenings);

        // Reports carry their parent order per item; loop `create` so each
        // lands under the right order (fallback: round-robin, none: skip).
        let mut reports_ok = 0usize;
        for (idx, report) in output.domains.screening.screening_reports.iter().enumerate() {
            let parent = report
                .order_id
                .as_ref()
                .and_then(|d| Uuid::parse_str(&d.value).ok())
                .and_then(|fake| order_map.get(&fake).copied())
                .or_else(|| order_ids.get(idx % order_ids.len().max(1)).copied());
            let Some(parent_id) = parent else {
                continue;
            };
            match self
                .state
                .screening_screening_report_commands
                .create(
                    report.clone(),
                    parent_id,
                    ctx.source.clone(),
                    ctx.correlation_id,
                    ctx.api_key_id,
                    ctx.organization_id,
                    ctx.user_id,
                )
                .await
            {
                Ok(_) => reports_ok += 1,
                Err(e) => tracing::warn!(index = idx, error = %e, "seed screening report failed"),
            }
        }
        summary.screening_reports = reports_ok;

        bulk!(asynchronous_orders, self.state.interviewing_asynchronous_order_commands, &output.domains.interviewing.asynchronous_orders);
        // Interview orders pre-generate their ids in `document_id` (scheme
        // "interview-order"); map fake → real so interviews link validly.
        let sync_order_ids = bulk_ids!(synchronous_orders, self.state.interviewing_synchronous_order_commands, &output.domains.interviewing.synchronous_orders);
        let mut sync_order_map: HashMap<Uuid, Uuid> = HashMap::new();
        for (req, id) in output
            .domains
            .interviewing
            .synchronous_orders
            .iter()
            .zip(sync_order_ids.iter())
        {
            if let Some(fake) = req
                .document_id
                .as_ref()
                .filter(|d| d.scheme_id.as_deref() == Some("interview-order"))
                .and_then(|d| Uuid::parse_str(&d.value).ok())
            {
                sync_order_map.insert(fake, *id);
            }
        }
        let interviews: Vec<_> = output
            .domains
            .interviewing
            .interviews
            .iter()
            .map(|iv| {
                let mut iv = iv.clone();
                iv.synchronous_order_id = iv
                    .synchronous_order_id
                    .and_then(|fake| sync_order_map.get(&fake).copied());
                iv
            })
            .collect();
        bulk!(interviews, self.state.interviewing_interview_commands, &interviews);

        // Assessment catalogs/reports are nested inside each assessment, so
        // the flat lists need no separate write.
        bulk!(assessments, self.state.assessments_assessment_commands, &output.domains.assessments.assessments);
        bulk!(wellness, self.state.wellness_wellness_commands, &output.domains.wellness.wellness);

        Ok(summary)
    }
