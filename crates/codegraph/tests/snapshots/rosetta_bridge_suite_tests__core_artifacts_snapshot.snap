ddl: "-- Generated by codegraph. DO NOT EDIT.\n-- Table: store.order\n\nCREATE SCHEMA IF NOT EXISTS extensions;\n\n\n\nCREATE SCHEMA IF NOT EXISTS store;\n\nCREATE TABLE IF NOT EXISTS store.\"order\" (\n\n    id UUID NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY,\n\n\n    platform_organization_id UUID NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000'::UUID,\n\n\n    \"label\" TEXT,\n\n\n    placed_on TIMESTAMPTZ,\n\n\n    status TEXT NOT NULL,\n\n\n    tags TEXT[],\n\n\n    total DOUBLE PRECISION NOT NULL,\n\n\n    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n\n\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n\n\n\n\n    deleted_at TIMESTAMPTZ NULL,\n    deleted_by UUID NULL,\n    updated_by UUID NULL,\n    is_demo_data BOOLEAN NOT NULL DEFAULT false\n\n);\n\n-- App role DML (RLS policies gate rows; this grants base table access)\nGRANT SELECT, INSERT, UPDATE, DELETE ON TABLE store.\"order\" TO app_user;\n\n\nDO $$ BEGIN\n  ALTER TABLE store.\"order\" ADD CONSTRAINT fk_order_status FOREIGN KEY (status) REFERENCES common.order_status(code) ON DELETE RESTRICT;\nEXCEPTION\n  WHEN duplicate_object THEN NULL;  -- constraint already exists\n  WHEN undefined_table OR invalid_schema_name THEN\n    RAISE NOTICE 'FK target not yet created: common.order_status — will be added by deferred_fks migration';\nEND $$;\n\n\n\n\n-- Child table: store.order_customer\nCREATE TABLE IF NOT EXISTS store.order_customer (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    order_id UUID NOT NULL,\n\n    platform_organization_id UUID NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000'::UUID,\n\n    customer_id TEXT NOT NULL,\n\n    \"name\" TEXT NOT NULL,\n\n\n    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nGRANT SELECT, INSERT, UPDATE, DELETE ON TABLE store.order_customer TO app_user;\n\nALTER TABLE store.order_customer ADD CONSTRAINT fk_order_customer_parent FOREIGN KEY (order_id) REFERENCES store.\"order\"(id) ON DELETE CASCADE;\n\nCREATE INDEX idx_order_customer_parent ON store.order_customer(order_id);\n\n\n\n\n-- Child table: store.order_partner\nCREATE TABLE IF NOT EXISTS store.order_partner (\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    order_id UUID NOT NULL,\n\n    platform_organization_id UUID NOT NULL DEFAULT '00000000-0000-0000-0000-000000000000'::UUID,\n\n    partner_id TEXT NOT NULL,\n\n\n    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n    updated_at TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nGRANT SELECT, INSERT, UPDATE, DELETE ON TABLE store.order_partner TO app_user;\n\nALTER TABLE store.order_partner ADD CONSTRAINT fk_order_partner_parent FOREIGN KEY (order_id) REFERENCES store.\"order\"(id) ON DELETE CASCADE;\n\nCREATE INDEX idx_order_partner_parent ON store.order_partner(order_id);\n\n\n\n\n"
entity: "//! SeaORM entity for Order.\n//! Generated by codegraph. DO NOT EDIT.\n\nuse sea_orm::entity::prelude::*;\n\n#[derive(Clone, Debug, Default, PartialEq, DeriveEntityModel)]\n#[sea_orm(schema_name = \"store\", table_name = \"order\")]\npub struct Model {\n\n\n    #[sea_orm(primary_key, auto_increment = false)]\n\n    pub id: Uuid,\n\n\n    pub platform_organization_id: Uuid,\n\n\n    pub label: Option<String>,\n\n\n    pub placed_on: Option<chrono::DateTime<chrono::Utc>>,\n\n\n    pub status: String,\n\n\n    pub tags: Option<Vec<String>>,\n\n\n    pub total: f64,\n\n\n    pub created_at: chrono::DateTime<chrono::Utc>,\n\n\n    pub updated_at: chrono::DateTime<chrono::Utc>,\n\n\n    pub deleted_at: Option<chrono::DateTime<chrono::Utc>>,\n\n\n    pub deleted_by: Option<Uuid>,\n\n\n    pub updated_by: Option<Uuid>,\n\n\n    pub is_demo_data: bool,\n\n}\n\n#[derive(Copy, Clone, Debug, EnumIter, DeriveRelation)]\npub enum Relation {\n\n}\n\nimpl ActiveModelBehavior for ActiveModel {}\n\n\n"
