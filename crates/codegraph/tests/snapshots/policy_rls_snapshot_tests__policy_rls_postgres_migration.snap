-- Policy-derived row level security — generated by codegraph. DO NOT EDIT.
--
-- Source: the rexlang actor policy graph (the `.actor` policy ingested with
-- the IFML model). ADDITIVE with the domains.toml-driven RLS in the
-- per-entity `{schema}_{table}_rls.sql` migrations: Postgres OR-combines
-- PERMISSIVE policies, so these grants can only widen access; the
-- RESTRICTIVE org-isolation/scope/role policies AND on top unchanged.
-- `forbid` grants are emitted as REVOKE (auditable privilege removal, not
-- row filtering).
--
-- Role mapping: human actors become NOLOGIN group roles (snake_case);
-- agent actors map to the existing gateway role app_user (they never hold
-- DB credentials). Attach a human role to a login user with
-- `GRANT <role> TO <user>` to activate its policies.

-- Policy roles (human actors)

DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'auditor') THEN
    CREATE ROLE "auditor" NOLOGIN;
  END IF;
END $$;

DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'recruiter') THEN
    CREATE ROLE "recruiter" NOLOGIN;
  END IF;
END $$;




-- capability `ArchiveCandidate` (class CandidateType) on recruiting.candidate


CREATE POLICY "policy_archive_candidate" ON recruiting.candidate
  FOR ALL TO auditor, recruiter
  USING ((internal IS NOT NULL))
  WITH CHECK ((internal IS NOT NULL));
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE recruiting.candidate TO auditor, recruiter;


-- capability `ReviewCandidate` (class recruiting::CandidateType) on recruiting.candidate

REVOKE ALL ON TABLE recruiting.candidate FROM app_user;


CREATE POLICY "policy_review_candidate" ON recruiting.candidate
  FOR ALL TO auditor, recruiter
  USING (true)
  WITH CHECK (true);
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE recruiting.candidate TO auditor, recruiter;
