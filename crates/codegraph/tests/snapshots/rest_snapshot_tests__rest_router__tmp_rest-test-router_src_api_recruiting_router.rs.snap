//! Router for recruiting domain.
//! Generated by codegraph. DO NOT EDIT.

use axum::Router;

use crate::app_state::AppState;
use crate::middleware::permission::PermissionGuard as _;

// Handwritten extensions — create this file to add custom routes.
// #[path = "handwritten_routes.rs"]
// mod handwritten_routes;

pub fn router() -> Router<AppState> {
    Router::new()


        .nest("/candidates", candidate_routes())


}


fn candidate_routes() -> Router<AppState> {
    use super::candidate_handler;



    Router::new()

        .route(
            "/",
            axum::routing::get(candidate_handler::list).guard("candidates", "list")
                .merge(axum::routing::post(candidate_handler::create).guard("candidates", "create")),
        )


        .route(
            "/{candidate_id}",
            axum::routing::get(candidate_handler::get_by_id).guard("candidates", "read")
                .merge(axum::routing::put(candidate_handler::update).guard("candidates", "update"))
                .merge(axum::routing::delete(candidate_handler::delete).guard("candidates", "delete")),
        )






}
