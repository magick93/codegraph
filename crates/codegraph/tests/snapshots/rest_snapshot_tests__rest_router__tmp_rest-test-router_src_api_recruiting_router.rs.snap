//! Router for recruiting domain.
//! Generated by codegraph. DO NOT EDIT.

use axum::Router;

use crate::app_state::AppState;

pub fn router() -> Router<AppState> {
    Router::new()


        .nest("/candidates", candidate_routes())


}


fn candidate_routes() -> Router<AppState> {
    use super::candidate_handler;



    Router::new()

        .route("/", axum::routing::get(candidate_handler::list).post(candidate_handler::create))


        .route("/{candidate_id}", axum::routing::get(candidate_handler::get_by_id).put(candidate_handler::update).delete(candidate_handler::delete))






}
