import { test, expect } from '../../e2e/fixtures/personas';
import { createEntityAsAcme, createEntityViaApi, deleteEntityViaApi, expectToast, expectTableContains, expectTableNotContains, waitForHydration } from '../../e2e/helpers';
import type { OrgContext } from '../../e2e/fixtures/personas';


const BASE_PATH = '/hr/worker';


// Entity reference dependency IDs — populated in beforeAll when FK deps exist

const depIds: Record<string, string | string[]> = {};


function testData(): Record<string, unknown> {
  return {
    'name': 'Test Name',
    // 'person_id': entity ref — emitted by _dep_setup.tera
    // 'parties': entity ref — emitted by _dep_setup.tera


    ...(depIds['person_id'] ? { 'person_id': depIds['person_id'] } : {}),

    ...(depIds['parties'] ? { 'parties': depIds['parties'] } : {}),

  };
}

function updatedData(): Record<string, unknown> {
  return {
    'name': 'Updated Name',
    // 'person_id': entity ref — emitted by _dep_setup.tera
    // 'parties': entity ref — emitted by _dep_setup.tera


    ...(depIds['person_id'] ? { 'person_id': depIds['person_id'] } : {}),

    ...(depIds['parties'] ? { 'parties': depIds['parties'] } : {}),

  };
}

test.describe('Worker Owner CRUD', () => {


  test.beforeAll(async ({ orgContext }) => {




    const dep_1 = await createEntityAsAcme(orgContext, '/platform/tenant', { 'legal_name': 'Test Legal Name' });
    depIds['tenant_id'] = dep_1['id'] as string;

    const dep_2 = await createEntityAsAcme(orgContext, '/hr/person', { 'full_name': 'Test Full Name', 'tenant_id': depIds['tenant_id'] });
    depIds['person_id'] = dep_2['id'] as string;

    const dep_3 = await createEntityAsAcme(orgContext, '/hr/party', { 'party_name': 'Test Party Name' });
    depIds['parties'] = [dep_3['id'] as string];

  });


  test.afterAll(async ({ orgContext }) => {

const baseUrl = process.env.PUBLIC_API_URL ?? 'http://localhost:3000';

    {
      const ids = depIds['parties'];
      if (ids) {
        for (const id of (Array.isArray(ids) ? ids : [ids])) {
          try {
            await fetch(`${baseUrl}/api/v1/hr/party/${id}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${orgContext.acme.apiKey}` },
            });
          } catch { /* best effort */ }
        }
      }
    }

    {
      const ids = depIds['person_id'];
      if (ids) {
        for (const id of (Array.isArray(ids) ? ids : [ids])) {
          try {
            await fetch(`${baseUrl}/api/v1/hr/person/${id}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${orgContext.acme.apiKey}` },
            });
          } catch { /* best effort */ }
        }
      }
    }

    {
      const ids = depIds['tenant_id'];
      if (ids) {
        for (const id of (Array.isArray(ids) ? ids : [ids])) {
          try {
            await fetch(`${baseUrl}/api/v1/platform/tenant/${id}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${orgContext.acme.apiKey}` },
            });
          } catch { /* best effort */ }
        }
      }
    }

  });



  let data: Record<string, unknown>;
  let updated: Record<string, unknown>;
  test.beforeEach(() => {
    data = testData();
    updated = updatedData();
  });



  test('owner can create Worker via form', async ({ ownerPage }) => {

    await ownerPage.goto(`${BASE_PATH}/new`);

    // Wait for SvelteKit to hydrate so the form's onsubmit handler is attached
    // Wait for Svelte 5 to hydrate the form's submit handler.
    await waitForHydration(ownerPage, '[data-testid="worker-submit-btn"]');
    if (await ownerPage.locator('#name').isVisible()) {
      await ownerPage.locator('#name').fill(String(data['name']));
    }
    if (data['person_id'] && await ownerPage.locator('#person_id').isVisible()) {
      await ownerPage.locator('#person_id').fill(String(data['person_id']));
    }
    if (data['parties'] && await ownerPage.locator('#parties').isVisible()) {
      await ownerPage.locator('#parties').fill(String(data['parties']));
    }
    await ownerPage.locator('[data-testid="worker-submit-btn"]').click();
    await expectToast(ownerPage, 'created', 'success');
    // Wait for SvelteKit goto() navigation to complete after toast

    await ownerPage.waitForURL(/\/hr\/worker\/[0-9a-f-]+$/, { timeout: 20_000 });

    const formCreatedId = ownerPage.url().split('/').pop()!;
  });




  test('owner sees Worker in list', async ({ ownerPage }) => {
    await ownerPage.goto(BASE_PATH);
    const table = ownerPage.locator('[data-testid="worker-table"]');
    const empty = ownerPage.locator('[data-testid="worker-empty"]');
    await expect(table.or(empty)).toBeVisible();
  });



  test('owner can view Worker detail', async ({ ownerPage, orgContext }) => {
    const entity = await createEntityAsAcme(orgContext, BASE_PATH, testData());
    const myId = entity['id'] as string;

    await ownerPage.goto(`${BASE_PATH}/${myId}`);

    await expect(ownerPage.locator('[data-testid="worker-field-name"]')).toBeVisible();
    await expect(ownerPage.locator('[data-testid="worker-field-person_id"]')).toBeVisible();
    await expect(ownerPage.locator('[data-testid="worker-field-parties"]')).toBeVisible();
  });




  test('owner can edit Worker', async ({ ownerPage, orgContext }) => {
    const entity = await createEntityAsAcme(orgContext, BASE_PATH, testData());
    const myId = entity['id'] as string;

    await ownerPage.goto(`${BASE_PATH}/${myId}/edit`);

    // Wait for Svelte 5 to hydrate the form's submit handler.
    await waitForHydration(ownerPage, '[data-testid="worker-submit-btn"]');
    if (await ownerPage.locator('#name').isVisible()) {
      await ownerPage.locator('#name').clear();
      await ownerPage.locator('#name').fill(String(updated['name']));
    }
    if (updated['person_id'] && await ownerPage.locator('#person_id').isVisible()) {
      await ownerPage.locator('#person_id').clear();
      await ownerPage.locator('#person_id').fill(String(updated['person_id']));
    }
    if (updated['parties'] && await ownerPage.locator('#parties').isVisible()) {
      await ownerPage.locator('#parties').clear();
      await ownerPage.locator('#parties').fill(String(updated['parties']));
    }
    await ownerPage.locator('[data-testid="worker-submit-btn"]').click();
    await expectToast(ownerPage, 'updated', 'success');
  });




  test('owner can delete Worker', async ({ ownerPage, orgContext }) => {
    const entity = await createEntityAsAcme(orgContext, BASE_PATH, testData());
    const myId = entity['id'] as string;

    await ownerPage.goto(`${BASE_PATH}/${myId}`);

    await waitForHydration(ownerPage, '[data-testid="worker-delete-btn"]');
    await ownerPage.locator('[data-testid="worker-delete-btn"]').click();
    // Wait for portal-rendered confirm dialog
    await expect(ownerPage.locator('[data-testid="confirm-dialog"]')).toBeVisible({ timeout: 20_000 });
    await ownerPage.locator('[data-testid="confirm-dialog-confirm"]').click();
    await expectToast(ownerPage, 'deleted', 'success');
    await ownerPage.goto(BASE_PATH);
    // After delete, list may be empty (showing empty state) or table may not contain the deleted item
    const table = ownerPage.locator('[data-testid="worker-table"]');
    const empty = ownerPage.locator('[data-testid="worker-empty"]');
    await expect(table.or(empty)).toBeVisible();
  });

});
