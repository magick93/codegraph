	enum QuestionTypeEnum: <"Postgres enum qanda.question_type (column questions.answer_type). Final version; the earlier 'single_choice' value was dropped in the last recreation.">
		TEXT
		TSRANGE displayName "tsrange" <"Answer is a timestamp range.">
		BOOLEAN
		MULTIPLE_CHOICE displayName "multiple_choice"
		TIMESTAMPZ displayName "timestampz" <"Answer is a timestamp.">

	enum FormLayoutEnum: <"Postgres enum public.form_layout - JSON Forms layout types (camelCase literals preserved via displayName).">
		VERTICAL_LAYOUT displayName "VerticalLayout"
		HORIZONTAL_LAYOUT displayName "HorizontalLayout"
		GROUP
		CATEGORIZATION
		CONTROL

	enum AuctionTypeEnum: <"Postgres enum public.auction_type - supported auction mechanisms; the marketplace runs English auctions.">
		CANDLE <"Candle auction with randomised candle_end_time.">
		BLIND <"Sealed bids, no visibility.">
		ENGLISH <"Open ascending-bid auction; default.">
		DUTCH <"Open descending-price auction.">
		SEALED_BID displayName "sealed_bid"
		VICKREY <"Sealed second-price auction.">
		REVERSE <"Reverse (buyer-driven) auction.">
		MULTI_UNIT displayName "multi_unit"
		PENNY <"Penny auction.">
		ALL_PAY displayName "all_pay"
		DOUBLE

	enum ReminderTypeEnum: <"Postgres enum public.reminder_type (column lead_watch_list.reminder).">
		NO_EMAIL_REMINDER displayName "no_email_reminder" <"Default - watch only, no email.">
		ONE_HOUR_BEFORE_CLOSING displayName "1_hour_before_closing"
		TWELVE_HOURS_BEFORE_CLOSING displayName "12_hours_before_closing"
		TWENTY_FOUR_HOURS_BEFORE_CLOSING displayName "24_hours_before_closing"

