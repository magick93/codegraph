namespace flywheel.common
: <"
    Shared primitives, value structures and code lists for the Flywheel
    domain model. Recreated from the Flywheel Postgres (Supabase) schema.

    Conventions used throughout the model:
    - Postgres uuid             -> Uuid (string typeAlias, [metadata id] marks primary keys)
    - Postgres timestamptz      -> zonedDateTime
    - Postgres timestamp        -> dateTime
    - Postgres numeric(p,s)     -> number(fractionalDigits: s)
    - Postgres text/varchar(n)  -> string / string(maxLength: n)
    - Postgres citext           -> string (case-insensitive semantics documented)
    - Postgres domains          -> typeAlias
    - Postgres ranges           -> explicit range types (lower/upper bounds)
    - Postgres jsonb columns    -> fully modelled structures (lead dossier, job
                                   application state, addresses, locales, purchase metadata)
    - Postgres CHECK constraints -> condition components

    All enumerations (postgres CREATE TYPE ... AS ENUM) live in this shared
    namespace so codelist tables and seeds route through the common domain.
">

version "1.0.0"

	typeAlias Uuid: <"Postgres uuid / gen_random_uuid(). Primary keys of this type are annotated with [metadata id]."> string(pattern: "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")

	typeAlias Slug: <"URL-safe identifier, e.g. company.slug, professional_profile.slug_name, posts.slug."> string(pattern: "[a-z0-9-]*")

	typeAlias SmallText: <"Postgres domain-equivalent of inbox.smalltext: text with length at most 255 characters."> string(maxLength: 255)

	typeAlias EmailAddress: <"Postgres citext email address; comparison is case-insensitive."> string

	typeAlias Money: <"Monetary amount, e.g. postgres numeric(18,2)."> number(digits: 18, fractionalDigits: 2)

	typeAlias PositiveMoney: <"Postgres domain public.positive_money: numeric(15,2) CHECK (value >= 0)."> number(digits: 15, fractionalDigits: 2, min: 0)

	typeAlias RgbComponent: <"Postgres domain brandstation.rgb_component: smallint CHECK (value BETWEEN 0 AND 255)."> number(digits: 4, fractionalDigits: 0, min: 0, max: 255)

	typeAlias Percent: <"Percentage value, e.g. company_plan.discount_percentage numeric(5,2)."> number(digits: 5, fractionalDigits: 2, min: 0, max: 100)

	typeAlias Tsid: <"Postgres bigint time-sorted identifier generated by generate_tsid() (42-bit timestamp + 12-bit random + 10-bit counter). Used for job_posts.id, job_applications.id, leads.id, auction.id, auction_bids.id."> number(digits: 18, fractionalDigits: 0, min: 0)

	typeAlias SearchVector: <"Postgres tsvector full-text search column (trigger-maintained). Modelled as a string; indexing is database infrastructure."> string

	typeAlias JsonSchema: <"A JSON Schema document stored in a Postgres jsonb column (e.g. forms.schema, templating.templates.jsonschema). Kept as a string because it defines the shape of other payloads rather than being domain data itself."> string

	type LtrPath: <"Postgres ltree material path, e.g. comments.path.">
		path string (1..1) <"Dot-separated ancestor labels, e.g. 'root.child.grandchild'.">

	type IntRange: <"Postgres int4range, e.g. company_plan.user_range.">
		lower int (0..1) <"Inclusive lower bound.">
		upper int (0..1) <"Exclusive upper bound.">
		condition LowerBeforeUpper:
			if lower exists and upper exists
			then lower <= upper

	type MoneyRange: <"Postgres numrange, e.g. job_posts.pay_range.">
		lower Money (0..1) <"Inclusive lower bound.">
		upper Money (0..1) <"Inclusive upper bound.">

	type DateTimeRange: <"Postgres tstzrange, e.g. company_plan.discount_duration, company_page.publication_date_range.">
		start zonedDateTime (0..1) <"Inclusive start of the range.">
		end zonedDateTime (0..1) <"Exclusive end of the range.">

	type RgbColor: <"RGB colour triplet stored as three brandstation.rgb_component smallints.">
		red RgbComponent (1..1) <"Red channel, 0-255.">
		green RgbComponent (1..1) <"Green channel, 0-255.">
		blue RgbComponent (1..1) <"Blue channel, 0-255.">

	type Bcp47Locale: <"Postgres jsonb column company.bcp_47_locale: an IETF BCP-47 language tag decomposed into subtags.">
		language string (1..1) <"ISO 639 language subtag, e.g. 'en' or 'mi'.">
		script string (0..1) <"ISO 15924 script subtag, e.g. 'Latn'.">
		region string (0..1) <"ISO 3166-1 region subtag, e.g. 'NZ'.">

	type GeoPoint: <"PostGIS extensions.geometry(point, 4167) - a WGS 1984 (NZGD2000) geographic point.">
		latitude number (1..1) <"Latitude in decimal degrees (GD2000 / EPSG:4167).">
		longitude number (1..1) <"Longitude in decimal degrees (GD2000 / EPSG:4167).">

	type GeoPolygon: <"PostGIS extensions.geometry(multipolygon, 4167) - district/suburb boundary.">
		boundary string (1..1) <"Multipolygon geometry serialised as GeoJSON or WKT; storage detail is database infrastructure.">

	type HstoreEntry: <"One key/value pair of a Postgres hstore column, e.g. form_inputs.options.">
		key string (1..1) <"Option key.">
		value string (0..1) <"Option value.">

	enum SystemProfileStatusEnum: <"Postgres enum public.system_profile_status (column professional_profile.sys_status, renamed from status).">
		ACTIVE <"Default for new profiles.">
		INACTIVE
		DELETED <"Soft deletion; user_deleted_at records when.">

	enum PronounsEnum: <"Postgres enum public.pronouns_enum (column preferred_pronouns.common_pronoun).">
		HE_HIM displayName "he_him" <"he/him">
		SHE_HER displayName "she_her" <"she/her">

	enum AccountRoleEnum: <"Basejump enum basejump.account_role; Flywheel adds the FINANCE value.">
		OWNER <"Primary owner of the account.">
		MEMBER
		FINANCE <"Added by Flywheel for billing access.">

	enum CompanyPageComponentEnum: <"Postgres enum public.company_page_component - the section types of a company page.">
		HERO <"Hero/banner section.">
		TESTIMONIALS <"Client testimonials section.">
		SERVICES <"Services listing section.">
		PEOPLE displayName "people" <"Team/people section; merged with SERVICES by a missing-comma defect in the original enum declaration.">

