namespace flywheel.jobs
: <"
    Demand side intake: job posts (briefs for professional help), their
    typebot/form sources and AI marketing copy, the job application state
    machine with its fully modelled applicant payload, and the community
    posts/comments/flags feature.
">

version "1.0.0"

import flywheel.common.*
import flywheel.profiles.*
import flywheel.company.*
import flywheel.accounts.*
import flywheel.qanda.*

	type JobMarketingElements: <"Structure of job_posts.marketing_elements jsonb (generated by the LLM job namer; fwdata JobMarketingElements).">
		jobTitle string (1..1) <"AI-generated job title.">
		jobSubtitle string (1..1) <"AI-generated subtitle.">
		emailSubject string (1..1) <"AI-generated marketing email subject.">
		emailPreheader string (1..1) <"AI-generated marketing email preheader.">

	type JobPost: <"Table public.job_posts - a brief posted by a business seeking a professional service provider. Origin of the lead-generation funnel.">
		[rootType]
		id Tsid (1..1) <"Primary key, default generate_tsid() - time-sorted bigint."> [metadata id]
		jobTitle string (1..1) <"Column job_title (originally varchar(256)).">
		content string (0..1) <"Full brief content.">
		author User (0..1) <"FK author -> auth.users(id) ON DELETE SET NULL, default auth.uid().">
		payRange MoneyRange (0..1) <"Column pay_range, numrange - budgeted pay for the role.">
		workType WorkTypeEnum (0..1) <"Column work_type.">
		jobPostDate date (0..1) <"Default CURRENT_DATE.">
		jobExpiryDate date (0..1) <"Trigger-set to published_on + 30 days.">
		experienceLevel string (0..1) <"Column experience_level, varchar(256).">
		qualifications string (0..*) <"Column qualifications, text[].">
		departmentCategory Uuid (0..1) <"Column department, varchar(256) - later repurposed to hold the category uuid.">
		publishedOn zonedDateTime (0..1) <"Column published_on.">
		account Account (0..1) <"FK account_id -> basejump.accounts(id) - posting workspace."> [metadata reference]
		source JobPostSourceEnum (0..1) <"CHECK source IN ('form','typebot') - intake channel.">
		typebotComplete boolean (1..1) <"Default FALSE - whether the typebot intake finished.">
		groupQuestion GroupQuestion (0..1) <"FK group_question_id -> qanda.group_questions.id - the onboarding question group that produced this post."> [metadata reference]
		typebotQuestionsEmailSentAt zonedDateTime (0..1) <"When the follow-up questions email was sent.">
		marketingElements JobMarketingElements (0..1) <"Column marketing_elements, jsonb - AI-generated title/subtitle/email copy.">

	type ExactBudget: <"fwdata ProposedBudgetSchema 'exact' branch.">
		budget Money (1..1) <"Exact budget disclosed by the business.">

	type RangeBudget: <"fwdata ProposedBudgetSchema 'range' branch.">
		minBudget Money (1..1) <"Column min_budget - lower bound.">
		maxBudget Money (1..1) <"Column max_budget - upper bound.">

	type MinimumHoursBudget: <"fwdata ProposedBudgetSchema 'minimum_hours' branch.">
		minHours number (1..1) <"Column min_hours.">
		hourlyRate Money (0..1) <"Column hourly_rate.">

	type NoBudget: <"fwdata ProposedBudgetSchema 'no_budget' branch - budget deferred with a reason.">
		reason NoBudgetReasonEnum (1..1)

	choice ProposedBudget: <"Union of budget disclosure options provided with a job application (fwdata ProposedBudgetSchema).">
		ExactBudget
		RangeBudget
		MinimumHoursBudget
		NoBudget

	type IndividualApplicant: <"fwdata ApplicantSchema - an individual professional applying personally.">
		jobTitle string (1..1)
		fullName string (1..1) <"Column applicant_fullname.">
		email EmailAddress (1..1)
		phone string (1..1)
		salaryExpectation Money (0..1) <"Column salary_expectation.">
		about string (0..1)
		attachments string (0..*) <"Attachment URLs.">

	type BusinessApplicant: <"fwdata BusinessApplicantSchema - a business applying for a job post.">
		businessName string (1..1) <"Column business_name.">
		contactPerson string (1..1)
		email EmailAddress (1..1)
		phone string (1..1)
		proposedBudget ProposedBudget (1..1)
		aboutBusiness string (0..1) <"Column about_business.">
		attachments string (0..*) <"Attachment URLs.">
		servicesOffered string (1..1) <"Column services_offered.">

	type LegalApplicant extends BusinessApplicant: <"fwdata LegalApplicantSchema - legal service provider applicant.">
		legalSpecialization string (1..1) <"Column legal_specialization - e.g. corporate law, intellectual property.">
		barAssociationMembership boolean (1..1) <"Column bar_association_membership.">
		yearsOfExperience int (0..1) <"Column years_of_experience.">

	type AccountingApplicant extends BusinessApplicant: <"fwdata AccountingApplicantSchema - accounting firm applicant.">
		accountingSpecialization string (1..1) <"Column accounting_specialization - e.g. tax, audit, financial advisory.">
		certifiedPublicAccountants boolean (1..1) <"Column certified_public_accountants.">
		yearsOfExperience int (0..1) <"Column years_of_experience.">

	type HrApplicant extends BusinessApplicant: <"fwdata HRApplicantSchema - HR/recruitment services applicant.">
		recruitmentSpecialization string (1..1) <"Column recruitment_specialization - e.g. tech, executive.">
		industriesServed string (0..*) <"Column industries_served, text[].">
		yearsOfExperience int (0..1) <"Column years_of_experience.">

	choice BusinessServiceProvider: <"Union of applicant payloads stored in job_applications.application_data jsonb (fwdata BusinessServiceProviderSchema); variant inferred by presence of discriminator attributes.">
		LegalApplicant
		AccountingApplicant
		HrApplicant
		BusinessApplicant
		IndividualApplicant

	type ApplicationStateContext: <"xstate state.context of a job application; job_applications.state -> 'context'.">
		application BusinessServiceProvider (0..1) <"Path state->'context'->'application' - the submitted applicant payload.">

	type ApplicationState: <"Structure of job_applications.state jsonb - a serialized xstate machine state.">
		value string (0..1) <"Path state->'value' - current machine state name.">
		context ApplicationStateContext (0..1) <"Path state->'context' - machine context.">

	type JobApplication: <"Table public.job_applications - a provider's application to a job post, tracked through an xstate review workflow. UNIQUE (job_id, professional_profile_id).">
		[rootType]
		id Tsid (1..1) <"Primary key, default generate_tsid()."> [metadata id]
		jobPost JobPost (1..1) <"FK job_id -> job_posts.id."> [metadata reference]
		professionalProfile ProfessionalProfile (0..1) <"FK professional_profile_id -> professional_profile.id - applicant profile when a registered professional."> [metadata reference]
		company Company (0..1) <"FK company_id -> company.id - applicant organisation."> [metadata reference]
		state ApplicationState (0..1) <"Column state, json (xstate).">
		nextEvents ApplicationEventEnum (0..*) <"Column next_events, text[] - events currently enabled in the state machine.">
		applicationData BusinessServiceProvider (0..1) <"Column application_data, jsonb - the submitted applicant payload.">
		lastEditBy ProfessionalProfile (0..1) <"FK last_edit_by -> professional_profile.id."> [metadata reference]
		condition ApplicantIdentified: <"CHECK professional_profile_id IS NOT NULL OR company_id IS NOT NULL.">
			if professionalProfile exists or company exists
			then True
			else False

	type JobApplicationHistory: <"Table public.job_application_history - audit trail of application state transitions, written by trigger when the state value changes.">
		id int (1..1) <"Surrogate key (postgres serial)."> [metadata id]
		jobApplication JobApplication (1..1) <"FK job_application_id -> job_applications.id."> [metadata reference]
		previousState string (0..1) <"Column previous_state, jsonb.">
		newState string (1..1) <"Column new_state, jsonb.">
		changedBy ProfessionalProfile (1..1) <"FK changed_by -> professional_profile.id."> [metadata reference]
		changedAt zonedDateTime (1..1) <"Default now().">

	type Post: <"Table public.posts - community/knowledge posts authored by professionals.">
		[rootType]
		id Uuid (1..1) <"Primary key."> [metadata id]
		author ProfessionalProfile (1..1) <"FK author_id -> professional_profile.id."> [metadata reference]
		title string (1..1)
		content string (1..1)
		slug Slug (1..1) <"Unique; CHECK slug ~ '^[a-z0-9-]+$'.">
		status PostStatusEnum (1..1) <"Default 'draft'.">
		publishedAt zonedDateTime (0..1)
		scheduledPublish zonedDateTime (0..1) <"Column scheduled_publish.">
		deletedAt zonedDateTime (0..1) <"Soft deletion.">

	type Comment: <"Table public.comments - threaded comments on posts; material path in comments.path (ltree, GiST indexed).">
		id Uuid (1..1) <"Primary key."> [metadata id]
		post Post (1..1) <"FK post_id -> posts.id."> [metadata reference]
		author ProfessionalProfile (1..1) <"FK author_id -> professional_profile.id."> [metadata reference]
		parentComment Comment (0..1) <"FK parent_comment_id -> comments.id - threading."> [metadata reference]
		content string (1..1) <"CHECK length(content) BETWEEN 1 AND 2000.">
		deletedAt zonedDateTime (0..1) <"Soft deletion.">
		deletedBy ProfessionalProfile (0..1) <"FK deleted_by -> professional_profile.id."> [metadata reference]
		path LtrPath (1..1) <"Column path, ltree NOT NULL - materialised ancestry path.">
		flaggedCount int (1..1) <"Default 0.">

	type CommentFlag: <"Table public.comment_flags - moderation flags on comments. UNIQUE (comment_id, flagged_by_id).">
		id Uuid (1..1) <"Primary key."> [metadata id]
		comment Comment (1..1) <"FK comment_id -> comments.id."> [metadata reference]
		flaggedBy ProfessionalProfile (1..1) <"FK flagged_by_id -> professional_profile.id."> [metadata reference]
		reason string (1..1)
		status FlagStatusEnum (1..1) <"Default 'pending'.">
		resolvedAt zonedDateTime (0..1)
		resolvedBy ProfessionalProfile (0..1) <"FK resolved_by -> professional_profile.id."> [metadata reference]
