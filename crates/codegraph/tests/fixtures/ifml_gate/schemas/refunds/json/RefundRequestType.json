{
  "$id": "RefundRequestType.json",
  "title": "RefundRequestType",
  "description": "A customer refund request tracked through an approval workflow",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short summary of the refund request"
    },
    "requesterEmail": {
      "type": "string",
      "format": "email",
      "description": "Email of the requesting customer"
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "description": "Refund amount in cents"
    },
    "urgent": {
      "type": "boolean",
      "description": "Whether the refund must be expedited"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the request was submitted"
    },
    "status": {
      "$ref": "../../common/json/codelist/RefundStatusCodeList.json",
      "description": "Workflow status of the request"
    },
    "reason": {
      "$ref": "../../common/json/codelist/RefundReasonCodeList.json",
      "description": "Reason code for the refund"
    },
    "channelCode": {
      "$ref": "../../common/json/codelist/RefundChannelCodeList.json",
      "description": "Channel the request arrived on (issue #835: `_code` is stripped from the DTO field)"
    },
    "escalation": {
      "$ref": "../../common/json/codelist/RefundEscalationCodeList.json",
      "description": "Escalation state driven by the action plane (WS6)"
    },
    "receipt": {
      "$ref": "MediaReferenceType.json",
      "description": "The uploaded receipt (issue #633: the media route's reference)"
    }
  },
  "required": [
    "title"
  ]
}
