package refunds

enum RefundStatus {
    draft = 0
    submitted = 1
    approved = 2
    rejected = 3
}

enum RefundEscalation {
    none = 0
    escalated = 1
}

/// The stored media reference (url + mime) — a contained value.
class MediaReference {
    String url
    String mimeType
}

class RefundRequest {
    String title
    int amount
    RefundStatus status
    RefundEscalation escalation
    contains MediaReference[0..1] receipt
}
