/// Set API key + org session variables within a transaction so Postgres RLS policies
/// can enforce tenant isolation and scope checks on read queries.
/// Cornucopia backend: runs against a tokio-postgres transaction.
async fn set_rls_session_vars(
    tx: &impl client::GenericClient,
    api_key_id: Uuid,
    organization_id: Uuid,
    user_id: Uuid,
) -> Result<(), {{ domain | pascal_case }}Error> {
    tx.execute(
        "SELECT set_config('app.current_api_key', $1, true), \
                set_config('app.organization_id', $2, true), \
                set_config('app.user_id', $3, true)",
        &[
            &api_key_id.to_string(),
            &organization_id.to_string(),
            &user_id.to_string(),
        ],
    ).await?;
    tx.execute("SET LOCAL ROLE app_user", &[]).await?;
    Ok(())
}
{% else %}
