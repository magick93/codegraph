use axum::http::{Method, StatusCode};
use cornucopia_queries::client::GenericClient;
use cornucopia_queries::queries::platform::platform;
use uuid::Uuid;

use crate::error::AppError;
use crate::middleware::{AuthInfo, AuthMode};

/// Enforce that the API key backing this request holds `{domain}.{entity}.{op}`
/// where `op` is derived from the HTTP method (GET/HEAD -> read, else write).
/// Non-API-key callers always pass.
pub async fn require_scope(
    _client: &impl GenericClient,
    auth: &AuthInfo,
    domain: &str,
    entity: &str,
    method: &Method,
) -> Result<(), AppError> {
    if !matches!(auth.auth_mode, AuthMode::ApiKey { .. }) {
        return Ok(());
    }

    // Scopes ride the auth payload (verify_api_key -> AuthInfo) — no second
    // query against api_keys_private, which the app role cannot read.
    let scopes = &auth.scopes;
    let operation = match method.as_str() {
        "GET" | "HEAD" => "read",
        _ => "write",
    };
    if has_scope(&scopes, domain, entity, operation) {
        return Ok(());
    }

    let required = format!("{domain}.{entity}.{operation}");
    Err(AppError {
        status: StatusCode::FORBIDDEN,
        code: "INSUFFICIENT_SCOPE",
        message: format!("API key lacks scope {required}"),
        details: None,
        correlation_id: None,
    })
}

/// Scope matcher shared with the platform guard: exact match, `{domain}.*`
/// domain wildcard, or the global `"*"` / `"admin"` wildcards.
pub fn has_scope(scopes: &[String], domain: &str, entity: &str, operation: &str) -> bool {
    let domain_wildcard = format!("{domain}.*");
    let required = format!("{domain}.{entity}.{operation}");
    scopes.iter().any(|scope| {
        scope == "*" || scope == "admin" || scope == &domain_wildcard || scope == &required
    })
}

/// Route-level middleware for generated entity routes. Reads the caller's
/// `AuthInfo` and the worker's `ClientSource` (injected into request extensions
/// by `worker.rs` — route-level layers cannot access router state), acquires a
/// per-request cornucopia client, and enforces `{domain}.{entity}.{read|write}`
/// for API-key callers. Unknown callers pass through untouched; a missing
/// client source or client-acquire failure denies closed (never bypasses).
pub async fn require_scope_for_request(
    request: axum::extract::Request,
    next: axum::middleware::Next,
    domain: &str,
    entity: &str,
) -> axum::response::Response {
    use axum::response::IntoResponse;

    let auth = match request.extensions().get::<AuthInfo>() {
        Some(auth) => auth.clone(),
        // No verified caller — nothing to scope-check (auth middleware denies
        // unauthenticated requests before we ever run).
        None => return next.run(request).await,
    };
    let client_source = match request
        .extensions()
        .get::<std::sync::Arc<dyn crate::db_client::ClientSource>>()
    {
        Some(source) => source.clone(),
        None => {
            tracing::error!("ClientSource extension missing; denying scoped request");
            return AppError::internal("Scope enforcement unavailable").into_response();
        }
    };
    let client = match client_source.client().await {
        Ok(client) => client,
        Err(e) => {
            tracing::error!(error = %e, "scope check could not acquire db client");
            return AppError::internal("Scope enforcement unavailable").into_response();
        }
    };
    match require_scope(&client, &auth, domain, entity, request.method()).await {
        Ok(()) => next.run(request).await,
        Err(e) => e.into_response(),
    }
}

