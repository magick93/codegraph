---
import Base from "../../layouts/Base.astro";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";

/**
 * GENERATED by codegraph (emdash_plugin) — do not edit by hand.
 * Public detail page for the {{ s.p.plugin_id }} plugin
 * ({{ s.detail.page_label }} via the `{{ s.detail.public_detail.route }}` route).
{%- if s.submit %}
 * The submission form is shaped by the bespoke `{{ s.submit.public_submit.handler }}` handler.
{%- endif %}
 */

export const prerender = false;

interface Detail {
  id?: unknown;
  [key: string]: unknown;
}

function isDetail(value: unknown): value is Detail {
  return typeof value === "object" && value !== null;
}

const { id } = Astro.params;
const handler = getPublicPluginApiRouteHandler(Astro.locals);
// The dispatcher matches the route by bare name and parses the query string
// off the Request URL into routeCtx.input — pass the detail param there.
const detailParam = "{{ s.detail.public_detail.param }}";
const detailRoute = "{{ s.detail.public_detail.route }}";
const requestUrl = new URL(Astro.url);
if (id) requestUrl.searchParams.set(detailParam, id);
const result = handler && id
  ? await handler("{{ s.p.plugin_id }}", "GET", detailRoute, new Request(requestUrl))
  : { success: false, data: null, error: { code: "NO_LOCALS", message: "emdash locals unavailable" } };

// Route result + runtime envelope: unwrap both layers.
const detailPayload = (result.data ?? {}) as { data?: unknown };
const detail: unknown = isDetail(result.data) ? result.data : detailPayload.data;
const record = result.success && isDetail(detail) ? detail : null;
const error = result.success ? null : result.error;

const titleField = "{{ s.detail.title_field }}";
const columns: Array<{ label: string; key: string; format?: string }> = [
{%- for c in s.detail.detail_fields %}
  { label: "{{ c.label }}", key: "{{ c.key }}"{% if c.format %}, format: "{{ c.format }}"{% endif %} },
{%- endfor %}
];

function cell(row: Detail, key: string, format?: string): string {
  const value = row[key];
  if (value === undefined || value === null || value === "") return "—";
  if (format === "bool") return value === true ? "Yes" : "No";
  return String(value);
}
---

<Base title={record ? String(record[titleField] ?? "") : "{{ s.detail.page_label }}"}>
  {error ? (
    <p>Plugin route error: {error.code}: {error.message}</p>
  ) : record === null ? (
    <p>{{ s.detail.page_label }} not found.</p>
  ) : (
    <>
      <p><a href="/{{ s.p.domain_kebab }}">← All {{ s.list.page_label | lower }}</a></p>
      <h1>{String(record[titleField] ?? "")}</h1>
      <dl>
        {columns.map((col) => (
          <>
            <dt>{col.label}</dt>
            <dd>{cell(record, col.key, col.format)}</dd>
          </>
        ))}
      </dl>

{%- if s.submit %}
      <section aria-labelledby="submit-heading">
        <h2 id="submit-heading">{{ s.submit.page_label }} submission</h2>
        <p class="field-help">
          Shaped by the bespoke <code>{{ s.submit.public_submit.handler }}</code> handler.
        </p>
        <form id="submit-form" action="/_emdash/api/plugins/{{ s.p.plugin_id }}/{{ s.submit.public_submit.route }}">
{%- for f in s.submit.public_submit.fields %}
{%- if f.kind == "select" %}
          <label for="{{ f.name }}">{{ f.label }}</label>
          <select id="{{ f.name }}" name="{{ f.name }}"{% if f.required %} required{% endif %}>
{%- for o in f.options %}
            <option value="{{ o.value }}">{{ o.label }}</option>
{%- endfor %}
          </select>
{%- elif f.kind == "textarea" %}
          <label for="{{ f.name }}">{{ f.label }}</label>
          <textarea id="{{ f.name }}" name="{{ f.name }}"{% if f.required %} required{% endif %}></textarea>
{%- elif f.kind == "number" %}
          <label for="{{ f.name }}">{{ f.label }}</label>
          <input id="{{ f.name }}" name="{{ f.name }}" type="number"{% if f.required %} required{% endif %} />
{%- elif f.kind == "email" %}
          <label for="{{ f.name }}">{{ f.label }}</label>
          <input id="{{ f.name }}" name="{{ f.name }}" type="email"{% if f.required %} required{% endif %} />
{%- else %}
          <label for="{{ f.name }}">{{ f.label }}</label>
          <input id="{{ f.name }}" name="{{ f.name }}" type="text"{% if f.required %} required{% endif %} />
{%- endif %}
{%- endfor %}
          <button type="submit">{{ s.submit.public_submit.button_label }}</button>
        </form>
        <p id="submit-status" role="status" aria-live="polite"></p>
      </section>
{%- endif %}
    </>
  )}
</Base>

{%- if s.submit %}
<script>
  const SUCCESS_MESSAGE = "{{ s.submit.public_submit.success_message }}";
  const FIELDS = [
{%- for f in s.submit.public_submit.fields %}
    { name: "{{ f.name }}", kind: "{{ f.kind }}" },
{%- endfor %}
  ];

  function messageFromResponse(body: unknown, httpStatus: number): string {
    if (body !== null && typeof body === "object" && "error" in body) {
      const err = (body as { error?: unknown }).error;
      if (err !== null && typeof err === "object" && "message" in err) {
        const message = (err as { message?: unknown }).message;
        if (typeof message === "string") {
          const code = (err as { code?: unknown }).code;
          return typeof code === "string" ? `${code}: ${message}` : message;
        }
      }
    }
    return `Request failed (HTTP ${httpStatus}).`;
  }

  async function submitForm(form: HTMLFormElement, status: HTMLElement): Promise<void> {
    const data = new FormData(form);
    const payload: Record<string, string | number> = {};
    for (const field of FIELDS) {
      const value = data.get(field.name);
      if (field.kind === "number") {
        const parsed = Number(value);
        if (Number.isFinite(parsed)) payload[field.name] = parsed;
      } else if (typeof value === "string" && value !== "") {
        payload[field.name] = value;
      }
    }

    status.textContent = "Sending…";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const body: unknown = await response.json().catch(() => null);
      if (response.ok) {
        status.textContent = SUCCESS_MESSAGE;
        form.reset();
      } else {
        status.textContent = messageFromResponse(body, response.status);
      }
    } catch {
      status.textContent = "Network error — please try again.";
    }
  }

  const form = document.getElementById("submit-form");
  const status = document.getElementById("submit-status");
  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void submitForm(form, status);
    });
  }
</script>
{%- endif %}
