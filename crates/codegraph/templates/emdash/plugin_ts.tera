import type { PluginContext, SandboxedPlugin } from "emdash/plugin";
import {
{%- if p.has_bridge %}
  DOMAIN_EVENT_POLL_TASK,
  createDomainEventPoller,
  createHttpDomainEventSource,
  createMemoryDomainEventSource,
  emit,
  ensureRecurringEventPollTask,
  pushMemoryDomainEvent,
{% endif %}
{%- if p.has_subscriptions %}
  listSubscriptions,
  subscribe,
{% endif %}
  seedGatewaySettings,
  sdkCall,
{%- if p.has_bridge %}
  type DomainEventPayload,
  type DomainEventSource,
  type PollSummary,
{%- elif p.has_subscriptions %}
  type DomainEventPayload,
{%- endif %}
} from "@community-os/emdash-common";
import { handleAdminInteraction } from "./admin";
{%- for h in p.plugin_bespoke_imports %}
import { {{ h }} } from "./bespoke";
{%- endfor %}

/**
 * {{ p.plugin_id }} — the {{ p.plugin_label }} domain plugin.
 *
 * GENERATED by codegraph (emdash_plugin) — do not edit by hand.
 * Regenerate via the codegraph pipeline (`emdash_plugins` profile feature).
 * {{ p.description }}
 *
 * All backend calls go through the Fern SDK via `sdkCall` — no hardcoded
 * paths, no local DTOs. Bespoke behavior lives in `./bespoke` and is invoked
 * at the points configured in plugins.toml (public submissions below).
 */

{%- if p.has_bridge %}

function envValue(name: string): string | undefined {
  if (typeof process === "undefined" || process.env === undefined) return undefined;
  return process.env[name];
}

function resolveSource(ctx: PluginContext): DomainEventSource {
  const mode = (envValue("EMDASH_DOMAIN_EVENTS_SOURCE") ?? "http").toLowerCase();
  return mode === "memory"
    ? createMemoryDomainEventSource()
    : createHttpDomainEventSource(ctx);
}

let lastPoll: PollSummary | null = null;
{% endif %}
{%- for sub in p.subscriptions %}

// ── {{ sub.topic }} consumption record ───────────────────────────────────

const {{ sub.const_name }} = "{{ sub.topic }}";
const {{ sub.const_name }}_ENSURE_TASK = "{{ sub.ensure_task_name }}";

let {{ sub.flag }} = false;

async function {{ sub.ensure_fn }}(ctx: PluginContext): Promise<boolean> {
  if ({{ sub.flag }}) return false;
  subscribe({{ sub.const_name }}, "{{ p.plugin_id }}", (payload) =>
    {{ sub.handler_fn }}(ctx, payload),
  );
  {{ sub.flag }} = true;
  if (ctx.cron) {
    try {
      const tasks = await ctx.cron.list();
      if (!tasks.some((t) => t.name === {{ sub.const_name }}_ENSURE_TASK)) {
        await ctx.cron.schedule({{ sub.const_name }}_ENSURE_TASK, { schedule: "*/5 * * * *" });
      }
    } catch (error) {
      ctx.log.warn("{{ p.plugin_id }}: failed to schedule subscription ensure task", {
        error: String(error),
      });
    }
  }
  ctx.log.info("{{ p.plugin_id }}: subscribed to {{ sub.topic }}");
  return true;
}

async function {{ sub.handler_fn }}(ctx: PluginContext, payload: DomainEventPayload): Promise<void> {
  const id = `${payload.entityId}:${payload.correlationId}`;
  const entry = {
    eventId: payload.correlationId,
    entityId: payload.entityId,
    eventType: payload.eventType,
    domain: payload.domain,
    entityTable: payload.entityTable,
    tenantId: payload.tenantId,
    changedFields: payload.changedFields,
    handledAt: new Date().toISOString(),
  };
  await ctx.storage.{{ sub.storage }}.put(id, entry);
  ctx.log.info("{{ p.plugin_id }}: consumed {{ sub.topic }}", {
    entityId: payload.entityId,
    correlationId: payload.correlationId,
  });
}
{%- endfor %}

// ── Sandbox plugin ───────────────────────────────────────────────────────────

export default {
  hooks: {
    "plugin:install": async (_event, ctx) => {
      await seedGatewaySettings(ctx, "{{ p.plugin_id }}");
{%- if p.has_bridge %}
      await ensureRecurringEventPollTask(ctx);
{%- endif %}
{%- for sub in p.subscriptions %}
      await {{ sub.ensure_fn }}(ctx);
{%- endfor %}
    },
{%- if p.has_bridge %}
    cron: async (_event, ctx) => {
      await ensureRecurringEventPollTask(ctx);
      const poller = createDomainEventPoller({ pluginId: "{{ p.plugin_id }}", source: resolveSource(ctx) });
      lastPoll = await poller.poll(ctx);
    },
{%- endif %}
  },
  routes: {
    health: {
      public: true,
      handler: async () => {
        return { success: true, data: { status: "ok", plugin: "{{ p.plugin_id }}" } };
      },
    },

    // ── Entity list + read routes (admin surface + e2e harness) ────────────
{%- for e in p.entities %}

    {{ e.camel }}List: {
      // Dev proof: production must gate this behind auth.
      public: true,
      handler: async (_routeCtx, ctx) =>
        sdkCall(ctx, (client) => client.{{ e.sdk_resource }}.{{ e.prefix }}List()),
    },
{%- if e.has_read %}

    {{ e.camel }}Get: {
      // Dev proof: production must gate this behind auth.
      public: true,
      handler: async (routeCtx, ctx) => {
        const input = (routeCtx.input ?? {}) as Record<string, unknown>;
        const id = typeof input.id === "string" ? input.id : "";
        if (!id) {
          return { success: false, error: { code: "INVALID_INPUT", message: "id is required" } };
        }
        return sdkCall(ctx, (client) =>
          client.{{ e.sdk_resource }}.{{ e.prefix }}GetById({{ e.get_req }}),
        );
      },
    },
{%- endif %}
{%- endfor %}

    // ── Public read surface (site pages) ─────────────────────────────────────
{%- for e in p.entities %}
{%- if e.public_list %}

    {{ e.public_list.route }}: {
      // Dev proof: production must gate this behind auth.
      public: true,
      handler: async (_routeCtx, ctx) => {
        const result = await sdkCall(ctx, (client) =>
          client.{{ e.sdk_resource }}.{{ e.prefix }}List(),
        );
        if (!result.success) return result;
        const all = Array.isArray(result.data) ? result.data : [];
{%- if e.public_list.filter_field and e.public_list.filter_value %}
        return {
          success: true,
          data: all.filter((item) => item.{{ e.public_list.filter_field }} === {{ e.public_list.filter_value }}),
        };
{%- else %}
        return { success: true, data: all };
{%- endif %}
      },
    },
{%- endif %}
{%- if e.public_detail %}

    {{ e.public_detail.route }}: {
      // Dev proof: production must gate this behind auth.
      public: true,
      handler: async (routeCtx, ctx) => {
        const input = (routeCtx.input ?? {}) as Record<string, unknown>;
        const id = typeof input.{{ e.public_detail.param }} === "string" ? input.{{ e.public_detail.param }} : "";
        if (!id) {
          return { success: false, error: { code: "INVALID_INPUT", message: "{{ e.public_detail.param }} is required" } };
        }
        return sdkCall(ctx, (client) =>
          client.{{ e.sdk_resource }}.{{ e.prefix }}GetById({{ e.get_req }}),
        );
      },
    },
{%- endif %}
{%- endfor %}

    // ── Public submissions (bespoke-shaped, anonymous-first) ─────────────────
{%- for e in p.entities %}
{%- if e.public_submit %}

    {{ e.public_submit.route }}: {
      // Dev proof: production must gate this behind auth.
      public: true,
      handler: (routeCtx, ctx) => {{ e.public_submit.handler }}(routeCtx, ctx),
    },
{%- endif %}
{%- endfor %}

    // ── Block Kit admin ──────────────────────────────────────────────────────

    admin: {
      // Admin-gated: the site's `/_emdash/api/admin/plugins/{id}/admin` route
      // requires an EmDash admin session + plugins:manage (+ X-EmDash-Request
      // on writes). Returns a BlockResponse ({ blocks, toast? }).
      handler: async (routeCtx, ctx) => handleAdminInteraction(routeCtx.input, ctx),
    },
{%- if p.has_bridge %}

    // ── Domain-event surface (observability + dev publishing) ────────────────

    publishEvent: {
      public: true,
      handler: async (routeCtx, ctx) => {
        const input = (routeCtx.input ?? {}) as {
          topic?: string;
          payload?: Partial<DomainEventPayload>;
        };
        const topic = input.topic ?? "{{ p.default_topic }}";
        const raw = input.payload ?? {};
        const payload: DomainEventPayload = {
          eventType: raw.eventType ?? "updated",
          domain: raw.domain ?? "{{ p.domain }}",
          entityTable: raw.entityTable ?? "{{ p.default_entity_table }}",
          entityId: raw.entityId ?? `local-${Date.now()}`,
          tenantId: raw.tenantId ?? null,
          changedFields: raw.changedFields ?? [],
          occurredAt: raw.occurredAt ?? new Date().toISOString(),
          correlationId: raw.correlationId ?? `local-${Date.now()}`,
          seq: raw.seq ?? 0,
        };
        const summary = await emit(topic, payload);
        ctx.log.info("{{ p.plugin_id }}: published", { topic, entityId: payload.entityId, summary });
        return { success: true, data: { topic, payload, summary } };
      },
    },
    queueDomainEvent: {
      public: true,
      handler: async (routeCtx, ctx) => {
        const source = resolveSource(ctx);
        if (source.kind !== "memory") {
          return {
            success: false,
            error: {
              code: "HTTP_SOURCE_NO_PUBLISH",
              message:
                "With the HTTP source the backend owns publishing (pgmq). " +
                "queueDomainEvent only works with EMDASH_DOMAIN_EVENTS_SOURCE=memory (dev/e2e).",
            },
          };
        }
        const input = (routeCtx.input ?? {}) as Partial<DomainEventPayload>;
        if (!input.entityId || !input.domain || !input.entityTable) {
          return {
            success: false,
            error: {
              code: "INVALID_EVENT",
              message: "queueDomainEvent requires payload.domain, entityTable and entityId",
            },
          };
        }
        const evt = pushMemoryDomainEvent({
          eventType: input.eventType ?? "updated",
          domain: input.domain,
          entityTable: input.entityTable,
          entityId: input.entityId,
          tenantId: input.tenantId ?? null,
          changedFields: input.changedFields ?? [],
          occurredAt: input.occurredAt ?? new Date().toISOString(),
          correlationId: input.correlationId ?? `queued-${Date.now()}`,
        });
        ctx.log.info("{{ p.plugin_id }}: queued domain event", {
          entityId: evt.entityId,
          seq: evt.seq,
        });
        return { success: true, data: { queued: true, seq: evt.seq, eventId: evt.entityId } };
      },
    },
    triggerEventPoll: {
      public: true,
      handler: async (_routeCtx, ctx) => {
        const poller = createDomainEventPoller({ pluginId: "{{ p.plugin_id }}", source: resolveSource(ctx) });
        const poll = await poller.poll(ctx);
        lastPoll = poll;
        ctx.log.info("{{ p.plugin_id }}: manual domain-event poll", {
          fetched: poll.fetched,
          cursor: poll.cursor,
          error: poll.error?.code ?? null,
        });
        return { success: true, data: { poll } };
      },
    },
    pollStatus: {
      public: true,
      handler: async (_routeCtx, ctx) => {
        const source = resolveSource(ctx);
        const cursor = await ctx.kv.get<string>("state:domainEventCursor");
        return { success: true, data: { sourceKind: source.kind, cursor, lastPoll } };
      },
    },
    pollTaskStatus: {
      public: true,
      handler: async (_routeCtx, ctx) => {
        if (!ctx.cron) {
          return { success: true, data: { scheduled: false, reason: "cron not wired" } };
        }
        const tasks = await ctx.cron.list();
        const pollTask = tasks.find((t) => t.name === DOMAIN_EVENT_POLL_TASK);
        return { success: true, data: { scheduled: Boolean(pollTask), task: pollTask ?? null } };
      },
    },
{%- endif %}
{%- if p.has_subscriptions %}

    // ── Subscription management ──────────────────────────────────────────────

    subscriptions: {
      public: true,
      handler: async () => {
        return { success: true, data: { subscriptions: listSubscriptions() } };
      },
    },
    ensureSubscriptions: {
      public: true,
      handler: async (_routeCtx, ctx) => {
        let registered = false;
{%- for sub in p.subscriptions %}
        registered = (await {{ sub.ensure_fn }}(ctx)) || registered;
{%- endfor %}
        return { success: true, data: { registered } };
      },
    },
{%- endif %}
  },
} satisfies SandboxedPlugin;
