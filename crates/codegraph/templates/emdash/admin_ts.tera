/**
 * Block Kit admin pages for the {{ p.plugin_id }} plugin.
 *
 * GENERATED by codegraph (emdash_plugin) — do not edit by hand.
 * Regenerate via the codegraph pipeline (`emdash_plugins` profile feature).
 *
 * Pages (from plugins.toml):
{%- for e in p.entities %}
 *   {{ e.page_path }} — {{ e.page_label }}
{%- endfor %}
 *
 * Interaction contract: the admin shell POSTs Block Kit interactions to the
 * plugin's `admin` route; this module turns each interaction into a
 * `BlockResponse` (`{ blocks, toast? }`). Every backend call goes through
 * the Fern SDK via `sdkCall(..., { tenant: true })` — RLS-scoped to the
 * current tenant when one is selected, typed by `@community-os/sdk`.
 * Hand-written behavior is dispatched to `./bespoke` at the points
 * configured in plugins.toml.
 */

import {
  adminActions,
  adminBanner,
  adminButton,
  adminContext,
  adminDateInput,
  adminDivider,
  adminFields,
  adminForm,
  adminHeader,
  adminNumberInput,
  adminPageResponse,
  adminSection,
  adminSelect,
  adminStats,
  adminTable,
  adminTextInput,
  adminToast,
  adminToggle,
  asBlockInteraction,
  gatewayFailurePage,
  isBlockAction,
  isFormSubmit,
  isPageLoad,
  pluginSettingsSchema,
  sdkCall,
  type AdminPageResponse,
  type Block,
  type BlockInteraction,
} from "@community-os/emdash-common";
import type { CosmosAppApi } from "@community-os/sdk";
import type { PluginContext } from "emdash/plugin";
{%- if p.admin_bespoke_imports %}
import * as bespoke from "./bespoke";
{%- endif %}

// ── Shared helpers ──────────────────────────────────────────────────────────

const NEW_FORM_BLOCK_ID = "new";

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null;
}

function valueOf(source: unknown, key: string): unknown {
  return isRecord(source) ? source[key] : undefined;
}

function strOf(source: unknown, key: string): string | undefined {
  const value = valueOf(source, key);
  return typeof value === "string" ? value : undefined;
}

function numOf(source: unknown, key: string): number | undefined {
  const value = valueOf(source, key);
  return typeof value === "number" ? value : undefined;
}

function boolOf(source: unknown, key: string): boolean | undefined {
  const value = valueOf(source, key);
  return typeof value === "boolean" ? value : undefined;
}

function titleOf(source: unknown, key: string): string {
  const value = strOf(source, key);
  return value && value.trim() ? value : "Untitled";
}

function isBlank(value: unknown): boolean {
  return (
    value === undefined ||
    value === null ||
    value === "" ||
    (Array.isArray(value) && value.length === 0)
  );
}

function cellValue(source: unknown, key: string, format?: string): string {
  const value = valueOf(source, key);
  if (value === undefined || value === null) return "";
  if (format === "bool") return value === true ? "Yes" : "No";
  return String(value);
}

function detailValue(source: unknown, key: string, format?: string): string {
  const value = valueOf(source, key);
  if (value === undefined || value === null || value === "") return "—";
  if (format === "bool") return value === true ? "Yes" : "No";
  return String(value);
}

function whenMatches(source: unknown, field: string, values: unknown[]): boolean {
  const value = valueOf(source, field);
  return values.some((candidate) => candidate === value);
}

function listErrorPage(): AdminPageResponse {
  return adminPageResponse(
    [adminBanner({ variant: "error", title: "Invalid request", description: "The admin action was malformed." })],
    adminToast("Invalid admin action", "error"),
  );
}

function missingFieldPage(key: string, labels: Record<string, string>): AdminPageResponse {
  const label = labels[key] ?? key;
  return adminPageResponse(
    [adminBanner({ variant: "error", title: `${label} required`, description: `Please fill in "${label}".` })],
    adminToast(`${label} is required`, "error"),
  );
}

{% for e in p.entities %}
// ── {{ e.page_label }} ({{ e.page_path }}) ──────────────────────────────────────────────

const {{ e.pascal | upper }}_REQUIRED_FIELDS: string[] = [
{%- for f in e.form_fields %}
{%- if f.required %}
  "{{ f.name }}",
{%- endif %}
{%- endfor %}
];

const {{ e.pascal | upper }}_FIELD_LABELS: Record<string, string> = {
{%- for f in e.form_fields %}
  "{{ f.name }}": "{{ f.label }}",
{%- endfor %}
};
{%- if e.has_create or e.has_update %}
function {{ e.camel }}FormFields(existing?: unknown) {
  return [
{%- for f in e.form_fields %}
{%- if f.control == "number" %}
    adminNumberInput("{{ f.name }}", "{{ f.label }}", { initialValue: numOf(existing, "{{ f.name }}") }),
{%- elif f.control == "toggle" %}
    adminToggle("{{ f.name }}", "{{ f.label }}", { initialValue: boolOf(existing, "{{ f.name }}") }),
{%- elif f.control == "select" %}
    adminSelect(
      "{{ f.name }}",
      "{{ f.label }}",
      [
{%- for o in f.options %}
        { label: "{{ o.label }}", value: "{{ o.value }}" },
{%- endfor %}
      ],
      { initialValue: strOf(existing, "{{ f.name }}"){% if f.initial_default %} ?? {{ f.initial_default }}{% endif %} },
    ),
{%- elif f.control == "date" or f.control == "datetime" %}
    adminDateInput("{{ f.name }}", "{{ f.label }}", { initialValue: strOf(existing, "{{ f.name }}"){% if f.initial_default %} ?? {{ f.initial_default }}{% endif %} }),
{%- else %}
    adminTextInput("{{ f.name }}", "{{ f.label }}", { initialValue: strOf(existing, "{{ f.name }}"){% if f.multiline %}, multiline: true{% endif %} }),
{%- endif %}
{%- endfor %}
  ];
}

function build{{ e.pascal }}Payload(values: Record<string, unknown>): Record<string, unknown> {
  const payload: Record<string, unknown> = {};
{%- for f in e.form_fields %}
{%- if f.control == "number" %}
  {
    const parsed = Number(values.{{ f.name }});
    if (Number.isFinite(parsed)) payload.{{ f.name }} = parsed;
  }
{%- elif f.control == "toggle" %}
  payload.{{ f.name }} = Boolean(values.{{ f.name }});
{%- elif f.control == "list" %}
  if (typeof values.{{ f.name }} === "string" && values.{{ f.name }}.trim()) {
    payload.{{ f.name }} = values.{{ f.name }}
      .split("\n")
      .map((line) => line.trim())
      .filter((line) => line.length > 0);
  }
{%- else %}
  if (typeof values.{{ f.name }} === "string" && values.{{ f.name }}.trim()) {
    payload.{{ f.name }} = values.{{ f.name }}.trim();
  }
{%- endif %}
{%- endfor %}
  return payload;
}
{% endif %}
async function list{{ e.pascal }}(ctx: PluginContext, toast?: string): Promise<AdminPageResponse> {
  const headerBlocks: Block[] = [
    adminHeader("{{ e.page_label }}"),
    adminActions([
{%- if e.has_create %}
      adminButton("{{ e.key }}:new", "New {{ e.page_label }}", { style: "primary", value: { action: "new" } }),
{%- endif %}
{%- for a in e.custom_actions %}
      adminButton("{{ a.full_id }}", "{{ a.label }}", { value: {}{% if a.style %}, style: "{{ a.style }}"{% endif %} }),
{%- endfor %}
    ]),
  ];

  const result = await sdkCall(ctx, (client) => client.{{ e.sdk_resource }}.{{ e.prefix }}List(), {
    tenant: true,
  });
  if (!result.success) {
    return adminPageResponse([...headerBlocks, ...gatewayFailurePage(result).blocks]);
  }
  const records = (result.data ?? []).slice(){% if e.sort_key %}.sort((a, b) => {
    const av = String(valueOf(a, "{{ e.sort_key }}") ?? "");
    const bv = String(valueOf(b, "{{ e.sort_key }}") ?? "");
    if (av === bv) return 0;
    const cmp = av > bv ? 1 : -1;
{%- if e.sort_dir == "desc" %}
    return -cmp;
{%- else %}
    return cmp;
{%- endif %}
  }){% endif %};
  const blocks: Block[] = [...headerBlocks];

  if (records.length === 0) {
    blocks.push(adminContext("{{ e.empty_text }}"));
    return adminPageResponse(blocks, toast ? adminToast(toast, "success") : undefined);
  }

  const rows = records.map((record) => ({
{%- for c in e.columns %}
    "{{ c.label }}": cellValue(record, "{{ c.key }}"{% if c.format %}, "{{ c.format }}"{% endif %}),
{%- endfor %}
    id: String(valueOf(record, "id") ?? ""),
  }));
  blocks.push(
    adminTable({
      columns: [
{%- for c in e.columns %}
        { label: "{{ c.label }}", key: "{{ c.label }}" },
{%- endfor %}
      ],
      rows,
      pageActionId: "{{ e.key }}:list",
      emptyText: "{{ e.empty_text }}",
    }),
  );
  for (const record of records) {
    const actions = [adminButton("{{ e.key }}:open", "View", { value: { id: valueOf(record, "id") } })];
{%- for a in e.actions %}
{%- if a.when %}
    if (whenMatches(record, "{{ a.when.field }}", {{ a.when.values_js }})) {
      actions.push(adminButton("{{ a.full_id }}", "{{ a.label }}", { value: { id: valueOf(record, "id") }{{ a.button_props }} }));
    }
{%- else %}
    actions.push(adminButton("{{ a.full_id }}", "{{ a.label }}", { value: { id: valueOf(record, "id") }{{ a.button_props }} }));
{%- endif %}
{%- endfor %}
{%- if e.has_delete %}
    actions.push(
      adminButton("{{ e.key }}:delete", "Delete", {
        value: { id: valueOf(record, "id") },
        style: "danger",
        confirm: {
          title: "Delete {{ e.page_label }}",
          text: "Delete this {{ e.page_label }}? This cannot be undone.",
          confirm: "Delete",
          deny: "Cancel",
          style: "danger",
        },
      }),
    );
{%- endif %}
    blocks.push(
      adminActions(actions, { blockId: `{{ e.key }}:${String(valueOf(record, "id") ?? "")}` }),
      adminContext(titleOf(record, "{{ e.title_field }}")),
    );
  }
  blocks.push(adminDivider(), adminContext(`${records.length} total`));
  return adminPageResponse(blocks, toast ? adminToast(toast, "success") : undefined);
}
{% if e.has_read %}
async function show{{ e.pascal }}Detail(ctx: PluginContext, id: string): Promise<AdminPageResponse> {
  const result = await sdkCall(
    ctx,
    (client) => client.{{ e.sdk_resource }}.{{ e.prefix }}GetById({{ e.get_req }}),
    { tenant: true },
  );
  if (!result.success || !result.data) {
    return adminPageResponse(
      [adminBanner({ variant: "error", title: "Not found", description: `Record ${id} not found.` })],
      adminToast("Record not found", "error"),
    );
  }
  const record = result.data;
  return adminPageResponse([
    adminActions([
      adminButton("{{ e.key }}:list", `← Back to {{ e.page_label }}`, { style: "secondary" }),
{%- for a in e.actions %}
{%- if a.when %}
      ...(whenMatches(record, "{{ a.when.field }}", {{ a.when.values_js }})
        ? [adminButton("{{ a.full_id }}", "{{ a.label }}", { value: { id }{{ a.button_props }} })]
        : []),
{%- else %}
      adminButton("{{ a.full_id }}", "{{ a.label }}", { value: { id }{{ a.button_props }} }),
{%- endif %}
{%- endfor %}
{%- if e.has_update %}
      adminButton("{{ e.key }}:edit", "Edit", { value: { id } }),
{%- endif %}
{%- if e.has_delete %}
      adminButton("{{ e.key }}:delete", "Delete", {
        value: { id },
        style: "danger",
        confirm: {
          title: "Delete {{ e.page_label }}",
          text: `Delete "${titleOf(record, "{{ e.title_field }}")}"? This cannot be undone.`,
          confirm: "Delete",
          deny: "Cancel",
          style: "danger",
        },
      }),
{%- endif %}
    ]),
    adminHeader(titleOf(record, "{{ e.title_field }}")),
    adminFields([
{%- for d in e.detail_fields %}
      { label: "{{ d.label }}", value: detailValue(record, "{{ d.key }}"{% if d.format %}, "{{ d.format }}"{% endif %}) },
{%- endfor %}
    ]),
  ]);
}
{% endif %}
{%- if e.has_read and e.has_update %}

async function edit{{ e.pascal }}Form(ctx: PluginContext, id: string): Promise<AdminPageResponse> {
  const result = await sdkCall(
    ctx,
    (client) => client.{{ e.sdk_resource }}.{{ e.prefix }}GetById({{ e.get_req }}),
    { tenant: true },
  );
  if (!result.success || !result.data) {
    return adminPageResponse(
      [adminBanner({ variant: "error", title: "Not found", description: `Record ${id} not found.` })],
      adminToast("Record not found", "error"),
    );
  }
  return adminPageResponse([
    adminActions([adminButton("{{ e.key }}:list", `← Back to {{ e.page_label }}`, { style: "secondary" })]),
    adminHeader(`Edit: ${titleOf(result.data, "{{ e.title_field }}")}`),
    adminForm({
      blockId: id,
      fields: {{ e.camel }}FormFields(result.data),
      submitLabel: "Save",
      submitActionId: "{{ e.key }}:update",
    }),
  ]);
}
{%- endif %}
{%- if e.has_create %}

function new{{ e.pascal }}Form(): AdminPageResponse {
  return adminPageResponse([
    adminActions([adminButton("{{ e.key }}:list", `← Back to {{ e.page_label }}`, { style: "secondary" })]),
    adminHeader("New {{ e.page_label }}"),
    adminForm({
      blockId: NEW_FORM_BLOCK_ID,
      fields: {{ e.camel }}FormFields(),
      submitLabel: "Save",
      submitActionId: "{{ e.key }}:create",
    }),
  ]);
}
{% endif %}
{%- for a in e.actions %}

async function {{ e.camel }}{{ a.id | pascal_case }}Action(ctx: PluginContext, id: string): Promise<AdminPageResponse> {
  const result = await sdkCall(
    ctx,
    (client) => client.{{ e.sdk_resource }}.{{ e.prefix }}Update({{ a.update_call }}),
    { tenant: true },
  );
  if (!result.success) return gatewayFailurePage(result);
  return list{{ e.pascal }}(ctx, "{{ a.label }} applied");
}
{%- endfor %}
{%- if e.has_create %}

async function create{{ e.pascal }}(ctx: PluginContext, values: Record<string, unknown>): Promise<AdminPageResponse> {
  const payload = build{{ e.pascal }}Payload(values);
{%- for af in e.auto_fields %}
  {{ af.assign_line }}
{%- endfor %}
  const missing = {{ e.pascal | upper }}_REQUIRED_FIELDS.find((key) => isBlank(payload[key]));
  if (missing) return missingFieldPage(missing, {{ e.pascal | upper }}_FIELD_LABELS);
  const result = await sdkCall(
    ctx,
    (client) => client.{{ e.sdk_resource }}.{{ e.prefix }}Create(payload as never),
    { tenant: true },
  );
  if (!result.success) return gatewayFailurePage(result);
  return list{{ e.pascal }}(ctx, `{{ e.page_label }} "${titleOf(payload, "{{ e.title_field }}")}" created`);
}
{%- endif %}
{%- if e.has_update %}

async function update{{ e.pascal }}(ctx: PluginContext, id: string, values: Record<string, unknown>): Promise<AdminPageResponse> {
  const payload = build{{ e.pascal }}Payload(values);
  const result = await sdkCall(
    ctx,
    (client) => client.{{ e.sdk_resource }}.{{ e.prefix }}Update({{ e.update_req }} as never),
    { tenant: true },
  );
  if (!result.success) return gatewayFailurePage(result);
  return list{{ e.pascal }}(ctx, "{{ e.page_label }} updated");
}
{%- endif %}
{%- if e.has_delete %}

async function delete{{ e.pascal }}(ctx: PluginContext, id: string): Promise<AdminPageResponse> {
  const result = await sdkCall(
    ctx,
    (client) => client.{{ e.sdk_resource }}.{{ e.prefix }}Delete({{ e.get_req }}),
    { tenant: true },
  );
  if (!result.success) return gatewayFailurePage(result);
  return list{{ e.pascal }}(ctx, "{{ e.page_label }} deleted");
}
{%- endif %}
{%- endfor %}

// ── Interaction dispatch ────────────────────────────────────────────────────

function handleBlockAction(
  interaction: { action_id: string; value?: unknown },
  ctx: PluginContext,
): Promise<AdminPageResponse> {
  const value = isRecord(interaction.value) ? interaction.value : {};
  const id = typeof value.id === "string" ? value.id : "";

  switch (interaction.action_id) {
{%- for e in p.entities %}
    case "{{ e.key }}:list":
      return list{{ e.pascal }}(ctx);
{%- if e.has_create %}
    case "{{ e.key }}:new":
      return Promise.resolve(new{{ e.pascal }}Form());
{%- endif %}
{%- if e.has_read %}
    case "{{ e.key }}:open":
      return id ? show{{ e.pascal }}Detail(ctx, id) : Promise.resolve(listErrorPage());
{%- endif %}
{%- if e.has_read and e.has_update %}
    case "{{ e.key }}:edit":
      return id ? edit{{ e.pascal }}Form(ctx, id) : Promise.resolve(listErrorPage());
{%- endif %}
{%- if e.has_delete %}
    case "{{ e.key }}:delete":
      return id ? delete{{ e.pascal }}(ctx, id) : Promise.resolve(listErrorPage());
{%- endif %}
{%- for a in e.actions %}
    case "{{ a.full_id }}":
      return id ? {{ e.camel }}{{ a.id | pascal_case }}Action(ctx, id) : Promise.resolve(listErrorPage());
{%- endfor %}
{%- for a in e.custom_actions %}
    case "{{ a.full_id }}":
      return bespoke.{{ a.handler }}(ctx, value);
{%- endfor %}
{%- endfor %}
    default:
      return Promise.resolve(listErrorPage());
  }
}

function handleFormSubmit(
  interaction: { action_id: string; block_id?: string; values: Record<string, unknown> },
  ctx: PluginContext,
): Promise<AdminPageResponse> {
  switch (interaction.action_id) {
{%- for e in p.entities %}
{%- if e.has_create %}
    case "{{ e.key }}:create":
      return create{{ e.pascal }}(ctx, interaction.values);
{%- endif %}
{%- if e.has_update %}
    case "{{ e.key }}:update": {
      const id = interaction.block_id && interaction.block_id !== NEW_FORM_BLOCK_ID ? interaction.block_id : "";
      return id ? update{{ e.pascal }}(ctx, id, interaction.values) : Promise.resolve(listErrorPage());
    }
{%- endif %}
{%- endfor %}
    default:
      return Promise.resolve(listErrorPage());
  }
}

/** Entry point wired from the plugin's `admin` route handler. */
export async function handleAdminInteraction(input: unknown, ctx: PluginContext): Promise<AdminPageResponse> {
  const interaction: BlockInteraction | null = asBlockInteraction(input);
  if (!interaction) return listErrorPage();
  if (isPageLoad(interaction)) {
    switch (interaction.page) {
{%- for e in p.entities %}
{%- if loop.first %}
      default:
{%- endif %}
      case "{{ e.page_path }}":
        return list{{ e.pascal }}(ctx);
{%- endfor %}
    }
  }
  if (isBlockAction(interaction)) return handleBlockAction(interaction, ctx);
  if (isFormSubmit(interaction)) return handleFormSubmit(interaction, ctx);
  return listErrorPage();
}
