/// List deliveries for a webhook endpoint.
pub async fn list_deliveries(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    Path(endpoint_id): Path<Uuid>,
) -> Result<Json<Vec<DeliveryResponse>>, ApiError> {
    let client = state.client_source.client().await.map_err(internal)?;
    set_org(&client, api_key_info.organization_id).await?;

    let rows = client
        .query(
            "SELECT id, endpoint_id, subscription_id, event_payload, response_status, response_body, \
                    attempt, delivered_at, next_retry_at, created_at \
             FROM platform.webhook_delivery \
             WHERE endpoint_id = $1 \
             ORDER BY created_at DESC LIMIT 100",
            &[&endpoint_id],
        )
        .await
        .map_err(internal)?;

    let deliveries = rows
        .into_iter()
        .filter_map(|r| {
            Some(DeliveryResponse {
                id: r.try_get::<_, Uuid>(0).ok()?,
                endpoint_id: r.try_get::<_, Uuid>(1).ok()?,
                subscription_id: r.try_get::<_, Uuid>(2).ok()?,
                event_payload: r.try_get::<_, serde_json::Value>(3).ok()?,
                response_status: r.try_get::<_, Option<i32>>(4).ok()?,
                response_body: r.try_get::<_, Option<String>>(5).ok()?,
                attempt: r.try_get::<_, i32>(6).ok()?,
                delivered_at: r.try_get::<_, Option<chrono::DateTime<chrono::Utc>>>(7).ok()?,
                next_retry_at: r.try_get::<_, Option<chrono::DateTime<chrono::Utc>>>(8).ok()?,
                created_at: r.try_get::<_, chrono::DateTime<chrono::Utc>>(9).ok()?,
            })
        })
        .collect();

    Ok(Json(deliveries))
}

/// Retry a failed delivery.
pub async fn retry_delivery(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    Path((endpoint_id, delivery_id)): Path<(Uuid, Uuid)>,
) -> Result<Json<serde_json::Value>, ApiError> {
    let client = state.client_source.client().await.map_err(internal)?;
    set_org(&client, api_key_info.organization_id).await?;

    client
        .execute(
            "UPDATE platform.webhook_delivery \
             SET next_retry_at = now(), response_status = NULL, response_body = NULL \
             WHERE id = $1 AND endpoint_id = $2 AND delivered_at IS NULL",
            &[&delivery_id, &endpoint_id],
        )
        .await
        .map_err(internal)?;

    Ok(Json(serde_json::json!({"status": "queued_for_retry"})))
}
