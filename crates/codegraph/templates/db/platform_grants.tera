-- Grants for hand-written platform handlers (entity-less custom-routes domain).
-- Generated by {{ project.generator_name }}. DO NOT EDIT.
--
-- The platform handlers (src/api/platform/handwritten_routes.rs) manage
-- tenants/accounts and API keys through the basejump + api_key_management
-- surfaces created by migrations 0001 (basejump install) and 0002
-- (api_key_management). Those migrations grant only to `authenticated`/
-- `service_role`; this migration extends execution/table grants to the
-- application roles `app_user` and `api_key` so the platform API can run them.
-- Idempotent: every grant is guarded so re-running is a no-op. The whole body
-- is a single DO block so it applies through both the CLI migrate path
-- (prepared statement, single statement per file) and the SeaORM Migrator
-- (execute_unprepared).
DO $$
DECLARE
    v_has_app_user BOOLEAN;
    v_has_api_key  BOOLEAN;
BEGIN
    SELECT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'app_user') INTO v_has_app_user;
    SELECT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'api_key')  INTO v_has_api_key;

    -- public.create_account(slug text, name text) — SECURITY DEFINER tenant creation.
    IF v_has_app_user AND to_regprocedure('public.create_account(text, text)') IS NOT NULL THEN
        GRANT EXECUTE ON FUNCTION public.create_account(text, text) TO app_user;
    END IF;
    IF v_has_api_key AND to_regprocedure('public.create_account(text, text)') IS NOT NULL THEN
        GRANT EXECUTE ON FUNCTION public.create_account(text, text) TO api_key;
    END IF;

    -- public.create_api_key(uuid, text, jsonb, timestamptz) — API-key issuance.
    IF v_has_api_key AND to_regprocedure('public.create_api_key(uuid, text, jsonb, timestamptz)') IS NOT NULL THEN
        GRANT EXECUTE ON FUNCTION public.create_api_key(uuid, text, jsonb, timestamptz) TO api_key;
    END IF;

    -- basejump membership/role helpers.
    IF v_has_app_user AND to_regprocedure('basejump.get_accounts_with_role(basejump.account_role)') IS NOT NULL THEN
        GRANT EXECUTE ON FUNCTION basejump.get_accounts_with_role(basejump.account_role) TO app_user;
    END IF;
    IF v_has_api_key AND to_regprocedure('basejump.get_accounts_with_role(basejump.account_role)') IS NOT NULL THEN
        GRANT EXECUTE ON FUNCTION basejump.get_accounts_with_role(basejump.account_role) TO api_key;
    END IF;

    IF v_has_app_user AND to_regprocedure('basejump.has_role_on_account(uuid, basejump.account_role)') IS NOT NULL THEN
        GRANT EXECUTE ON FUNCTION basejump.has_role_on_account(uuid, basejump.account_role) TO app_user;
    END IF;
    IF v_has_api_key AND to_regprocedure('basejump.has_role_on_account(uuid, basejump.account_role)') IS NOT NULL THEN
        GRANT EXECUTE ON FUNCTION basejump.has_role_on_account(uuid, basejump.account_role) TO api_key;
    END IF;

    -- basejump tables the handlers query/insert (SELECT already granted in 0002;
    -- INSERT is needed for direct account/membership writes under SET LOCAL ROLE).
    IF v_has_app_user THEN
        IF to_regclass('basejump.accounts') IS NOT NULL THEN
            GRANT SELECT, INSERT ON basejump.accounts TO app_user;
        END IF;
        IF to_regclass('basejump.account_user') IS NOT NULL THEN
            GRANT SELECT, INSERT ON basejump.account_user TO app_user;
        END IF;

        -- api_keys_private is service_role-only by default; platform handlers
        -- that read/rotate keys run under app_user, so widen SELECT/UPDATE
        -- (INSERT stays limited to the SECURITY DEFINER public.create_api_key).
        IF to_regclass('api_keys_private.api_keys') IS NOT NULL THEN
            GRANT SELECT, UPDATE ON api_keys_private.api_keys TO app_user;
        END IF;
    END IF;
END $$;
