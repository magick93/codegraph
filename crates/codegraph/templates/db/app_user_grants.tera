-- Late-binding app_user grants.
-- Generated by {{ project.generator_name }}. DO NOT EDIT.
--
-- 0002_api_key_management.sql runs before the codelist/entity DDL bands, so
-- its guarded grants never fire on a fresh database. This migration sorts
-- after every generated band and grants app_user access to everything the
-- project actually created. Statement splitting handles the DO $$ blocks.

DO $$ DECLARE s TEXT; BEGIN
  FOREACH s IN ARRAY ARRAY[{% for s in grant_schemas %}'{{ s }}'{% if not loop.last %},{% endif %}{% endfor %}]::TEXT[] LOOP
    IF EXISTS (SELECT 1 FROM information_schema.schemata WHERE schema_name = s) THEN
      EXECUTE format('GRANT USAGE ON SCHEMA %I TO app_user', s);
      EXECUTE format('GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA %I TO app_user', s);
      EXECUTE format('GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA %I TO app_user', s);
      EXECUTE format('ALTER DEFAULT PRIVILEGES IN SCHEMA %I GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_user', s);
    END IF;
  END LOOP;
END $$;

-- Append-only entities: operations exclude update/delete, so the blanket
-- grants above are narrowed back down per table.
{% for d in domains %}{% for e in d.entities %}{% if e.append_only and e.table_name %}
REVOKE UPDATE, DELETE ON {{ d.postgres_schema }}.{{ e.table_name }} FROM app_user;
{% endif %}{% endfor %}{% endfor %}
-- pgmq queue access (queues are created as events_<domain> by pgmq_setup).
GRANT USAGE ON SCHEMA pgmq TO app_user;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA pgmq TO app_user;
{% for d in domains %}
DO $$ BEGIN
  IF to_regclass('pgmq.q_events_{{ d.name }}') IS NOT NULL THEN
    GRANT SELECT, INSERT, UPDATE, DELETE ON pgmq.q_events_{{ d.name }} TO app_user;
    GRANT SELECT, INSERT, UPDATE, DELETE ON pgmq.a_events_{{ d.name }} TO app_user;
  END IF;
END $$;
{% endfor %}
