//! Per-operation permission middleware.
//! Generated by {{ project.generator_name }}. DO NOT EDIT.
//!
//! Enforces authorization in the request path BEFORE handlers run:
//! - JWT auth: the caller's basejump org role (resolved by the auth
//!   middleware) is mapped to allowed actions.
//! - API key auth: the key's scopes are checked via
//!   public.check_api_key_scope_by_id(key_id, resource, action) — exactly one
//!   query per request, never cached.
//!
//! The data path (SET LOCAL ROLE app_user) is unchanged. Row-level API-key
//! scoping still happens in the api_key_scoped_* RLS policies.

use axum::{
    extract::Request,
    middleware::Next,
    response::{IntoResponse, Response},
    Extension,
};
use sea_orm::{ConnectionTrait, Statement};

use super::{AuthInfo, AuthMode};

/// A permission required by a route: `resource` is the entity's URL path
/// segment (same vocabulary as the api_key_scoped_* RLS policies' resource
/// names) and `action` is one of "create", "read", "update", "delete", "list".
#[derive(Clone, Debug)]
pub struct RequiredPermission {
    pub resource: String,
    pub action: String,
}

/// Decorator for method routers that attaches this route's permission guard:
/// the `require_permission` middleware plus the permission it must check.
///
/// ```ignore
/// .route(
///     "/",
///     axum::routing::get(handler::list).guard("case", "list")
///         .merge(axum::routing::post(handler::create).guard("case", "create")),
/// )
/// ```
pub trait PermissionGuard<S> {
    fn guard(self, resource: &'static str, action: &'static str) -> Self;
}

impl<S: Clone + 'static> PermissionGuard<S> for axum::routing::MethodRouter<S> {
    fn guard(self, resource: &'static str, action: &'static str) -> Self {
        self
            // from_fn first (inner), Extension second (outer): the extension
            // must insert the permission BEFORE the middleware reads it.
            .route_layer(axum::middleware::from_fn(require_permission))
            .route_layer(Extension(RequiredPermission {
                resource: resource.to_string(),
                action: action.to_string(),
            }))
    }
}

pub async fn require_permission(
    // The pooled DB connection, inserted as a request extension for all API
    // routes by the server assembly (see server.rs).
    Extension(db): Extension<sea_orm::DatabaseConnection>,
    Extension(auth_info): Extension<AuthInfo>,
    request: Request,
    next: Next,
) -> Response {
    let Some(required) = request.extensions().get::<RequiredPermission>().cloned() else {
        // Route has no permission requirement attached.
        return next.run(request).await;
    };

    if !has_permission(&db, &auth_info, &required).await {
        return crate::error::AppError::forbidden(format!(
            "Missing required permission: {}:{}",
            required.resource, required.action
        ))
        .into_response();
    }

    next.run(request).await
}

/// Map a basejump org role to allowed actions.
/// Roles: "owner", "member" (basejump) plus "manager", "employee" (RBAC
/// extension). owner/manager are full-access, member can act but not delete,
/// employee is read-only. Unknown roles are denied.
fn role_allows(role: &str, action: &str) -> bool {
    match role {
        "owner" | "manager" => true,
        "member" => matches!(action, "create" | "read" | "update" | "list"),
        "employee" => matches!(action, "read" | "list"),
        _ => false,
    }
}

async fn has_permission(
    db: &sea_orm::DatabaseConnection,
    auth_info: &AuthInfo,
    required: &RequiredPermission,
) -> bool {
    match &auth_info.auth_mode {
        AuthMode::Jwt { .. } => role_allows(&auth_info.role, &required.action),
        AuthMode::ApiKey { .. } => {
            let result = db
                .query_one(Statement::from_sql_and_values(
                    sea_orm::DatabaseBackend::Postgres,
                    "SELECT public.check_api_key_scope_by_id($1, $2, $3)",
                    [
                        auth_info.api_key_id.into(),
                        required.resource.clone().into(),
                        required.action.clone().into(),
                    ],
                ))
                .await;
            match result {
                Ok(Some(row)) => row.try_get_by_index::<bool>(0).unwrap_or(false),
                _ => {
                    tracing::warn!(
                        resource = %required.resource,
                        action = %required.action,
                        "api key scope check failed — denying"
                    );
                    false
                }
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn owner_and_manager_allow_all() {
        for action in ["create", "read", "update", "delete", "list"] {
            assert!(role_allows("owner", action));
            assert!(role_allows("manager", action));
        }
    }

    #[test]
    fn member_cannot_delete() {
        assert!(role_allows("member", "create"));
        assert!(role_allows("member", "read"));
        assert!(role_allows("member", "update"));
        assert!(role_allows("member", "list"));
        assert!(!role_allows("member", "delete"));
    }

    #[test]
    fn employee_is_read_only() {
        assert!(role_allows("employee", "read"));
        assert!(role_allows("employee", "list"));
        assert!(!role_allows("employee", "create"));
        assert!(!role_allows("employee", "update"));
        assert!(!role_allows("employee", "delete"));
    }

    #[test]
    fn unknown_role_denied() {
        assert!(!role_allows("service", "read"));
        assert!(!role_allows("", "delete"));
    }
}
