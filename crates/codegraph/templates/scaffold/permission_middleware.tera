//! Per-operation permission middleware.
//! Generated by {{ project.generator_name }}. DO NOT EDIT.

use axum::{
    extract::Request,
    middleware::Next,
    response::{IntoResponse, Response},
};

use super::AuthInfo;
use cosmos_hooks_api::authorization::{AuthzRequest, AuthorizationService};

/// The registered authorization service, injected into request extensions by
/// the server (`axum::Extension(state.registry.authorization.clone())`).
type AuthzService = std::sync::Arc<dyn AuthorizationService>;

/// Permission string declared by a route's permission layer, e.g.
/// "support:support-plan:read". Inserted into request extensions by the
/// per-module `*_permission` middleware layer.
#[derive(Clone)]
pub struct RequiredPermission(pub String);

/// Authorize the request against the registered `AuthorizationService`.
///
/// Short-circuits to allow when no `RequiredPermission` extension is present
/// (routes without a declared permission keep working unchanged — backward
/// compat with the old always-allow stub). When the extension is present, the
/// decision is delegated to the `AuthorizationService` injected into request
/// extensions by the server; if no service is registered the request is denied.
pub async fn require_permission(
    request: axum::extract::Request,
    next: axum::middleware::Next,
) -> Response {
    let Some(required) = request.extensions().get::<RequiredPermission>().map(|p| p.0.clone()) else {
        return next.run(request).await; // no declared permission -> allow (backward compat)
    };
    let auth = request.extensions().get::<AuthInfo>().cloned();
    let target_id = extract_uuid_from_path(request.uri().path());
    let ctx = AuthzRequest {
        actor_did: auth.as_ref().and_then(|a| a.did.clone()),
        organization_id: auth.as_ref().map(|a| a.organization_id.to_string()),
        permission: required,
        target_id,
        target_did: None,
    };
    let Some(svc) = request
        .extensions()
        .get::<Option<AuthzService>>()
        .and_then(|opt| opt.clone())
    else {
        tracing::warn!("AuthorizationService not registered; denying permission-gated request");
        return crate::error::AppError::forbidden("Authorization service unavailable").into_response();
    };
    match svc.authorize(ctx).await {
        Ok(decision) if decision.allowed => next.run(request).await,
        Ok(decision) => crate::error::AppError::forbidden(
            decision.reason.unwrap_or_else(|| "Not authorized".to_string()),
        ).into_response(),
        Err(e) => crate::error::AppError::internal(format!("Authorization error: {e}")).into_response(),
    }
}

/// Extract a candidate target-record id from the request path.
///
/// Returns the last path segment when it looks like a UUID (36 chars with at
/// least 4 hyphens) or is a simple non-empty segment that is not a known
/// subpath keyword (search / tree / actions / workflow).
fn extract_uuid_from_path(path: &str) -> Option<String> {
    const SUBPATH_KEYWORDS: [&str; 4] = ["search", "tree", "actions", "workflow"];
    let last = path.trim_end_matches('/').rsplit('/').next().unwrap_or("");
    if last.is_empty() {
        return None;
    }
    let looks_like_uuid = last.len() == 36 && last.matches('-').count() >= 4;
    if looks_like_uuid || !SUBPATH_KEYWORDS.contains(&last) {
        Some(last.to_string())
    } else {
        None
    }
}
