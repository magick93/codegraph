# Generated by {{ project.generator_name }}. DO NOT EDIT.
# {{ worker_name }} — Cloudflare Worker crate for the {{ name }} domain.

[package]
name = "{{ worker_name }}"
version = "0.1.0"
edition = "2021"

[lib]
name = "{{ worker_lib_name }}"
path = "src/lib.rs"
crate-type = ["cdylib", "rlib"]

[[bin]]
name = "{{ worker_name }}"
path = "src/main.rs"

[features]
default = ["native"]
native = ["dep:tokio", "dep:tracing-subscriber"]
cloudflare-worker = ["worker/axum", "worker/http"]

[dependencies]
axum = { workspace = true }
sea-orm = { workspace = true }
serde = { workspace = true }
serde_json = { workspace = true }
serde_qs = { workspace = true }
percent-encoding = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
utoipa = { workspace = true }
garde = { workspace = true }
rust_decimal = { workspace = true }
jsonwebtoken = { workspace = true }
async-trait = { workspace = true }
thiserror = { workspace = true }
tracing = { workspace = true }
tokio = { workspace = true, optional = true }
tracing-subscriber = { workspace = true, optional = true }
worker = { workspace = true, optional = true }
codegraph-workflow = { workspace = true }
codegraph-type-contracts = { workspace = true }
{% if domain_types_path %}{{ project.domain_types_crate | replace(from="_", to="-") }} = { path = "{{ domain_types_path }}" }{% endif %}
{% if project.persistence_provider == "cornucopia" %}
tokio-postgres = { workspace = true }
deadpool-postgres = { workspace = true }
cornucopia-queries = { path = "../../cornucopia-queries" }
{% endif %}
