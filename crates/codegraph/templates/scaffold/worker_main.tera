//! Native development entry point for the {{ worker_name }} worker.
//! Serves only this domain's router (`crate::api::{{ name }}::router::router()`).
//! Generated by {{ project.generator_name }}. DO NOT EDIT.

mod api;
mod app_state;
mod domain;
mod entity;
mod error;
mod middleware;
mod qs_query;
mod worker;
{% if project.hooks_api_crate %}mod hooks;{% endif %}

#[cfg(feature = "native")]
#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    tracing_subscriber::fmt::init();

    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL environment variable is required (e.g. postgres://user:pass@localhost:5432/postgres)"
    })?;
    let jwt_secret = std::env::var("SUPABASE_JWT_SECRET")
        .unwrap_or_else(|_| "dev-jwt-secret".to_string());

    let db = sea_orm::Database::connect(&database_url).await?;
{% if project.persistence_provider == "cornucopia" %}
    let pool_cfg: tokio_postgres::Config = database_url.parse()?;
    let pool = deadpool_postgres::Pool::builder(deadpool_postgres::Manager::new(
        pool_cfg,
        tokio_postgres::NoTls,
    ))
    .build()?;
    let state = app_state::AppState::new(db, pool, jwt_secret);
{% else %}
    let state = app_state::AppState::new(db, jwt_secret);
{% endif %}

    let app = worker::router(state);

    let addr: std::net::SocketAddr = std::env::var("BIND_ADDR")
        .unwrap_or_else(|_| "0.0.0.0:3000".to_string())
        .parse()
        .expect("BIND_ADDR must be a valid socket address (e.g. 0.0.0.0:3000)");
    tracing::info!("{{ worker_name }} ({{ name }}) listening on http://{addr}");
    let listener = tokio::net::TcpListener::bind(addr).await?;
    axum::serve(listener, app).await?;
    Ok(())
}

