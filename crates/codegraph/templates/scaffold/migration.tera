    println!();
    println!("Migration files are located in the migrations/ directory.");
    println!("Apply them in numeric order using your preferred tool.");
    Ok(())
{% endif %}
}

{% if migration_strategy == "sea-orm" %}
async fn run_sea_orm_migrations() -> Result<(), Box<dyn std::error::Error>> {
    let db_url = std::env::var("DATABASE_URL")
        .map_err(|_| "DATABASE_URL environment variable is required")?;
    let db = sea_orm::Database::connect(&db_url).await?;

    // Ensure schema_migrations table exists
    sea_orm::ConnectionTrait::execute(
        &db,
        sea_orm::Statement::from_string(
            sea_orm::DatabaseBackend::Postgres,
            r#"
            CREATE TABLE IF NOT EXISTS schema_migrations (
                version TEXT PRIMARY KEY,
                applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
            )
            "#,
        ),
    )
    .await?;

    // Locate the migrations directory: MIGRATIONS_DIR env → repo-root
    // `../../migrations` (derived from this crate's manifest dir) →
    // CWD-relative `migrations`.
    let migrations_dir = migration_dir();
    if !migrations_dir.is_dir() {
        println!(
            "No migrations/ directory found (tried {}).",
            migrations_dir.display()
        );
        return Ok(());
    }

    let mut files: Vec<_> = std::fs::read_dir(&migrations_dir)?
        .filter_map(|e| e.ok())
        .filter(|e| e.path().extension().is_some_and(|ext| ext == "sql"))
        .collect();
    files.sort_by_key(|e| e.file_name());

    let mut applied = 0u32;
    for entry in &files {
        let fname = entry.file_name().to_string_lossy().to_string();
        let version = fname.trim_end_matches(".sql");

        // Check if already applied
        let already = sea_orm::ConnectionTrait::query_one(
            &db,
            sea_orm::Statement::from_sql_and_values(
                sea_orm::DatabaseBackend::Postgres,
                "SELECT 1 FROM schema_migrations WHERE version = $1",
                [version.into()],
            ),
        )
        .await?
        .is_some();

        if already {
            continue;
        }

        let sql = std::fs::read_to_string(entry.path())?;
        let statements = split_sql_statements(&sql);

        // Apply the file's statements one by one inside a transaction;
        // the version is recorded only after every statement succeeds.
        let txn = sea_orm::TransactionTrait::begin(&db).await?;
        let mut failure: Option<(usize, sea_orm::DbErr)> = None;
        for (idx, stmt_sql) in statements.iter().enumerate() {
            let res = sea_orm::ConnectionTrait::execute(
                &txn,
                sea_orm::Statement::from_string(
                    sea_orm::DatabaseBackend::Postgres,
                    stmt_sql.clone(),
                ),
            )
            .await;
            if let Err(e) = res {
                failure = Some((idx, e));
                break;
            }
        }
        if let Some((idx, e)) = failure {
            txn.rollback().await?;
            return Err(format!("Migration {fname} failed at statement {idx}: {e}").into());
        }
        txn.commit().await?;

        // Record migration
        sea_orm::ConnectionTrait::execute(
            &db,
            sea_orm::Statement::from_sql_and_values(
                sea_orm::DatabaseBackend::Postgres,
                "INSERT INTO schema_migrations (version) VALUES ($1)",
                [version.into()],
            ),
        )
        .await?;

        println!("Applied: {version}");
        applied += 1;
    }

    if applied == 0 {
        println!("All migrations already applied.");
    } else {
        println!("Applied {applied} migration(s).");
    }
    Ok(())
}

