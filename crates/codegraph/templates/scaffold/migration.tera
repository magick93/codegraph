{% elif migration_strategy == "supabase" %}
    println!("This application uses Supabase for database migrations.");
    println!("To apply migrations, run:");
    println!("  npx supabase db reset");
    println!();
    println!("Or use the Supabase local development workflow:");
    println!("  npx supabase start");
    Ok(())
{% else %}
