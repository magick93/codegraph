//! Router assembly and Cloudflare Worker entrypoint for the {{ worker_name }}
//! worker ({{ name }} domain).
//! Generated by {{ project.generator_name }}. DO NOT EDIT.

use axum::extract::State;
use axum::response::Json;
use axum::Router;

use crate::app_state::AppState;

/// Build the {{ name }} worker's axum router: the per-domain API router
/// (entity routes) wrapped in the worker-mode auth middleware, plus minimal
/// `/version` and `/health` endpoints.
pub fn router(state: AppState) -> Router<()> {
    let domain_routes = crate::api::{{ name }}::router::router().layer(
        axum::middleware::from_fn_with_state(state.clone(), crate::middleware::auth_middleware),
    );
    // `merge` instead of `nest("/", ...)`: axum 0.8 removed root nesting
    // ("Nesting at the root is no longer supported").
    Router::new()
        .merge(domain_routes)
        .route("/version", axum::routing::get(version))
        .route("/health", axum::routing::get(health))
        .route("/health/ready", axum::routing::get(health_ready))
        .with_state(state)
}

async fn version() -> Json<serde_json::Value> {
    Json(serde_json::json!({
        "name": "{{ worker_name }}",
        "domain": "{{ name }}",
        "version": "0.1.0",
    }))
}

{% if project.persistence_provider == "cornucopia" %}
/// Probe the database through the cornucopia client source.
async fn db_ok(state: &AppState) -> bool {
    #[cfg(not(target_arch = "wasm32"))]
    {
        use sea_orm::ConnectionTrait;
        sea_orm::ConnectionTrait::execute(
            &state.db,
            sea_orm::Statement::from_string(sea_orm::DatabaseBackend::Postgres, "SELECT 1"),
        )
        .await
        .is_ok()
    }
    #[cfg(target_arch = "wasm32")]
    {
        // The worker slice opens a fresh Hyperdrive-backed client per probe —
        // this also doubles as a runtime connectivity check for the
        // cornucopia transport.
        use cornucopia_queries::client::GenericClient;
        match state.client_source.client().await {
            Ok(client) => GenericClient::query_one(&client, "SELECT 1", &[]).await.is_ok(),
            Err(e) => {
                tracing::warn!(error = %e, "{{ worker_name }} health probe failed");
                false
            }
        }
    }
}
{% else %}
async fn db_ok(state: &AppState) -> bool {
    sea_orm::ConnectionTrait::execute(
        &state.db,
        sea_orm::Statement::from_string(sea_orm::DatabaseBackend::Postgres, "SELECT 1"),
    )
    .await
