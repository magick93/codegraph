//! Router assembly and Cloudflare Worker entrypoint for the {{ worker_name }}
//! worker ({{ name }} domain).
//! Generated by {{ project.generator_name }}. DO NOT EDIT.

use axum::extract::State;
use axum::response::Json;
use axum::Router;

use crate::app_state::AppState;

/// Build the {{ name }} worker's axum router: the per-domain API router
/// (entity routes) wrapped in the worker-mode auth middleware, plus minimal
/// `/version` and `/health` endpoints.
pub fn router(state: AppState) -> Router<()> {
    let domain_routes = crate::api::{{ name }}::router::router().layer(
        axum::middleware::from_fn_with_state(state.clone(), crate::middleware::auth_middleware),
    );
    Router::new()
        .nest("/", domain_routes)
        .route("/version", axum::routing::get(version))
        .route("/health", axum::routing::get(health))
        .route("/health/ready", axum::routing::get(health_ready))
        .with_state(state)
}

async fn version() -> Json<serde_json::Value> {
    Json(serde_json::json!({
        "name": "{{ worker_name }}",
        "domain": "{{ name }}",
        "version": "0.1.0",
    }))
}

async fn health(State(state): State<AppState>) -> Json<serde_json::Value> {
    let db_ok = sea_orm::ConnectionTrait::execute(
        &state.db,
        sea_orm::Statement::from_string(sea_orm::DatabaseBackend::Postgres, "SELECT 1"),
    )
    .await
    .is_ok();
    Json(serde_json::json!({
        "status": if db_ok { "ok" } else { "degraded" },
        "db": if db_ok { "connected" } else { "unreachable" },
        "service": "{{ worker_name }}",
    }))
}

async fn health_ready(State(state): State<AppState>) -> Json<serde_json::Value> {
    let db_ok = sea_orm::ConnectionTrait::execute(
        &state.db,
        sea_orm::Statement::from_string(sea_orm::DatabaseBackend::Postgres, "SELECT 1"),
    )
    .await
    .is_ok();
    Json(serde_json::json!({
        "status": if db_ok { "ok" } else { "degraded" },
        "ready": db_ok,
        "service": "{{ worker_name }}",
    }))
}

