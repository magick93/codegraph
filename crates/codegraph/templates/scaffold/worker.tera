}
{% endif %}

async fn health(State(state): State<AppState>) -> Json<serde_json::Value> {
    let db_ok = db_ok(&state).await;
    Json(serde_json::json!({
        "status": if db_ok { "ok" } else { "degraded" },
        "db": if db_ok { "connected" } else { "unreachable" },
        "service": "{{ worker_name }}",
    }))
}

async fn health_ready(State(state): State<AppState>) -> Json<serde_json::Value> {
    let db_ok = db_ok(&state).await;
    Json(serde_json::json!({
        "status": if db_ok { "ok" } else { "degraded" },
        "ready": db_ok,
        "service": "{{ worker_name }}",
    }))
}

/// Wasm-only worker entrypoint — native builds never compile this module, so
/// worker-rs stays behind the `cloudflare-worker` feature.
#[cfg(target_arch = "wasm32")]
mod worker_impl {
    use std::sync::Arc;

    use tower_service::Service;
    use worker::*;

    use super::*;
{% if project.persistence_provider == "cornucopia" %}
    use crate::db_client::{DbConnectionParams, HyperdriveClientSource};

    /// Resolve the database connection parameters for the worker slice.
    ///
    /// The Hyperdrive binding wins; a plain `DATABASE_URL` var is the local
    /// dev / pre-Hyperdrive fallback. The actual client is built per request
    /// by `HyperdriveClientSource` (see `db_client.rs`).
    fn database_params(env: &Env) -> Result<DbConnectionParams, worker::Error> {
        let connection_string = env
            .hyperdrive("{{ hyperdrive_binding }}")
            .map(|h| h.connection_string())
            .or_else(|_| env.var("DATABASE_URL").map(|v| v.to_string()))
            .map_err(|e| {
                worker::Error::RustError(format!(
                    "{{ hyperdrive_binding }} hyperdrive binding or DATABASE_URL var required: {e}"
                ))
            })?;
        DbConnectionParams::from_connection_string(&connection_string).map_err(|e| {
            worker::Error::RustError(format!(
                "failed to parse database connection parameters: {e}"
            ))
        })
    }

    async fn app_state_from_env(env: &Env) -> Result<AppState, worker::Error> {
        let params = database_params(env)?;
        let client_source =
            Arc::new(HyperdriveClientSource::new(params.clone()));
        let jwt_secret = env
            .secret("JWT_SECRET")
            .map(|s| s.to_string())
            .unwrap_or_default();
        Ok(AppState::new(client_source, params, jwt_secret))
    }
{% else %}
    async fn app_state_from_env(env: &Env) -> Result<AppState, worker::Error> {
        // Hyperdrive binding first, DATABASE_URL fallback for local dev.
        let _database_url = env
            .hyperdrive("{{ hyperdrive_binding }}")
            .map(|h| h.connection_string())
            .or_else(|_| env.var("DATABASE_URL").map(|v| v.to_string()))
            .map_err(|e| {
                worker::Error::RustError(format!(
                    "{{ hyperdrive_binding }} hyperdrive binding or DATABASE_URL var required: {e}"
                ))
            })?;
        // TODO(worker-db): route SeaORM through a Hyperdrive socket adapter
        // for production traffic. Until then the wasm slice uses a placeholder
        // connection (compile-gate slice; runtime DB parity lands in a later
        // step of the multi-worker epic).
        let db = AppState::placeholder_connection();
        let jwt_secret = env
            .secret("JWT_SECRET")
            .map(|s| s.to_string())
            .unwrap_or_default();
        Ok(AppState::new(db, jwt_secret))
    }
{% endif %}

    #[event(fetch)]
    async fn fetch(
        req: HttpRequest,
        env: Env,
        _ctx: Context,
    ) -> Result<axum::http::Response<axum::body::Body>> {
        let state = app_state_from_env(&env).await?;
        Ok(router(state).call(req).await?)
    }
{% if has_workflow_timers %}

    /// Cron-triggered timer sweep for the {{ name }} domain.
    ///
    /// Runs [`codegraph_workflow::timer::process_pending_timers`] against a
    /// per-invocation client from the same `ClientSource` the fetch handler
    /// uses, filtered to `workflow_definition.domain = "{{ name }}"`.
    #[event(scheduled)]
    async fn scheduled(
        _event: ScheduledEvent,
        env: Env,
        _ctx: ScheduleContext,
    ) -> Result<(), worker::Error> {
        use codegraph_workflow::WorkflowClient;

        let state = app_state_from_env(&env).await?;
        let client = crate::workflow_client::CornucopiaWorkflowClient::new(
            state.client_source.clone(),
        );
        let workflow_service = codegraph_workflow::GenericWorkflowService::new(client.clone());
        let mut tx = client
            .begin()
            .await
            .map_err(|e| worker::Error::RustError(e.to_string()))?;
        let result = codegraph_workflow::timer::process_pending_timers(
            tx.as_mut(),
            Some("{{ name }}"),
            &workflow_service,
        )
        .await;
        if result.is_err() {
            let _ = tx.rollback().await;
        }
        result.map_err(|e| worker::Error::RustError(e.to_string()))
    }
{% endif %}
}
