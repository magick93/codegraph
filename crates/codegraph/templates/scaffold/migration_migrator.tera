//! Migrator that applies raw SQL migration files via SeaORM.
//! Generated by {{ project.generator_name }}. DO NOT EDIT.
//!
//! Each `.sql` file in the `migrations/` directory is executed as-is (no
//! statement splitting), so PL/pgSQL `$$` blocks and multi-statement files
//! work correctly. Applied files are tracked in the `seaql_migrations` table
//! (transactionally — a failed migration run rolls back completely).
//!
//! `down` is a no-op: raw SQL files have no inverse statements.

use sea_orm_migration::prelude::*;
use std::path::Path;

pub struct Migrator;

#[async_trait::async_trait]
impl MigratorTrait for Migrator {
    fn migrations() -> Vec<Box<dyn MigrationTrait>> {
        load_migrations()
    }
}

/// A migration that runs a raw SQL file unchanged.
struct RawSqlMigration {
    name: String,
    sql: String,
}

impl MigrationName for RawSqlMigration {
    fn name(&self) -> &str {
        &self.name
    }
}

#[async_trait::async_trait]
impl MigrationTrait for RawSqlMigration {
    async fn up(&self, manager: &SchemaManager) -> Result<(), DbErr> {
        manager
            .get_connection()
            .execute_unprepared(&self.sql)
            .await
            .map(|_| ())
    }

    async fn down(&self, _manager: &SchemaManager) -> Result<(), DbErr> {
        Ok(())
    }
}

/// Locate the raw SQL migrations directory.
///
/// Resolution order:
/// 1. `MIGRATIONS_DIR` environment variable
/// 2. `<app>/migrations` (derived from this crate's manifest dir)
/// 3. `./migrations` relative to the current working directory
fn migrations_dir() -> std::path::PathBuf {
    if let Ok(dir) = std::env::var("MIGRATIONS_DIR") {
        let p = Path::new(&dir);
        if p.exists() {
            return p.to_path_buf();
        }
    }
    let manifest_relative = Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("..")
        .join("migrations");
    if manifest_relative.exists() {
        return manifest_relative;
    }
    Path::new("migrations").to_path_buf()
}

/// Load all `.sql` files from the migrations directory in filename order.
fn load_migrations() -> Vec<Box<dyn MigrationTrait>> {
    let dir = migrations_dir();
    let mut entries: Vec<_> = std::fs::read_dir(&dir)
        .map(|rd| rd.flatten().collect::<Vec<_>>())
        .unwrap_or_default()
        .into_iter()
        .filter(|e| e.path().extension().map_or(false, |ext| ext == "sql"))
        .collect();
    entries.sort_by_key(|e| e.file_name());

    entries
        .into_iter()
        .filter_map(|entry| {
            let name = entry.file_name().to_string_lossy().into_owned();
            let sql = std::fs::read_to_string(entry.path()).ok()?;
            if sql.trim().is_empty() {
                return None;
            }
            Some(Box::new(RawSqlMigration { name, sql }) as Box<dyn MigrationTrait>)
        })
        .collect()
}
