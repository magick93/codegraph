# Generated by {{ project.generator_name }}. DO NOT EDIT.
# Wrangler config for the {{ worker_name }} worker ({{ name }} domain).

name = "{{ worker_name }}"
main = "build/worker/shim.mjs"
compatibility_date = "2024-12-01"

[build]
command = "cargo install worker-build && worker-build --release --no-default-features --features cloudflare-worker"

[vars]
# Set in Cloudflare or in a local .dev.vars file.
JWT_SECRET = ""
DATABASE_URL = ""

[[hyperdrive]]
binding = "{{ hyperdrive_binding }}"
id = "<REPLACE_WITH_HYPERDRIVE_ID>"
# Local dev: point hyperdrive at your local Postgres.
# localConnectionString = "postgres://user:pass@localhost:5432/{{ postgres_schema }}"
{% for binding in service_bindings %}

[[services]]
binding = "{{ binding.binding }}"
service = "{{ binding.service_name }}"
{% endfor %}
{% if custom_domain %}

[[routes]]
pattern = "{{ custom_domain }}"
# zone_name = "your-zone.com"
{% endif %}
{% if cron_triggers %}

[triggers]
crons = [
{% for cron in cron_triggers %}
    "{{ cron }}",
{% endfor %}
]
{% endif %}
