        Commands::Start { bind_addr, database_url, config: _config, pid_file } => {
            std::env::set_var("BIND_ADDR", &bind_addr);
            if let Some(u) = database_url {
                std::env::set_var("DATABASE_URL", &u);
            }
            let pf_path = pid_file_path(Some(&bind_addr), pid_file.as_deref());
            let pid = std::process::id();
            if let Err(e) = std::fs::write(&pf_path, pid.to_string()) {
                eprintln!("warning: could not write PID file {pf_path}: {e}");
            } else {
                tracing::info!("PID {pid} written to {pf_path}");
