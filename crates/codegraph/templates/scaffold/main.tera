                let pid_str = match std::fs::read_to_string(&pf_path) {
                    Ok(s) => s.trim().to_string(),
                    Err(_) => {
                        println!("Server is stopped (no PID file at {pf_path}).");
                        std::process::exit(1);
                    }
                };
                let pid: u32 = match pid_str.parse() {
                    Ok(p) => p,
                    Err(_) => {
                        println!("Server is stopped (corrupted PID file {pf_path}).");
                        std::process::exit(1);
                    }
                };
                if process_exists(pid) {
                    println!("Server is running (PID {pid}).");
