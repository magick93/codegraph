fn pid_file_path(bind_addr: Option<&str>, pid_file: Option<&str>) -> String {
    if let Some(pf) = pid_file {
        if !pf.is_empty() {
            return pf.to_string();
        }
    }
    let addr = bind_addr.unwrap_or("0.0.0.0:3000");
    let port = addr.rsplit(':').next().unwrap_or("3000");
    format!("hr-app-{port}.pid")
}

#[derive(Parser)]
#[command(name = "{{ app_name }}", version)]
struct Cli {
    #[command(subcommand)]
    command: Commands,
}

#[derive(Subcommand)]
enum Commands {
    /// Start the API server
    Start {
        #[arg(long = "bind-addr", env = "BIND_ADDR", default_value = "0.0.0.0:3000")]
        bind_addr: String,
        #[arg(long = "database-url", env = "DATABASE_URL")]
        database_url: Option<String>,
        #[arg(long = "config", env = "HR_APP_CONFIG")]
        config: Option<String>,
        #[arg(long = "pid-file")]
        pid_file: Option<String>,
    },
    /// Stop a running server (sends SIGTERM)
    Stop {
        #[arg(long = "bind-addr")]
        bind_addr: Option<String>,
        #[arg(long = "pid-file")]
        pid_file: Option<String>,
        #[arg(long, default_value_t = false)]
        force: bool,
        #[arg(long, default_value_t = 15)]
        timeout: u64,
    },
    /// Check if a server is running
    Status {
        #[arg(long = "bind-addr")]
