            println!("Build time:  {}", build::BUILD_TIME_3339);
            println!("Rust:        {} ({})", build::RUST_VERSION, build::RUST_CHANNEL);
            println!("OS:          {}", build::BUILD_OS);
        }
        Commands::Init { output } => {
            let config = crate::config::ServerConfig::default();
            match toml::to_string_pretty(&config) {
                Ok(toml) => {
                    if let Err(e) = std::fs::write(&output, toml) {
                        eprintln!("Failed to write {output}: {e}");
                        std::process::exit(1);
                    }
                    println!("Configuration written to {output}");
                }
                Err(e) => {
                    eprintln!("Failed to serialize config: {e}");
                    std::process::exit(1);
                }
            }
        }
        Commands::Doctor { database_url, config: _config } => {
            if let Some(u) = database_url {
                std::env::set_var("DATABASE_URL", &u);
            }
            crate::doctor::run_checks().await;
        }
        Commands::Migrate { database_url, config: _config } => {
            if let Some(u) = database_url {
                std::env::set_var("DATABASE_URL", &u);
            }
            if let Err(e) = crate::migration::run_migrations().await {
                eprintln!("Migration error: {e}");
                std::process::exit(1);
            }
        }
        Commands::Stop { bind_addr, pid_file, force, timeout } => {
            #[cfg(not(unix))]
            {
                eprintln!("Process management is not supported on this platform.");
                std::process::exit(1);
            }
            #[cfg(unix)]
            {
                let pf_path = pid_file_path(bind_addr.as_deref(), pid_file.as_deref());
                let pid_str = match std::fs::read_to_string(&pf_path) {
                    Ok(s) => s.trim().to_string(),
                    Err(_) => {
                        eprintln!("No server appears to be running (PID file {pf_path} not found).");
                        std::process::exit(1);
                    }
                };
                let pid: u32 = match pid_str.parse() {
                    Ok(p) => p,
                    Err(_) => {
                        eprintln!("Invalid PID file {pf_path}: corrupted content.");
                        std::process::exit(1);
                    }
                };
                if !process_exists(pid) {
                    let _ = std::fs::remove_file(&pf_path);
                    println!("Server was already stopped (stale PID file {pf_path} removed).");
                    return;
                }
                let signal = if force { libc::SIGKILL } else { libc::SIGTERM };
                let sig_name = if force { "SIGKILL" } else { "SIGTERM" };
                if !send_signal(pid, signal) {
                    eprintln!("Failed to send {sig_name} to PID {pid}.");
                    std::process::exit(1);
                }
                println!("Sent {sig_name} to PID {pid}, waiting for shutdown...");
                let mut waited = 0u64;
                while waited < timeout {
                    std::thread::sleep(std::time::Duration::from_millis(500));
                    waited += 1; // count in 500ms ticks, but we track seconds approximately
                    if !process_exists(pid) {
                        let _ = std::fs::remove_file(&pf_path);
                        println!("Server stopped gracefully in ~{}s.", (waited + 1) / 2);
                        return;
                    }
                    if waited % 2 == 1 {
                        // wait full 500ms
                    }
                }
                let elapsed = waited / 2;
                if force {
                    let _ = std::fs::remove_file(&pf_path);
                    eprintln!("Server did not exit after SIGKILL within {elapsed}s.");
                    std::process::exit(1);
                }
                eprintln!("Server did not stop within {elapsed}s. Use --force to send SIGKILL.");
                std::process::exit(1);
            }
        }
        Commands::Status { bind_addr, pid_file } => {
            #[cfg(not(unix))]
