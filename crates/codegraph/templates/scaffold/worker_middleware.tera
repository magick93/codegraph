/// Axum middleware validating the `Authorization: Bearer <jwt>` header.
/// HS256 signature verified against `SUPABASE_JWT_SECRET`.
pub async fn auth_middleware(
    State(state): State<AppState>,
    mut request: Request,
    next: Next,
) -> Result<Response, (StatusCode, Json<serde_json::Value>)> {
    let token = request
        .headers()
        .get("authorization")
        .and_then(|v| v.to_str().ok())
        .and_then(|s| s.strip_prefix("Bearer "))
        .map(|s| s.to_string())
        .ok_or_else(|| reject_unauthorized("Missing or malformed Authorization header"))?;

    let auth_info = verify_jwt(&token, &state.jwt_secret)?;

    request.extensions_mut().insert(auth_info);
    Ok(next.run(request).await)
}

fn verify_jwt(
    token: &str,
    jwt_secret: &str,
) -> Result<AuthInfo, (StatusCode, Json<serde_json::Value>)> {
    // HS256 only for the worker slice. ES256/JWKS and `sk_` API keys are not
    // implemented yet — see the TODO(worker-auth) note at the top of the file.
    let mut validation = Validation::new(jsonwebtoken::Algorithm::HS256);
    validation.validate_exp = true;

    let token_data = decode::<JwtClaims>(
        token,
        &DecodingKey::from_secret(jwt_secret.as_bytes()),
        &validation,
    )
    .map_err(|e| reject_unauthorized(&format!("Invalid JWT: {e}")))?;

    let user_id: Uuid = token_data
        .claims
        .sub
        .parse()
        .map_err(|_| reject_unauthorized("JWT sub is not a valid UUID"))?;

    Ok(AuthInfo {
        // Organization/role resolution needs the basejump SECURITY DEFINER
        // functions (monolith parity) — nil values in the worker slice.
        organization_id: Uuid::nil(),
        api_key_id: Uuid::nil(),
        user_id,
        auth_mode: AuthMode::Jwt { user_id },
        role: "member".to_string(),
    })
}

fn reject_unauthorized(msg: &str) -> (StatusCode, Json<serde_json::Value>) {
    (
        StatusCode::UNAUTHORIZED,
        Json(serde_json::json!({
            "error": { "code": "UNAUTHORIZED", "message": msg }
        })),
    )
}

