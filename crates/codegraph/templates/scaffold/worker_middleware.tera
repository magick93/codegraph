//! Worker-mode authentication middleware — JWT (HS256 + ES256/JWKS) and
//! `sk_` API-key verification, at monolith parity.
//!
//! Auth is resolved through a per-request cornucopia client from the worker's
//! `client_source` (the same Hyperdrive-backed source the workflow engine
//! uses), so `organization_id`/`role` are real values (not nil) and `tenant_id`
//! RLS scoping works for both auth modes.
//! Generated by {{ project.generator_name }}. DO NOT EDIT.

use axum::{
    extract::{Request, State},
    http::StatusCode,
    middleware::Next,
    response::Response,
    Json,
};
use cornucopia_queries::client::GenericClient;
use jsonwebtoken::{decode, decode_header, Algorithm, DecodingKey, Validation};
use serde::Deserialize;
use tokio_postgres::types::ToSql;
use uuid::Uuid;

use crate::app_state::AppState;

/// Verified auth info stored in request extensions.
/// Shape matches the monolith middleware so generated handlers can extract
/// `crate::middleware::ApiKeyInfo` unchanged.
#[derive(Clone, Debug)]
// Some fields exist for API-surface completeness; suppress dead-code noise.
#[allow(dead_code)]
pub struct AuthInfo {
    pub organization_id: Uuid,
    /// API key UUID for API-key auth, or nil for JWT auth.
    pub api_key_id: Uuid,
    /// User UUID for JWT auth, or nil for API key auth.
    pub user_id: Uuid,
    pub auth_mode: AuthMode,
    /// Basejump account role: "owner", "member", "manager", or "employee".
    pub role: String,
    /// Scopes returned by `verify_api_key()` (API-key auth only).
    pub scopes: Vec<String>,
}

#[derive(Clone, Debug)]
#[allow(dead_code)]
pub enum AuthMode {
    Jwt { user_id: Uuid },
    ApiKey { api_key_id: Uuid, raw_key: String },
}

/// Alias kept for handler ergonomics — generated handlers extract this type.
pub type ApiKeyInfo = AuthInfo;

#[derive(Deserialize)]
struct VerifyResult {
    valid: bool,
    api_key_id: Option<Uuid>,
    organization_id: Option<Uuid>,
    #[serde(default)]
    scopes: Option<serde_json::Value>,
    error: Option<String>,
}

// Fields exist for serde deserialization; expiry is validated by jsonwebtoken.
#[derive(Debug, Deserialize)]
#[allow(dead_code)]
struct JwtClaims {
    sub: String,
    exp: u64,
    aud: Option<String>,
}

/// Axum middleware validating the `Authorization: Bearer <token>` header.
/// `sk_` prefix → API-key verification; otherwise JWT (HS256 via
/// `SUPABASE_JWT_SECRET`, or ES256 via the Supabase JWKS endpoint).
pub async fn auth_middleware(
    State(state): State<AppState>,
    mut request: Request,
    next: Next,
) -> Result<Response, (StatusCode, Json<serde_json::Value>)> {
    let token = request
        .headers()
        .get("authorization")
        .and_then(|v| v.to_str().ok())
        .and_then(|s| s.strip_prefix("Bearer "))
        .map(|s| s.to_string())
        .ok_or_else(|| reject_unauthorized("Missing or malformed Authorization header"))?;

    let auth_info = if token.starts_with("sk_") {
        verify_api_key(&state, &token).await?
    } else {
        verify_jwt(&state, &token).await?
    };

    let endpoint = request.uri().path().to_string();
    let method = request.method().to_string();

    request.extensions_mut().insert(auth_info.clone());

    let response = next.run(request).await;

    // Log usage for API-key auth. The monolith awaits this inline and ignores
    // the result; we keep that exact semantics. `ctx.wait_until` is not
    // reachable from the axum middleware layer (the worker `Context` is not
    // threaded into `AppState`), and a detached `spawn_local` task is not
    // guaranteed to complete before the isolate is frozen — so an inline
    // best-effort `await` is the only reliable option. It adds one extra DB
    // round-trip on API-key requests only.
    if let AuthMode::ApiKey { api_key_id, .. } = &auth_info.auth_mode {
        let status_code = response.status().as_u16() as i32;
        log_api_key_usage(&state, *api_key_id, &endpoint, &method, status_code).await;
    }

    Ok(response)
}

/// Bind owned tokio-postgres `ToSql` values into the `&[&(dyn ToSql + Sync)]`
/// view cornucopia's `GenericClient` expects.
fn bind(params: &[Box<dyn ToSql + Sync + Send>]) -> Vec<&(dyn ToSql + Sync)> {
    params
        .iter()
        .map(|p| p.as_ref() as &(dyn ToSql + Sync))
        .collect()
}

async fn verify_api_key(
    state: &AppState,
    token: &str,
) -> Result<AuthInfo, (StatusCode, Json<serde_json::Value>)> {
    let client = state
        .client_source
        .client()
        .await
        .map_err(|e| reject_unauthorized(&format!("Auth check failed: {e}")))?;

    let params: Vec<Box<dyn ToSql + Sync + Send>> = vec![Box::new(token.to_string())];
    let refs = bind(&params);
    let row = client
        .query_one("SELECT public.verify_api_key($1)", &refs)
        .await
        .map_err(|e| reject_unauthorized(&format!("Auth check failed: {e}")))?;

    let json_val: serde_json::Value = row
        .try_get::<_, serde_json::Value>(0)
        .map_err(|e| reject_unauthorized(&format!("Auth parse error: {e}")))?;

    let verify: VerifyResult = serde_json::from_value(json_val)
        .map_err(|e| reject_unauthorized(&format!("Auth parse error: {e}")))?;

    if !verify.valid {
        return Err(reject_unauthorized(
            verify.error.as_deref().unwrap_or("Invalid API key"),
        ));
    }

    let api_key_id = verify
        .api_key_id
        .ok_or_else(|| reject_unauthorized("Missing api_key_id"))?;
    let organization_id = verify
        .organization_id
        .ok_or_else(|| reject_unauthorized("Missing organization_id"))?;

    Ok(AuthInfo {
        organization_id,
        api_key_id,
        user_id: Uuid::nil(),
        auth_mode: AuthMode::ApiKey {
            api_key_id,
            raw_key: token.to_string(),
        },
        role: "api_key".to_string(),
        scopes: crate::api::scope::parse_scopes(
            verify.scopes.unwrap_or(serde_json::Value::Array(vec![])),
        ),
    })
}

async fn verify_jwt(
    state: &AppState,
    token: &str,
) -> Result<AuthInfo, (StatusCode, Json<serde_json::Value>)> {
    let header = decode_header(token)
        .map_err(|e| reject_unauthorized(&format!("Invalid JWT header: {e}")))?;

    let mut validation = Validation::new(header.alg);
    validation.set_audience(&["authenticated"]);
    validation.validate_exp = true;

    let decoding_key = match header.alg {
        Algorithm::HS256 => DecodingKey::from_secret(state.jwt_secret.as_bytes()),
        Algorithm::ES256 => {
            let supabase_url = state.supabase_url.as_deref().ok_or_else(|| {
                reject_unauthorized(
                    "SUPABASE_URL or PUBLIC_SUPABASE_URL must be set for ES256 JWT verification",
                )
            })?;
            let jwks_url = format!(
                "{}/auth/v1/.well-known/jwks.json",
                supabase_url.trim_end_matches('/')
            );
            let jwks = fetch_jwks(&jwks_url).await?;
            let keys = jwks["keys"]
                .as_array()
                .ok_or_else(|| reject_unauthorized("JWKS has no keys"))?;
            let key = if let Some(kid) = &header.kid {
                keys.iter().find(|k| k["kid"].as_str() == Some(kid.as_str()))
            } else {
                keys.first()
            }
            .ok_or_else(|| reject_unauthorized("No matching JWKS key"))?;
            let x = key["x"]
                .as_str()
                .ok_or_else(|| reject_unauthorized("Missing JWKS x"))?;
            let y = key["y"]
                .as_str()
                .ok_or_else(|| reject_unauthorized("Missing JWKS y"))?;
            DecodingKey::from_ec_components(x, y)
                .map_err(|e| reject_unauthorized(&format!("Invalid JWKS key: {e}")))?
        }
        alg => {
            return Err(reject_unauthorized(&format!(
                "Unsupported JWT algorithm: {:?}",
                alg
            )))
        }
    };

    let token_data = decode::<JwtClaims>(token, &decoding_key, &validation)
        .map_err(|e| reject_unauthorized(&format!("Invalid JWT: {e}")))?;

    let user_id: Uuid = token_data
        .claims
        .sub
        .parse()
        .map_err(|_| reject_unauthorized("JWT sub is not a valid UUID"))?;

    // Resolve organization + role through the per-request client. These
    // SECURITY DEFINER functions bypass basejump RLS (monolith parity), so the
    // resolved `organization_id` drives `set_config(...)` tenant scoping in
    // generated handlers and the workflow engine.
    let client = state
        .client_source
        .client()
        .await
        .map_err(|e| reject_unauthorized(&format!("Org lookup failed: {e}")))?;

    let org_params: Vec<Box<dyn ToSql + Sync + Send>> = vec![Box::new(user_id)];
    let org_refs = bind(&org_params);
    let row = client
        .query_opt("SELECT public.resolve_user_org($1)", &org_refs)
        .await
        .map_err(|e| reject_unauthorized(&format!("Org lookup failed: {e}")))?
        .ok_or_else(|| reject_unauthorized("User has no organization membership"))?;
    let organization_id: Uuid = row
        .try_get::<_, Uuid>(0)
        .map_err(|e| reject_unauthorized(&format!("Org parse error: {e}")))?;

    let role_params: Vec<Box<dyn ToSql + Sync + Send>> =
        vec![Box::new(organization_id), Box::new(user_id)];
    let role_refs = bind(&role_params);
    let role = client
        .query_opt(
            "SELECT account_role::text FROM basejump.account_user WHERE account_id = $1 AND user_id = $2",
            &role_refs,
        )
        .await
        .ok()
        .flatten()
        .and_then(|r| r.try_get::<_, String>(0).ok())
        .unwrap_or_else(|| "member".to_string());

    Ok(AuthInfo {
        organization_id,
        api_key_id: Uuid::nil(),
        user_id,
        auth_mode: AuthMode::Jwt { user_id },
        role,
        scopes: Vec::new(),
    })
}

/// Best-effort API-key usage log (fire-and-forget: await inline, ignore result).
async fn log_api_key_usage(
    state: &AppState,
    api_key_id: Uuid,
    endpoint: &str,
    method: &str,
    status_code: i32,
) {
    let Ok(client) = state.client_source.client().await else {
        return;
    };
    let params: Vec<Box<dyn ToSql + Sync + Send>> = vec![
        Box::new(api_key_id),
        Box::new(endpoint.to_string()),
        Box::new(method.to_string()),
        Box::new(status_code),
        Box::new(String::new()),
        Box::new(String::new()),
    ];
    let refs = bind(&params);
    let _ = client
        .execute(
            "SELECT public.log_api_key_usage($1, $2, $3, $4, $5, $6)",
            &refs,
        )
        .await;
}

// ── ES256 JWKS fetch with an in-isolate TTL cache ────────────────────────────
//
// Decision #104 (option 1): cache the JWKS document in the isolate, keyed by
// URL, with a 5-minute TTL. No KV binding for now. The cache is a process-global
// `Mutex` so every request served by this isolate shares it.

const JWKS_TTL_MS: u64 = 5 * 60 * 1000;

struct CachedJwks {
    fetched_at_ms: u64,
    document: serde_json::Value,
}

static JWKS_CACHE: std::sync::Mutex<Option<std::collections::HashMap<String, CachedJwks>>> =
    std::sync::Mutex::new(None);

fn now_millis() -> u64 {
    #[cfg(target_arch = "wasm32")]
    {
        worker::Date::now().as_millis()
    }
    #[cfg(not(target_arch = "wasm32"))]
    {
        use std::time::{SystemTime, UNIX_EPOCH};
        SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .map(|d| d.as_millis() as u64)
            .unwrap_or(0)
    }
}

fn jwks_cache_lock(
) -> std::sync::MutexGuard<'static, Option<std::collections::HashMap<String, CachedJwks>>> {
    JWKS_CACHE
        .lock()
        .unwrap_or_else(|poisoned| poisoned.into_inner())
}

async fn fetch_jwks(
    jwks_url: &str,
) -> Result<serde_json::Value, (StatusCode, Json<serde_json::Value>)> {
    let now = now_millis();
    {
        let cache = jwks_cache_lock();
        if let Some(entry) = cache.as_ref().and_then(|m| m.get(jwks_url)) {
            if now.saturating_sub(entry.fetched_at_ms) < JWKS_TTL_MS {
                return Ok(entry.document.clone());
            }
        }
    }

    let body = fetch_jwks_http(jwks_url).await?;
    let document: serde_json::Value = serde_json::from_str(&body)
        .map_err(|e| reject_unauthorized(&format!("JWKS parse failed: {e}")))?;

    {
        let mut cache = jwks_cache_lock();
        let map = cache.get_or_insert_with(std::collections::HashMap::new);
        map.insert(
            jwks_url.to_string(),
            CachedJwks {
                fetched_at_ms: now_millis(),
                document: document.clone(),
            },
        );
    }

    Ok(document)
}

#[cfg(not(target_arch = "wasm32"))]
async fn fetch_jwks_http(
    jwks_url: &str,
) -> Result<String, (StatusCode, Json<serde_json::Value>)> {
    reqwest::get(jwks_url)
        .await
        .map_err(|e| reject_unauthorized(&format!("JWKS fetch failed: {e}")))?
        .text()
        .await
        .map_err(|e| reject_unauthorized(&format!("JWKS body read failed: {e}")))
}

/// Bridge a non-`Send` workers-rs future (the global `worker::Fetch`, which
/// holds JS objects) into the `Send`-future world axum handlers require — run
/// it in the worker event loop and ship a `Send`-safe result back over a
/// oneshot channel. Same pattern as the gateway's service-binding forwarding.
#[cfg(target_arch = "wasm32")]
fn run_in_worker_loop<T>(
    future: impl std::future::Future<Output = T> + 'static,
) -> impl std::future::Future<Output = Result<T, String>> + Send
where
    T: Send + 'static,
{
    let (tx, rx) = futures_channel::oneshot::channel();
    worker::wasm_bindgen_futures::spawn_local(async move {
        let _ = tx.send(future.await);
    });
    async move { rx.await.map_err(|_| "worker loop task dropped".to_string()) }
}

#[cfg(target_arch = "wasm32")]
async fn fetch_jwks_http(
    jwks_url: &str,
) -> Result<String, (StatusCode, Json<serde_json::Value>)> {
    let url = worker::Url::parse(jwks_url)
        .map_err(|e| reject_unauthorized(&format!("Invalid JWKS URL: {e}")))?;
    run_in_worker_loop(async move {
        let mut resp = worker::Fetch::Url(url)
            .send()
            .await
            .map_err(|e| e.to_string())?;
        resp.text().await.map_err(|e| e.to_string())
    })
    .await
    .map_err(|e| reject_unauthorized(&format!("JWKS fetch failed: {e}")))?
    .map_err(|e| reject_unauthorized(&format!("JWKS fetch failed: {e}")))
}

fn reject_unauthorized(msg: &str) -> (StatusCode, Json<serde_json::Value>) {
    (
        StatusCode::UNAUTHORIZED,
        Json(serde_json::json!({
            "error": { "code": "UNAUTHORIZED", "message": msg }
        })),
    )
}

/// Metrics middleware — no-op in the worker slice.
///
/// The monolith records Prometheus metrics through the `metrics` crate;
/// worker crates keep the middleware point so entities with
/// `pipeline.middleware = ["metrics"]` compile unchanged, but record
/// nothing until Workers Observability parity lands.
pub mod metrics_middleware {
    use axum::{middleware::Next, response::Response};

    pub async fn track_metrics(req: axum::extract::Request, next: Next) -> Response {
{% if observability %}
        // Wasm-safe per-request metric: a structured console log that surfaces
        // in `wrangler tail` / Workers Logs. The native path is a no-op (the
        // monolith keeps the Prometheus `metrics` recorder).
        let method = req.method().to_string();
        let path = req.uri().path().to_string();
        let start_ms = super::now_millis();
        let response = next.run(req).await;
        let status = response.status().as_u16();
        let duration_ms = super::now_millis().saturating_sub(start_ms);
        #[cfg(target_arch = "wasm32")]
        worker::console_log!(
            "http_request method={method} path={path} status={status} duration_ms={duration_ms}"
        );
        #[cfg(not(target_arch = "wasm32"))]
        let _ = (method, path, status, duration_ms);
        response
{% else %}
        // TODO(worker-observability): emit request metrics via Workers Observability.
        next.run(req).await
{% endif %}
    }
}

/// Per-operation permission middleware — inline worker variant of the
/// monolith `middleware/permission.rs`. Route-level pipeline middleware
/// (`pipeline.middleware = ["permission"]`) compiles unchanged against this
/// module; real permission evaluation lands with runtime parity.
pub mod permission {
    use axum::{
        extract::Request,
        middleware::Next,
        response::{IntoResponse, Response},
        Extension,
    };

    use super::AuthInfo;

    pub async fn require_permission(
        Extension(auth_info): Extension<AuthInfo>,
        request: Request,
        next: Next,
    ) -> Response {
        let required = request
            .extensions()
            .get::<RequiredPermission>()
            .map(|p| p.0.as_str())
            .unwrap_or("unknown");

        // TODO(worker-auth): enforce real permissions; accept everything in
        // the compile-gate slice (mirrors the monolith's permissive stub).
        if !has_permission(&auth_info, required) {
            return crate::error::AppError::forbidden(format!(
                "Missing required permission: {required}"
            ))
            .into_response();
        }

        next.run(request).await
    }

    #[derive(Clone)]
    pub struct RequiredPermission(pub String);

    fn has_permission(_auth_info: &AuthInfo, _required: &str) -> bool {
        true
    }
}
