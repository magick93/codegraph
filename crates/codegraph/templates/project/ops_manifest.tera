# Ops harness configuration for {{ project_name }} — generated by `codegraph init`.
# Edit to add project-specific hooks, extensions, and seed SQL.

app_name = "{{ app_name }}"
graph_binary = "{{ graph_binary }}"
schemas_dir = "schemas"
classifier = "classifier.toml"
domain_config = "domains.toml"
profile = "default"
output_dir = "generated"

[servers]
api_port = 3000
ui_port = 5173
bind_addr = "0.0.0.0"

[database.api]
host = "localhost"
port = 5432
user = "postgres"
password = "postgres"
database = "postgres"

[database.e2e]
host = "localhost"
port = 54322
user = "postgres"
password = "postgres"
database = "postgres"

[capabilities]
has_cli = true
has_ui = true
has_admin_cli = true
has_grpc = {{ features.grpc }}
database_target = "{{ database_target }}"
persistence_provider = "{{ persistence_provider }}"

[smoke]
entity = "{{ domains[0].name }}/item"
create_body = "{}"

[hurl]
dir = "hurl"
skip = ["08_rls_isolation.hurl"]
org_id_a = "00000000-0000-0000-0000-000000000001"
org_id_b = "00000000-0000-0000-0000-000000000002"

hooks = []
extensions = []

# Supabase: uncomment and fill in to enable the `e2e` suite's local stack.
#
# [supabase]
# dir = "supabase"
# anon_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# service_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# jwt_secret = "super-secret-jwt-token-with-at-least-32-characters-long"
