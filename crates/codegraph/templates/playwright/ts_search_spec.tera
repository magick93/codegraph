    const response = await request.post('/api/{{ domain }}/{{ path_segment }}', {
      headers,
      data: payload,
    });
    expect(response.status()).toBe(201);
    const { data } = await response.json();
    createdId = data.id;
  });

  test.afterAll(async ({ request }) => {
    if (createdId) {
      await request.delete(`/api/{{ domain }}/{{ path_segment }}/${createdId}`, { headers });
    }
  });

  test('GET /search?q= finds the created entity', async ({ request }) => {
    const response = await request.get(`/api/{{ domain }}/{{ path_segment }}/search?q=${searchTerm}`, { headers });
    expect(response.status()).toBe(200);
    const body = await response.json();
    expect(body.total).toBeGreaterThanOrEqual(1);
    expect(body.data.some((e: { id: string }) => e.id === createdId)).toBe(true);
  });

  test('search does not match unrelated terms', async ({ request }) => {
    const response = await request.get('/api/{{ domain }}/{{ path_segment }}/search?q=zzzznonexistentterm', { headers });
    expect(response.status()).toBe(200);
    const body = await response.json();
    expect(body.total).toBe(0);
    expect(body.data.length).toBe(0);
  });

  test('empty q is rejected with 400', async ({ request }) => {
    const response = await request.get('/api/{{ domain }}/{{ path_segment }}/search?q=', { headers });
    expect(response.status()).toBe(400);
