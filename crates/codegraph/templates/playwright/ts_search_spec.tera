    const { data: secondData } = await second.json();
    const secondId = secondData.id;

    const response = await request.get(`/api/{{ domain }}/{{ path_segment }}/search?q=${searchTerm}`, { headers });
    expect(response.status()).toBe(200);
    const body = await response.json();
    const idxPrimary = body.data.findIndex((e: { id: string }) => e.id === createdId);
    const idxSecondary = body.data.findIndex((e: { id: string }) => e.id === secondId);
    expect(idxPrimary).not.toBe(-1);
    expect(idxSecondary).not.toBe(-1);
    expect(idxPrimary).toBeLessThan(idxSecondary);

