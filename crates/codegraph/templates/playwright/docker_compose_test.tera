# Docker Compose for E2E test environment
# Generated by codegraph. DO NOT EDIT.

version: "3.9"
services:
  db:
    image: postgres:16
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: community_os_test
    ports:
      - "5433:5432"
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 5s
      timeout: 3s
      retries: 10
    # Migrations are applied by the app on boot (migration::Migrator::up),
    # tracked in the seaql_migrations table.

  app:
    build:
      context: ../..
      dockerfile: generated/cosmos-app/Dockerfile
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db:5432/community_os_test
      SUPABASE_JWT_SECRET: test-secret-for-e2e-only
      SUPABASE_URL: http://localhost:54321
      ATPROTO_AUTHORITY: community.os
      PDS_ENDPOINT: http://localhost:2583
      FIREHOSE_HOST: localhost
      APP_ENV: development
      RUST_LOG: warn
      TEST_MODE: "true"
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/health"]
      interval: 10s
      timeout: 5s
      retries: 5
